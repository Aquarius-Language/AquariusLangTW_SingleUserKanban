# 介面主題：每個主題提供相同的顏色角色，切換時重新建立顏色值。
變數 畫 = 匯入("Processing");
# 角色：底、側欄、面板、卡底、卡滑過、邊線、強邊線、墨、次墨、淡墨、強調、強調字、琥珀、珊瑚、成功、選取、陰影、遮罩、亮色
變數 定義 = [
    {"名稱":["Aquarius Night","星泉夜色"],"亮":假,
     "底":[8,14,17],"側欄":[12,20,24],"面板":[15,24,28],"卡底":[22,33,37],"卡滑過":[28,42,47],"邊線":[39,57,61],"強邊線":[62,86,91],
     "墨":[231,236,233],"次墨":[150,166,170],"淡墨":[104,120,124],"強調":[165,231,216],"強調字":[8,14,17],
     "琥珀":[236,194,131],"珊瑚":[240,150,147],"成功":[150,220,170],"選取":[70,140,128],"陰影":[0,0,0,120],"遮罩":[2,6,8,170],
     "色票":[[165,231,216],[166,188,232],[220,173,218],[236,194,131],[233,146,143],[171,204,146]]},
    {"名稱":["Daylight","晨光白"],"亮":真,
     "底":[244,247,247],"側欄":[236,241,241],"面板":[255,255,255],"卡底":[255,255,255],"卡滑過":[246,250,249],"邊線":[220,227,228],"強邊線":[190,201,203],
     "墨":[24,34,38],"次墨":[86,101,106],"淡墨":[130,143,147],"強調":[15,128,110],"強調字":[255,255,255],
     "琥珀":[168,104,14],"珊瑚":[196,60,56],"成功":[22,140,84],"選取":[178,226,214],"陰影":[20,40,40,40],"遮罩":[20,30,32,110],
     "色票":[[22,150,128],[70,110,200],[160,80,170],[200,135,30],[210,80,76],[90,150,60]]},
    {"名稱":["Midnight Blue","午夜藍"],"亮":假,
     "底":[10,14,26],"側欄":[13,18,33],"面板":[17,23,40],"卡底":[25,33,54],"卡滑過":[32,42,68],"邊線":[44,56,86],"強邊線":[70,86,124],
     "墨":[230,235,247],"次墨":[150,162,190],"淡墨":[108,120,150],"強調":[140,172,255],"強調字":[10,14,26],
     "琥珀":[240,198,120],"珊瑚":[250,140,150],"成功":[140,220,180],"選取":[60,84,150],"陰影":[0,0,10,130],"遮罩":[4,6,14,175],
     "色票":[[140,172,255],[120,220,230],[210,160,255],[240,198,120],[250,140,150],[160,220,140]]},
    {"名稱":["Paper","紙與墨"],"亮":真,
     "底":[243,238,227],"側欄":[236,230,216],"面板":[251,248,240],"卡底":[255,253,247],"卡滑過":[249,245,235],"邊線":[223,213,194],"強邊線":[196,183,160],
     "墨":[48,40,31],"次墨":[106,94,79],"淡墨":[146,133,115],"強調":[166,86,40],"強調字":[255,251,242],
     "琥珀":[160,104,20],"珊瑚":[186,58,50],"成功":[60,120,60],"選取":[236,206,170],"陰影":[60,40,20,40],"遮罩":[40,30,20,110],
     "色票":[[166,86,40],[60,110,150],[140,70,120],[180,130,30],[190,70,60],[80,130,70]]},
    {"名稱":["Nebula","星雲紫"],"亮":假,
     "底":[15,11,23],"側欄":[20,15,30],"面板":[25,19,37],"卡底":[35,27,51],"卡滑過":[44,34,63],"邊線":[60,49,84],"強邊線":[90,74,124],
     "墨":[238,232,247],"次墨":[168,156,190],"淡墨":[124,112,148],"強調":[214,172,255],"強調字":[20,12,30],
     "琥珀":[244,200,130],"珊瑚":[250,146,160],"成功":[160,226,180],"選取":[96,70,140],"陰影":[0,0,0,130],"遮罩":[6,2,12,175],
     "色票":[[214,172,255],[140,200,255],[255,160,210],[244,200,130],[250,146,160],[170,226,160]]},
    {"名稱":["High Contrast","高對比"],"亮":假,
     "底":[0,0,0],"側欄":[0,0,0],"面板":[10,10,10],"卡底":[18,18,18],"卡滑過":[34,34,34],"邊線":[150,150,150],"強邊線":[230,230,230],
     "墨":[255,255,255],"次墨":[225,225,225],"淡墨":[190,190,190],"強調":[255,214,0],"強調字":[0,0,0],
     "琥珀":[255,200,60],"珊瑚":[255,120,120],"成功":[110,255,160],"選取":[0,90,200],"陰影":[0,0,0,0],"遮罩":[0,0,0,200],
     "色票":[[255,214,0],[110,190,255],[255,140,255],[255,170,60],[255,110,110],[120,255,140]]}
];
變數 數量 = 長度(定義);
變數 目前 = 0;
變數 色 = {};
變數 色票 = [];
變數 是亮色 = 假;
變數 建色 = 函式(值) { 如果 (長度(值)==4) { 回傳 畫.顏色(值[0],值[1],值[2],值[3]); } 回傳 畫.顏色(值[0],值[1],值[2]); };
變數 角色們 = ["底","側欄","面板","卡底","卡滑過","邊線","強邊線","墨","次墨","淡墨","強調","強調字","琥珀","珊瑚","成功","選取","陰影","遮罩"];
變數 套用 = 函式(索引) {
    如果 (索引<0 || 索引>=數量) { 索引=0; } 目前=索引; 變數 主=定義[索引]; 變數 新={};
    迴圈 (變數 索=0; 索<長度(角色們); 索++) { 新[角色們[索]]=建色(主[角色們[索]]); }
    色=新; 是亮色=主["亮"]; 色票=[]; 迴圈 (變數 索=0; 索<6; 索++) { 色票=加入(色票,建色(主["色票"][索])); }
};
變數 名稱 = 函式(索引,語言) { 回傳 定義[索引]["名稱"][語言]; };
# 取得某主題的預覽顏色（不切換主題）。
變數 預覽 = 函式(索引,角色) { 回傳 建色(定義[索引][角色]); };
# 以 0..255 透明度重建顏色。
變數 透明 = 函式(顏色,透明度) { 回傳 畫.顏色(畫.紅色分量(顏色),畫.綠色分量(顏色),畫.藍色分量(顏色),透明度); };
# 兩色混合，比例 0..1。
變數 混合 = 函式(甲,乙,比) { 回傳 畫.色彩插值(甲,乙,比); };
