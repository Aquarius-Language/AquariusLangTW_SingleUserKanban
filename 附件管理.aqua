# 附件位元組與看板中繼資料分開保存，避免每次鍵入重新序列化大型陣列。
# 桌面使用應用程式資料夾，網頁使用瀏覽器的 IndexedDB；無法使用持久儲存時退回記憶體。
變數 儲存=匯入("Storage"); 變數 序列=匯入("Serialization"); 變數 空值=[0][1];
變數 持久=真; 變數 記憶體={}; 變數 序號=0; 變數 前綴="xingquan-kanban.asset."; 變數 索引鍵="xingquan-kanban.asset-index";
變數 索引=[]; 變數 索引已載入=假;
變數 設定=函式(持久儲存,儲存前綴) { 持久=持久儲存; 前綴=儲存前綴+".asset."; 索引鍵=儲存前綴+".asset-index"; 索引=[]; 索引已載入=假; };
變數 載入索引=函式() {
    如果 (索引已載入 || !持久) { 回傳 空值; } 索引已載入=真;
    變數 位元=儲存.讀取(索引鍵); 如果 (位元==空值) { 回傳 空值; }
    變數 結果=序列.嘗試解析二進位(位元); 如果 (結果.ok) { 如果 (型別(結果.value)=="array") { 索引=結果.value; } }
};
變數 寫索引=函式() { 如果 (持久) { 儲存.寫入(索引鍵,序列.二進位序列化(索引,1)); } };
變數 建立=函式(名稱,位元組) {
    載入索引(); 序號++; 變數 鍵=前綴+序列.JSON序列化(目前時間())+"-"+序列.JSON序列化(序號);
    如果 (持久) { 迴圈 (變數 索=0;索<64;索++) { 如果 (儲存.讀取(鍵)==空值) { 中斷; } 序號++; 鍵=前綴+序列.JSON序列化(目前時間())+"-"+序列.JSON序列化(序號); } }
    如果 (持久) { 儲存.寫入(鍵,位元組); 索引=加入(索引,鍵); 寫索引(); } 否則 { 記憶體[鍵]=位元組; }
    回傳 {"名稱":名稱,"資源鍵":鍵,"大小":長度(位元組)};
};
變數 讀取=函式(附件) { 如果 (!持久) { 回傳 記憶體[附件["資源鍵"]]; } 回傳 儲存.讀取(附件["資源鍵"]); };
變數 是位元組=函式(值) { 如果 (型別(值)!="integer") { 回傳 假; } 回傳 值>=0 && 值<=255; };
變數 處理看板=函式(板,載入) {
    迴圈 (變數 列索=0;列索<長度(板["清單"]);列索++) { 變數 列=板["清單"][列索];
        迴圈 (變數 卡索=0;卡索<長度(列["卡片"]);卡索++) { 變數 卡=列["卡片"][卡索];
            迴圈 (變數 附索=0;附索<長度(卡["附件"]);附索++) { 變數 附=卡["附件"][附索];
                如果 (載入) {
                    如果 (附["位元組"]==空值) { 回傳 假; } 變數 位元=附["位元組"]; 如果 (型別(位元)!="array") { 回傳 假; } 如果 (長度(位元)!=附["大小"]) { 回傳 假; }
                    迴圈 (變數 位=0;位<長度(位元);位++) { 如果 (!是位元組(位元[位])) { 回傳 假; } }
                    卡["附件"][附索]=建立(附["名稱"],位元);
                }
                否則 { 變數 位元=讀取(附); 如果 (位元==空值) { 回傳 假; } 附["位元組"]=位元; }
            }
        }
    } 回傳 真;
};
變數 處理文件=函式(文件,載入) {
    迴圈 (變數 區索=0;區索<長度(文件["工作區"]);區索++) { 變數 區=文件["工作區"][區索]; 迴圈 (變數 板索=0;板索<長度(區["看板"]);板索++) { 如果 (!處理看板(區["看板"][板索],載入)) { 回傳 假; } } }
    迴圈 (變數 索=0;索<長度(文件["範本"]);索++) { 如果 (!處理看板(文件["範本"][索]["看板"],載入)) { 回傳 假; } }
    回傳 真;
};
變數 封裝=函式(文件) { 變數 新=序列.解析JSON(序列.JSON序列化(文件)); 如果 (!處理文件(新,假)) { 回傳 空值; } 回傳 新; };
變數 載入=函式(文件) { 回傳 處理文件(文件,真); };
# 收集文件引用的資源鍵。
變數 收集鍵=函式(文件,鍵們) {
    如果 (文件==空值) { 回傳 鍵們; }
    變數 板們=[]; 迴圈 (變數 區索=0;區索<長度(文件["工作區"]);區索++) { 變數 區=文件["工作區"][區索]; 迴圈 (變數 板索=0;板索<長度(區["看板"]);板索++) { 板們=加入(板們,區["看板"][板索]); } }
    迴圈 (變數 索=0;索<長度(文件["範本"]);索++) { 板們=加入(板們,文件["範本"][索]["看板"]); }
    迴圈 (變數 板索=0;板索<長度(板們);板索++) { 變數 板=板們[板索]; 迴圈 (變數 列索=0;列索<長度(板["清單"]);列索++) { 變數 列=板["清單"][列索]; 迴圈 (變數 卡索=0;卡索<長度(列["卡片"]);卡索++) { 變數 附們=列["卡片"][卡索]["附件"]; 迴圈 (變數 附索=0;附索<長度(附們);附索++) { 鍵們[附們[附索]["資源鍵"]]=真; } } } }
    回傳 鍵們;
};
# 啟動時刪除主檔與上一份備援都不再引用的附件檔案；回傳刪除數量。
# 只處理由索引記錄的檔案；索引以前的舊附件會保留。
變數 清理=函式(主檔,備援) {
    如果 (!持久) { 回傳 0; } 載入索引(); 如果 (長度(索引)==0) { 回傳 0; }
    變數 用到=收集鍵(備援,收集鍵(主檔,{})); 變數 留=[]; 變數 刪=0;
    迴圈 (變數 索=0;索<長度(索引);索++) { 變數 鍵=索引[索]; 如果 (用到[鍵]!=空值) { 留=加入(留,鍵); } 否則 { 儲存.刪除(鍵); 刪++; } }
    如果 (刪>0) { 索引=留; 寫索引(); } 回傳 刪;
};
