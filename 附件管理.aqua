# 附件位元組與看板中繼資料分開保存，避免每次鍵入重新序列化大型陣列。
變數 儲存=匯入("Storage"); 變數 序列=匯入("Serialization"); 變數 空值=[0][1];
變數 網頁=真; 變數 記憶體={}; 變數 序號=0; 變數 前綴="xingquan-kanban.asset.";
變數 設定=函式(網頁環境,儲存前綴) { 網頁=網頁環境; 前綴=儲存前綴+".asset."; };
變數 建立=函式(名稱,位元組) {
    序號++; 變數 鍵=前綴+序列.JSON序列化(目前時間())+"-"+序列.JSON序列化(序號);
    如果 (!網頁) { 迴圈 (變數 索=0;儲存.讀取(鍵)!=空值;索++) { 序號++; 鍵=前綴+序列.JSON序列化(目前時間())+"-"+序列.JSON序列化(序號); } }
    如果 (網頁) { 記憶體[鍵]=位元組; } 否則 { 儲存.寫入(鍵,位元組); }
    回傳 {"名稱":名稱,"資源鍵":鍵,"大小":長度(位元組)};
};
變數 讀取=函式(附件) { 如果 (網頁) { 回傳 記憶體[附件["資源鍵"]]; } 回傳 儲存.讀取(附件["資源鍵"]); };
變數 是位元組=函式(值) { 變數 文=序列.JSON序列化(值); 如果 (長度(文)==0 || 長度(文)>3) { 回傳 假; } 迴圈 (變數 索=0;索<長度(文);索++) { 變數 合法=假; 變數 數字="0123456789"; 迴圈 (變數 位=0;位<10;位++) { 如果 (文[索]==數字[位]) { 合法=真; } } 如果 (!合法) { 回傳 假; } } 回傳 值>=0 && 值<=255; };
變數 處理看板=函式(板,載入) {
    迴圈 (變數 列索=0;列索<長度(板["清單"]);列索++) { 變數 列=板["清單"][列索];
        迴圈 (變數 卡索=0;卡索<長度(列["卡片"]);卡索++) { 變數 卡=列["卡片"][卡索];
            迴圈 (變數 附索=0;附索<長度(卡["附件"]);附索++) { 變數 附=卡["附件"][附索];
                如果 (載入) { 如果 (附["位元組"]==空值) { 回傳 假; } 變數 位元=附["位元組"]; 變數 文字=序列.JSON序列化(位元); 如果 (文字[0]!="[") { 回傳 假; } 如果 (長度(位元)!=附["大小"]) { 回傳 假; } 迴圈 (變數 位=0;位<長度(位元);位++) { 如果 (!是位元組(位元[位])) { 回傳 假; } } 卡["附件"][附索]=建立(附["名稱"],位元); }
                否則 { 變數 位元=讀取(附); 如果 (位元==空值) { 回傳 假; } 附["位元組"]=位元; }
            }
        }
    } 回傳 真;
};
變數 處理文件=函式(文件,載入) {
    迴圈 (變數 區索=0;區索<長度(文件["工作區"]);區索++) { 變數 區=文件["工作區"][區索]; 迴圈 (變數 板索=0;板索<長度(區["看板"]);板索++) { 如果 (!處理看板(區["看板"][板索],載入)) { 回傳 假; } } }
    迴圈 (變數 索=0;索<長度(文件["範本"]);索++) { 如果 (!處理看板(文件["範本"][索]["看板"],載入)) { 回傳 假; } }
    回傳 真;
};
變數 封裝=函式(文件) { 變數 新=序列.解析JSON(序列.JSON序列化(文件)); 如果 (!處理文件(新,假)) { 回傳 空值; } 回傳 新; };
變數 載入=函式(文件) { 回傳 處理文件(文件,真); };
