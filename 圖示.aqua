# 以線條繪製的介面圖示。座標以 24 格設計，依尺寸縮放；呼叫前需已套用介面縮放矩陣。
變數 畫 = 匯入("Processing");
變數 左 = 0.0d; 變數 上 = 0.0d; 變數 格 = 1.0d;
變數 點橫 = 函式(值) { 回傳 左+值*格; };
變數 點縱 = 函式(值) { 回傳 上+值*格; };
變數 線 = 函式(甲,乙,丙,丁) { 畫.線段(點橫(甲),點縱(乙),點橫(丙),點縱(丁)); };
變數 折線 = 函式(點們,封閉) {
    畫.開始圖形(); 迴圈 (變數 索=0; 索<長度(點們); 索++) { 畫.頂點(點橫(點們[索][0]),點縱(點們[索][1])); }
    如果 (封閉) { 畫.結束圖形(1); } 否則 { 畫.結束圖形(); }
};
變數 圓 = 函式(橫,縱,半徑) { 畫.圓形(點橫(橫),點縱(縱),半徑*2*格); };
變數 弧 = 函式(橫,縱,半徑,起,終) { 畫.圓弧(點橫(橫),點縱(縱),半徑*2*格,半徑*2*格,起,終); };
變數 框 = 函式(橫,縱,寬,高,圓角) { 畫.矩形(點橫(橫),點縱(縱),寬*格,高*格,圓角*格); };
變數 實點 = 函式(橫,縱,半徑,顏色) { 畫.停用描邊(); 畫.填色(顏色); 圓(橫,縱,半徑); 畫.停用填色(); };
變數 派 = 3.14159265d;

# 星形：中心、外徑與內徑。
變數 星點 = 函式(外,內) { 變數 點們=[]; 迴圈 (變數 索=0; 索<10; 索++) { 變數 角=-派/2+索*派/5; 變數 半=外; 如果 (索%2==1) { 半=內; } 點們=加入(點們,[12+畫.餘弦(角)*半,12.6d+畫.正弦(角)*半]); } 回傳 點們; };

變數 繪 = 函式(名稱,中橫,中縱,尺寸,顏色) {
    格=尺寸/24.0d; 左=中橫-尺寸/2.0d; 上=中縱-尺寸/2.0d;
    畫.推入樣式(); 畫.停用填色(); 畫.描邊(顏色); 畫.描邊粗細(畫.最大值(1.2d,1.75d*尺寸/18.0d)); 畫.描邊端點(1); 畫.描邊接角(1);
    如果 (名稱=="加") { 線(12,5,12,19); 線(5,12,19,12); }
    否則如果 (名稱=="關閉") { 線(6.5d,6.5d,17.5d,17.5d); 線(17.5d,6.5d,6.5d,17.5d); }
    否則如果 (名稱=="更多") { 實點(6,12,1.7d,顏色); 實點(12,12,1.7d,顏色); 實點(18,12,1.7d,顏色); }
    否則如果 (名稱=="直更多") { 實點(12,6,1.7d,顏色); 實點(12,12,1.7d,顏色); 實點(12,18,1.7d,顏色); }
    否則如果 (名稱=="勾") { 折線([[5,12.5d],[10,17],[19,7]],假); }
    否則如果 (名稱=="圓") { 圓(12,12,8); }
    否則如果 (名稱=="勾圓") { 畫.停用描邊(); 畫.填色(顏色); 圓(12,12,9); 畫.停用填色(); 畫.描邊(255,255,255); 畫.描邊粗細(畫.最大值(1.4d,2.0d*尺寸/18.0d)); 折線([[7.5d,12.5d],[10.7d,15.6d],[16.5d,8.8d]],假); }
    否則如果 (名稱=="復原") { 折線([[8,6],[4,10],[8,14]],假); 線(4,10,14,10); 弧(14,14.5d,4.5d,-派/2,派/2); 線(14,19,9,19); }
    否則如果 (名稱=="重做") { 折線([[16,6],[20,10],[16,14]],假); 線(20,10,10,10); 弧(10,14.5d,4.5d,派/2,派*1.5d); 線(10,19,15,19); }
    否則如果 (名稱=="搜尋") { 圓(10.5d,10.5d,6); 線(15.2d,15.2d,20,20); }
    否則如果 (名稱=="篩選") { 折線([[4,5],[20,5],[14,12.5d],[14,19],[10,17],[10,12.5d]],真); }
    否則如果 (名稱=="標籤") { 折線([[4,4],[12,4],[20,12],[12,20],[4,12]],真); 實點(8.5d,8.5d,1.5d,顏色); }
    否則如果 (名稱=="人") { 圓(12,8.5d,3.6d); 弧(12,20.5d,7,派,派*2); }
    否則如果 (名稱=="日曆") { 框(4,5.5d,16,14.5d,2); 線(4,10,20,10); 線(8.5d,3.5d,8.5d,7.5d); 線(15.5d,3.5d,15.5d,7.5d); }
    否則如果 (名稱=="時鐘") { 圓(12,12,8.5d); 折線([[12,7],[12,12],[15.5d,14]],假); }
    否則如果 (名稱=="星") { 折線(星點(8.6d,3.8d),真); }
    否則如果 (名稱=="實星") { 畫.填色(顏色); 折線(星點(8.6d,3.8d),真); 畫.停用填色(); }
    否則如果 (名稱=="旗") { 線(6,21,6,4); 折線([[6,4.5d],[18,4.5d],[15,9],[18,13.5d],[6,13.5d]],假); }
    否則如果 (名稱=="實旗") { 線(6,21,6,4); 畫.填色(顏色); 折線([[6,4.5d],[18,4.5d],[15,9],[18,13.5d],[6,13.5d]],真); 畫.停用填色(); }
    否則如果 (名稱=="看板") { 框(4,4,4.5d,16,1.2d); 框(9.75d,4,4.5d,10,1.2d); 框(15.5d,4,4.5d,13,1.2d); }
    否則如果 (名稱=="表格") { 框(4,5,16,14,1.5d); 線(4,10,20,10); 線(4,14.5d,20,14.5d); 線(9.5d,5,9.5d,19); }
    否則如果 (名稱=="封存") { 框(3.5d,4.5d,17,4.5d,1); 折線([[5,9],[5,19.5d],[19,19.5d],[19,9]],假); 線(9.5d,13,14.5d,13); }
    否則如果 (名稱=="範本") { 折線([[12,4],[20.5d,8.5d],[12,13],[3.5d,8.5d]],真); 折線([[3.5d,12.5d],[12,17],[20.5d,12.5d]],假); 折線([[3.5d,16.5d],[12,21],[20.5d,16.5d]],假); }
    否則如果 (名稱=="設定") {
        圓(12,12,3); 圓(12,12,6.2d);
        迴圈 (變數 索=0; 索<8; 索++) { 變數 角=索*派/4; 畫.線段(點橫(12+畫.餘弦(角)*6.4d),點縱(12+畫.正弦(角)*6.4d),點橫(12+畫.餘弦(角)*9),點縱(12+畫.正弦(角)*9)); }
    }
    否則如果 (名稱=="說明") { 圓(12,12,9); 弧(12,9.6d,3,-派,0.35d); 線(14.8d,10.7d,12,13.2d); 線(12,13.2d,12,14.4d); 實點(12,17.6d,1.2d,顏色); }
    否則如果 (名稱=="資訊") { 圓(12,12,9); 線(12,11,12,17); 實點(12,7.6d,1.2d,顏色); }
    否則如果 (名稱=="警告") { 折線([[12,3.8d],[21,19.8d],[3,19.8d]],真); 線(12,9.5d,12,14); 實點(12,17,1.1d,顏色); }
    否則如果 (名稱=="調色盤") { 圓(12,12,8.8d); 實點(8.5d,9.5d,1.5d,顏色); 實點(12.5d,7.2d,1.5d,顏色); 實點(16,10,1.5d,顏色); 實點(15,14.8d,1.5d,顏色); }
    否則如果 (名稱=="地球") { 圓(12,12,8.8d); 畫.橢圓(點橫(12),點縱(12),8*格,17.6d*格); 線(3.4d,12,20.6d,12); }
    否則如果 (名稱=="垃圾桶") { 線(4,7,20,7); 折線([[6,7],[7,20],[17,20],[18,7]],假); 線(9.5d,4,14.5d,4); 線(10,10.5d,10,16.5d); 線(14,10.5d,14,16.5d); }
    否則如果 (名稱=="複製") { 框(8.5d,8.5d,11.5d,11.5d,2); 折線([[15.5d,8.5d],[15.5d,4],[4,4],[4,15.5d],[8.5d,15.5d]],假); }
    否則如果 (名稱=="移動") { 線(3.5d,12,15.5d,12); 折線([[11.5d,8],[15.5d,12],[11.5d,16]],假); 線(20,5,20,19); }
    否則如果 (名稱=="迴紋針") {
        變數 舊左=左; 變數 舊上=上; 畫.推入矩陣(); 畫.平移(點橫(12),點縱(12)); 畫.旋轉(派/4); 左=-12*格; 上=-12*格;
        線(8,6,8,17); 弧(12,17,4,0,派); 線(16,17,16,5); 弧(14,5,2,派,派*2); 線(12,5,12,15);
        畫.彈出矩陣(); 左=舊左; 上=舊上;
    }
    否則如果 (名稱=="筆記") { 框(5,3.5d,14,17,2); 線(8.5d,8.5d,15.5d,8.5d); 線(8.5d,12,15.5d,12); 線(8.5d,15.5d,12.5d,15.5d); }
    否則如果 (名稱=="檢查表") { 框(3.5d,4.5d,6,6,1.2d); 折線([[4.8d,7.6d],[6.3d,9],[8.6d,6]],假); 線(12.5d,7.5d,20.5d,7.5d); 框(3.5d,13.5d,6,6,1.2d); 線(12.5d,16.5d,20.5d,16.5d); }
    否則如果 (名稱=="向下") { 折線([[6,9],[12,15],[18,9]],假); }
    否則如果 (名稱=="向上") { 折線([[6,15],[12,9],[18,15]],假); }
    否則如果 (名稱=="向右") { 折線([[9,6],[15,12],[9,18]],假); }
    否則如果 (名稱=="向左") { 折線([[15,6],[9,12],[15,18]],假); }
    否則如果 (名稱=="握把") { 實點(9,6,1.5d,顏色); 實點(15,6,1.5d,顏色); 實點(9,12,1.5d,顏色); 實點(15,12,1.5d,顏色); 實點(9,18,1.5d,顏色); 實點(15,18,1.5d,顏色); }
    否則如果 (名稱=="開啟") { 折線([[3,18.5d],[3,5.5d],[9,5.5d],[11,7.5d],[20,7.5d],[20,10]],假); 折線([[3,18.5d],[6,10.5d],[21.5d,10.5d],[18.5d,18.5d]],真); }
    否則如果 (名稱=="儲存") { 線(12,3.5d,12,14.5d); 折線([[7,10],[12,15],[17,10]],假); 折線([[4,15],[4,20],[20,20],[20,15]],假); }
    否則如果 (名稱=="匯出") { 線(12,15,12,3.8d); 折線([[7.5d,8],[12,3.5d],[16.5d,8]],假); 折線([[4,13],[4,20],[20,20],[20,13]],假); }
    否則如果 (名稱=="編輯") { 折線([[15.5d,4.5d],[19.5d,8.5d],[9,19],[4.5d,19.5d],[5,15]],真); 線(13,7,17,11); }
    否則如果 (名稱=="鍵盤") { 框(2.5d,6.5d,19,11,2); 線(7,14,17,14); 實點(6.5d,10,0.9d,顏色); 實點(10,10,0.9d,顏色); 實點(13.5d,10,0.9d,顏色); 實點(17,10,0.9d,顏色); }
    否則如果 (名稱=="眼") {
        畫.貝茲曲線(點橫(2.5d),點縱(12),點橫(7),點縱(5),點橫(17),點縱(5),點橫(21.5d),點縱(12)); 畫.貝茲曲線(點橫(2.5d),點縱(12),點橫(7),點縱(19),點橫(17),點縱(19),點橫(21.5d),點縱(12)); 圓(12,12,3);
    }
    否則如果 (名稱=="實眼") {
        畫.貝茲曲線(點橫(2.5d),點縱(12),點橫(7),點縱(5),點橫(17),點縱(5),點橫(21.5d),點縱(12)); 畫.貝茲曲線(點橫(2.5d),點縱(12),點橫(7),點縱(19),點橫(17),點縱(19),點橫(21.5d),點縱(12)); 實點(12,12,3.4d,顏色);
    }
    否則如果 (名稱=="側欄") { 框(3,4.5d,18,15,2); 線(9.5d,4.5d,9.5d,19.5d); }
    否則如果 (名稱=="放大") { 圓(10.5d,10.5d,6.5d); 線(15.5d,15.5d,20.5d,20.5d); 線(10.5d,7.5d,10.5d,13.5d); 線(7.5d,10.5d,13.5d,10.5d); }
    否則如果 (名稱=="縮小") { 圓(10.5d,10.5d,6.5d); 線(15.5d,15.5d,20.5d,20.5d); 線(7.5d,10.5d,13.5d,10.5d); }
    否則如果 (名稱=="排序") { 線(5,7,19,7); 線(5,12,15,12); 線(5,17,11,17); }
    否則如果 (名稱=="收合") { 折線([[14,6],[8,12],[14,18]],假); 折線([[20,6],[14,12],[20,18]],假); }
    否則如果 (名稱=="展開") { 折線([[10,6],[16,12],[10,18]],假); 折線([[4,6],[10,12],[4,18]],假); }
    否則如果 (名稱=="活動") { 折線([[3,12],[7,12],[10,5],[14,19],[17,12],[21,12]],假); }
    否則如果 (名稱=="工作區") { 框(4,4,7,7,1.5d); 框(13,4,7,7,1.5d); 框(4,13,7,7,1.5d); 框(13,13,7,7,1.5d); }
    否則如果 (名稱=="重試") { 弧(12,12,7.5d,-派*0.85d,派*0.9d); 折線([[4.2d,4.5d],[4.6d,9],[9,8.2d]],假); }
    否則如果 (名稱=="重複") { 折線([[17,2.5d],[20.5d,6],[17,9.5d]],假); 線(3.5d,11,3.5d,10); 弧(7.5d,10,4,派,派*1.5d); 線(7.5d,6,20.5d,6); 折線([[7,21.5d],[3.5d,18],[7,14.5d]],假); 線(20.5d,13,20.5d,14); 弧(16.5d,14,4,0,派*0.5d); 線(16.5d,18,3.5d,18); }
    否則如果 (名稱=="選取") { 框(4,4,16,16,3); 折線([[8,12],[11,15],[16.5d,9]],假); }
    否則如果 (名稱=="空框") { 框(4,4,16,16,3); }
    否則如果 (名稱=="貼上") { 框(5,5,14,16,2); 框(9,3,6,4,1); }
    否則如果 (名稱=="剪下") { 圓(7,17,2.8d); 圓(17,17,2.8d); 線(8.8d,14.8d,17,4); 線(15.2d,14.8d,7,4); }
    否則如果 (名稱=="清單") { 框(4,4,7,16,1.5d); 框(13,4,7,10,1.5d); }
    否則如果 (名稱=="卡片") { 框(3.5d,6,17,12,2); 線(7,10.5d,15,10.5d); }
    否則如果 (名稱=="點") { 實點(12,12,3.5d,顏色); }
    否則如果 (名稱=="首頁") { 折線([[3.5d,11],[12,4],[20.5d,11]],假); 折線([[6,9.5d],[6,20],[18,20],[18,9.5d]],假); }
    否則如果 (名稱=="指令") { 框(3,5,18,14,2.5d); 折線([[7,9.5d],[10,12],[7,14.5d]],假); 線(12,15,17,15); }
    否則如果 (名稱=="太陽") { 圓(12,12,4); 迴圈 (變數 索=0; 索<8; 索++) { 變數 角=索*派/4; 畫.線段(點橫(12+畫.餘弦(角)*6.6d),點縱(12+畫.正弦(角)*6.6d),點橫(12+畫.餘弦(角)*9),點縱(12+畫.正弦(角)*9)); } }
    否則如果 (名稱=="月亮") { 弧(12,12,8.5d,派*0.3d,派*1.85d); 弧(15.5d,9,6.4d,派*0.62d,派*1.38d); }
    否則如果 (名稱=="字") { 折線([[5,19],[10,5],[15,19]],假); 線(7,14,13,14); 線(15,9,21,9); 線(18,9,18,19); }
    否則如果 (名稱=="鎖") { 框(5,10.5d,14,10,2); 弧(12,10.5d,4.5d,派,派*2); }
    否則如果 (名稱=="拖曳") { 折線([[12,3],[12,21]],假); 折線([[3,12],[21,12]],假); 折線([[9.5d,5.5d],[12,3],[14.5d,5.5d]],假); 折線([[9.5d,18.5d],[12,21],[14.5d,18.5d]],假); 折線([[5.5d,9.5d],[3,12],[5.5d,14.5d]],假); 折線([[18.5d,9.5d],[21,12],[18.5d,14.5d]],假); }
    否則 { 圓(12,12,3); }
    畫.彈出樣式();
};
