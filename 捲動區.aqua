# 可重用的雙軸捲動模型。使用現有裁切、滾輪與指標能力，無須修改語言核心。
# 「橫／縱」是目前位置；「目標橫／目標縱」供平滑捲動逐格接近；「速橫／速縱」是放手後的慣性。
變數 限制 = 函式(值,下限,上限) { 如果 (值 < 下限) { 回傳 下限; } 如果 (值 > 上限) { 回傳 上限; } 回傳 值; };
變數 建立 = 函式() { 回傳 {"橫":0.0d,"縱":0.0d,"目標橫":0.0d,"目標縱":0.0d,"速橫":0.0d,"速縱":0.0d,"內容寬":0.0d,"內容高":0.0d,"視野寬":0.0d,"視野高":0.0d}; };
變數 最大橫 = 函式(區) { 回傳 限制(區["內容寬"]-區["視野寬"],0,10000000); };
變數 最大縱 = 函式(區) { 回傳 限制(區["內容高"]-區["視野高"],0,10000000); };
變數 設定 = 函式(區,內容寬,內容高,視野寬,視野高) {
    區["內容寬"]=內容寬; 區["內容高"]=內容高; 區["視野寬"]=視野寬; 區["視野高"]=視野高;
    區["橫"]=限制(區["橫"],0,最大橫(區)); 區["縱"]=限制(區["縱"],0,最大縱(區));
    區["目標橫"]=限制(區["目標橫"],0,最大橫(區)); 區["目標縱"]=限制(區["目標縱"],0,最大縱(區));
};
# 立即移動（拖曳、測試與無動畫模式）。
變數 移動 = 函式(區,橫,縱) {
    區["橫"]=限制(區["橫"]+橫,0,最大橫(區)); 區["縱"]=限制(區["縱"]+縱,0,最大縱(區));
    區["目標橫"]=區["橫"]; 區["目標縱"]=區["縱"]; 區["速橫"]=0.0d; 區["速縱"]=0.0d;
};
# 平滑移動：累加目標，由「步進」逐格接近。
變數 平滑移動 = 函式(區,橫,縱) {
    區["目標橫"]=限制(區["目標橫"]+橫,0,最大橫(區)); 區["目標縱"]=限制(區["目標縱"]+縱,0,最大縱(區)); 區["速橫"]=0.0d; 區["速縱"]=0.0d;
};
變數 跳到 = 函式(區,橫,縱) { 區["橫"]=限制(橫,0,最大橫(區)); 區["縱"]=限制(縱,0,最大縱(區)); 區["目標橫"]=區["橫"]; 區["目標縱"]=區["縱"]; 區["速橫"]=0.0d; 區["速縱"]=0.0d; };
變數 平滑到 = 函式(區,橫,縱) { 區["目標橫"]=限制(橫,0,最大橫(區)); 區["目標縱"]=限制(縱,0,最大縱(區)); };
# 確保 [起,終) 範圍在縱向可視區內。
變數 顯示縱向 = 函式(區,起,終,平滑) {
    變數 目標=區["目標縱"]; 如果 (起<目標) { 目標=起; } 否則如果 (終>目標+區["視野高"]) { 目標=終-區["視野高"]; }
    如果 (平滑) { 平滑到(區,區["目標橫"],目標); } 否則 { 跳到(區,區["橫"],目標); }
};
變數 顯示橫向 = 函式(區,起,終,平滑) {
    變數 目標=區["目標橫"]; 如果 (起<目標) { 目標=起; } 否則如果 (終>目標+區["視野寬"]) { 目標=終-區["視野寬"]; }
    如果 (平滑) { 平滑到(區,目標,區["目標縱"]); } 否則 { 跳到(區,目標,區["縱"]); }
};
# 按下指標時停止平滑捲動與慣性，避免點選目標在放開前移動。
變數 停止 = 函式(區) { 區["目標橫"]=區["橫"]; 區["目標縱"]=區["縱"]; 區["速橫"]=0.0d; 區["速縱"]=0.0d; };
# 放手後的慣性（每毫秒像素）。
變數 慣性 = 函式(區,速橫,速縱) { 區["速橫"]=速橫; 區["速縱"]=速縱; };
# 依經過毫秒推進；回傳是否仍需要下一格。
變數 步進 = 函式(區,毫秒) {
    如果 (毫秒>100) { 毫秒=100; } 變數 進行=假;
    如果 (區["速橫"]!=0 || 區["速縱"]!=0) {
        區["目標橫"]=限制(區["目標橫"]+區["速橫"]*毫秒,0,最大橫(區)); 區["目標縱"]=限制(區["目標縱"]+區["速縱"]*毫秒,0,最大縱(區));
        變數 衰=1.0d-毫秒*0.0032d; 如果 (衰<0) { 衰=0.0d; } 區["速橫"]=區["速橫"]*衰; 區["速縱"]=區["速縱"]*衰;
        如果 (區["速橫"]<0.02d && 區["速橫"]>-0.02d) { 區["速橫"]=0.0d; } 如果 (區["速縱"]<0.02d && 區["速縱"]>-0.02d) { 區["速縱"]=0.0d; }
        進行=真;
    }
    變數 比=1.0d-畫指數(-毫秒/70.0d);
    變數 差橫=區["目標橫"]-區["橫"]; 變數 差縱=區["目標縱"]-區["縱"];
    如果 (差橫>0.5d || 差橫<-0.5d) { 區["橫"]=區["橫"]+差橫*比; 進行=真; } 否則 { 區["橫"]=區["目標橫"]; }
    如果 (差縱>0.5d || 差縱<-0.5d) { 區["縱"]=區["縱"]+差縱*比; 進行=真; } 否則 { 區["縱"]=區["目標縱"]; }
    回傳 進行;
};
# 不依賴繪圖庫的指數近似（泰勒展開，對 0..-2 精確足夠）。
變數 畫指數 = 函式(值) { 變數 和=1.0d; 變數 項=1.0d; 迴圈 (變數 索=1; 索<12; 索++) { 項=項*值/索; 和+=項; } 如果 (和<0) { 回傳 0.0d; } 回傳 和; };
變數 滑塊 = 函式(內容,視野,位移,軌道) {
    如果 (內容 <= 視野 || 內容 <= 0) { 回傳 [0,軌道]; }
    變數 長 = 限制(軌道*視野/內容,32,軌道);
    回傳 [(軌道-長)*位移/(內容-視野),長];
};
變數 拖曳 = 函式(區,橫軸,位移,軌道) {
    變數 內容=區["內容高"]; 變數 視野=區["視野高"]; 如果 (橫軸) { 內容=區["內容寬"]; 視野=區["視野寬"]; }
    變數 塊=滑塊(內容,視野,0,軌道); 變數 值=0.0d;
    如果 (軌道>塊[1]) { 值=限制(位移,0,軌道-塊[1])*(內容-視野)/(軌道-塊[1]); }
    如果 (橫軸) { 區["橫"]=值; 區["目標橫"]=值; } 否則 { 區["縱"]=值; 區["目標縱"]=值; }
    區["速橫"]=0.0d; 區["速縱"]=0.0d;
};
