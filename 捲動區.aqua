# 可重用的雙軸捲動模型。使用現有裁切、滾輪與指標能力，無須修改語言核心。
變數 限制 = 函式(值,下限,上限) { 如果 (值 < 下限) { 回傳 下限; } 如果 (值 > 上限) { 回傳 上限; } 回傳 值; };
變數 建立 = 函式() { 回傳 {"橫":0.0d,"縱":0.0d,"內容寬":0.0d,"內容高":0.0d,"視野寬":0.0d,"視野高":0.0d}; };
變數 設定 = 函式(區,內容寬,內容高,視野寬,視野高) {
    區["內容寬"]=內容寬; 區["內容高"]=內容高; 區["視野寬"]=視野寬; 區["視野高"]=視野高;
    區["橫"]=限制(區["橫"],0,限制(內容寬-視野寬,0,10000000));
    區["縱"]=限制(區["縱"],0,限制(內容高-視野高,0,10000000));
};
變數 移動 = 函式(區,橫,縱) { 區["橫"]=區["橫"]+橫; 區["縱"]=區["縱"]+縱; 設定(區,區["內容寬"],區["內容高"],區["視野寬"],區["視野高"]); };
變數 滑塊 = 函式(內容,視野,位移,軌道) {
    如果 (內容 <= 視野 || 內容 <= 0) { 回傳 [0,軌道]; }
    變數 長 = 限制(軌道*視野/內容,32,軌道);
    回傳 [(軌道-長)*位移/(內容-視野),長];
};
變數 拖曳 = 函式(區,橫軸,位移,軌道) {
    變數 內容=區["內容高"]; 變數 視野=區["視野高"]; 如果 (橫軸) { 內容=區["內容寬"]; 視野=區["視野寬"]; }
    變數 塊=滑塊(內容,視野,0,軌道); 變數 值=0.0d;
    如果 (軌道>塊[1]) { 值=限制(位移,0,軌道-塊[1])*(內容-視野)/(軌道-塊[1]); }
    如果 (橫軸) { 區["橫"]=值; } 否則 { 區["縱"]=值; }
};
