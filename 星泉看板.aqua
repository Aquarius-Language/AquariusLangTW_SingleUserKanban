變數 換行="
"; 變數 定位="	";
# 星泉看板：應用程式、互動與繪製全由星泉編譯成 WebAssembly。
變數 介面=匯入("星泉介面.aqua"); 變數 引擎=匯入("看板引擎.aqua"); 變數 捲動=匯入("捲動區.aqua");
變數 附件庫=匯入("附件管理.aqua"); 變數 語言=匯入("語言.aqua"); 變數 主題=匯入("主題.aqua"); 變數 圖示=匯入("圖示.aqua");
變數 儲存前綴="xingquan-kanban"; 變數 版本文字="1.1.0";
變數 畫=介面.畫; 變數 空值=介面.空值;
變數 檔案=介面.檔案; 變數 儲存空間=介面.儲存空間; 變數 編輯庫=介面.編輯庫;
變數 資料=函式() { 回傳 引擎.文件; };
變數 是網頁=介面.網頁環境(); 變數 是安卓=介面.安卓環境(); 變數 視窗=空值;

# ── 頁面與檢視 ──
變數 目前板=0; 變數 目前區=0; 變數 頁面="看板"; 變數 檢視="流動";
變數 看板捲動=捲動.建立(); 變數 頁面捲動=捲動.建立(); 變數 詳情捲動=捲動.建立(); 變數 側欄捲動=捲動.建立();
變數 列捲動={}; 變數 列幾何=[];
變數 命中區=[]; 變數 語意節點=[]; 變數 命中裁切=空值;
變數 比例=1.0d; 變數 版寬=1440.0d; 變數 版高=900.0d; 變數 鼠橫=0.0d; 變數 鼠縱=0.0d;
變數 介面百分比=100; 變數 自動比例=1.0d; 變數 手機版=假;
變數 頂欄高=60.0d; 變數 狀態列高=34.0d; 變數 側欄寬=244.0d; 變數 側欄收合=假;
變數 看板上緣=225.0d; 變數 看板區=[0,0,0,0];

# ── 互動 ──
變數 指標="閒置"; 變數 按下資訊=空值; 變數 按下鍵=""; 變數 滑過鍵=""; 變數 滑過區=空值; 變數 滑過起=0.0d;
變數 指標按鈕=0; 變數 指標修飾=0; 變數 指標裝置="mouse"; 變數 已收滾輪=假;
變數 卡片拖曳=空值; 變數 拖曳中=假; 變數 放置目標=空值; 變數 清單拖曳=空值; 變數 步驟拖曳=空值; 變數 日曆拖曳日=""; 變數 滑塊拖曳=空值;
變數 焦點鍵=""; 變數 焦點卡=0;
變數 上次點擊=0.0d; 變數 點擊次數=0; 變數 點擊點=[0,0];
變數 手機拖縱=0.0d; 變數 手機拖橫=0.0d; 變數 手機捲動中=假; 變數 手機滑動=0.0d; 變數 長按起=0.0d; 變數 長按中=假; 變數 速度樣本=[];

# ── 編輯 ──
變數 編輯器=空值; 變數 編輯識別=""; 變數 編輯回呼=空值; 變數 多行編輯=假; 變數 編輯提交=空值;
變數 編輯快照=""; 變數 編輯說明=""; 變數 編輯已記錄=假; 變數 編輯已改=假; 變數 選字拖曳=""; 變數 游標起=0.0d;
變數 欄位版面={};

# ── 對話 ──
變數 對話=""; 變數 對話資料=空值; 變數 對話開啟=0.0d; 變數 對話堆疊=[];
變數 詳情卡=0; 變數 教學=-1;

# ── 篩選與選取 ──
變數 查詢=""; 變數 標籤篩選=""; 變數 負責篩選=""; 變數 狀態篩選=0;
變數 多選=[]; 變數 卡片剪貼=[]; 變數 剪貼文字="";
變數 表格排序=["",1]; 變數 日曆月="";
變數 新增中列=0; 變數 新增文字="";

# ── 儲存 ──
變數 未儲存=假; 變數 存檔狀態=""; 變數 儲存耗時=0.0d; 變數 載入中=假; 變數 待載入=空值; 變數 載入畫面=假;
變數 訊息=""; 變數 附件預算=4194304;
變數 上次封包=空值; 變數 儲存鎖定=假; 變數 自動今日=真; 變數 待儲存期限=0.0d; 變數 正在儲存=假; 變數 重試次數=0; 變數 錯誤紀錄=[];
變數 首繪完成=假;
變數 篩選暫存={}; 變數 表格暫存=空值;
變數 上次查詢=""; 變數 上次標籤=""; 變數 上次負責=""; 變數 上次狀態=0; 變數 上次今日="";

# ── 動畫與提示 ──
變數 減少動態=假; 變數 動畫={}; 變數 需要動畫=假; 變數 上幀=0.0d; 變數 幀距=16.0d; 變數 提示們=[];
變數 分行快取={}; 變數 分行快取數=0;

# ── 顏色（依主題重新設定） ──
變數 底=0; 變數 側底=0; 變數 面板=0; 變數 卡底=0; 變數 卡滑過=0; 變數 邊線=0; 變數 強邊線=0;
變數 墨=0; 變數 次墨=0; 變數 淡墨=0; 變數 薄荷=0; 變數 強調字=0; 變數 琥珀=0; 變數 珊瑚=0; 變數 成功=0; 變數 選取色=0; 變數 陰影=0; 變數 遮罩=0;
變數 色票=[]; 變數 深底=0;
變數 套主題=函式(索引) {
    主題.套用(索引); 變數 色=主題.色;
    底=色["底"]; 側底=色["側欄"]; 面板=色["面板"]; 卡底=色["卡底"]; 卡滑過=色["卡滑過"]; 邊線=色["邊線"]; 強邊線=色["強邊線"];
    墨=色["墨"]; 次墨=色["次墨"]; 淡墨=色["淡墨"]; 薄荷=色["強調"]; 強調字=色["強調字"]; 琥珀=色["琥珀"]; 珊瑚=色["珊瑚"]; 成功=色["成功"];
    選取色=色["選取"]; 陰影=色["陰影"]; 遮罩=色["遮罩"]; 色票=主題.色票; 深底=底;
};
變數 透明=函式(顏色,值) { 回傳 主題.透明(顏色,值); };

# ── 語言 ──
變數 字=函式(鍵) { 回傳 語言.字(鍵); };
變數 格式=函式(鍵,參數們) { 回傳 語言.格式(鍵,參數們); };
變數 英文=函式() { 回傳 語言.目前==0; };

變數 色名=函式(索) { 回傳 [字("泉綠"),字("星藍"),字("暮紫"),字("晨金"),字("珊瑚"),字("苔綠")][索]; };
變數 狀態名=函式(索) { 回傳 [字("全部卡片"),字("尚未完成"),字("已完成"),字("今日與逾期"),字("我關注的"),字("七天內到期"),字("高優先")][索]; };
變數 優先名=函式(索) { 回傳 [字("低"),字("一般"),字("高")][索]; };
變數 重複名=函式(索) { 回傳 [字("不重複"),字("每天"),字("每週"),字("每月")][索]; };

變數 取板=函式() { 回傳 引擎.找看板(目前板); };
變數 取區=函式() { 回傳 引擎.找工作區(目前區); };
變數 取卡=函式() { 變數 板=取板(); 如果 (板==空值) { 回傳 空值; } 變數 找=引擎.找卡片(板,詳情卡); 如果 (找==空值) { 回傳 空值; } 回傳 找[1]; };
變數 字數=函式(數) { 回傳 字串.轉文字(數); };
變數 最小=函式(甲,乙) { 如果 (甲<乙) { 回傳 甲; } 回傳 乙; };
變數 最大=函式(甲,乙) { 如果 (甲>乙) { 回傳 甲; } 回傳 乙; };
變數 限=函式(值,下,上) { 如果 (值<下) { 回傳 下; } 如果 (值>上) { 回傳 上; } 回傳 值; };
變數 命中=函式(橫,縱,左,上,寬,高) { 回傳 橫>=左 && 橫<左+寬 && 縱>=上 && 縱<上+高; };
變數 片段=函式(文字,起,終) { 如果 (起<0) { 起=0; } 如果 (終>長度(文字)) { 終=長度(文字); } 如果 (終<=起) { 回傳 ""; } 回傳 字串.切片(文字,起,終); };
變數 整潔=函式(文字) { 回傳 字串.修剪(文字); };
變數 餘數=函式(數,除數) { 回傳 畫.向下取整(數-畫.向下取整(數/(除數*1.0d))*除數); };
變數 標籤文字=函式(標籤們) { 回傳 字串.合併(標籤們," · "); };
變數 已選=函式(編號) { 回傳 陣列.包含(多選,編號); };
變數 選卡=函式(編號) { 變數 位=陣列.尋找(多選,編號); 如果 (位>=0) { 多選=引擎.去除(多選,位); } 否則 { 多選=加入(多選,編號); } };
變數 大小文字=函式(位元) { 如果 (位元<1024) { 回傳 字數(位元)+" B"; } 回傳 字數((位元*10/1024)/10.0d)+" KB"; };

# ── 文字 ──────────────────────────────────────────────────
變數 顯示=函式(文字,橫,縱,大小,顏色) { 畫.填色(顏色); 介面.繪文字(文字,橫,縱,大小,比例,0); };
變數 量=函式(文字,大小) { 介面.文字大小(大小,比例); 回傳 介面.文字寬度(文字,比例); };
變數 置中顯示=函式(文字,中橫,縱,大小,顏色) { 畫.填色(顏色); 介面.繪文字(文字,中橫,縱,大小,比例,2); };
變數 右顯示=函式(文字,右,縱,大小,顏色) { 顯示(文字,右-量(文字,大小),縱,大小,顏色); };
# 依寬度截斷並加上刪節號；以二分搜尋減少量測次數。
變數 截斷=函式(文字,寬,大小) {
    如果 (量(文字,大小)<=寬) { 回傳 文字; }
    變數 低=0; 變數 高=長度(文字);
    迴圈 (變數 次=0; 次<20; 次++) { 如果 (低>=高) { 中斷; } 變數 中=(低+高+1)/2; 如果 (介面.文字寬度(片段(文字,0,中)+"…",比例)<=寬) { 低=中; } 否則 { 高=中-1; } }
    回傳 片段(文字,0,低)+"…";
};
變數 短文=函式(文字,橫,縱,寬,大小,顏色) { 如果 (寬<=4) { 回傳 空值; } 顯示(截斷(文字,寬,大小),橫,縱,大小,顏色); };
變數 是寬字=函式(碼) { 回傳 碼>=11904; };

# 分行：保留每行在原文中的 UTF-16 起訖，英文依單字換行，中日韓文字可任意斷行。
變數 分行索引=函式(文字,寬,大小) {
    介面.文字大小(大小,比例); 變數 密度=介面.像素密度();
    變數 存=分行快取[文字]; 如果 (存!=空值) { 如果 (存[1]==寬 && 存[2]==大小 && 存[4]==比例 && 存[5]==密度) { 回傳 存[3]; } }
    變數 結果=[]; 變數 行起=0; 變數 總=長度(文字);
    迴圈 (變數 索=0; 索<總; 索++) {
        變數 字=文字[索];
        如果 (字串.字元碼(文字,索)==10) { 變數 終=索; 如果 (終>行起) { 如果 (字串.字元碼(文字,終-1)==13) { 終-=1; } } 結果=加入(結果,[行起,終]); 行起=索+1; }
        否則如果 (索>行起) {
            如果 (介面.文字寬度(片段(文字,行起,索+1),比例)>寬) {
                如果 (字==" ") { 結果=加入(結果,[行起,索]); 行起=索+1; }
                否則 {
                    變數 斷=-1; 如果 (!是寬字(字串.字元碼(文字,索))) { 迴圈 (變數 回=索-1; 回>行起; 回-=1) { 變數 前=文字[回]; 如果 (前==" ") { 斷=回; 中斷; } 如果 (是寬字(字串.字元碼(文字,回))) { 斷=回+1; 中斷; } } }
                    如果 (斷>行起 && 斷<索) { 如果 (文字[斷]==" ") { 結果=加入(結果,[行起,斷]); 行起=斷+1; } 否則 { 結果=加入(結果,[行起,斷]); 行起=斷; } }
                    否則 { 結果=加入(結果,[行起,索]); 行起=索; }
                }
            }
        }
    }
    結果=加入(結果,[行起,總]);
    分行快取數++; 如果 (分行快取數>600) { 分行快取={}; 分行快取數=0; } 分行快取[文字]=[文字,寬,大小,結果,比例,密度]; 回傳 結果;
};
變數 分行=函式(文字,寬,大小) { 變數 索引們=分行索引(文字,寬,大小); 變數 行們=[]; 迴圈 (變數 索=0;索<長度(索引們);索++) { 行們=加入(行們,片段(文字,索引們[索][0],索引們[索][1])); } 回傳 行們; };
# 繪製多行文字；超過行數時最後一行加上刪節號。回傳實際行數。
變數 段落=函式(文字,橫,縱,寬,高,大小,顏色) { 回傳 段落行(文字,橫,縱,寬,大小,顏色,畫.向下取整(最大(1,(高+8)/(大小+9))),大小+9); };
變數 段落行=函式(文字,橫,縱,寬,大小,顏色,最多,行高) {
    變數 行們=分行(文字,寬,大小); 變數 數=最小(長度(行們),最多);
    迴圈 (變數 索=0;索<數;索++) { 變數 行=行們[索]; 如果 (索==數-1 && 長度(行們)>數) { 行=截斷(行+"……",寬,大小); 如果 (量(行們[索]+"…",大小)<=寬) { 行=行們[索]+"…"; } } 顯示(行,橫,縱+大小+索*行高,大小,顏色); }
    回傳 數;
};
# 不量測文字的行數估計（大量卡片版面用）。寬字以一個字級計，其他以 0.6 計。
變數 估寬=函式(文字,大小) { 變數 寬=0.0d; 迴圈 (變數 索=0;索<長度(文字);索++) { 變數 碼=字串.字元碼(文字,索); 如果 (碼==空值) { 碼=32; } 如果 (是寬字(碼)) { 寬+=大小; } 否則如果 (碼<=32) { 寬+=大小*0.32d; } 否則 { 寬+=大小*0.6d; } } 回傳 寬; };
變數 估行=函式(文字,寬,大小,最多) { 如果 (寬<=10) { 回傳 1; } 變數 行=畫.向上取整(估寬(文字,大小)/寬); 回傳 畫.向下取整(限(行,1,最多)); };

# ── 形狀 ──────────────────────────────────────────────────
變數 方框=函式(橫,縱,寬,高,底色,線) { 畫.描邊(線); 畫.描邊粗細(1); 畫.填色(底色); 畫.矩形(橫,縱,寬,高,10); 畫.停用描邊(); };
變數 圓角框=函式(橫,縱,寬,高,底色,線,圓角) { 如果 (線==空值) { 如果 (畫.透明度(底色)<=0) { 回傳 空值; } 畫.停用描邊(); } 否則 { 畫.描邊(線); 畫.描邊粗細(1); } 如果 (畫.透明度(底色)<=0) { 畫.停用填色(); } 否則 { 畫.填色(底色); } 畫.矩形(橫,縱,寬,高,圓角); 畫.停用描邊(); };
變數 實框=函式(橫,縱,寬,高,底色,圓角) { 如果 (畫.透明度(底色)<=0) { 回傳 空值; } 畫.停用描邊(); 畫.填色(底色); 畫.矩形(橫,縱,寬,高,圓角); };
變數 陰影框=函式(橫,縱,寬,高,圓角,層) {
    如果 (畫.透明度(陰影)<=0) { 回傳 空值; } 畫.停用描邊();
    迴圈 (變數 索=層; 索>=1; 索-=1) { 畫.填色(透明(陰影,畫.透明度(陰影)/(層+1))); 畫.矩形(橫-索,縱-索+層,寬+索*2,高+索*2,圓角+索); }
};
變數 繪圖示=函式(名稱,中橫,中縱,尺寸,顏色) { 圖示.繪(名稱,中橫,中縱,尺寸,顏色); };

# ── 操作區 ────────────────────────────────────────────────
變數 區鍵=函式(種類,文字,橫,縱) { 回傳 種類+"|"+文字+"|"+字數(畫.四捨五入(橫))+","+字數(畫.四捨五入(縱)); };
變數 角色=函式(種類) { 如果 (種類=="輸入") { 回傳 "textbox"; } 如果 (種類=="卡片" || 種類=="表格列") { 回傳 "listitem"; } 如果 (種類=="捲軸") { 回傳 "scrollbar"; } 如果 (種類=="開關") { 回傳 "switch"; } 回傳 "button"; };
變數 登記=函式(橫,縱,寬,高,處理,文字,種類,資料) {
    如果 (命中裁切!=空值) { 變數 右=最小(橫+寬,命中裁切[0]+命中裁切[2]); 變數 下=最小(縱+高,命中裁切[1]+命中裁切[3]); 橫=最大(橫,命中裁切[0]); 縱=最大(縱,命中裁切[1]); 寬=右-橫; 高=下-縱; 如果 (寬<=0 || 高<=0) { 回傳 空值; } }
    如果 (縱+高<0 || 縱>版高 || 橫+寬<0 || 橫>版寬) { 回傳 空值; }
    命中區=加入(命中區,[橫,縱,寬,高,處理,文字,種類,資料]);
    如果 (種類!="遮罩") { 語意節點=加入(語意節點,介面.語意值(長度(命中區),角色(種類),文字,"")); }
};
變數 滑過=函式(種類,文字,橫,縱) { 回傳 滑過鍵==區鍵(種類,文字,橫,縱); };
變數 按住=函式(種類,文字,橫,縱) { 回傳 按下鍵==區鍵(種類,文字,橫,縱); };
變數 裁切=函式(橫,縱,寬,高) { 介面.裁切(橫,縱,寬,高,比例); };
變數 設裁切=函式(區) { 命中裁切=區; 如果 (區==空值) { 畫.停用裁切(); } 否則 { 裁切(區[0],區[1],區[2],區[3]); } };
# 與目前的裁切範圍取交集（巢狀區域，例如看板中的清單）。
變數 交集裁切=函式(區) {
    如果 (命中裁切==空值) { 設裁切(區); 回傳 空值; } 變數 外=命中裁切;
    變數 左=最大(區[0],外[0]); 變數 上=最大(區[1],外[1]); 變數 右=最小(區[0]+區[2],外[0]+外[2]); 變數 下=最小(區[1]+區[3],外[1]+外[3]);
    設裁切([左,上,最大(0,右-左),最大(0,下-上)]);
};

# ── 按鈕 ──────────────────────────────────────────────────
# 樣式：「一般」、「主要」、「幽靈」、「危險」、「選中」。
變數 鈕寬=函式(文字,圖示名,大小) { 變數 寬=24.0d; 如果 (文字!="") { 寬+=量(文字,大小); } 如果 (圖示名!="") { 寬+=18; 如果 (文字!="") { 寬+=8; } } 回傳 寬; };
變數 按鈕樣=函式(文字,圖示名,橫,縱,寬,高,處理,樣式,標籤,停用) {
    如果 (寬<=0) { 寬=鈕寬(文字,圖示名,13); }
    如果 (標籤=="") { 標籤=文字; }
    變數 鍵=區鍵("按鈕",標籤,橫,縱); 變數 經過=滑過鍵==鍵 && !停用; 變數 按=按下鍵==鍵 && !停用;
    變數 底色=面板; 變數 字色=墨; 變數 線=邊線;
    如果 (樣式=="主要") { 底色=薄荷; 字色=強調字; 線=空值; 如果 (經過) { 底色=主題.混合(薄荷,墨,0.12d); } }
    否則如果 (樣式=="幽靈") { 底色=透明(面板,0); 線=空值; 如果 (經過) { 底色=卡滑過; } }
    否則如果 (樣式=="危險") { 底色=透明(珊瑚,28); 字色=珊瑚; 線=透明(珊瑚,90); 如果 (經過) { 底色=透明(珊瑚,52); } }
    否則如果 (樣式=="選中") { 底色=透明(薄荷,40); 字色=墨; 線=薄荷; }
    否則 { 如果 (經過) { 底色=卡滑過; 線=強邊線; } }
    如果 (按) { 底色=主題.混合(底色,底,0.25d); }
    如果 (停用) { 字色=淡墨; }
    圓角框(橫,縱,寬,高,底色,線,8);
    變數 內寬=鈕寬(文字,圖示名,13)-24; 變數 起=橫+12; 如果 (內寬<寬-24) { 起=橫+(寬-內寬)/2; } 如果 (文字!="" && 圖示名!="" && 內寬>寬-24) { 起=橫+10; }
    如果 (圖示名!="") { 繪圖示(圖示名,起+9,縱+高/2,16,字色); 起+=26; 如果 (文字=="") { 起-=8; } }
    如果 (文字!="") { 短文(文字,起,縱+高/2+5,橫+寬-起-8,13,字色); }
    如果 (!停用) { 登記(橫,縱,寬,高,處理,標籤,"按鈕",空值); } 回傳 寬;
};
# 舊介面相容：文字、位置、寬度、處理、是否主要。
變數 按鈕=函式(文字,橫,縱,寬,處理,強調) { 變數 樣="一般"; 如果 (強調) { 樣="主要"; } 回傳 按鈕樣(文字,"",橫,縱,寬,34,處理,樣,"",假); };
變數 圖示按鈕=函式(文字,圖示名,橫,縱,寬,處理,樣式) { 回傳 按鈕樣(文字,圖示名,橫,縱,寬,34,處理,樣式,"",假); };
# 只有圖示的方形按鈕；標籤作為提示與可及性名稱。
變數 圖示鈕=函式(圖示名,橫,縱,尺寸,處理,標籤,樣式,停用) {
    變數 鍵=區鍵("按鈕",標籤,橫,縱); 變數 經過=滑過鍵==鍵 && !停用; 變數 按=按下鍵==鍵 && !停用;
    變數 底色=透明(面板,0); 變數 線=空值; 變數 色=次墨;
    如果 (樣式=="一般") { 底色=面板; 線=邊線; 色=墨; } 如果 (樣式=="選中") { 底色=透明(薄荷,40); 色=薄荷; } 如果 (樣式=="主要") { 底色=薄荷; 色=強調字; }
    如果 (經過) { 如果 (樣式=="主要") { 底色=主題.混合(薄荷,墨,0.12d); } 否則 { 底色=卡滑過; 色=墨; } }
    如果 (按) { 底色=主題.混合(底色,底,0.25d); } 如果 (停用) { 色=淡墨; }
    圓角框(橫,縱,尺寸,尺寸,底色,線,8); 繪圖示(圖示名,橫+尺寸/2,縱+尺寸/2,最小(18,尺寸-12),色);
    如果 (!停用) { 登記(橫,縱,尺寸,尺寸,處理,標籤,"按鈕","提示"); }
};
變數 開關=函式(值,橫,縱,處理,標籤) {
    變數 鍵=區鍵("開關",標籤,橫,縱); 變數 底色=邊線; 如果 (值) { 底色=薄荷; } 如果 (滑過鍵==鍵) { 底色=主題.混合(底色,墨,0.12d); }
    實框(橫,縱,38,22,底色,11); 變數 位=動值("開關"+標籤,0.0d,120); 如果 (值) { 位=動值("開關"+標籤,1.0d,120); }
    實框(橫+3+位*16,縱+3,16,16,面板,8); 如果 (值) { 實框(橫+3+位*16,縱+3,16,16,強調字,8); }
    登記(橫,縱,38,22,處理,標籤,"開關",空值); 回傳 38;
};
# 分段控制：選項為 [[文字,圖示],…]。
變數 分段=函式(選項們,目前值,橫,縱,高,處理,標籤) {
    變數 寬們=[]; 變數 總=4.0d; 迴圈 (變數 索=0;索<長度(選項們);索++) { 變數 寬=鈕寬(選項們[索][0],選項們[索][1],13)-4; 寬們=加入(寬們,寬); 總+=寬; }
    圓角框(橫,縱,總,高,面板,邊線,9); 變數 位=橫+2;
    迴圈 (變數 索=0;索<長度(選項們);索++) {
        變數 選=索; 變數 寬=寬們[索]; 變數 名=選項們[索][0]; 變數 標=標籤+"："+名; 如果 (英文()) { 標=標籤+": "+名; } 如果 (名=="") { 標=標籤+" "+字數(索+1); }
        變數 鍵=區鍵("按鈕",標,位,縱+2); 變數 色=次墨;
        如果 (索==目前值) { 實框(位,縱+2,寬,高-4,透明(薄荷,46),7); 色=墨; } 否則如果 (滑過鍵==鍵) { 實框(位,縱+2,寬,高-4,卡滑過,7); 色=墨; }
        變數 起=位+(寬-(鈕寬(名,選項們[索][1],13)-24))/2;
        如果 (選項們[索][1]!="") { 繪圖示(選項們[索][1],起+8,縱+高/2,15,色); 起+=24; }
        如果 (名!="") { 顯示(名,起,縱+高/2+5,13,色); }
        登記(位,縱+2,寬,高-4,函式(){ 處理(選); },標,"按鈕",空值); 位+=寬;
    }
    回傳 總;
};
變數 色塊鈕=函式(顏色,橫,縱,尺寸,選中,處理,標籤) {
    變數 鍵=區鍵("按鈕",標籤,橫,縱); 如果 (選中 || 滑過鍵==鍵) { 圓角框(橫-3,縱-3,尺寸+6,尺寸+6,透明(底,0),墨,尺寸/2+3); }
    實框(橫,縱,尺寸,尺寸,顏色,尺寸/2); 如果 (選中) { 繪圖示("勾",橫+尺寸/2,縱+尺寸/2,尺寸*0.7d,底); }
    登記(橫,縱,尺寸,尺寸,處理,標籤,"按鈕",空值);
};
變數 標籤色=函式(名稱) { 回傳 色票[引擎.標籤色(名稱)]; };
# 標籤晶片，回傳寬度。
變數 晶片=函式(文字,顏色,橫,縱,大小) {
    變數 寬=量(文字,大小)+16;
    如果 (主題.是亮色) { 實框(橫,縱,寬,大小+9,透明(顏色,34),6); 顯示(文字,橫+8,縱+大小+3,大小,主題.混合(顏色,墨,0.35d)); }
    否則 { 實框(橫,縱,寬,大小+9,透明(顏色,40),6); 顯示(文字,橫+8,縱+大小+3,大小,顏色); }
    回傳 寬;
};
# 可移除的標籤晶片：右側的 × 是獨立按鈕。
變數 移除晶片=函式(文字,顏色,橫,縱,大小,處理,標籤) {
    變數 寬=量(文字,大小)+34; 變數 高=大小+11; 變數 鈕橫=橫+寬-21; 變數 鍵=區鍵("按鈕",標籤,鈕橫,縱);
    變數 字色=顏色; 變數 底色=透明(顏色,40); 如果 (主題.是亮色) { 字色=主題.混合(顏色,墨,0.35d); 底色=透明(顏色,34); }
    實框(橫,縱,寬,高,底色,7); 顯示(文字,橫+9,縱+大小+4,大小,字色);
    如果 (滑過鍵==鍵) { 實框(鈕橫+2,縱+3,高-6,高-6,透明(字色,46),5); }
    繪圖示("關閉",鈕橫+2+(高-6)/2,縱+高/2,11,字色);
    登記(鈕橫,縱,21,高,處理,標籤,"按鈕","提示"); 回傳 寬;
};
變數 進度條=函式(橫,縱,寬,高,比,顏色) { 實框(橫,縱,寬,高,邊線,高/2); 如果 (比>0) { 實框(橫,縱,最大(高,寬*限(比,0,1)),高,顏色,高/2); } };
變數 徽章=函式(文字,橫,縱,底色,字色) { 變數 寬=最大(20,量(文字,11)+12); 實框(橫,縱,寬,18,底色,9); 置中顯示(文字,橫+寬/2,縱+13,11,字色); 回傳 寬; };
變數 分隔線=函式(橫,縱,寬) { 畫.描邊(邊線); 畫.描邊粗細(1); 畫.線段(橫,縱,橫+寬,縱); 畫.停用描邊(); };
變數 小標=函式(文字,橫,縱) { 如果 (英文()) { 顯示(字串.轉大寫(文字),橫,縱,11,淡墨); } 否則 { 顯示(文字,橫,縱,11,淡墨); } };

# ── 動畫 ──────────────────────────────────────────────────
變數 插值=函式(項,現) { 如果 (項[3]<=0) { 回傳 項[1]; } 變數 進=(現-項[2])/項[3]; 如果 (進>=1) { 回傳 項[1]; } 如果 (進<0) { 進=0.0d; } 變數 反=1.0d-進; 回傳 項[0]+(項[1]-項[0])*(1.0d-反*反*反); };
# 回傳逐漸接近目標的值；目標改變時從目前值重新開始。
變數 動值=函式(鍵,目標,時長) {
    變數 現=目前時間(); 變數 項=動畫[鍵];
    如果 (項==空值 || 減少動態 || !首繪完成) { 動畫[鍵]=[目標*1.0d,目標*1.0d,現,0]; 回傳 目標; }
    如果 (項[1]!=目標) { 項=[插值(項,現),目標*1.0d,現,時長]; 動畫[鍵]=項; }
    變數 值=插值(項,現); 如果 (值!=目標) { 需要動畫=真; } 回傳 值;
};
# 經過時間的進度 0..1（對話與提示淡入）。
變數 時間進度=函式(起,時長) { 如果 (減少動態 || 起<=0) { 回傳 1.0d; } 變數 進=(目前時間()-起)/時長; 如果 (進>=1) { 回傳 1.0d; } 需要動畫=真; 如果 (進<0) { 回傳 0.0d; } 變數 反=1.0d-進; 回傳 1.0d-反*反*反; };

# ── 提示 ──────────────────────────────────────────────────
# 種類：資訊、成功、警告、錯誤。可附帶一個動作（例如復原）。
變數 提示=函式(文字,種類,動作文字,動作) {
    訊息=文字; 變數 時長=4200.0d; 如果 (種類=="錯誤") { 時長=8000.0d; } 如果 (動作!=空值) { 時長=6500.0d; }
    變數 現=目前時間(); 提示們=加入(提示們,{"文字":文字,"種類":種類,"動作文字":動作文字,"動作":動作,"起":現,"到期":現+時長});
    如果 (長度(提示們)>3) { 提示們=其餘(提示們); } 介面.延遲重繪(時長+30); 畫.重繪();
};
變數 簡提示=函式(文字) { 提示(文字,"資訊","",空值); };
變數 移除提示=函式(項) { 變數 新=[]; 迴圈 (變數 索=0;索<長度(提示們);索++) { 如果 (提示們[索]["起"]!=項["起"]) { 新=加入(新,提示們[索]); } } 提示們=新; 畫.重繪(); };
變數 繪提示=函式() {
    變數 現=目前時間(); 變數 留=[]; 迴圈 (變數 索=0;索<長度(提示們);索++) { 如果 (提示們[索]["到期"]>現) { 留=加入(留,提示們[索]); } } 提示們=留;
    變數 底緣=版高-狀態列高-16; 如果 (手機版) { 底緣=版高-76; }
    迴圈 (變數 索=長度(提示們)-1; 索>=0; 索-=1) {
        變數 項=提示們[索]; 變數 入=時間進度(項["起"],200); 變數 出=1.0d; 變數 餘=項["到期"]-現; 如果 (餘<240 && !減少動態) { 出=限(餘/240.0d,0,1); 需要動畫=真; }
        變數 寬=最小(版寬-32,最大(320,量(項["文字"],13)+96)); 如果 (項["動作"]!=空值) { 寬+=鈕寬(項["動作文字"],"",13)+8; } 寬=最小(寬,版寬-32);
        變數 高=48.0d; 變數 左=(版寬-寬)/2; 變數 上=底緣-高+(1.0d-入)*18;
        變數 色=薄荷; 變數 圖="資訊"; 如果 (項["種類"]=="錯誤") { 色=珊瑚; 圖="警告"; } 如果 (項["種類"]=="警告") { 色=琥珀; 圖="警告"; } 如果 (項["種類"]=="成功") { 色=成功; 圖="勾"; }
        陰影框(左,上,寬,高,12,4); 圓角框(左,上,寬,高,主題.混合(面板,卡底,0.5d),強邊線,12); 實框(左,上+10,3,高-20,色,2);
        繪圖示(圖,左+24,上+高/2,18,色); 變數 文寬=寬-90; 如果 (項["動作"]!=空值) { 文寬-=鈕寬(項["動作文字"],"",13)+8; }
        短文(項["文字"],左+42,上+高/2+5,文寬,13,墨);
        變數 本項=項;
        如果 (項["動作"]!=空值) { 變數 鈕=鈕寬(項["動作文字"],"",13); 按鈕樣(項["動作文字"],"",左+寬-鈕-44,上+8,鈕,32,函式(){ 變數 動=本項["動作"]; 移除提示(本項); 動(); },"幽靈","",假); }
        圖示鈕("關閉",左+寬-38,上+10,28,函式(){ 移除提示(本項); },字("關閉提示"),"幽靈",假);
        如果 (出<1) { 實框(左-1,上-1,寬+2,高+2,透明(底,畫.四捨五入((1.0d-出)*255)),12); }
        底緣=上-8;
    }
};

# ── 儲存 ──────────────────────────────────────────────────
變數 清除篩選暫存=函式() { 篩選暫存={}; 表格暫存=空值; 統計暫存=空值; 有效暫存={}; };
變數 儲存完成文字=函式() { 如果 (是網頁) { 回傳 字("已儲存於此瀏覽器"); } 回傳 字("已自動儲存"); };
變數 自動存=函式() {
    待儲存期限=0.0d;
    如果 (儲存鎖定) { 存檔狀態=字("已暫停自動儲存 · 請先載入有效備份"); 回傳 空值; }
    變數 起=目前時間(); 正在儲存=真; 變數 封=介面.封包(引擎.文件);
    # 寫入採主機原子替換；保留上一份完整文件，失敗時不清除未儲存標誌。
    如果 (上次封包!=空值) { 儲存空間.寫入(儲存前綴+".backup",上次封包); }
    儲存空間.寫入(儲存前綴+".document",封);
    上次封包=封; 正在儲存=假; 重試次數=0;
    儲存耗時=目前時間()-起; 未儲存=假; 存檔狀態=儲存完成文字(); 介面.防止關閉(視窗,假);
};
# 合併短時間內的多次修改後再寫入，避免每個動作都阻塞畫面。
變數 排程儲存=函式(延遲) {
    未儲存=真; 存檔狀態=字("正在儲存…"); 介面.防止關閉(視窗,真);
    變數 期限=目前時間()+延遲; 如果 (待儲存期限<=0 || 期限>待儲存期限) { 待儲存期限=期限; } 介面.延遲重繪(延遲+15);
};
變數 改動=函式() { 清除篩選暫存(); 排程儲存(450.0d); 畫.重繪(); };
變數 延後儲存=函式() { 清除篩選暫存(); 未儲存=真; 排程儲存(900.0d); 存檔狀態=字("輸入中 · 即將自動儲存"); 畫.重繪(); };
變數 儲存未完成=函式() { 如果 (待儲存期限>0) { 自動存(); } };
# 執行會改動文件的動作；動作回傳「假」表示沒有變更，不會留下復原步驟。
變數 執行改動=函式(說明,動作) {
    變數 快=引擎.快照(); 變數 結果=動作();
    如果 (結果==假) { 回傳 假; }
    引擎.推入復原(快,說明); 改動(); 回傳 真;
};
變數 記錄錯誤=函式(文字) { 錯誤紀錄=加入(錯誤紀錄,文字); 如果 (長度(錯誤紀錄)>40) { 錯誤紀錄=其餘(錯誤紀錄); } 儲存空間.寫入(儲存前綴+".errors",介面.封包(錯誤紀錄)); };

# ── 對話堆疊 ──────────────────────────────────────────────
變數 開對話=函式(種類,內容) {
    如果 (對話!="") { 對話堆疊=加入(對話堆疊,{"種類":對話,"資料":對話資料,"捲動":詳情捲動}); }
    對話=種類; 對話資料=內容; 詳情捲動=捲動.建立(); 對話開啟=目前時間(); 畫.重繪();
};
變數 關對話=函式() {
    結束編輯();
    如果 (長度(對話堆疊)>0) { 變數 上=最後一個(對話堆疊); 對話堆疊=引擎.去除(對話堆疊,長度(對話堆疊)-1); 對話=上["種類"]; 對話資料=上["資料"]; 詳情捲動=上["捲動"]; 對話開啟=0.0d; }
    否則 { 對話=""; 對話資料=空值; }
    畫.重繪();
};
變數 關全部對話=函式() { 結束編輯(); 對話堆疊=[]; 對話=""; 對話資料=空值; 畫.重繪(); };
變數 有對話=函式(種類) { 如果 (對話==種類) { 回傳 真; } 迴圈 (變數 索=0;索<長度(對話堆疊);索++) { 如果 (對話堆疊[索]["種類"]==種類) { 回傳 真; } } 回傳 假; };
# 選單項目
變數 項=函式(文字,圖示名,動作) { 回傳 {"文字":文字,"圖示":圖示名,"動作":動作}; };
變數 勾項=函式(文字,勾選,動作) { 回傳 {"文字":文字,"圖示":"","動作":動作,"勾選":勾選}; };
變數 色項=函式(文字,顏色,勾選,動作) { 回傳 {"文字":文字,"圖示":"","動作":動作,"勾選":勾選,"色":顏色}; };
變數 險項=函式(文字,圖示名,動作) { 回傳 {"文字":文字,"圖示":圖示名,"動作":動作,"危險":真}; };
變數 分隔=函式() { 回傳 {"分隔":真}; };
變數 說明項=函式(文字,圖示名,說明,動作) { 回傳 {"文字":文字,"圖示":圖示名,"動作":動作,"說明":說明}; };
變數 表單=函式(標題,欄名,預設,提交) { 開對話("表單",{"標題":標題,"欄名":欄名,"值":預設,"提交":提交,"多行":假}); 聚焦("表單",預設,函式(值){ 對話資料["值"]=值; },假,""); };
變數 多行表單=函式(標題,欄名,預設,提交) { 開對話("表單",{"標題":標題,"欄名":欄名,"值":預設,"提交":提交,"多行":真}); 聚焦("表單",預設,函式(值){ 對話資料["值"]=值; },真,""); };
變數 確認=函式(標題,說明,提交) { 開對話("確認",{"標題":標題,"說明":說明,"提交":提交,"危險":假}); };
變數 危險確認=函式(標題,說明,按鈕字,提交) { 開對話("確認",{"標題":標題,"說明":說明,"提交":提交,"危險":真,"按鈕":按鈕字}); };
變數 菜單=函式(標題,項目) { 開對話("選單",{"標題":標題,"項目":正規項目(項目),"錨":空值,"焦點":-1}); };
# 依按鈕位置展開的選單。
變數 彈出=函式(錨,項目,寬) { 開對話("選單",{"標題":"","項目":正規項目(項目),"錨":錨,"寬":寬,"焦點":-1}); };
變數 右鍵選單=函式(項目) { 開對話("選單",{"標題":"","項目":正規項目(項目),"錨":[鼠橫,鼠縱,0,0],"寬":240,"焦點":-1,"右鍵":真}); };
# 舊格式 [文字,動作] 轉為項目。
變數 正規項目=函式(項目) { 變數 新=[]; 迴圈 (變數 索=0;索<長度(項目);索++) { 變數 甲=項目[索]; 如果 (型別(甲)=="array") { 新=加入(新,項(甲[0],"",甲[1])); } 否則 { 新=加入(新,甲); } } 回傳 新; };

# ── 文字欄位 ──────────────────────────────────────────────
# 字位表：第 g 個字位（grapheme）在 UTF-16 的起點；最後一項為文字長度。
變數 字位快取=["",[0]];
變數 是附加碼=函式(碼) { 回傳 (碼>=768 && 碼<=879) || 碼==65039 || 碼==65038 || 碼==8419 || (碼>=127995 && 碼<=127999) || (碼>=917504 && 碼<=917631); };
變數 字位表=函式(文) {
    如果 (字位快取[0]==文) { 回傳 字位快取[1]; }
    變數 表=陣列.建立(1,0,長度(文)+1); 變數 索=0; 變數 總=長度(文);
    迴圈 (變數 次=0; 次<總+1; 次++) {
        如果 (索>=總) { 中斷; }
        變數 碼=字串.字元碼(文,索); 如果 (碼==空值) { 碼=0; } 變數 下=索+1; 如果 (碼>65535) { 下=索+2; }
        迴圈 (變數 吸=0; 吸<16; 吸++) {
            如果 (下>=總) { 中斷; } 變數 後=字串.字元碼(文,下); 如果 (後==空值) { 中斷; }
            如果 (後==8205) { 下+=1; 如果 (下<總) { 變數 接=字串.字元碼(文,下); 如果 (接!=空值) { 如果 (接>65535) { 下+=2; } 否則 { 下+=1; } } } }
            否則如果 (是附加碼(後)) { 如果 (後>65535) { 下+=2; } 否則 { 下+=1; } }
            否則 { 中斷; }
        }
        如果 (下>總) { 下=總; } 陣列.追加(表,下); 索=下;
    }
    字位快取=[文,表]; 回傳 表;
};
變數 字位轉碼位=函式(文,字位) { 變數 表=字位表(文); 如果 (字位<0) { 回傳 0; } 如果 (字位>=長度(表)) { 回傳 長度(文); } 回傳 表[字位]; };
變數 碼位轉字位=函式(文,碼位) {
    變數 表=字位表(文); 變數 低=0; 變數 高=長度(表)-1;
    迴圈 (變數 次=0; 次<40; 次++) { 如果 (低>=高) { 中斷; } 變數 中=(低+高+1)/2; 如果 (表[中]<=碼位) { 低=中; } 否則 { 高=中-1; } }
    回傳 低;
};
變數 編輯長度=函式() { 如果 (編輯器==空值) { 回傳 0; } 回傳 介面.編輯長度(編輯器); };
變數 安全選取=函式(錨,游) { 如果 (編輯器==空值) { 回傳 空值; } 變數 長=編輯長度(); 編輯器.選取(畫.向下取整(限(錨,0,長)),畫.向下取整(限(游,0,長))); 游標起=目前時間(); };
變數 選取範圍=函式() { 如果 (編輯器==空值) { 回傳 [0,0]; } 變數 選=介面.編輯選取(編輯器); 回傳 [選["anchor"],選["caret"]]; };
變數 有選取=函式() { 變數 選=選取範圍(); 回傳 選[0]!=選[1]; };

變數 編輯取消=空值;
變數 結束編輯=函式() { 如果 (編輯器!=空值) { 編輯器.取消組字(); 介面.結束文字輸入(); } 編輯器=空值; 編輯識別=""; 編輯回呼=空值; 編輯提交=空值; 編輯取消=空值; 選字拖曳=""; };
變數 編輯原文="";
變數 聚焦=函式(識別,文字,回呼,多行,說明) {
    如果 (編輯識別==識別) { 畫.開始文字輸入(); 回傳 空值; } 結束編輯();
    編輯器=編輯庫.建立(文字); 編輯器.選取(介面.編輯長度(編輯器),介面.編輯長度(編輯器)); 編輯識別=識別; 編輯回呼=回呼; 多行編輯=多行; 編輯說明=說明; 編輯原文=文字;
    編輯已記錄=假; 編輯已改=假; 編輯快照=""; 如果 (說明!="") { 編輯快照=引擎.快照(); }
    游標起=目前時間(); 畫.開始文字輸入();
};
變數 提交編輯=函式() {
    如果 (編輯器!=空值 && 編輯回呼!=空值) {
        變數 新=介面.編輯內容(編輯器);
        如果 (編輯說明!="" && !編輯已記錄 && 新!=編輯原文) { 引擎.推入復原(編輯快照,編輯說明); 編輯已記錄=真; }
        如果 (新!=編輯原文) { 編輯已改=真; }
        變數 回呼=編輯回呼; 回呼(新);
    }
    游標起=目前時間(); 畫.重繪();
};
# 文字欄位。選項：占位、多行、說明（復原名稱）、圖示、大小、無框、提交（換行鍵）、取消（離開鍵）、最小行、最多行。
# 回傳實際高度（多行可隨內容長高）。
變數 輸入欄=函式(識別,內容,橫,縱,寬,高,回呼,選) {
    變數 多行=選["多行"]==真; 變數 大小=選["大小"]; 如果 (大小==空值) { 大小=14; } 變數 說明=選["說明"]; 如果 (說明==空值) { 說明=""; }
    變數 焦點=編輯識別==識別; 變數 文=內容; 如果 (焦點) { 文=介面.編輯內容(編輯器); }
    變數 無框=選["無框"]==真; 變數 圖示名=選["圖示"]; 如果 (圖示名==空值) { 圖示名=""; }
    變數 內左=橫+12; 如果 (圖示名!="") { 內左=橫+36; } 變數 內寬=橫+寬-12-內左; 如果 (選["清除"]==真 && 文!="") { 內寬-=26; }
    變數 行高=大小+8; 變數 行們=[[0,長度(文)]]; 如果 (多行) { 行們=分行索引(文,內寬,大小); }
    如果 (多行 && 選["最多行"]!=空值) { 變數 需=長度(行們); 如果 (選["最小行"]!=空值) { 需=最大(需,選["最小行"]); } 需=最小(需,選["最多行"]); 高=需*行高+18; }
    變數 標=選["標籤"]; 如果 (標==空值) { 標=識別; } 變數 鍵=區鍵("輸入",標,橫,縱); 變數 經過=滑過鍵==鍵;
    變數 欄底=底; 如果 (主題.是亮色) { 欄底=面板; }
    如果 (!無框) { 變數 線=邊線; 如果 (經過) { 線=強邊線; } 如果 (焦點) { 線=薄荷; } 圓角框(橫,縱,寬,高,欄底,線,8); 如果 (焦點) { 畫.停用填色(); 畫.描邊(透明(薄荷,70)); 畫.描邊粗細(3); 畫.矩形(橫-1.5d,縱-1.5d,寬+3,高+3,9.5d); 畫.停用描邊(); } }
    否則 { 如果 (焦點) { 圓角框(橫,縱,寬,高,欄底,薄荷,8); } 否則如果 (經過) { 圓角框(橫,縱,寬,高,透明(卡滑過,255),空值,8); } }
    如果 (圖示名!="") { 變數 圖色=淡墨; 如果 (焦點) { 圖色=薄荷; } 繪圖示(圖示名,橫+20,縱+最小(高,40)/2,16,圖色); }
    變數 原裁切=命中裁切; 裁切(內左-2,縱+2,內寬+4,高-4);
    變數 版={"橫":橫,"縱":縱,"寬":寬,"高":高,"多行":多行,"偏":0.0d,"起行":0,"左":內左,"內寬":內寬,"大小":大小,"行高":行高,"行們":行們,"文":文};
    變數 舊=欄位版面[識別]; 如果 (舊!=空值 && 焦點) { 版["偏"]=舊["偏"]; 版["起行"]=舊["起行"]; }
    變數 範=[0,0]; 變數 游碼=0; 如果 (焦點) { 範=選取範圍(); 游碼=字位轉碼位(文,範[1]); }
    變數 選起=字位轉碼位(文,最小(範[0],範[1])); 變數 選終=字位轉碼位(文,最大(範[0],範[1]));
    介面.文字大小(大小,比例);
    如果 (!多行) {
        變數 基線=縱+高/2+大小*0.36d; 變數 游橫=0.0d;
        如果 (焦點) { 游橫=介面.文字寬度(片段(文,0,游碼),比例); 如果 (游橫-版["偏"]>內寬-3) { 版["偏"]=游橫-內寬+3; } 如果 (游橫-版["偏"]<0) { 版["偏"]=游橫; } }
        如果 (焦點 && 選起!=選終) { 變數 甲=介面.文字寬度(片段(文,0,選起),比例)-版["偏"]; 變數 乙=介面.文字寬度(片段(文,0,選終),比例)-版["偏"]; 實框(內左+甲,基線-大小-1,乙-甲,大小+7,透明(選取色,170),2); }
        如果 (文=="") { 如果 (選["占位"]!=空值) { 顯示(選["占位"],內左,基線,大小,淡墨); } }
        否則 { 顯示(文,內左-版["偏"],基線,大小,墨); }
        如果 (焦點) {
            變數 組=介面.組字(); 變數 游=內左+游橫-版["偏"];
            如果 (組!="") { 變數 組寬=量(組,大小); 實框(游,基線-大小-1,組寬,大小+7,面板,2); 顯示(組,游,基線,大小,薄荷); 實框(游,基線+3,組寬,1.5d,薄荷,0); }
            否則如果 (選起==選終) { 變數 經=目前時間()-游標起; 如果 (減少動態 || 畫.向下取整(經/530)%2==0) { 實框(游,基線-大小,1.6d,大小+5,薄荷,0); } 介面.延遲重繪(530-經%530+8); }
            畫.文字輸入矩形(畫.四捨五入(游*比例),畫.四捨五入((基線-大小)*比例),1,畫.四捨五入((大小+8)*比例));
        }
    } 否則 {
        變數 可視=畫.向下取整(最大(1,(高-12)/行高)); 變數 游行=0;
        迴圈 (變數 索=0;索<長度(行們);索++) { 如果 (行們[索][0]<=游碼) { 游行=索; } }
        如果 (焦點) { 如果 (游行<版["起行"]) { 版["起行"]=游行; } 如果 (游行>=版["起行"]+可視) { 版["起行"]=游行-可視+1; } }
        如果 (版["起行"]>長度(行們)-1) { 版["起行"]=最大(0,長度(行們)-1); }
        如果 (文=="" && 選["占位"]!=空值) { 顯示(選["占位"],內左,縱+8+大小,大小,淡墨); }
        迴圈 (變數 索=版["起行"];索<長度(行們);索++) {
            如果 (索>=版["起行"]+可視) { 中斷; } 變數 行=行們[索]; 變數 基線=縱+8+大小+(索-版["起行"])*行高;
            如果 (焦點 && 選起!=選終) { 變數 段起=最大(行[0],選起); 變數 段終=最小(行[1],選終);
                如果 (段起<段終 || (選起<=行[1] && 選終>行[1])) { 變數 甲=介面.文字寬度(片段(文,行[0],段起),比例); 變數 乙=介面.文字寬度(片段(文,行[0],段終),比例); 如果 (選終>行[1]) { 乙+=6; } 實框(內左+甲,基線-大小-1,乙-甲,大小+7,透明(選取色,170),2); 介面.文字大小(大小,比例); } }
            顯示(片段(文,行[0],行[1]),內左,基線,大小,墨);
        }
        如果 (焦點) {
            變數 行=行們[游行]; 變數 游=內左+量(片段(文,行[0],游碼),大小); 變數 基線=縱+8+大小+(游行-版["起行"])*行高; 變數 組=介面.組字();
            如果 (組!="") { 變數 組寬=量(組,大小); 實框(游,基線-大小-1,組寬,大小+7,面板,2); 顯示(組,游,基線,大小,薄荷); 實框(游,基線+3,組寬,1.5d,薄荷,0); }
            否則如果 (選起==選終) { 變數 經=目前時間()-游標起; 如果 (減少動態 || 畫.向下取整(經/530)%2==0) { 實框(游,基線-大小,1.6d,大小+5,薄荷,0); } 介面.延遲重繪(530-經%530+8); }
            畫.文字輸入矩形(畫.四捨五入(游*比例),畫.四捨五入((基線-大小)*比例),1,畫.四捨五入(行高*比例));
        }
        如果 (長度(行們)>可視) { 變數 軌=高-12; 變數 塊長=最大(18,軌*可視/長度(行們)); 變數 塊起=(軌-塊長)*版["起行"]/最大(1,長度(行們)-可視); 實框(橫+寬-6,縱+6+塊起,3,塊長,強邊線,2); }
    }
    設裁切(原裁切);
    欄位版面[識別]=版;
    變數 本選=選;
    登記(橫,縱,寬,高,函式(){ 聚焦(識別,內容,回呼,多行,說明); 編輯提交=本選["提交"]; 編輯取消=本選["取消"]; },標,"輸入",識別);
    如果 (選["清除"]==真 && 文!="") { 圖示鈕("關閉",橫+寬-30,縱+(高-24)/2,24,函式(){ 結束編輯(); 回呼(""); 畫.重繪(); },字("清除"),"幽靈",假); }
    如果 (焦點) { 編輯提交=選["提交"]; 編輯取消=選["取消"]; }
    回傳 高;
};
# 舊介面相容：上方標籤、方框、回呼、多行、是否記錄復原。
變數 輸入框=函式(識別,名稱,內容,橫,縱,寬,高,回呼,多行,記錄) {
    顯示(名稱,橫,縱-8,12,次墨); 變數 說明=""; 如果 (記錄) { 說明=格式("編輯「{0}」",[名稱]); }
    輸入欄(識別,內容,橫,縱,寬,高,回呼,{"多行":多行,"說明":說明,"標籤":名稱});
};
# 由指標位置找出字位。
變數 點中字位=函式(識別,橫,縱) {
    變數 版=欄位版面[識別]; 如果 (版==空值) { 回傳 0; } 變數 文=版["文"]; 介面.文字大小(版["大小"],比例);
    變數 起=0; 變數 終=長度(文); 變數 相對=橫-版["左"]+版["偏"];
    如果 (版["多行"]) { 變數 行們=版["行們"]; 變數 行=畫.向下取整((縱-版["縱"]-6)/版["行高"])+版["起行"]; 行=畫.向下取整(限(行,0,長度(行們)-1)); 起=行們[行][0]; 終=行們[行][1]; 相對=橫-版["左"]; }
    變數 甲=碼位轉字位(文,起); 變數 乙=碼位轉字位(文,終); 變數 最佳=甲; 變數 差=100000.0d;
    # 以二分搜尋找出左側寬度最接近的字位。
    變數 低=甲; 變數 高=乙;
    迴圈 (變數 次=0; 次<30; 次++) { 如果 (低>=高) { 中斷; } 變數 中=(低+高)/2; 變數 寬=介面.文字寬度(片段(文,起,字位轉碼位(文,中+1)),比例); 如果 (寬<相對) { 低=中+1; } 否則 { 高=中; } }
    迴圈 (變數 候=低-1; 候<=低+1; 候++) { 如果 (候>=甲 && 候<=乙) { 變數 寬=介面.文字寬度(片段(文,起,字位轉碼位(文,候)),比例); 變數 距=畫.絕對值(寬-相對); 如果 (距<差) { 差=距; 最佳=候; } } }
    回傳 最佳;
};
變數 是字詞字=函式(碼) { 如果 (碼==空值) { 回傳 假; } 回傳 (碼>=48 && 碼<=57) || (碼>=65 && 碼<=90) || (碼>=97 && 碼<=122) || 碼==95 || (碼>=192 && 碼!=12288 && (碼<12289 || 碼>12351) && (碼<65280 || 碼>65295)); };
# 雙擊選取字詞：英數連續字，或連續的中日韓文字。
變數 選取字詞=函式(字位) {
    變數 文=介面.編輯內容(編輯器); 變數 碼=字位轉碼位(文,字位); 如果 (碼>=長度(文) && 碼>0) { 碼-=1; }
    如果 (長度(文)==0) { 回傳 空值; } 變數 本=字串.字元碼(文,碼); 變數 寬類=是寬字(本); 變數 字類=是字詞字(本);
    變數 起=碼; 變數 終=碼+1;
    迴圈 (變數 次=0; 次<4000; 次++) { 如果 (起<=0) { 中斷; } 變數 前=字串.字元碼(文,起-1); 如果 (是寬字(前)!=寬類 || 是字詞字(前)!=字類 || 前==10) { 中斷; } 起-=1; }
    迴圈 (變數 次=0; 次<4000; 次++) { 如果 (終>=長度(文)) { 中斷; } 變數 後=字串.字元碼(文,終); 如果 (是寬字(後)!=寬類 || 是字詞字(後)!=字類 || 後==10) { 中斷; } 終+=1; }
    安全選取(碼位轉字位(文,起),碼位轉字位(文,終));
};
變數 選取整行=函式(字位) {
    變數 文=介面.編輯內容(編輯器); 如果 (!多行編輯) { 安全選取(0,編輯長度()); 回傳 空值; }
    變數 碼=字位轉碼位(文,字位); 變數 起=碼; 變數 終=碼;
    迴圈 (變數 次=0; 次<70000; 次++) { 如果 (起<=0) { 中斷; } 如果 (字串.字元碼(文,起-1)==10) { 中斷; } 起-=1; }
    迴圈 (變數 次=0; 次<70000; 次++) { 如果 (終>=長度(文)) { 中斷; } 如果 (字串.字元碼(文,終)==10) { 終+=1; 中斷; } 終+=1; }
    安全選取(碼位轉字位(文,起),碼位轉字位(文,終));
};
# 上下鍵在多行欄位中移動到相鄰行的相同水平位置。
變數 垂直移動=函式(方向,延伸) {
    變數 版=欄位版面[編輯識別]; 如果 (版==空值) { 回傳 空值; } 變數 文=介面.編輯內容(編輯器); 變數 選=選取範圍(); 變數 錨=選[0];
    如果 (!版["多行"]) { 變數 目標=0; 如果 (方向>0) { 目標=編輯長度(); } 如果 (延伸) { 安全選取(錨,目標); } 否則 { 安全選取(目標,目標); } 回傳 空值; }
    變數 行們=版["行們"]; 變數 游碼=字位轉碼位(文,選[1]); 變數 行=0; 迴圈 (變數 索=0;索<長度(行們);索++) { 如果 (行們[索][0]<=游碼) { 行=索; } }
    變數 目標行=行+方向; 變數 目標=0;
    如果 (目標行<0) { 目標=0; } 否則如果 (目標行>=長度(行們)) { 目標=編輯長度(); }
    否則 { 介面.文字大小(版["大小"],比例); 變數 寬=介面.文字寬度(片段(文,行們[行][0],游碼),比例); 變數 起行=版["起行"]; 目標=點中字位(編輯識別,版["左"]+寬,版["縱"]+8+(目標行-起行)*版["行高"]+版["行高"]/2); }
    如果 (延伸) { 安全選取(錨,目標); } 否則 { 安全選取(目標,目標); }
};
# 文字欄位的右鍵選單；保留編輯狀態。
變數 文字選單=函式() {
    變數 有選=有選取(); 變數 項目=[];
    項目=加入(項目,{"文字":字("剪下"),"圖示":"剪下","快捷":"Ctrl+X","停用":!有選,"動作":函式(){ 編輯器.剪下(); 提交編輯(); }});
    項目=加入(項目,{"文字":字("複製"),"圖示":"複製","快捷":"Ctrl+C","停用":!有選,"動作":函式(){ 編輯器.複製(); }});
    項目=加入(項目,{"文字":字("貼上"),"圖示":"貼上","快捷":"Ctrl+V","動作":函式(){ 編輯器.貼上(); 提交編輯(); }});
    項目=加入(項目,{"文字":字("刪除"),"圖示":"垃圾桶","停用":!有選,"動作":函式(){ 編輯器.刪除(); 提交編輯(); }});
    項目=加入(項目,分隔());
    項目=加入(項目,{"文字":字("全選"),"圖示":"選取","快捷":"Ctrl+A","動作":函式(){ 安全選取(0,編輯長度()); }});
    如果 (編輯已改) { 項目=加入(項目,{"文字":字("復原輸入"),"圖示":"復原","快捷":"Ctrl+Z","動作":函式(){ 編輯器.快速鍵("z",2); 提交編輯(); }}); }
    開對話("選單",{"標題":"","項目":項目,"錨":[鼠橫,鼠縱,0,0],"寬":230,"焦點":-1,"右鍵":真,"保留編輯":真});
};

# ── 匯入與匯出 ────────────────────────────────────────────
變數 手動儲存=函式() {
    結束編輯(); 變數 資源=介面.儲存檔(字("儲存星泉看板備份"),字("星泉看板備份"),字("星泉看板備份")+".星板"); 如果 (資源==空值) { 簡提示(字("已取消儲存。")); 回傳 空值; }
    變數 完整=附件庫.封裝(引擎.文件); 如果 (完整==空值) { 提示(字("有附件檔案遺失，請先恢復附件再儲存備份。"),"錯誤","",空值); 回傳 空值; }
    檔案.儲存位元組(資源,介面.封包(完整),!是網頁); 匯出過=真; 如果 (待儲存期限<=0) { 未儲存=假; } 存檔狀態=字("已匯出完整備份");
    如果 (是網頁 && 待儲存期限<=0) { 介面.防止關閉(視窗,假); } 提示(字("備份包含所有工作區、範本與附件。"),"成功","",空值);
};
變數 匯出過=假;
變數 讀入資源=函式(資源) {
    載入中=真; 變數 新=介面.解包(檔案.讀取位元組(資源));
    如果 (!引擎.驗證文件(新)) { 載入中=假; 提示(字("這份檔案不是支援的星泉看板備份。"),"錯誤","",空值); 回傳 空值; }
    如果 (!附件庫.載入(新)) { 載入中=假; 提示(字("附件內容無效，尚未取代目前看板。"),"錯誤","",空值); 回傳 空值; }
    引擎.推入復原(引擎.快照(),字("載入備份")); 引擎.置換(新); 清除篩選暫存(); 目前板=資料()["上次看板"]; 校正選擇(); 載入中=假; 儲存鎖定=假; 關全部對話(); 改動();
    提示(字("已載入備份。"),"成功",字("復原"),函式(){ 復原操作(); });
};
變數 手動載入=函式() {
    變數 資源=介面.開啟檔(字("載入星泉看板"),字("星泉看板備份")); 如果 (長度(資源)==0) { 回傳 空值; } 變數 檔=資源[0];
    確認(字("載入備份"),字("目前內容會由備份取代。可先儲存一份備份，載入後亦可復原。"),函式(){ 待載入=檔; 載入中=真; 載入畫面=假; 畫.重繪(); });
};
變數 匯出看板=函式(種類) {
    變數 板=取板(); 如果 (板==空值) { 回傳 空值; }
    如果 (種類=="csv") {
        變數 資源=介面.匯出檔(字("匯出看板"),"CSV","csv",板["名稱"]+".csv"); 如果 (資源==空值) { 回傳 空值; }
        變數 文=引擎.匯出CSV(板,[字("清單"),字("卡片"),字("說明"),字("標籤"),字("負責人"),字("開始日"),字("到期日"),字("已完成"),字("優先程度"),字("檢查表")],字("是"),字("否"),[字("低"),字("一般"),字("高")]);
        介面.儲存文字檔(資源,文,!是網頁); 提示(字("已匯出 CSV。"),"成功","",空值);
    } 否則 {
        變數 資源=介面.匯出檔(字("匯出看板"),"Markdown","md",板["名稱"]+".md"); 如果 (資源==空值) { 回傳 空值; }
        介面.儲存文字檔(資源,引擎.匯出Markdown(板,字("到期"),字("負責"),字("標籤")),!是網頁); 提示(字("已匯出 Markdown。"),"成功","",空值);
    }
};

# ── 選擇看板 ──────────────────────────────────────────────
變數 校正選擇=函式() {
    變數 板=取板(); 如果 (板!=空值) { 如果 (!板["封存"]) { 變數 所=引擎.找所屬區(目前板); 如果 (所!=空值) { 如果 (!所["封存"]) { 目前區=所["編號"]; 回傳 空值; } } } }
    目前板=0; 變數 原區=取區(); 如果 (原區!=空值) { 如果 (!原區["封存"]) { 迴圈 (變數 索=0; 索<長度(原區["看板"]); 索++) { 如果 (!原區["看板"][索]["封存"]) { 目前板=原區["看板"][索]["編號"]; 回傳 空值; } } 回傳 空值; } }
    目前區=0; 迴圈 (變數 區=0; 區<長度(資料()["工作區"]); 區++) { 變數 工作=資料()["工作區"][區]; 如果 (!工作["封存"]) { 目前區=工作["編號"]; 迴圈 (變數 索=0; 索<長度(工作["看板"]); 索++) { 如果 (!工作["看板"][索]["封存"]) { 目前板=工作["看板"][索]["編號"]; 回傳 空值; } } 回傳 空值; } }
};
變數 復原操作=函式() { 結束編輯(); 變數 說=引擎.下個復原(); 如果 (引擎.復原()) { 關全部對話(); 校正選擇(); 改動(); 如果 (說!="") { 簡提示(格式("已復原：{0}",[說])); } 否則 { 簡提示(字("已復原上一個動作。")); } } };
變數 重做操作=函式() { 結束編輯(); 變數 說=引擎.下個重做(); 如果 (引擎.重做()) { 關全部對話(); 校正選擇(); 改動(); 如果 (說!="") { 簡提示(格式("已重做：{0}",[說])); } 否則 { 簡提示(字("已重做。")); } } };
變數 重設篩選=函式() { 查詢=""; 標籤篩選=""; 負責篩選=""; 狀態篩選=0; 多選=[]; 焦點卡=0; 清除篩選暫存(); };
變數 開看板=函式(板) {
    結束編輯(); 清除篩選暫存(); 目前板=板["編號"]; 變數 所=引擎.找所屬區(目前板); 如果 (所!=空值) { 目前區=所["編號"]; } 資料()["上次看板"]=目前板; 頁面="看板";
    看板捲動=捲動.建立(); 列捲動={}; 重設篩選(); 詳情卡=0; 新增中列=0; 畫.重繪();
};
變數 開詳情=函式(編號) {
    結束編輯(); 詳情卡=編號;
    如果 (對話=="詳情") { 詳情捲動=捲動.建立(); 畫.重繪(); 回傳 空值; }
    開對話("詳情",{"卡":編號});
};
變數 選工作區=函式(區) {
    結束編輯(); 清除篩選暫存(); 目前區=區["編號"]; 目前板=0; 頁面="看板"; 重設篩選();
    卡片拖曳=空值; 拖曳中=假; 放置目標=空值; 滑塊拖曳=空值; 焦點鍵=""; 看板捲動=捲動.建立(); 列捲動={};
    迴圈 (變數 索=0;索<長度(區["看板"]);索++) { 如果 (!區["看板"][索]["封存"]) { 開看板(區["看板"][索]); 回傳 空值; } }
    資料()["上次看板"]=0; 畫.重繪();
};

# ── 建立 ──────────────────────────────────────────────────
變數 新工作區=函式() { 表單(字("建立工作區"),字("工作區名稱"),"",函式(名稱){ 執行改動(字("建立工作區"),函式(){ 選工作區(引擎.建立工作區(名稱)); }); }); };
變數 新看板=函式() {
    如果 (取區()==空值) { 新工作區(); 回傳 空值; }
    表單(字("建立看板"),字("看板名稱"),"",函式(名稱){ 執行改動(字("建立看板"),函式(){ 變數 板=引擎.建立看板(取區(),名稱); 引擎.建立清單(板,字("待辦")); 引擎.建立清單(板,字("進行中")); 變數 完=引擎.建立清單(板,字("已完成")); 完["完成欄"]=真; 開看板(板); }); });
};
變數 新清單=函式() { 如果 (取板()==空值) { 回傳 空值; } 表單(字("新增清單"),字("清單名稱"),"",函式(名稱){ 執行改動(字("新增清單"),函式(){ 引擎.建立清單(取板(),名稱); 看板捲動["目標橫"]=看板捲動["內容寬"]; }); }); };
# 直接在清單底部輸入新卡片，按換行鍵連續新增。
變數 開始新增=函式(列號) { 新增中列=列號; 新增文字=""; 聚焦("新增卡片"+字數(列號),"",函式(值){ 新增文字=值; },假,""); 編輯提交=提交新增; 編輯取消=取消新增; 畫.重繪(); };
變數 加卡=函式(列,名稱,開啟) {
    名稱=整潔(名稱); 如果 (名稱=="") { 回傳 空值; }
    如果 (!引擎.可移入(列)) { 提示(字("這份清單已達在製品上限，請先完成或移動卡片。"),"警告","",空值); 回傳 空值; }
    變數 新卡=空值;
    執行改動(字("新增卡片"),函式(){ 新卡=引擎.建立卡片(列,名稱); 引擎.記事(取板(),格式("新增「{0}」。",[名稱])); 如果 (列["完成欄"] && 取板()["自動完成"]) { 新卡["完成"]=真; } });
    變數 捲=取列捲動(列["編號"]); 捲["目標縱"]=捲["內容高"]+400;
    如果 (開啟) { 開詳情(新卡["編號"]); } 回傳 新卡;
};
變數 提交新增=函式() {
    變數 板=取板(); 如果 (板==空值) { 回傳 空值; } 變數 列=引擎.找清單(板,新增中列); 如果 (列==空值) { 新增中列=0; 結束編輯(); 回傳 空值; }
    變數 名=整潔(新增文字); 如果 (名=="") { 新增中列=0; 結束編輯(); 畫.重繪(); 回傳 空值; }
    加卡(列,名,假); 新增文字=""; 變數 號=新增中列; 結束編輯(); 開始新增(號); 編輯提交=提交新增; 編輯取消=取消新增;
};
變數 取消新增=函式() { 新增中列=0; 新增文字=""; 結束編輯(); 畫.重繪(); };

# ── 卡片 ──────────────────────────────────────────────────
變數 切換完成=函式(卡號) {
    變數 板=取板(); 變數 找=引擎.找卡片(板,卡號); 如果 (找==空值) { 回傳 空值; } 變數 卡=找[1]; 變數 新值=!卡["完成"]; 變數 下次=空值;
    變數 說=字("標記完成"); 如果 (!新值) { 說=字("標記未完成"); }
    執行改動(說,函式(){ 下次=引擎.設定完成(板,找[0],卡,新值); });
    如果 (下次!=空值) { 提示(格式("已建立下一次：{0}",[下次["到期日"]]),"成功","",空值); }
};
變數 封存卡片們=函式(編號們) {
    變數 板=取板(); 如果 (板==空值 || 長度(編號們)==0) { 回傳 空值; } 變數 數=0;
    執行改動(字("封存卡片"),函式(){ 迴圈 (變數 索=0;索<長度(編號們);索++) { 變數 找=引擎.找卡片(板,編號們[索]); 如果 (找!=空值) { 如果 (!找[1]["封存"]) { 找[1]["封存"]=真; 數++; 引擎.記事(板,格式("封存「{0}」。",[找[1]["名稱"]])); } } } 如果 (數==0) { 回傳 假; } });
    多選=[]; 如果 (數>0) { 提示(格式("已封存 {0} 張卡片。",[數]),"資訊",字("復原"),函式(){ 復原操作(); }); }
};
變數 複製卡片們=函式(編號們,剪下) {
    變數 板=取板(); 如果 (板==空值 || 長度(編號們)==0) { 回傳 空值; } 卡片剪貼=[]; 變數 名們=[];
    迴圈 (變數 索=0;索<長度(編號們);索++) { 變數 找=引擎.找卡片(板,編號們[索]); 如果 (找!=空值) { 卡片剪貼=加入(卡片剪貼,引擎.複本(找[1])); 名們=加入(名們,找[1]["名稱"]); } }
    剪貼文字=字串.合併(名們,字串.從字元碼(10)); 介面.寫剪貼簿(剪貼文字);
    如果 (剪下) { 封存卡片們(編號們); } 否則 { 簡提示(格式("已複製 {0} 張卡片。",[長度(卡片剪貼)])); }
};
# 貼上內部複製的卡片；沒有內部卡片時把剪貼簿文字的每一行建立為卡片。
變數 貼上卡片=函式(列,位置) {
    如果 (列==空值) { 回傳 空值; } 變數 來源=卡片剪貼; 變數 文=介面.讀剪貼簿(); 如果 (文==空值) { 文=""; }
    # 系統剪貼簿已換成其他文字時，以文字為準。
    如果 (長度(來源)>0 && 文!="" && 文!=剪貼文字) { 來源=[]; }
    如果 (長度(來源)==0) {
        如果 (文=="") { 回傳 空值; } 變數 行們=字串.分割(字串.取代(文,字串.從字元碼(13),""),字串.從字元碼(10)); 來源=[];
        迴圈 (變數 索=0;索<長度(行們);索++) { 變數 名=整潔(行們[索]); 如果 (名!="" && 長度(來源)<200) { 來源=加入(來源,{"名稱":名}); } }
        如果 (長度(來源)==0) { 回傳 空值; }
    }
    變數 數=0; 變數 板=取板();
    執行改動(字("貼上卡片"),函式(){ 迴圈 (變數 索=0;索<長度(來源);索++) { 如果 (引擎.可移入(列)) { 如果 (來源[索]["編號"]!=空值) { 引擎.貼上卡(列,來源[索],位置+數); } 否則 { 引擎.插入卡片(列,來源[索]["名稱"],位置+數); } 數++; } } 如果 (數==0) { 回傳 假; } });
    如果 (數<長度(來源)) { 提示(字("部分卡片受清單上限限制，尚未貼上。"),"警告","",空值); } 否則 { 簡提示(格式("已貼上 {0} 張卡片。",[數])); }
};
變數 貼上目標=函式() {
    變數 板=取板(); 如果 (板==空值) { 回傳 空值; }
    如果 (焦點卡!=0) { 變數 找=引擎.找卡片(板,焦點卡); 如果 (找!=空值) { 貼上卡片(找[0],找[2]+1); 回傳 空值; } }
    如果 (滑過區!=空值) { 如果 (滑過區[6]=="卡片" || 滑過區[6]=="清單空白") { 變數 列=引擎.找清單(板,滑過區[7][1]); 如果 (列!=空值) { 貼上卡片(列,長度(列["卡片"])); 回傳 空值; } } }
    變數 列們=可見清單(板); 如果 (長度(列們)>0) { 貼上卡片(列們[0],長度(列們[0]["卡片"])); }
};
變數 複製一張=函式(卡號) { 變數 板=取板(); 變數 找=引擎.找卡片(板,卡號); 如果 (找==空值) { 回傳 空值; } 變數 新=空值; 執行改動(字("複製卡片"),函式(){ 新=引擎.貼上卡(找[0],找[1],找[2]+1); 新["名稱"]=新["名稱"]+字("（複本）"); }); 回傳 新; };
變數 卡片移動=函式(卡號) {
    變數 板=取板(); 變數 項目=[]; 變數 找=引擎.找卡片(板,卡號); 如果 (找==空值) { 回傳 空值; }
    迴圈 (變數 索=0; 索<長度(板["清單"]); 索++) { 變數 列=板["清單"][索]; 如果 (!列["封存"]) { 變數 本=列["編號"]==找[0]["編號"]; 項目=加入(項目,勾項(列["名稱"],本,函式(){ 執行改動(字("移動卡片"),函式(){ 如果 (!引擎.移卡(板,卡號,列["編號"],-1)) { 提示(字("目標清單已達在製品上限。"),"警告","",空值); 回傳 假; } }); })); } }
    項目=加入(項目,分隔()); 項目=加入(項目,項(字("移至頂端"),"向上",函式(){ 執行改動(字("移動卡片"),函式(){ 回傳 引擎.移卡(板,卡號,找[0]["編號"],0); }); }));
    項目=加入(項目,項(字("移至底部"),"向下",函式(){ 執行改動(字("移動卡片"),函式(){ 回傳 引擎.移卡(板,卡號,找[0]["編號"],長度(找[0]["卡片"])); }); }));
    右鍵或彈出(字("移動至清單"),項目);
};
變數 右鍵或彈出=函式(標題,項目) { 如果 (對話=="選單") { 關對話(); } 開對話("選單",{"標題":標題,"項目":正規項目(項目),"錨":空值,"寬":320,"焦點":-1}); };
變數 設定優先=函式(編號們,值) { 變數 板=取板(); 執行改動(字("設定優先程度"),函式(){ 迴圈 (變數 索=0;索<長度(編號們);索++) { 變數 找=引擎.找卡片(板,編號們[索]); 如果 (找!=空值) { 找[1]["優先"]=值; } } }); };
變數 優先選單=函式(編號們,錨) { 變數 項目=[]; 變數 目前值=-1; 如果 (長度(編號們)==1) { 變數 找=引擎.找卡片(取板(),編號們[0]); 如果 (找!=空值) { 目前值=找[1]["優先"]; } }
    迴圈 (變數 索=2;索>=0;索-=1) { 變數 值=索; 變數 圖="旗"; 如果 (索==2) { 圖="實旗"; } 項目=加入(項目,{"文字":優先名(索),"圖示":圖,"勾選":目前值==索,"動作":函式(){ 設定優先(編號們,值); }}); }
    彈出(錨,項目,200); };
變數 卡片選單=函式(卡號) {
    變數 板=取板(); 變數 找=引擎.找卡片(板,卡號); 如果 (找==空值) { 回傳 空值; } 變數 卡=找[1]; 變數 列=找[0]; 變數 組=[卡號]; 如果 (已選(卡號) && 長度(多選)>1) { 組=多選; }
    變數 項目=[];
    如果 (長度(組)>1) { 批次操作(); 回傳 空值; }
    項目=加入(項目,{"文字":字("開啟卡片"),"圖示":"卡片","快捷":"Enter","動作":函式(){ 開詳情(卡號); }});
    變數 完字=字("標記完成"); 如果 (卡["完成"]) { 完字=字("標記未完成"); } 項目=加入(項目,{"文字":完字,"圖示":"勾","快捷":"D","動作":函式(){ 切換完成(卡號); }});
    變數 注字=字("關注"); 如果 (卡["關注"]) { 注字=字("取消關注"); } 項目=加入(項目,項(注字,"眼",函式(){ 執行改動(字("切換關注"),函式(){ 卡["關注"]=!卡["關注"]; }); }));
    項目=加入(項目,項(字("優先程度")+"…","旗",函式(){ 優先選單([卡號],[鼠橫,鼠縱,0,0]); }));
    項目=加入(項目,項(字("到期日")+"…","日曆",函式(){ 開日期選擇([鼠橫,鼠縱,0,0],卡["到期日"],函式(值){ 執行改動(字("設定到期日"),函式(){ 卡["到期日"]=值; }); }); }));
    項目=加入(項目,分隔());
    項目=加入(項目,{"文字":字("複製"),"圖示":"複製","快捷":"Ctrl+C","動作":函式(){ 複製卡片們([卡號],假); }});
    項目=加入(項目,{"文字":字("剪下"),"圖示":"剪下","快捷":"Ctrl+X","動作":函式(){ 複製卡片們([卡號],真); }});
    如果 (長度(卡片剪貼)>0) { 項目=加入(項目,{"文字":格式("在下方貼上 {0} 張卡片",[長度(卡片剪貼)]),"圖示":"貼上","快捷":"Ctrl+V","動作":函式(){ 貼上卡片(列,找[2]+1); }}); }
    項目=加入(項目,{"文字":字("建立複本"),"圖示":"範本","快捷":"Ctrl+D","動作":函式(){ 複製一張(卡號); }});
    項目=加入(項目,項(字("移動至…"),"移動",函式(){ 卡片移動(卡號); }));
    項目=加入(項目,項(字("複製標題文字"),"筆記",函式(){ 介面.寫剪貼簿(卡["名稱"]); 簡提示(字("已複製標題。")); }));
    變數 選字=字("加入選取"); 如果 (已選(卡號)) { 選字=字("取消選取"); } 項目=加入(項目,{"文字":選字,"圖示":"選取","快捷":"Ctrl+"+字("點選"),"動作":函式(){ 選卡(卡號); }});
    項目=加入(項目,分隔());
    項目=加入(項目,{"文字":字("封存卡片"),"圖示":"封存","快捷":"Delete","危險":真,"動作":函式(){ 封存卡片們([卡號]); }});
    右鍵選單(項目);
};
變數 批次操作=函式() {
    變數 板=取板(); 變數 項目=[]; 變數 組=多選;
    迴圈 (變數 索=0; 索<長度(板["清單"]); 索++) { 變數 列=板["清單"][索]; 如果 (!列["封存"]) { 項目=加入(項目,項(格式("移至「{0}」",[列["名稱"]]),"移動",函式(){ 變數 失敗=假; 執行改動(字("移動卡片"),函式(){ 變數 動=0; 迴圈 (變數 位=0; 位<長度(組); 位++) { 如果 (引擎.移卡(板,組[位],列["編號"],-1)) { 動++; } 否則 { 失敗=真; } } 如果 (動==0) { 回傳 假; } }); 如果 (失敗) { 提示(字("部分卡片受清單上限限制，尚未移動。"),"警告","",空值); } 多選=[]; })); } }
    項目=加入(項目,分隔());
    項目=加入(項目,項(字("標記全部完成"),"勾",函式(){ 執行改動(字("標記完成"),函式(){ 迴圈 (變數 位=0; 位<長度(組); 位++) { 變數 找=引擎.找卡片(板,組[位]); 如果 (找!=空值) { 引擎.設定完成(板,找[0],找[1],真); } } }); 多選=[]; }));
    項目=加入(項目,項(字("標記全部未完成"),"圓",函式(){ 執行改動(字("標記未完成"),函式(){ 迴圈 (變數 位=0; 位<長度(組); 位++) { 變數 找=引擎.找卡片(板,組[位]); 如果 (找!=空值) { 找[1]["完成"]=假; } } }); 多選=[]; }));
    項目=加入(項目,項(字("設定優先程度…"),"旗",函式(){ 優先選單(組,[鼠橫,鼠縱,0,0]); }));
    項目=加入(項目,項(字("設定到期日…"),"日曆",函式(){ 開日期選擇([鼠橫,鼠縱,0,0],"",函式(值){ 執行改動(字("設定到期日"),函式(){ 迴圈 (變數 位=0; 位<長度(組); 位++) { 變數 找=引擎.找卡片(板,組[位]); 如果 (找!=空值) { 找[1]["到期日"]=值; } } }); }); }));
    項目=加入(項目,項(字("加上標籤…"),"標籤",函式(){ 表單(字("加上標籤"),字("標籤名稱"),"",函式(值){ 執行改動(字("加上標籤"),函式(){ 迴圈 (變數 位=0; 位<長度(組); 位++) { 變數 找=引擎.找卡片(板,組[位]); 如果 (找!=空值) { 如果 (!引擎.標籤含(找[1]["標籤"],值)) { 找[1]["標籤"]=加入(找[1]["標籤"],值); } } } }); }); }));
    項目=加入(項目,項(字("複製"),"複製",函式(){ 複製卡片們(組,假); }));
    項目=加入(項目,分隔());
    項目=加入(項目,險項(字("封存所選卡片"),"封存",函式(){ 封存卡片們(組); }));
    項目=加入(項目,項(字("清除選取"),"關閉",函式(){ 多選=[]; }));
    右鍵或彈出(格式("批次處理 {0} 張卡片",[長度(組)]),項目);
};

# ── 清單 ──────────────────────────────────────────────────
變數 清單選單=函式(列,錨) {
    變數 板=取板(); 變數 項目=[];
    項目=加入(項目,項(字("新增卡片"),"加",函式(){ 開始新增(列["編號"]); }));
    項目=加入(項目,項(字("重新命名"),"編輯",函式(){ 表單(字("清單名稱"),字("名稱"),列["名稱"],函式(值){ 執行改動(字("重新命名清單"),函式(){ 列["名稱"]=值; }); }); }));
    變數 收字=字("收合清單"); 如果 (列["收合"]) { 收字=字("展開清單"); } 項目=加入(項目,項(收字,"收合",函式(){ 執行改動(收字,函式(){ 列["收合"]=!列["收合"]; }); }));
    如果 (長度(卡片剪貼)>0) { 項目=加入(項目,項(格式("貼上 {0} 張卡片",[長度(卡片剪貼)]),"貼上",函式(){ 貼上卡片(列,長度(列["卡片"])); })); }
    項目=加入(項目,分隔());
    項目=加入(項目,說明項(字("在製品上限"),"旗",字("零表示不限"),函式(){ 表單(字("在製品上限"),字("請輸入零至九百九十九"),字數(列["上限"]),函式(值){ 變數 數=字串.解析整數(值); 如果 (數==空值) { 數=-1; } 如果 (數<0 || 數>999) { 提示(字("上限必須是零至九百九十九的整數。"),"警告","",空值); 回傳 空值; } 執行改動(字("設定在製品上限"),函式(){ 列["上限"]=數; }); }); }));
    項目=加入(項目,勾項(字("完成欄（移入自動完成）"),列["完成欄"],函式(){ 執行改動(字("切換完成欄"),函式(){ 列["完成欄"]=!列["完成欄"]; }); }));
    項目=加入(項目,項(字("依到期日排序"),"排序",函式(){ 執行改動(字("依到期日排序"),函式(){ 變數 卡們=列["卡片"]; 迴圈 (變數 甲=1; 甲<長度(卡們); 甲++) { 變數 項值=卡們[甲]; 變數 鍵=引擎.日期數(項值["到期日"]); 如果 (鍵<=0) { 鍵=99999999; } 變數 乙=甲-1; 迴圈 (變數 次=0; 次<長度(卡們); 次++) { 如果 (乙<0) { 中斷; } 變數 比=引擎.日期數(卡們[乙]["到期日"]); 如果 (比<=0) { 比=99999999; } 如果 (比<=鍵) { 中斷; } 卡們[乙+1]=卡們[乙]; 乙-=1; } 卡們[乙+1]=項值; } }); }));
    項目=加入(項目,項(字("向左移動"),"向左",函式(){ 執行改動(字("移動清單"),函式(){ 變數 位=引擎.清單位置(板,列["編號"]); 回傳 引擎.移清單(板,列["編號"],位-1); }); }));
    項目=加入(項目,項(字("向右移動"),"向右",函式(){ 執行改動(字("移動清單"),函式(){ 變數 位=引擎.清單位置(板,列["編號"]); 回傳 引擎.移清單(板,列["編號"],位+2); }); }));
    項目=加入(項目,項(字("複製這份清單"),"複製",函式(){ 執行改動(字("複製清單"),函式(){ 變數 新=引擎.建立清單(板,列["名稱"]+字("（複本）")); 新["上限"]=列["上限"]; 新["完成欄"]=列["完成欄"]; 迴圈 (變數 索=0; 索<長度(列["卡片"]); 索++) { 如果 (!列["卡片"][索]["封存"]) { 引擎.貼上卡(新,列["卡片"][索],-1); } } }); }));
    項目=加入(項目,分隔());
    項目=加入(項目,項(字("封存已完成的卡片"),"封存",函式(){ 變數 號們=[]; 迴圈 (變數 索=0; 索<長度(列["卡片"]); 索++) { 如果 (列["卡片"][索]["完成"] && !列["卡片"][索]["封存"]) { 號們=加入(號們,列["卡片"][索]["編號"]); } } 封存卡片們(號們); }));
    項目=加入(項目,險項(字("封存清單"),"封存",函式(){ 執行改動(字("封存清單"),函式(){ 列["封存"]=真; }); 提示(格式("已封存清單「{0}」。",[列["名稱"]]),"資訊",字("復原"),函式(){ 復原操作(); }); }));
    如果 (錨==空值) { 右鍵選單(項目); } 否則 { 彈出(錨,項目,260); }
};

# ── 篩選選單 ──────────────────────────────────────────────
變數 狀態選單=函式(錨) { 變數 項目=[]; 變數 圖們=["看板","圓","勾","時鐘","眼","日曆","旗"]; 迴圈 (變數 索=0;索<7;索++) { 變數 值=索; 項目=加入(項目,{"文字":狀態名(索),"圖示":圖們[索],"勾選":狀態篩選==索,"動作":函式(){ 狀態篩選=值; 清除篩選暫存(); }}); } 彈出(錨,項目,230); };
變數 收集選單=函式(錨,欄位) {
    變數 板=取板(); 變數 全=引擎.收集(板,欄位); 變數 項目=[]; 變數 目前值=標籤篩選; 如果 (欄位!="標籤") { 目前值=負責篩選; }
    項目=加入(項目,勾項(字("全部"),目前值=="",函式(){ 如果 (欄位=="標籤") { 標籤篩選=""; } 否則 { 負責篩選=""; } 清除篩選暫存(); }));
    如果 (長度(全)>0) { 項目=加入(項目,分隔()); }
    迴圈 (變數 索=0;索<長度(全);索++) { 變數 名=全[索][0]; 變數 甲={"文字":名,"說明":字數(全[索][1]),"勾選":名==目前值,"動作":函式(){ 如果 (欄位=="標籤") { 標籤篩選=名; } 否則 { 負責篩選=名; } 清除篩選暫存(); }}; 如果 (欄位=="標籤") { 甲["色"]=標籤色(名); } 否則 { 甲["圖示"]="人"; } 項目=加入(項目,甲); }
    如果 (長度(全)==0) { 項目=加入(項目,{"文字":字("這份看板還沒有任何項目。"),"停用":真,"動作":函式(){}}); }
    彈出(錨,項目,260);
};

# ── 外殼：頂欄、側欄、狀態列 ──────────────────────────────
變數 繪星標=函式(橫,縱,尺寸) {
    變數 縮=尺寸/32.0d; 畫.停用填色(); 畫.描邊(薄荷); 畫.描邊粗細(1.4d); 畫.橢圓(橫,縱,32*縮,18*縮); 畫.線段(橫-12*縮,縱-12*縮,橫+12*縮,縱+12*縮); 畫.停用描邊(); 畫.填色(薄荷); 畫.圓形(橫,縱,5*縮);
};
變數 頁籤=函式(名,圖,文字,橫,只圖示) {
    變數 寬=鈕寬(文字,圖,14)+4; 如果 (只圖示) { 寬=40.0d; } 變數 選中=頁面==名; 變數 鍵=區鍵("按鈕",文字,橫,12); 變數 色=次墨;
    如果 (選中) { 色=墨; } 否則如果 (滑過鍵==鍵) { 實框(橫,12,寬,36,卡滑過,8); 色=墨; }
    如果 (只圖示) { 繪圖示(圖,橫+20,30,17,色); } 否則 { 繪圖示(圖,橫+21,30,16,色); 顯示(文字,橫+36,35,14,色); }
    變數 資="提示"; 如果 (!只圖示) { 資=空值; }
    登記(橫,12,寬,36,函式(){ 結束編輯(); 頁面=名; 頁面捲動=捲動.建立(); 畫.重繪(); },文字,"按鈕",資); 回傳 寬;
};
變數 繪頂欄=函式() {
    實框(0,0,版寬,頂欄高,側底,0); 分隔線(0,頂欄高-0.5d,版寬);
    圖示鈕("側欄",12,12,36,函式(){ 切換側欄(); },字("切換側欄"),"幽靈",假);
    繪星標(76,30,26); 顯示(字("星泉看板"),96,29,17,墨); 顯示(字("讓想法，找到流動的方向"),97,46,10,淡墨);
    變數 位=最大(250,側欄寬+16); 變數 起=位; 如果 (版寬<1000) { 位=250; }
    變數 選中橫=0.0d; 變數 選中寬=0.0d; 變數 名們=["看板","範本","封存"]; 變數 圖們=["看板","範本","封存"]; 變數 字們=[字("看板"),字("範本"),字("封存庫")];
    變數 窄=版寬<1100; 變數 很窄=版寬<960;
    迴圈 (變數 索=0;索<3;索++) { 變數 寬=頁籤(名們[索],圖們[索],字們[索],位,很窄); 如果 (頁面==名們[索]) { 選中橫=位; 選中寬=寬; } 位+=寬+4; }
    如果 (選中寬>0) { 變數 動橫=動值("頁籤橫",選中橫,180); 變數 動寬=動值("頁籤寬",選中寬,180); 實框(動橫+10,頂欄高-3,動寬-20,3,薄荷,1.5d); }
    # 右側工具
    變數 右=版寬-14;
    右-=36; 變數 設定樣="幽靈"; 如果 (頁面=="設定") { 設定樣="選中"; } 圖示鈕("設定",右,12,36,函式(){ 結束編輯(); 頁面="設定"; 頁面捲動=捲動.建立(); },字("設定"),設定樣,假);
    如果 (窄) {
        右-=44; 圖示鈕("儲存",右,12,36,手動儲存,字("儲存備份"),"主要",假); 如果 (是網頁 && !匯出過) { 實框(右+29,9,10,10,琥珀,5); }
        右-=44; 圖示鈕("開啟",右,12,36,手動載入,字("載入"),"一般",假);
    } 否則 {
        變數 存寬=鈕寬(字("儲存備份"),"儲存",13); 右-=存寬+8; 圖示按鈕(字("儲存備份"),"儲存",右,13,存寬,手動儲存,"主要");
        如果 (是網頁 && !匯出過) { 實框(右+存寬-9,10,10,10,琥珀,5); }
        變數 開寬=鈕寬(字("載入"),"開啟",13); 右-=開寬+8; 圖示按鈕(字("載入"),"開啟",右,13,開寬,手動載入,"一般");
    }
    右-=46; 變數 重做標=字("重做"); 如果 (引擎.下個重做()!="") { 重做標=格式("重做：{0}",[引擎.下個重做()]); } 圖示鈕("重做",右,12,36,重做操作,重做標,"幽靈",!引擎.可重做());
    右-=38; 變數 復原標=字("復原"); 如果 (引擎.下個復原()!="") { 復原標=格式("復原：{0}",[引擎.下個復原()]); } 圖示鈕("復原",右,12,36,復原操作,復原標,"幽靈",!引擎.可復原());
    # 指令面板入口
    變數 指寬=最小(260,右-位-24); 如果 (指寬>=150) {
        右-=指寬+12; 變數 鍵=區鍵("按鈕",字("搜尋與指令"),右,14); 變數 線=邊線; 如果 (滑過鍵==鍵) { 線=強邊線; }
        圓角框(右,14,指寬,32,主題.混合(側底,底,0.5d),線,8); 繪圖示("搜尋",右+18,30,15,淡墨); 短文(字("搜尋看板、卡片與指令"),右+34,35,指寬-96,12,淡墨);
        如果 (指寬>200) { 徽章("Ctrl K",右+指寬-58,21,邊線,次墨); }
        登記(右,14,指寬,32,函式(){ 開指令面板(); },字("搜尋與指令"),"按鈕",空值);
    }
};
變數 切換側欄=函式() { 側欄收合=!側欄收合; 如果 (側欄收合) { 儲存空間.設定偏好(儲存前綴+".sidebar",1); } 否則 { 儲存空間.設定偏好(儲存前綴+".sidebar",0); } 畫.重繪(); };
變數 側欄看板列=函式(板,橫,縱,寬,收合) {
    變數 本=板; 變數 目前=板["編號"]==目前板 && 頁面=="看板"; 變數 標=格式("開啟看板：{0}",[板["名稱"]]); 變數 鍵=區鍵("側欄看板",標,橫,縱);
    如果 (目前) { 實框(橫,縱,寬,36,透明(薄荷,34),8); 實框(橫,縱+8,3,20,薄荷,1.5d); } 否則如果 (滑過鍵==鍵) { 實框(橫,縱,寬,36,卡滑過,8); }
    如果 (收合) { 實框(橫+寬/2-12,縱+6,24,24,透明(色票[板["色系"]],90),7); 變數 首=片段(板["名稱"],0,1); 如果 (字串.字元碼(板["名稱"],0)!=空值) { 如果 (字串.字元碼(板["名稱"],0)>65535) { 首=片段(板["名稱"],0,2); } } 置中顯示(字串.轉大寫(首),橫+寬/2,縱+23,12,墨); }
    否則 {
        實框(橫+12,縱+13,10,10,色票[板["色系"]],3); 變數 色=次墨; 如果 (目前) { 色=墨; }
        變數 文寬=寬-48; 如果 (板["星號"]) { 繪圖示("實星",橫+寬-18,縱+18,12,琥珀); 文寬-=14; }
        短文(板["名稱"],橫+32,縱+23,文寬,13,色);
    }
    登記(橫,縱,寬,36,函式(){ 開看板(本); },標,"側欄看板",[板["編號"]]);
};
變數 繪側欄=函式() {
    變數 寬=側欄寬; 變數 收合=寬<120; 變數 上=頂欄高; 變數 下=版高-狀態列高;
    實框(0,上,寬,下-上,側底,0); 畫.描邊(邊線); 畫.線段(寬-0.5d,上,寬-0.5d,下); 畫.停用描邊();
    變數 區=取區(); 變數 名=字("尚未建立"); 如果 (區!=空值) { 名=區["名稱"]; }
    變數 縱=上+14;
    如果 (!收合) { 小標(字("工作空間"),18,縱+10); 縱+=20; }
    變數 區鈕=函式(){
        變數 項目=[]; 迴圈 (變數 索=0; 索<長度(資料()["工作區"]); 索++) { 變數 工作=資料()["工作區"][索]; 如果 (!工作["封存"]) { 項目=加入(項目,勾項(工作["名稱"],工作["編號"]==目前區,函式(){ 選工作區(工作); })); } }
        項目=加入(項目,分隔()); 項目=加入(項目,項(字("建立工作區"),"加",新工作區)); 如果 (取區()!=空值) { 項目=加入(項目,項(字("工作空間設定"),"設定",工作區設定)); }
        彈出([12,縱,最大(寬-24,220),40],項目,最大(寬-24,240));
    };
    如果 (收合) { 圖示鈕("工作區",寬/2-18,縱,36,區鈕,格式("工作空間：{0}",[名]),"幽靈",假); 縱+=46; }
    否則 {
        變數 鍵=區鍵("按鈕",名+"  ▾",12,縱); 變數 線=邊線; 如果 (滑過鍵==鍵) { 線=強邊線; }
        圓角框(12,縱,寬-24,40,面板,線,9); 繪圖示("工作區",32,縱+20,16,薄荷); 短文(名,48,縱+25,寬-100,13,墨); 繪圖示("向下",寬-34,縱+20,14,次墨);
        登記(12,縱,寬-24,40,區鈕,名+"  ▾","按鈕",空值); 縱+=54;
    }
    # 收藏與看板清單共用捲動區
    變數 底區=下-104; 如果 (收合) { 底區=下-96; }
    變數 清單們=[]; 變數 收藏們=[];
    迴圈 (變數 甲=0; 甲<長度(資料()["工作區"]); 甲++) { 變數 工作=資料()["工作區"][甲]; 如果 (!工作["封存"]) { 迴圈 (變數 乙=0; 乙<長度(工作["看板"]); 乙++) { 變數 板=工作["看板"][乙]; 如果 (!板["封存"] && 板["星號"]) { 收藏們=加入(收藏們,板); } } } }
    如果 (區!=空值) { 迴圈 (變數 索=0; 索<長度(區["看板"]); 索++) { 如果 (!區["看板"][索]["封存"]) { 清單們=加入(清單們,區["看板"][索]); } } }
    變數 視野=底區-縱-46; 變數 總高=0.0d; 如果 (長度(收藏們)>0) { 總高+=長度(收藏們)*38+30; } 總高+=長度(清單們)*38+30;
    捲動.設定(側欄捲動,寬,總高,寬,視野); 變數 原裁切=命中裁切; 設裁切([0,縱,寬,視野]);
    變數 位=縱-側欄捲動["縱"];
    如果 (長度(收藏們)>0) {
        如果 (!收合) { 小標(字("收藏"),18,位+14); } 否則 { 繪圖示("實星",寬/2,位+12,12,琥珀); } 位+=24;
        迴圈 (變數 索=0;索<長度(收藏們);索++) { 側欄看板列(收藏們[索],10,位,寬-20,收合); 位+=38; } 位+=6;
    }
    如果 (!收合) { 變數 板標=字("看板"); 如果 (英文()) { 板標="Boards"; } 小標(板標,18,位+14); 位+=24; } 否則 { 分隔線(14,位+10,寬-28); 位+=20; }
    迴圈 (變數 索=0;索<長度(清單們);索++) { 側欄看板列(清單們[索],10,位,寬-20,收合); 位+=38; }
    設裁切(原裁切);
    變數 新縱=縱+視野+6; 如果 (收合) { 圖示鈕("加",寬/2-18,新縱,36,新看板,字("新增看板"),"幽靈",假); } 否則 { 按鈕樣(字("新增看板"),"加",10,新縱,寬-20,36,新看板,"幽靈","",假); } 如果 (側欄捲動["內容高"]>視野) { 變數 塊=捲動.滑塊(側欄捲動["內容高"],視野,側欄捲動["縱"],視野); 實框(寬-6,縱+塊[0],3,塊[1],強邊線,2); }
    登記區("側欄",[0,縱,寬,視野]);
    # 底部
    分隔線(12,底區+6,寬-24); 變數 底縱=底區+16;
    如果 (收合) { 圖示鈕("說明",寬/2-18,底縱,36,說明選單,字("說明與導覽"),"幽靈",假); 圖示鈕("鍵盤",寬/2-18,底縱+40,36,開快捷鍵,字("鍵盤快捷鍵"),"幽靈",假); }
    否則 { 按鈕樣(字("說明與導覽"),"說明",10,底縱,寬-20,36,說明選單,"幽靈","",假); 按鈕樣(字("鍵盤快捷鍵"),"鍵盤",10,底縱+40,寬-20,36,開快捷鍵,"幽靈","",假); }
};
變數 說明選單=函式() {
    彈出([12,版高-狀態列高-100,200,40],[項(字("重新觀看入門導覽"),"說明",函式(){ 開始導覽(); }),項(字("鍵盤快捷鍵"),"鍵盤",開快捷鍵),項(字("搜尋與指令"),"指令",開指令面板),分隔(),說明項(字("關於星泉看板"),"資訊","v"+版本文字,函式(){ 確認(字("關於星泉看板"),格式("版本 {0}。以星泉程式語言編寫，編譯為 WebAssembly，在桌面與瀏覽器使用同一份程式。",[版本文字]),函式(){}); })],260);
};
# 記錄捲動區域位置，供滾輪判斷。
變數 捲動區們=[];
變數 登記區=函式(名,矩形) { 捲動區們=加入(捲動區們,[名,矩形]); };
變數 繪狀態列=函式() {
    變數 上=版高-狀態列高; 實框(0,上,版寬,狀態列高,側底,0); 分隔線(0,上+0.5d,版寬);
    變數 圖="勾"; 變數 色=成功; 如果 (未儲存) { 圖="時鐘"; 色=琥珀; } 如果 (儲存鎖定) { 圖="警告"; 色=珊瑚; }
    繪圖示(圖,22,上+狀態列高/2,14,色);
    變數 模式=字("桌面版"); 如果 (是網頁) { 模式=字("網頁版"); }
    短文(模式+" · "+存檔狀態,36,上+22,版寬*0.45d,12,次墨);
    變數 中文字=""; 如果 (長度(多選)>0) { 中文字=格式("已選取 {0} 張卡片 · 按離開鍵取消",[長度(多選)]); }
    否則如果 (頁面=="看板" && 取板()!=空值) { 變數 統=板統計(取板()); 中文字=格式("{0} 張卡片 · {1} 已完成",[統[0],統[1]]); 如果 (統[2]>0) { 中文字+=" · "+格式("{0} 逾期",[統[2]]); } }
    如果 (中文字!="" && 版寬>860) { 短文(中文字,版寬*0.45d,上+22,版寬*0.55d-250,12,淡墨); }
    繪縮放();
};
變數 設定介面縮放=函式(百分比) {
    介面百分比=畫.向下取整(畫.限制範圍(百分比,70,150)/10)*10;
    儲存空間.設定偏好(儲存前綴+".ui-scale",介面百分比);
    滑塊拖曳=空值; 卡片拖曳=空值; 拖曳中=假; 放置目標=空值; 焦點鍵=""; 指標="閒置";
    畫.重繪();
};
變數 繪縮放=函式() {
    如果 (手機版) { 回傳 空值; }
    變數 左=版寬-170; 變數 上=版高-狀態列高+4; 變數 高=狀態列高-8;
    顯示(字("介面"),左-40,上+高/2+5,11,淡墨);
    圖示鈕("縮小",左,上,高,函式(){ 設定介面縮放(介面百分比-10); },字("縮小介面"),"幽靈",介面百分比<=70);
    變數 鍵=區鍵("按鈕",字("重設介面縮放（100%）"),左+高+4,上); 如果 (滑過鍵==鍵) { 實框(左+高+4,上,64,高,卡滑過,6); }
    置中顯示(字數(介面百分比)+"%",左+高+36,上+高/2+5,12,墨); 登記(左+高+4,上,64,高,函式(){ 設定介面縮放(100); },字("重設介面縮放（100%）"),"按鈕",空值);
    圖示鈕("放大",左+高+72,上,高,函式(){ 設定介面縮放(介面百分比+10); },字("放大介面"),"幽靈",介面百分比>=150);
};

# ── 看板視圖 ──────────────────────────────────────────────
變數 取列捲動=函式(列號) { 變數 區=列捲動[列號]; 如果 (區==空值) { 區=捲動.建立(); 列捲動[列號]=區; } 回傳 區; };
變數 可見清單=函式(板) { 變數 列們=[]; 迴圈 (變數 索=0; 索<長度(板["清單"]); 索++) { 如果 (!板["清單"][索]["封存"]) { 列們=加入(列們,板["清單"][索]); } } 回傳 列們; };
# 看板統計與清單有效卡數在資料變更前保持快取。
變數 統計暫存=空值; 變數 有效暫存={};
變數 板統計=函式(板) { 如果 (統計暫存!=空值) { 如果 (統計暫存[0]==板["編號"]) { 回傳 統計暫存[1]; } } 變數 結果=引擎.統計(板); 統計暫存=[板["編號"],結果]; 回傳 結果; };
變數 有效數=函式(列) { 變數 存=有效暫存[列["編號"]]; 如果 (存!=空值) { 回傳 存; } 變數 數=引擎.有效卡數(列); 有效暫存[列["編號"]]=數; 回傳 數; };
變數 篩選中=函式() { 回傳 查詢!="" || 標籤篩選!="" || 負責篩選!="" || 狀態篩選!=0; };
變數 篩選數=函式() { 變數 數=0; 如果 (查詢!="") { 數++; } 如果 (標籤篩選!="") { 數++; } 如果 (負責篩選!="") { 數++; } 如果 (狀態篩選!=0) { 數++; } 回傳 數; };
變數 檢查篩選變更=函式() {
    如果 (上次查詢!=查詢 || 上次標籤!=標籤篩選 || 上次負責!=負責篩選 || 上次狀態!=狀態篩選 || 上次今日!=資料()["今日"]) { 清除篩選暫存(); 上次查詢=查詢; 上次標籤=標籤篩選; 上次負責=負責篩選; 上次狀態=狀態篩選; 上次今日=資料()["今日"]; }
};
變數 篩卡=函式(列) {
    檢查篩選變更(); 變數 已篩=篩選暫存[列["編號"]]; 如果 (已篩!=空值) { 回傳 已篩[0]; }
    變數 卡們=[]; 迴圈 (變數 索=0; 索<長度(列["卡片"]); 索++) { 變數 卡=列["卡片"][索]; 如果 (引擎.符合(卡,查詢,標籤篩選,狀態篩選,負責篩選)) { 卡們=加入(卡們,卡); } }
    篩選暫存[列["編號"]]=[卡們,空值,0,0.0d]; 回傳 卡們;
};
變數 有附加資訊=函式(卡) { 回傳 卡["到期日"]!="" || 長度(卡["檢查表"])>0 || 長度(卡["附件"])>0 || 長度(卡["留言"])>0 || 卡["負責人"]!="" || 卡["優先"]==2 || 卡["關注"] || 卡["重複"]>0; };
變數 卡高=函式(卡,寬) {
    變數 高=12.0d; 如果 (卡["封面"]>0) { 高+=6; } 如果 (長度(卡["標籤"])>0) { 高+=26; }
    高+=估行(卡["名稱"],寬-50,14,3)*20; 如果 (有附加資訊(卡)) { 高+=28; } 回傳 高+14;
};
# 每份清單的卡片版面：[卡們,頂們,總高,卡寬]。
變數 列版面=函式(列,卡寬) {
    變數 卡們=篩卡(列); 變數 存=篩選暫存[列["編號"]];
    如果 (存[1]!=空值 && 存[3]==卡寬) { 回傳 存; }
    變數 頂們=陣列.建立(0,0,長度(卡們)+1); 變數 位=0.0d;
    迴圈 (變數 索=0;索<長度(卡們);索++) { 陣列.追加(頂們,位); 位+=卡高(卡們[索],卡寬)+10; }
    陣列.追加(頂們,位); 存=[卡們,頂們,位,卡寬]; 篩選暫存[列["編號"]]=存; 回傳 存;
};
變數 到期資訊=函式(卡) {
    # 回傳 [文字, 顏色]；完成、逾期、今天、即將到期分別上色。
    變數 差=引擎.距今(卡["到期日"]); 如果 (差==空值) { 回傳 ["",次墨]; }
    變數 文=片段(卡["到期日"],5,10); 變數 色=次墨;
    如果 (卡["完成"]) { 回傳 [文,成功]; }
    如果 (差<0) { 文=格式("逾期 {0} 天",[-差]); 色=珊瑚; } 否則如果 (差==0) { 文=字("今天到期"); 色=琥珀; } 否則如果 (差==1) { 文=字("明天到期"); 色=琥珀; } 否則如果 (差<=3) { 色=琥珀; }
    回傳 [文,色];
};
變數 頭像=函式(名,橫,縱,尺寸) {
    變數 首=片段(名,0,1); 實框(橫,縱,尺寸,尺寸,透明(標籤色(名),120),尺寸/2); 置中顯示(字串.轉大寫(首),橫+尺寸/2,縱+尺寸*0.7d,尺寸*0.5d,墨);
};
# 繪製卡片，回傳高度。狀態：「一般」「拖影」「佔位」。
變數 繪卡片=函式(卡,列,橫,縱,寬,狀態) {
    變數 高=卡高(卡,寬); 變數 標=格式("卡片：{0}",[卡["名稱"]]); 變數 鍵=區鍵("卡片",標,橫,縱); 變數 經過=滑過鍵==鍵 && 狀態=="一般";
    如果 (狀態=="佔位") { 畫.停用填色(); 畫.描邊(強邊線); 畫.描邊粗細(1.5d); 畫.矩形(橫,縱,寬,高,10); 畫.停用描邊(); 回傳 高; }
    變數 線=邊線; 變數 底色=卡底; 如果 (經過) { 底色=卡滑過; 線=強邊線; } 如果 (已選(卡["編號"])) { 線=薄荷; }
    如果 (狀態=="拖影") { 陰影框(橫,縱,寬,高,10,8); } 否則如果 (經過 || 主題.是亮色) { 陰影框(橫,縱,寬,高,10,2); }
    # 深色主題只在滑過或選取時描邊，減少每張卡片的繪製量。
    如果 (經過 || 主題.是亮色 || 狀態=="拖影" || 已選(卡["編號"])) { 圓角框(橫,縱,寬,高,底色,線,10); } 否則 { 實框(橫,縱,寬,高,底色,10); }
    如果 (已選(卡["編號"])) { 畫.停用填色(); 畫.描邊(薄荷); 畫.描邊粗細(2); 畫.矩形(橫,縱,寬,高,10); 畫.停用描邊(); }
    變數 上=縱+12;
    如果 (卡["封面"]>0) { 實框(橫+1,縱+1,寬-2,8,色票[(卡["封面"]-1)%6],4); 實框(橫+1,縱+5,寬-2,4,色票[(卡["封面"]-1)%6],0); 上+=6; }
    如果 (長度(卡["標籤"])>0) {
        變數 位=橫+12; 變數 標們=卡["標籤"];
        迴圈 (變數 索=0;索<長度(標們);索++) { 變數 需=量(標們[索],11)+16; 如果 (位+需>橫+寬-12) { 如果 (索<長度(標們)) { 顯示("+"+字數(長度(標們)-索),位,上+15,11,次墨); } 中斷; } 位+=晶片(標們[索],標籤色(標們[索]),位,上,11)+6; }
        上+=26;
    }
    變數 行數=估行(卡["名稱"],寬-50,14,3); 變數 名色=墨; 如果 (卡["完成"]) { 名色=次墨; }
    段落行(卡["名稱"],橫+12,上-1,寬-46,14,名色,行數,20); 上+=行數*20;
    如果 (有附加資訊(卡)) {
        變數 位=橫+12; 變數 基=上+21; 變數 右界=橫+寬-12;
        如果 (卡["負責人"]!="") { 頭像(卡["負責人"],右界-22,上+5,22); 右界-=28; }
        變數 到=到期資訊(卡); 如果 (到[0]!="") { 變數 寬度=量(到[0],12)+26; 如果 (到[1]!=次墨) { 實框(位-4,上+4,寬度+4,22,透明(到[1],36),6); } 繪圖示("時鐘",位+7,上+15,13,到[1]); 顯示(到[0],位+18,基,12,到[1]); 位+=寬度+6; }
        如果 (卡["重複"]>0) { 繪圖示("重複",位+7,上+15,13,次墨); 位+=20; }
        變數 進=引擎.檢查進度(卡); 如果 (進[1]>0) { 變數 色=次墨; 如果 (進[0]==進[1]) { 色=成功; } 變數 文=字數(進[0])+"/"+字數(進[1]); 如果 (位+量(文,12)+22<右界) { 繪圖示("檢查表",位+7,上+15,13,色); 顯示(文,位+18,基,12,色); 位+=量(文,12)+26; } }
        如果 (長度(卡["附件"])>0 && 位+36<右界) { 繪圖示("迴紋針",位+7,上+15,13,次墨); 顯示(字數(長度(卡["附件"])),位+16,基,12,次墨); 位+=34; }
        如果 (長度(卡["留言"])>0 && 位+36<右界) { 繪圖示("筆記",位+7,上+15,13,次墨); 顯示(字數(長度(卡["留言"])),位+16,基,12,次墨); 位+=34; }
        如果 (卡["優先"]==2 && 位+20<右界) { 繪圖示("實旗",位+7,上+15,13,琥珀); 位+=22; }
        如果 (卡["關注"] && 位+20<右界) { 繪圖示("眼",位+8,上+15,14,次墨); 位+=22; }
    }
    如果 (狀態=="一般") {
        登記(橫,縱,寬,高,函式(){ 開詳情(卡["編號"]); },標,"卡片",[卡["編號"],列["編號"]]);
        變數 完標=格式("切換完成：{0}",[卡["名稱"]]); 變數 完鍵=區鍵("按鈕",完標,橫+寬-34,縱+8); 變數 完經=滑過鍵==完鍵;
        如果 (卡["完成"]) { 繪圖示("勾圓",橫+寬-22,縱+20,18,成功); }
        否則如果 (完經) { 繪圖示("勾圓",橫+寬-22,縱+20,18,透明(薄荷,200)); }
        否則如果 (經過) { 繪圖示("圓",橫+寬-22,縱+20,18,淡墨); }
        登記(橫+寬-34,縱+8,26,26,函式(){ 切換完成(卡["編號"]); },完標,"按鈕","提示");
        如果 (焦點卡==卡["編號"]) { 畫.停用填色(); 畫.描邊(薄荷); 畫.描邊粗細(2); 畫.矩形(橫-3,縱-3,寬+6,高+6,12); 畫.停用描邊(); }
    } 否則如果 (狀態=="拖影" && 卡["完成"]) { 繪圖示("勾圓",橫+寬-22,縱+20,18,成功); }
    回傳 高;
};
變數 拖曳卡片=函式() { 如果 (卡片拖曳==空值) { 回傳 空值; } 變數 找=引擎.找卡片(取板(),卡片拖曳[0]); 如果 (找==空值) { 回傳 空值; } 回傳 找[1]; };
# 依清單版面計算放下位置：回傳 [清單號, 原始索引, 篩選後索引]。
變數 計算放置目標=函式() {
    如果 (!拖曳中 || 卡片拖曳==空值) { 回傳 空值; }
    如果 (檢視!="流動" || 頁面!="看板") { 回傳 空值; }
    如果 (!命中(鼠橫,鼠縱,看板區[0],看板區[1]-20,看板區[2],看板區[3]+40)) { 回傳 空值; }
    迴圈 (變數 索=0;索<長度(列幾何);索++) {
        變數 幾=列幾何[索]; 如果 (鼠橫>=幾[1]-7 && 鼠橫<幾[1]+幾[3]+7) {
            變數 列=引擎.找清單(取板(),幾[0]); 如果 (列==空值) { 回傳 空值; }
            如果 (幾[5]) { 回傳 [列["編號"],長度(列["卡片"]),-1]; }
            變數 版=幾[6]; 變數 卡們=版[0]; 變數 頂們=版[1]; 變數 捲=取列捲動(列["編號"]); 變數 相對=鼠縱-幾[2]+捲["縱"];
            變數 源=-1; 變數 源高=0.0d; 迴圈 (變數 位=0;位<長度(卡們);位++) { 如果 (卡們[位]["編號"]==卡片拖曳[0]) { 源=位; 源高=頂們[位+1]-頂們[位]; } }
            變數 放=長度(卡們);
            迴圈 (變數 位=0;位<長度(卡們);位++) { 如果 (位!=源) { 變數 頂=頂們[位]; 如果 (源>=0 && 位>源) { 頂-=源高; } 變數 中=頂+(頂們[位+1]-頂們[位])/2; 如果 (相對<中) { 放=位; 中斷; } } }
            變數 實=長度(列["卡片"]); 如果 (放<長度(卡們)) { 迴圈 (變數 找=0;找<長度(列["卡片"]);找++) { 如果 (列["卡片"][找]["編號"]==卡們[放]["編號"]) { 實=找; 中斷; } } }
            回傳 [列["編號"],實,放];
        }
    }
    回傳 空值;
};
變數 繪看板標頭=函式(板,左,上,寬) {
    變數 區=取區(); 變數 區名=""; 如果 (區!=空值) { 區名=區["名稱"]; }
    繪圖示("工作區",左+7,上+8,12,淡墨); 短文(區名,左+20,上+12,寬*0.5d,12,淡墨);
    # 右側動作
    變數 右=左+寬; 變數 窄=寬<900;
    變數 加寬=鈕寬(字("新增清單"),"加",13); 如果 (窄) { 加寬=36; 右-=36; 圖示鈕("加",右,上+14,36,新清單,字("新增清單"),"主要",假); } 否則 { 右-=加寬; 圖示按鈕(字("新增清單"),"加",右,上+14,加寬,新清單,"主要"); }
    右-=44; 圖示鈕("設定",右,上+14,36,看板設定,字("看板設定"),"一般",假);
    變數 選項們=[[字("看板"),"看板"],[字("表格"),"表格"],[字("日曆"),"日曆"]]; 如果 (窄) { 選項們=[["","看板"],["","表格"],["","日曆"]]; }
    變數 目前視=0; 如果 (檢視=="表格") { 目前視=1; } 如果 (檢視=="日曆") { 目前視=2; }
    變數 分寬=4.0d; 迴圈 (變數 索=0;索<3;索++) { 分寬+=鈕寬(選項們[索][0],選項們[索][1],13)-4; } 右-=分寬+10;
    分段(選項們,目前視,右,上+14,36,函式(索){ 如果 (索==0) { 檢視="流動"; } 如果 (索==1) { 檢視="表格"; } 如果 (索==2) { 檢視="日曆"; 如果 (日曆月=="") { 日曆月=片段(資料()["今日"],0,7); } } 看板捲動=捲動.建立(); 清除篩選暫存(); },字("檢視"));
    # 標題與收藏
    變數 標寬=最大(80,右-左-60); 介面.文字大小(26,比例); 變數 名=截斷(板["名稱"],標寬,26); 顯示(名,左,上+46,26,墨); 變數 名寬=量(名,26);
    變數 星圖="星"; 變數 星樣="幽靈"; 如果 (板["星號"]) { 星圖="實星"; } 變數 星標=字("加入收藏"); 如果 (板["星號"]) { 星標=字("取消收藏"); }
    圖示鈕(星圖,左+名寬+8,上+22,32,函式(){ 執行改動(星標,函式(){ 板["星號"]=!板["星號"]; }); },星標,星樣,假);
    如果 (板["星號"]) { 繪圖示("實星",左+名寬+24,上+38,16,琥珀); }
    變數 統=板統計(板); 變數 說寬=寬*0.55d; 如果 (統[0]>0) { 說寬=寬-260; }
    短文(板["說明"],左,上+70,最小(說寬,寬-260),13,次墨);
    如果 (統[0]>0) { 變數 比=統[1]*1.0d/統[0]; 變數 條左=左+寬-230; 進度條(條左,上+62,120,6,比,薄荷); 顯示(格式("{0}/{1} 完成",[統[1],統[0]]),條左+130,上+70,12,次墨); 如果 (統[2]>0) { 繪圖示("時鐘",條左-16,上+65,12,珊瑚); } }
};
變數 繪篩選列=函式(板,左,上,寬) {
    變數 位=左; 變數 縱=上; 變數 搜寬=最小(280,寬*0.32d); 如果 (寬<700) { 搜寬=寬; }
    輸入欄("搜尋",查詢,位,縱,搜寬,36,函式(值){ 查詢=值; 清除篩選暫存(); },{"占位":字("搜尋卡片"),"圖示":"搜尋","標籤":字("搜尋卡片"),"清除":真,"提交":函式(){ 結束編輯(); }});
    位+=搜寬+10; 如果 (寬<700) { 位=左; 縱+=46; }
    變數 放=函式(文字,圖示名,作用中,處理) {
        變數 鈕=鈕寬(文字,圖示名,13)+18; 如果 (位+鈕>左+寬) { 位=左; 縱+=46; }
        變數 本位=位; 變數 本縱=縱; 變數 樣="一般"; 如果 (作用中) { 樣="選中"; }
        按鈕樣(文字,圖示名,位,縱,鈕,36,函式(){ 處理([本位,本縱,鈕,36]); },樣,"",假); 繪圖示("向下",位+鈕-14,縱+18,11,次墨); 位+=鈕+8;
    };
    放(狀態名(狀態篩選),"篩選",狀態篩選!=0,狀態選單);
    變數 標字=字("標籤"); 如果 (標籤篩選!="") { 標字=標籤篩選; } 放(標字,"標籤",標籤篩選!="",函式(錨){ 收集選單(錨,"標籤"); });
    變數 負字=字("負責人"); 如果 (負責篩選!="") { 負字=負責篩選; } 放(負字,"人",負責篩選!="",函式(錨){ 收集選單(錨,"負責人"); });
    如果 (篩選中()) { 變數 字樣=格式("清除篩選（{0}）",[篩選數()]); 變數 鈕=鈕寬(字樣,"關閉",13); 如果 (位+鈕>左+寬) { 位=左; 縱+=46; } 按鈕樣(字樣,"關閉",位,縱,鈕,36,函式(){ 重設篩選(); 結束編輯(); },"幽靈",字("清除篩選"),假); 位+=鈕+8; }
    如果 (長度(多選)>0) { 變數 字樣=格式("處理所選 {0}",[長度(多選)]); 變數 鈕=鈕寬(字樣,"選取",13); 如果 (位+鈕>左+寬) { 位=左; 縱+=46; } 按鈕樣(字樣,"選取",位,縱,鈕,36,批次操作,"主要","",假); 位+=鈕+8; }
    否則如果 (位+200<左+寬 && !手機版) { 顯示(字("按住控制鍵點選可多選"),位+6,縱+23,12,淡墨); }
    回傳 縱+36;
};
變數 繪看板=函式() {
    變數 板=取板(); 變數 左=側欄寬+28; 變數 寬=版寬-左-24;
    如果 (板==空值) {
        變數 中=左+寬/2; 繪圖示("看板",中,頂欄高+170,56,淡墨); 置中顯示(字("開始你的第一份看板"),中,頂欄高+250,24,墨); 置中顯示(字("看板收納清單與卡片，幫你把想法拆成下一步。"),中,頂欄高+280,14,次墨);
        如果 (取區()==空值) { 圖示按鈕(字("建立工作區"),"工作區",中-90,頂欄高+306,180,新工作區,"主要"); } 否則 { 圖示按鈕(字("建立看板"),"加",中-80,頂欄高+306,160,新看板,"主要"); }
        回傳 空值;
    }
    變數 上=頂欄高+16; 繪看板標頭(板,左,上,寬); 變數 底緣=繪篩選列(板,左,上+90,寬);
    看板上緣=底緣+16; 變數 高=版高-狀態列高-看板上緣-12; 看板區=[左,看板上緣,寬,高];
    變數 列們=可見清單(板);
    如果 (檢視=="表格") { 繪表格(列們,左,看板上緣,寬,高); 回傳 空值; }
    如果 (檢視=="日曆") { 繪日曆(板,左,看板上緣,寬,高); 回傳 空值; }
    登記(左,看板上緣,寬,高,函式(){},字("看板空白處"),"看板空白",空值);
    # 欄寬：清單少時加寬填滿畫面。
    變數 開數=0; 變數 收數=0; 迴圈 (變數 索=0;索<長度(列們);索++) { 如果 (列們[索]["收合"]) { 收數++; } 否則 { 開數++; } }
    變數 列寬=288.0d; 如果 (開數>0) { 變數 可=(寬-收數*62-250+14)/開數-14; 如果 (可>列寬) { 列寬=最小(340,可); } }
    如果 (手機版) { 列寬=寬; }
    變數 總寬=收數*62+開數*(列寬+14)+250;
    捲動.設定(看板捲動,總寬,高,寬,高); 列幾何=[]; 變數 拖=拖曳卡片(); 放置目標=計算放置目標();
    變數 拖高=0.0d; 如果 (拖!=空值) { 拖高=卡高(拖,列寬-20)+10; }
    變數 全部數=0; 變數 篩後數=0;
    設裁切([左,看板上緣,寬,高]); 變數 位=左-看板捲動["橫"];
    迴圈 (變數 索=0; 索<長度(列們); 索++) {
        變數 列=列們[索]; 變數 本列=列;
        如果 (列["收合"]) {
            如果 (位+48>=左 && 位<左+寬) {
                變數 標=格式("清單：{0}",[列["名稱"]]); 變數 鍵=區鍵("清單頭",標,位,看板上緣); 變數 底色=面板; 如果 (滑過鍵==鍵) { 底色=卡滑過; }
                圓角框(位,看板上緣,48,高,底色,邊線,12); 登記(位,看板上緣,48,高,函式(){ 執行改動(字("展開清單"),函式(){ 本列["收合"]=假; }); },標,"清單頭",[列["編號"]]);
                圖示鈕("展開",位+6,看板上緣+8,36,函式(){ 執行改動(字("展開清單"),函式(){ 本列["收合"]=假; }); },格式("展開「{0}」",[列["名稱"]]),"幽靈",假);
                徽章(字數(長度(篩卡(列))),位+(48-最大(20,量(字數(長度(篩卡(列))),11)+12))/2,看板上緣+52,邊線,次墨);
                畫.填色(墨); 介面.繪直文字(截斷(列["名稱"],高-120,14),位+18,看板上緣+86,14,比例);
                如果 (放置目標!=空值) { 如果 (放置目標[0]==列["編號"]) { 畫.停用填色(); 畫.描邊(薄荷); 畫.描邊粗細(2); 畫.矩形(位,看板上緣,48,高,12); 畫.停用描邊(); } }
            }
            列幾何=加入(列幾何,[列["編號"],位,看板上緣,48,高,真,空值]); 位+=62;
        } 否則 {
            變數 版=列版面(列,列寬-20); 變數 卡們=版[0]; 全部數+=有效數(列); 篩後數+=長度(卡們);
            變數 頭高=56.0d; 變數 尾高=52.0d; 如果 (新增中列==列["編號"]) { 尾高=96.0d; }
            變數 身上=看板上緣+頭高; 變數 身高=高-頭高-尾高;
            列幾何=加入(列幾何,[列["編號"],位,身上,列寬,身高,假,版]);
            如果 (位+列寬>=左 && 位<左+寬) { 繪清單(板,列,版,位,看板上緣,列寬,高,頭高,尾高,拖,拖高); }
            位+=列寬+14;
        }
    }
    # 新增清單欄
    如果 (位<左+寬) {
        變數 鍵=區鍵("按鈕",字("新增清單"),位,看板上緣); 變數 底色=透明(面板,120); 如果 (滑過鍵==鍵) { 底色=面板; }
        圓角框(位,看板上緣,236,54,底色,邊線,12); 繪圖示("加",位+24,看板上緣+27,16,次墨); 顯示(字("新增清單"),位+42,看板上緣+32,14,次墨);
        登記(位,看板上緣,236,54,新清單,字("新增清單"),"按鈕",空值);
    }
    設裁切(空值);
    如果 (看板捲動["內容寬"]>看板捲動["視野寬"]) { 繪捲軸(看板捲動,左,看板上緣,寬,高); }
    如果 (長度(列們)==0) { 置中顯示(字("這份看板還沒有清單。"),左+寬/2,看板上緣+110,16,次墨); }
    否則如果 (篩選中() && 篩後數==0 && 全部數>0) {
        變數 中=左+寬/2; 變數 框寬=420.0d; 陰影框(中-框寬/2,看板上緣+90,框寬,120,14,4); 圓角框(中-框寬/2,看板上緣+90,框寬,120,面板,強邊線,14);
        繪圖示("篩選",中,看板上緣+118,22,淡墨); 置中顯示(字("沒有符合篩選條件的卡片。"),中,看板上緣+152,15,墨);
        按鈕樣(字("清除篩選"),"關閉",中-70,看板上緣+164,140,34,函式(){ 重設篩選(); },"一般","",假);
    }
    # 拖曳中的卡片
    如果 (拖!=空值 && 拖曳中) { 變數 拖寬=列寬-20; 繪卡片(拖,空值,鼠橫-卡片拖曳[5],鼠縱-卡片拖曳[6],拖寬,"拖影"); 如果 (長度(多選)>1 && 已選(拖["編號"])) { 徽章(字數(長度(多選)),鼠橫-卡片拖曳[5]+拖寬-14,鼠縱-卡片拖曳[6]-8,薄荷,強調字); } }
    如果 (清單拖曳!=空值) { 如果 (清單拖曳[3]) { 繪清單拖影(); } }
};
變數 繪清單=函式(板,列,版,左,上,寬,高,頭高,尾高,拖,拖高) {
    變數 卡們=版[0]; 變數 頂們=版[1]; 變數 本列=列; 變數 拖動此清單=假; 如果 (清單拖曳!=空值) { 如果 (清單拖曳[0]==列["編號"] && 清單拖曳[3]) { 拖動此清單=真; } }
    如果 (拖動此清單) { 畫.停用填色(); 畫.描邊(強邊線); 畫.描邊粗細(1.5d); 畫.矩形(左,上,寬,高,12); 畫.停用描邊(); 回傳 空值; }
    變數 是目標=假; 如果 (放置目標!=空值) { 如果 (放置目標[0]==列["編號"]) { 是目標=真; } }
    變數 底色=面板; 如果 (是目標) { 底色=主題.混合(面板,薄荷,0.06d); }
    圓角框(左,上,寬,高,底色,邊線,12);
    # 清單本體（右鍵：新增卡片、貼上）
    登記(左,上+頭高,寬,高-頭高,函式(){},格式("清單內容：{0}",[列["名稱"]]),"清單空白",[0,列["編號"]]);
    # 標頭
    變數 標=格式("清單：{0}",[列["名稱"]]); 實框(左+12,上,寬-24,3,色票[板["色系"]],1.5d);
    登記(左,上,寬,頭高,函式(){},標,"清單頭",[列["編號"]]);
    變數 數=長度(卡們); 變數 數字=字數(數); 如果 (篩選中()) { 數字=字數(數)+"/"+字數(有效數(列)); }
    變數 名寬=寬-140; 短文(列["名稱"],左+16,上+28,名寬,15,墨); 變數 名終=左+16+最小(名寬,量(列["名稱"],15))+8;
    徽章(數字,名終,上+15,邊線,次墨);
    如果 (列["上限"]>0) { 變數 有效=有效數(列); 變數 色=次墨; 如果 (有效>=列["上限"]) { 色=珊瑚; } 否則如果 (有效>=列["上限"]-1) { 色=琥珀; } 顯示(格式("上限 {0}/{1}",[有效,列["上限"]]),左+16,上+47,11,色); }
    否則如果 (列["完成欄"]) { 繪圖示("勾",左+21,上+43,11,成功); 顯示(字("完成欄"),左+30,上+47,11,淡墨); }
    如果 (命中(鼠橫,鼠縱,左,上,寬,頭高) || 焦點鍵!="") { 圖示鈕("收合",左+寬-80,上+12,32,函式(){ 執行改動(字("收合清單"),函式(){ 本列["收合"]=真; }); },格式("收合「{0}」",[列["名稱"]]),"幽靈",假); }
    圖示鈕("更多",左+寬-44,上+12,32,函式(){ 清單選單(本列,[左+寬-44,上+12,32,32]); },格式("清單設定：{0}",[列["名稱"]]),"幽靈",假);
    # 卡片
    變數 身上=上+頭高; 變數 身高=高-頭高-尾高; 變數 捲=取列捲動(列["編號"]);
    變數 源=-1; 變數 源高=0.0d; 如果 (拖!=空值 && 拖曳中) { 迴圈 (變數 位=0;位<長度(卡們);位++) { 如果 (卡們[位]["編號"]==拖["編號"]) { 源=位; 源高=頂們[位+1]-頂們[位]; } } }
    變數 隙目標=0.0d; 變數 放位=-1; 如果 (是目標 && 拖曳中) { 隙目標=拖高; 放位=放置目標[2]; } 變數 隙=動值("隙"+字數(列["編號"]),隙目標,140);
    如果 (!拖曳中 && 隙目標==0) { 隙=0.0d; }
    變數 內容高=版[2]+隙+8; 如果 (源>=0) { 內容高-=源高; }
    捲動.設定(捲,寬,內容高,寬,身高);
    變數 原裁切=命中裁切; 交集裁切([左+1,身上,寬-2,身高]);
    變數 偏=捲["縱"]; 變數 起=0; 變數 低=0; 變數 高位=長度(卡們);
    迴圈 (變數 次=0;次<30;次++) { 如果 (低>=高位) { 中斷; } 變數 中=(低+高位)/2; 如果 (頂們[中+1]<偏-400) { 低=中+1; } 否則 { 高位=中; } } 起=低;
    迴圈 (變數 位=起; 位<長度(卡們); 位++) {
        如果 (位!=源) {
            變數 頂=頂們[位]; 如果 (源>=0 && 位>源) { 頂-=源高; } 如果 (放位>=0 && 位>=放位) { 頂+=隙; } 否則如果 (放位<0 && 隙>0.5d && 位>=長度(卡們)) { 頂+=隙; }
            變數 縱=身上+4+頂-偏; 如果 (縱>身上+身高) { 中斷; }
            如果 (縱+頂們[位+1]-頂們[位]>身上) { 繪卡片(卡們[位],列,左+10,縱,寬-20,"一般"); }
        }
    }
    如果 (放位>=0 && 隙>2) { 變數 頂=0.0d; 如果 (放位<長度(卡們)) { 頂=頂們[放位]; 如果 (源>=0 && 放位>源) { 頂-=源高; } } 否則 { 頂=版[2]; 如果 (源>=0) { 頂-=源高; } } 實框(左+10,身上+4+頂-偏,寬-20,隙-10,透明(薄荷,40),10); }
    如果 (長度(卡們)==0 && !拖曳中) { 如果 (篩選中()) { 置中顯示(字("沒有符合的卡片"),左+寬/2,身上+40,12,淡墨); } 否則 { 置中顯示(字("拖曳卡片到這裡，或新增一張"),左+寬/2,身上+40,12,淡墨); } }
    設裁切(原裁切);
    如果 (捲["內容高"]>捲["視野高"]) { 變數 塊=捲動.滑塊(捲["內容高"],身高,捲["縱"],身高); 實框(左+寬-6,身上+塊[0],4,塊[1],強邊線,2); 登記(左+寬-9,身上,9,身高,函式(){},格式("垂直捲動條：{0}",[列["名稱"]]),"捲軸",[捲,假,身上,身高,塊[0],塊[1]]); }
    # 底部新增
    變數 尾上=上+高-尾高;
    如果 (新增中列==列["編號"]) {
        輸入欄("新增卡片"+字數(列["編號"]),新增文字,左+10,尾上+6,寬-20,44,函式(值){ 新增文字=值; },{"占位":字("輸入卡片標題，按換行鍵新增"),"標籤":字("新卡片標題"),"提交":提交新增,"取消":取消新增});
        按鈕樣(字("新增"),"加",左+10,尾上+56,96,32,提交新增,"主要","",假); 圖示鈕("關閉",左+112,尾上+56,32,取消新增,字("取消新增"),"幽靈",假);
    } 否則 {
        按鈕樣(字("寫下下一步"),"加",左+10,尾上+8,寬-20,36,函式(){ 開始新增(本列["編號"]); },"幽靈",格式("新增卡片到「{0}」",[列["名稱"]]),假);
    }
};
變數 繪清單拖影=函式() {
    變數 列=引擎.找清單(取板(),清單拖曳[0]); 如果 (列==空值) { 回傳 空值; } 變數 寬=240.0d;
    陰影框(鼠橫-清單拖曳[1],鼠縱-清單拖曳[2],寬,64,12,8); 圓角框(鼠橫-清單拖曳[1],鼠縱-清單拖曳[2],寬,64,面板,薄荷,12);
    繪圖示("清單",鼠橫-清單拖曳[1]+22,鼠縱-清單拖曳[2]+32,16,薄荷); 短文(列["名稱"],鼠橫-清單拖曳[1]+40,鼠縱-清單拖曳[2]+37,寬-60,15,墨);
    變數 目標=計算清單位置(); 如果 (目標>=0) { 變數 橫=0.0d; 如果 (目標<長度(列幾何)) { 橫=列幾何[目標][1]-8; } 否則 { 變數 末=最後一個(列幾何); 橫=末[1]+末[3]+6; } 實框(橫,看板上緣,3,看板區[3],薄荷,1.5d); }
};
變數 計算清單位置=函式() { 迴圈 (變數 索=0;索<長度(列幾何);索++) { 變數 幾=列幾何[索]; 如果 (鼠橫<幾[1]+幾[3]/2) { 回傳 索; } } 回傳 長度(列幾何); };
變數 繪捲軸=函式(區,左,上,寬,高) {
    如果 (區["內容寬"]>區["視野寬"]) { 變數 塊=捲動.滑塊(區["內容寬"],區["視野寬"],區["橫"],寬); 實框(左,上+高+2,寬,8,透明(邊線,140),4); 實框(左+塊[0],上+高+2,塊[1],8,強邊線,4); 登記(左,上+高-2,寬,14,函式(){},字("水平捲動條"),"捲軸",[區,真,左,寬,塊[0],塊[1]]); }
    如果 (區["內容高"]>區["視野高"]) { 變數 塊=捲動.滑塊(區["內容高"],區["視野高"],區["縱"],高); 實框(左+寬+2,上,8,高,透明(邊線,140),4); 實框(左+寬+2,上+塊[0],8,塊[1],強邊線,4); 登記(左+寬-2,上,14,高,函式(){},字("垂直捲動條"),"捲軸",[區,假,上,高,塊[0],塊[1]]); }
};

# ── 排序 ──────────────────────────────────────────────────
# 合併排序，比較函式回傳負數表示甲在前；穩定排序。
變數 排序=函式(陣列值,比較) {
    變數 數=長度(陣列值); 如果 (數<2) { 回傳 陣列值; }
    變數 甲=陣列.克隆(陣列值); 變數 乙=陣列.克隆(陣列值); 變數 寬=1;
    迴圈 (變數 輪=0; 輪<40; 輪++) {
        如果 (寬>=數) { 中斷; }
        迴圈 (變數 左=0; 左<數; 左+=寬*2) {
            變數 中=最小(左+寬,數); 變數 右=最小(左+寬*2,數); 變數 子=左; 變數 丑=中; 變數 位=左;
            迴圈 (變數 次=0; 次<右-左; 次++) {
                變數 取左=假; 如果 (子<中) { 如果 (丑>=右) { 取左=真; } 否則 { 如果 (比較(甲[子],甲[丑])<=0) { 取左=真; } } }
                如果 (取左) { 乙[位]=甲[子]; 子++; } 否則 { 乙[位]=甲[丑]; 丑++; }
                位++;
            }
        }
        變數 暫=甲; 甲=乙; 乙=暫; 寬=寬*2;
    }
    回傳 甲;
};

# ── 表格視圖 ──────────────────────────────────────────────
變數 表格欄=函式() { 回傳 [["完成",48],["卡片",0],["清單",150],["標籤",170],["優先",96],["負責人",140],["到期日",130]]; };
變數 表格比較=函式(欄) {
    回傳 函式(甲,乙) {
        變數 甲卡=甲[0]; 變數 乙卡=乙[0]; 變數 結果=0;
        如果 (欄=="卡片") { 結果=引擎.比較文字(引擎.小寫(甲卡["名稱"]),引擎.小寫(乙卡["名稱"])); }
        否則如果 (欄=="清單") { 結果=甲[2]-乙[2]; }
        否則如果 (欄=="優先") { 結果=乙卡["優先"]-甲卡["優先"]; }
        否則如果 (欄=="完成") { 如果 (甲卡["完成"]!=乙卡["完成"]) { 如果 (甲卡["完成"]) { 結果=1; } 否則 { 結果=-1; } } }
        否則如果 (欄=="負責人") { 結果=引擎.比較文字(甲卡["負責人"],乙卡["負責人"]); 如果 (甲卡["負責人"]=="" && 乙卡["負責人"]!="") { 結果=1; } 如果 (乙卡["負責人"]=="" && 甲卡["負責人"]!="") { 結果=-1; } }
        否則如果 (欄=="標籤") { 變數 子=""; 變數 丑=""; 如果 (長度(甲卡["標籤"])>0) { 子=甲卡["標籤"][0]; } 如果 (長度(乙卡["標籤"])>0) { 丑=乙卡["標籤"][0]; } 結果=引擎.比較文字(子,丑); 如果 (子=="" && 丑!="") { 結果=1; } 如果 (丑=="" && 子!="") { 結果=-1; } }
        否則如果 (欄=="到期日") { 變數 子=引擎.日期數(甲卡["到期日"]); 變數 丑=引擎.日期數(乙卡["到期日"]); 如果 (子<=0) { 子=99999999; } 如果 (丑<=0) { 丑=99999999; } 結果=子-丑; }
        回傳 結果*表格排序[1];
    };
};
變數 表格資料=函式(列們) {
    如果 (表格暫存!=空值) { 回傳 表格暫存; } 變數 行們=[];
    迴圈 (變數 索=0; 索<長度(列們); 索++) { 變數 清單卡=篩卡(列們[索]); 迴圈 (變數 位=0; 位<長度(清單卡); 位++) { 行們=加入(行們,[清單卡[位],列們[索],索]); } }
    如果 (表格排序[0]!="") { 行們=排序(行們,表格比較(表格排序[0])); }
    表格暫存=行們; 回傳 行們;
};
變數 繪表格=函式(列們,左,上,寬,高) {
    變數 卡們=表格資料(列們); 變數 欄們=表格欄(); 變數 固定=0; 迴圈 (變數 索=0;索<長度(欄們);索++) { 固定+=欄們[索][1]; }
    變數 名寬=最大(280,寬-固定-12); 變數 總寬=固定+名寬+12; 變數 列高=48.0d; 變數 頭高=40.0d;
    捲動.設定(看板捲動,總寬,長度(卡們)*列高+頭高+20,寬,高); 設裁切([左,上,寬,高]);
    圓角框(左,上,寬,高,面板,邊線,12);
    變數 橫=左-看板捲動["橫"];
    # 列
    變數 起=畫.向下取整(最大(0,畫.向下取整(看板捲動["縱"]/列高)-1)); 變數 終=最小(長度(卡們),起+畫.向上取整(高/列高)+2);
    設裁切([左,上+頭高,寬,高-頭高]);
    迴圈 (變數 索=起; 索<終; 索++) {
        變數 卡=卡們[索][0]; 變數 列=卡們[索][1]; 變數 縱=上+頭高+索*列高-看板捲動["縱"]; 變數 本卡=卡;
        變數 鍵=區鍵("表格列",卡["名稱"],橫,縱); 如果 (滑過鍵==鍵 || 焦點卡==卡["編號"]) { 實框(橫+4,縱+2,總寬-8,列高-4,卡滑過,8); } 否則如果 (已選(卡["編號"])) { 實框(橫+4,縱+2,總寬-8,列高-4,透明(薄荷,30),8); }
        分隔線(橫+12,縱+列高,總寬-24);
        登記(橫,縱,總寬,列高,函式(){ 開詳情(本卡["編號"]); },卡["名稱"],"表格列",[卡["編號"],列["編號"]]);
        變數 位=橫+8; 變數 基=縱+列高/2+5;
        變數 完標=格式("切換完成：{0}",[卡["名稱"]]); 如果 (卡["完成"]) { 繪圖示("勾圓",位+20,縱+列高/2,18,成功); } 否則 { 繪圖示("圓",位+20,縱+列高/2,18,淡墨); } 登記(位+6,縱+10,28,28,函式(){ 切換完成(本卡["編號"]); },完標,"按鈕","提示"); 位+=48;
        變數 名色=墨; 如果 (卡["完成"]) { 名色=次墨; } 如果 (卡["封面"]>0) { 實框(位,縱+14,4,列高-28,色票[(卡["封面"]-1)%6],2); } 短文(卡["名稱"],位+12,基,名寬-24,14,名色); 位+=名寬;
        實框(位+4,縱+列高/2-4,8,8,色票[取板()["色系"]],2); 短文(列["名稱"],位+18,基,132,13,次墨); 位+=150;
        變數 晶位=位; 迴圈 (變數 標=0;標<長度(卡["標籤"]);標++) { 變數 需=量(卡["標籤"][標],11)+16; 如果 (晶位+需>位+164) { 顯示("+"+字數(長度(卡["標籤"])-標),晶位,基,11,次墨); 中斷; } 晶位+=晶片(卡["標籤"][標],標籤色(卡["標籤"][標]),晶位,縱+列高/2-10,11)+4; } 位+=170;
        變數 優圖="旗"; 變數 優色=淡墨; 如果 (卡["優先"]==2) { 優圖="實旗"; 優色=琥珀; } 如果 (卡["優先"]==0) { 優色=淡墨; }
        變數 優鍵=區鍵("按鈕",格式("優先程度：{0}",[卡["名稱"]]),位,縱+8); 如果 (滑過鍵==優鍵) { 實框(位,縱+8,88,32,面板,6); }
        繪圖示(優圖,位+14,縱+列高/2,14,優色); 顯示(優先名(卡["優先"]),位+28,基,13,次墨);
        變數 優位=位; 變數 優縱=縱; 登記(位,縱+8,88,32,函式(){ 優先選單([本卡["編號"]],[優位,優縱+8,88,32]); },格式("優先程度：{0}",[卡["名稱"]]),"按鈕",空值); 位+=96;
        如果 (卡["負責人"]!="") { 頭像(卡["負責人"],位,縱+列高/2-11,22); 短文(卡["負責人"],位+30,基,104,13,次墨); } 位+=140;
        變數 到=到期資訊(卡); 變數 到鍵=區鍵("按鈕",格式("到期日：{0}",[卡["名稱"]]),位,縱+8); 如果 (滑過鍵==到鍵) { 實框(位,縱+8,120,32,面板,6); }
        如果 (卡["到期日"]!="") { 繪圖示("時鐘",位+12,縱+列高/2,13,到[1]); 短文(卡["到期日"],位+24,基,92,13,到[1]); } 否則 { 繪圖示("日曆",位+12,縱+列高/2,13,淡墨); 顯示("—",位+26,基,13,淡墨); }
        變數 到位=位; 變數 到縱=縱; 登記(位,縱+8,120,32,函式(){ 開日期選擇([到位,到縱+8,120,32],本卡["到期日"],函式(值){ 執行改動(字("設定到期日"),函式(){ 本卡["到期日"]=值; }); }); },格式("到期日：{0}",[卡["名稱"]]),"按鈕",空值);
    }
    設裁切([左,上,寬,高]);
    # 固定標頭
    實框(左+1,上+1,寬-2,頭高-1,面板,12); 分隔線(左+1,上+頭高,寬-2);
    變數 位=橫+8; 變數 名稱們=[字("完成"),字("卡片"),字("清單"),字("標籤"),字("優先程度"),字("負責人"),字("到期日")];
    迴圈 (變數 索=0;索<長度(欄們);索++) {
        變數 欄=欄們[索][0]; 變數 欄寬=欄們[索][1]; 如果 (欄寬==0) { 欄寬=名寬; } 變數 欄名=名稱們[索]; 變數 本欄=欄;
        變數 標=格式("依「{0}」排序",[欄名]); 變數 鍵=區鍵("按鈕",標,位,上+4); 變數 色=淡墨; 如果 (表格排序[0]==欄) { 色=墨; } 如果 (滑過鍵==鍵) { 實框(位,上+4,欄寬-6,頭高-8,卡滑過,6); 色=墨; }
        如果 (索==0) { 繪圖示("勾",位+20,上+頭高/2,13,色); } 否則 { 顯示(欄名,位+12,上+25,12,色); }
        如果 (表格排序[0]==欄) { 變數 箭="向下"; 如果 (表格排序[1]<0) { 箭="向上"; } 變數 字寬=量(欄名,12); 如果 (索==0) { 字寬=10; } 繪圖示(箭,位+20+字寬,上+頭高/2,11,薄荷); }
        登記(位,上+4,欄寬-6,頭高-8,函式(){ 如果 (表格排序[0]==本欄) { 如果 (表格排序[1]>0) { 表格排序=[本欄,-1]; } 否則 { 表格排序=["",1]; } } 否則 { 表格排序=[本欄,1]; } 表格暫存=空值; },標,"按鈕",空值);
        位+=欄寬;
    }
    設裁切(空值);
    如果 (長度(卡們)==0) { 置中顯示(字("沒有符合的卡片"),左+寬/2,上+頭高+60,14,淡墨); }
    繪捲軸(看板捲動,左,上,寬,高);
};

# ── 日曆視圖 ──────────────────────────────────────────────
變數 月名=函式(月) { 如果 (英文()) { 回傳 ["January","February","March","April","May","June","July","August","September","October","November","December"][月-1]; } 回傳 字數(月)+" 月"; };
變數 月標題=函式(年,月) { 如果 (英文()) { 回傳 月名(月)+" "+字數(年); } 回傳 字數(年)+" 年 "+字數(月)+" 月"; };
變數 週名=函式(索) { 如果 (英文()) { 回傳 ["Sun","Mon","Tue","Wed","Thu","Fri","Sat"][索]; } 回傳 ["日","一","二","三","四","五","六"][索]; };
變數 移動月份=函式(差) { 變數 新=引擎.加月份(日曆月+"-01",差); 日曆月=片段(新,0,7); 清除篩選暫存(); 畫.重繪(); };
變數 繪日曆=函式(板,左,上,寬,高) {
    如果 (日曆月=="" || 長度(日曆月)!=7) { 日曆月=片段(資料()["今日"],0,7); }
    變數 年=字串.解析整數(片段(日曆月,0,4)); 變數 月=字串.解析整數(片段(日曆月,5,7));
    圖示鈕("向左",左,上,34,函式(){ 移動月份(-1); },字("上個月"),"一般",假); 圖示鈕("向右",左+40,上,34,函式(){ 移動月份(1); },字("下個月"),"一般",假);
    按鈕樣(字("今天"),"",左+84,上,0,34,函式(){ 日曆月=片段(資料()["今日"],0,7); 清除篩選暫存(); },"一般","",假);
    顯示(月標題(年,月),左+84+鈕寬(字("今天"),"",13)+16,上+25,20,墨);
    # 收集到期卡片
    變數 首日=引擎.日數(日曆月+"-01"); 變數 起日=首日-引擎.星期(首日); 變數 格們=陣列.建立(42,空值); 變數 無日=0; 變數 列們=可見清單(板);
    迴圈 (變數 索=0;索<42;索++) { 格們[索]=[]; }
    迴圈 (變數 索=0;索<長度(列們);索++) { 變數 卡們=篩卡(列們[索]); 迴圈 (變數 位=0;位<長度(卡們);位++) { 變數 卡=卡們[位]; 變數 天=引擎.日數(卡["到期日"]); 如果 (天<=0) { 無日++; } 否則 { 變數 格=天-起日; 如果 (格>=0 && 格<42) { 格們[格]=加入(格們[格],[卡,列們[索]]); } } } }
    右顯示(格式("{0} 張卡片沒有到期日",[無日]),左+寬,上+23,12,淡墨);
    變數 格寬=寬/7.0d; 變數 頂=上+48; 變數 格高=(高-48-28)/6.0d; 變數 今=引擎.日數(資料()["今日"]);
    迴圈 (變數 索=0;索<7;索++) { 小標(週名(索),左+索*格寬+10,頂+16); }
    頂+=26; 圓角框(左,頂,寬,格高*6,面板,邊線,12);
    迴圈 (變數 索=0;索<42;索++) {
        變數 行=索/7; 變數 欄=索%7; 變數 橫=左+欄*格寬; 變數 縱=頂+行*格高; 變數 天=起日+索; 變數 日期=引擎.日數轉日期(天); 變數 本日期=日期;
        變數 本月=片段(日期,0,7)==日曆月; 變數 鍵=區鍵("日曆格",日期,橫,縱);
        如果 (日曆拖曳日==日期) { 實框(橫+2,縱+2,格寬-4,格高-4,透明(薄荷,50),8); } 否則如果 (滑過鍵==鍵) { 實框(橫+2,縱+2,格寬-4,格高-4,卡滑過,8); }
        如果 (欄>0) { 畫.描邊(邊線); 畫.線段(橫,縱,橫,縱+格高); 畫.停用描邊(); } 如果 (行>0) { 分隔線(橫,縱,格寬); }
        登記(橫,縱,格寬,格高,函式(){},日期,"日曆格",[日期]);
        變數 數色=次墨; 如果 (!本月) { 數色=淡墨; } 變數 日字=字數(天-引擎.日數(片段(日期,0,8)+"01")+1);
        如果 (天==今) { 實框(橫+6,縱+6,24,22,薄荷,11); 置中顯示(日字,橫+18,縱+22,12,強調字); } 否則 { 顯示(日字,橫+10,縱+22,12,數色); }
        變數 項們=格們[索]; 變數 可容=畫.向下取整(最大(0,(格高-34)/24)); 變數 位=縱+32;
        迴圈 (變數 位索=0;位索<長度(項們);位索++) {
            如果 (位索>=可容 && 長度(項們)>可容) {
                變數 餘=長度(項們)-位索; 變數 本項們=項們; 變數 標=格式("另外 {0} 張",[餘]); 變數 位置=[橫+4,位,格寬-8,22];
                按鈕樣(標,"",橫+4,位,格寬-8,22,函式(){ 變數 選=[]; 迴圈 (變數 子=0;子<長度(本項們);子++) { 變數 卡號=本項們[子][0]["編號"]; 選=加入(選,項(本項們[子][0]["名稱"],"卡片",函式(){ 開詳情(卡號); })); } 彈出(位置,選,280); },"幽靈",標+" "+本日期,假);
                中斷;
            }
            變數 卡=項們[位索][0]; 變數 列=項們[位索][1]; 變數 本卡=卡; 變數 標=格式("卡片：{0}",[卡["名稱"]]); 變數 卡鍵=區鍵("卡片",標,橫+4,位);
            變數 底色=卡底; 如果 (滑過鍵==卡鍵) { 底色=卡滑過; }
            如果 (卡片拖曳!=空值 && 拖曳中) { 如果 (卡片拖曳[0]==卡["編號"]) { 底色=透明(卡底,90); } }
            圓角框(橫+4,位,格寬-8,22,底色,邊線,5); 變數 條色=色票[板["色系"]]; 如果 (卡["封面"]>0) { 條色=色票[(卡["封面"]-1)%6]; } 實框(橫+4,位+3,3,16,條色,1.5d);
            變數 名色=墨; 如果 (卡["完成"]) { 名色=淡墨; } 短文(卡["名稱"],橫+12,位+16,格寬-24,11,名色);
            登記(橫+4,位,格寬-8,22,函式(){ 開詳情(本卡["編號"]); },標,"卡片",[卡["編號"],列["編號"]]);
            位+=24;
        }
    }
    如果 (卡片拖曳!=空值 && 拖曳中) { 變數 拖=拖曳卡片(); 如果 (拖!=空值) { 陰影框(鼠橫-60,鼠縱-12,200,26,6,6); 圓角框(鼠橫-60,鼠縱-12,200,26,卡底,薄荷,6); 短文(拖["名稱"],鼠橫-50,鼠縱+5,180,12,墨); } }
};
# 日曆空白格的右鍵：新增當天到期的卡片。
變數 日曆新增=函式(日期) {
    變數 板=取板(); 變數 列們=可見清單(板); 如果 (長度(列們)==0) { 回傳 空值; }
    表單(格式("新增 {0} 到期的卡片",[日期]),字("卡片標題"),"",函式(名){ 變數 卡=加卡(列們[0],名,假); 如果 (卡!=空值) { 卡["到期日"]=日期; 清除篩選暫存(); } });
};

# ── 卡片詳情 ──────────────────────────────────────────────
變數 步驟編輯=空值; 變數 步驟新增=-1; 變數 步驟新文字=""; 變數 筆記草稿=""; 變數 步驟幾何=[];
變數 附件總量=函式() { 變數 數=0; 迴圈 (變數 區=0; 區<長度(資料()["工作區"]); 區++) { 變數 工作=資料()["工作區"][區]; 迴圈 (變數 板=0; 板<長度(工作["看板"]); 板++) { 變數 板體=工作["看板"][板]; 迴圈 (變數 列=0; 列<長度(板體["清單"]); 列++) { 變數 清單=板體["清單"][列]; 迴圈 (變數 卡=0; 卡<長度(清單["卡片"]); 卡++) { 變數 卡體=清單["卡片"][卡]; 迴圈 (變數 附=0; 附<長度(卡體["附件"]); 附++) { 數+=卡體["附件"][附]["大小"]; } } } } } 回傳 數; };
變數 添加附件=函式(卡) {
    變數 資源=介面.選擇附件(字("加入附件（每個最多 256 KB）")); 如果 (長度(資源)==0) { 回傳 空值; }
    變數 加入數=0; 變數 太大=假; 變數 超額=假;
    執行改動(字("加入附件"),函式(){
        迴圈 (變數 索=0; 索<長度(資源); 索++) { 變數 檔=資源[索]; 如果 (介面.資源大小(檔)>262144) { 太大=真; } 否則 { 變數 位元=檔案.讀取位元組(檔); 如果 (附件總量()+長度(位元)<=附件預算) { 卡["附件"]=加入(卡["附件"],附件庫.建立(介面.資源名稱(檔),位元)); 加入數++; } 否則 { 超額=真; } } }
        如果 (加入數==0) { 回傳 假; }
    });
    如果 (太大) { 提示(字("附件太大：每個最多 256 KB。"),"警告","",空值); } 如果 (超額) { 提示(字("附件總量已達 4 MB 上限。"),"警告","",空值); }
    如果 (加入數>0) { 簡提示(格式("已加入 {0} 個附件。",[加入數])); }
};
變數 標籤加入選單=函式(卡,錨) {
    變數 全=引擎.收集(取板(),"標籤"); 變數 項目=[];
    迴圈 (變數 索=0;索<長度(全);索++) { 變數 名=全[索][0]; 變數 有=引擎.標籤含(卡["標籤"],名); 項目=加入(項目,色項(名,標籤色(名),有,函式(){ 執行改動(字("編輯標籤"),函式(){ 如果 (引擎.標籤含(卡["標籤"],名)) { 變數 位=陣列.尋找(卡["標籤"],名); 卡["標籤"]=引擎.去除(卡["標籤"],位); } 否則 { 卡["標籤"]=加入(卡["標籤"],名); } }); })); }
    如果 (長度(全)>0) { 項目=加入(項目,分隔()); }
    項目=加入(項目,項(字("建立新標籤…"),"加",函式(){ 表單(字("新增標籤"),字("標籤名稱"),"",函式(值){ 如果 (!引擎.標籤含(卡["標籤"],值)) { 執行改動(字("新增標籤"),函式(){ 卡["標籤"]=加入(卡["標籤"],值); }); } }); }));
    彈出(錨,項目,260);
};
變數 側欄標題=函式(文字,橫,縱) { 小標(文字,橫,縱); };
變數 繪詳情=函式(左,上,寬,高) {
    變數 卡=取卡(); 如果 (卡==空值) { 關對話(); 回傳 空值; } 變數 板=取板(); 變數 找=引擎.找卡片(板,詳情卡); 變數 列=找[0]; 變數 本卡=卡;
    # 標頭
    繪圖示("卡片",左+30,上+30,18,薄荷);
    變數 在字=格式("在「{0}」清單中",[列["名稱"]]); 按鈕樣(在字,"",左+44,上+14,0,32,函式(){ 卡片移動(本卡["編號"]); },"幽靈",字("移動卡片"),假);
    圖示鈕("關閉",左+寬-50,上+12,36,關對話,字("關閉詳情"),"幽靈",假);
    圖示鈕("更多",左+寬-90,上+12,36,函式(){ 卡片選單(本卡["編號"]); },字("卡片動作"),"幽靈",假);
    輸入欄("卡片名稱",卡["名稱"],左+20,上+52,寬-40,44,函式(值){ 本卡["名稱"]=值; 延後儲存(); },{"無框":真,"大小":22,"說明":字("編輯卡片名稱"),"標籤":字("卡片名稱")});
    變數 內容上=上+106; 變數 內容高=高-118; 變數 內左=左+24; 變數 內寬=寬-48;
    分隔線(左+1,內容上-6,寬-2);
    變數 雙欄=內寬>=700; 變數 主寬=內寬; 變數 側寬=內寬; 如果 (雙欄) { 側寬=250.0d; 主寬=內寬-側寬-28; }
    設裁切([左+1,內容上,寬-2,內容高]); 變數 起縱=內容上+12-詳情捲動["縱"]; 步驟幾何=[];
    變數 側左=內左; 變數 主左=內左; 變數 主縱=起縱; 變數 側縱=起縱;
    如果 (雙欄) { 側左=內左+主寬+28; }
    # ── 側欄 ──
    變數 側終=繪詳情側欄(卡,列,側左,側縱,側寬);
    如果 (!雙欄) { 主縱=側終+24; }
    # ── 主欄 ──
    變數 縱=主縱;
    繪圖示("筆記",主左+8,縱+10,16,次墨); 顯示(字("說明"),主左+26,縱+15,15,墨); 縱+=28;
    變數 說高=輸入欄("卡片說明",卡["說明"],主左,縱,主寬,94,函式(值){ 本卡["說明"]=值; 延後儲存(); },{"多行":真,"最小行":3,"最多行":16,"占位":字("加上更詳細的說明…"),"說明":字("編輯說明"),"標籤":字("說明與背景")});
    縱+=說高+26;
    # 檢查表
    繪圖示("檢查表",主左+8,縱+10,16,次墨); 顯示(字("檢查表"),主左+26,縱+15,15,墨);
    按鈕樣(字("新增檢查表"),"加",主左+主寬-鈕寬(字("新增檢查表"),"加",13),縱-4,0,30,函式(){ 表單(字("新增檢查表"),字("檢查表名稱"),字("待辦步驟"),函式(值){ 執行改動(字("新增檢查表"),函式(){ 本卡["檢查表"]=加入(本卡["檢查表"],{"名稱":值,"項目":[]}); }); 開始步驟(長度(本卡["檢查表"])-1); }); },"一般","",假);
    縱+=36;
    如果 (長度(卡["檢查表"])==0) { 顯示(字("把大任務拆成可以勾選的步驟。"),主左+26,縱+12,13,淡墨); 縱+=26; }
    迴圈 (變數 表索=0; 表索<長度(卡["檢查表"]); 表索++) { 縱=繪檢查表(卡,表索,主左,縱,主寬); }
    縱+=14;
    # 附件
    繪圖示("迴紋針",主左+8,縱+10,16,次墨); 顯示(字("附件"),主左+26,縱+15,15,墨);
    按鈕樣(字("加入附件"),"加",主左+主寬-鈕寬(字("加入附件"),"加",13),縱-4,0,30,函式(){ 添加附件(本卡); },"一般","",假); 縱+=36;
    如果 (長度(卡["附件"])==0) { 顯示(字("附件以加入時的內容保存，每個最多 256 KB。"),主左+26,縱+12,13,淡墨); 縱+=26; }
    迴圈 (變數 索=0; 索<長度(卡["附件"]); 索++) {
        變數 附位=索; 變數 附=卡["附件"][索]; 圓角框(主左,縱,主寬,44,卡底,邊線,8);
        實框(主左+8,縱+8,28,28,透明(薄荷,40),6); 繪圖示("迴紋針",主左+22,縱+22,15,薄荷);
        短文(附["名稱"],主左+46,縱+20,主寬-200,13,墨); 顯示(大小文字(附["大小"]),主左+46,縱+36,11,淡墨);
        按鈕樣(字("另存"),"儲存",主左+主寬-150,縱+6,0,32,函式(){ 變數 資源=介面.下載附件(字("儲存附件"),附["名稱"]); 如果 (資源!=空值) { 變數 位元=附件庫.讀取(附); 如果 (位元!=空值) { 檔案.儲存位元組(資源,位元,!是網頁); } 否則 { 提示(字("找不到附件檔案，請由完整備份恢復。"),"錯誤","",空值); } } },"幽靈","",假);
        圖示鈕("垃圾桶",主左+主寬-42,縱+6,32,函式(){ 執行改動(字("移除附件"),函式(){ 本卡["附件"]=引擎.去除(本卡["附件"],附位); }); 提示(字("已移除附件。"),"資訊",字("復原"),函式(){ 復原操作(); }); },格式("移除「{0}」",[附["名稱"]]),"幽靈",假);
        縱+=52;
    }
    縱+=14;
    # 筆記
    繪圖示("筆記",主左+8,縱+10,16,次墨); 顯示(字("個人筆記"),主左+26,縱+15,15,墨); 縱+=28;
    變數 草高=輸入欄("筆記草稿",筆記草稿,主左,縱,主寬,60,函式(值){ 筆記草稿=值; },{"多行":真,"最小行":2,"最多行":8,"占位":字("寫下想法或進度…"),"標籤":字("新筆記")});
    縱+=草高+8;
    如果 (整潔(筆記草稿)!="") { 按鈕樣(字("儲存筆記"),"勾",主左,縱,0,32,函式(){ 變數 文=整潔(筆記草稿); 執行改動(字("新增筆記"),函式(){ 本卡["留言"]=加入(本卡["留言"],文); }); 筆記草稿=""; 結束編輯(); },"主要","",假); 縱+=42; }
    迴圈 (變數 索=長度(卡["留言"])-1; 索>=0; 索-=1) {
        變數 記位=索; 變數 文=卡["留言"][索]; 變數 行們=分行(文,主寬-70,13); 變數 行數=最小(長度(行們),8); 變數 框高=行數*20+22;
        圓角框(主左,縱,主寬,框高,卡底,邊線,8); 段落行(文,主左+14,縱+6,主寬-70,13,墨,行數,20);
        圖示鈕("更多",主左+主寬-40,縱+6,30,函式(){ 右鍵選單([項(字("編輯"),"編輯",函式(){ 多行表單(字("編輯筆記"),字("內容"),本卡["留言"][記位],函式(值){ 執行改動(字("編輯筆記"),函式(){ 本卡["留言"][記位]=值; }); }); }),項(字("複製文字"),"複製",函式(){ 介面.寫剪貼簿(本卡["留言"][記位]); }),險項(字("刪除"),"垃圾桶",函式(){ 執行改動(字("刪除筆記"),函式(){ 本卡["留言"]=引擎.去除(本卡["留言"],記位); }); })]); },字("筆記動作"),"幽靈",假);
        縱+=框高+8;
    }
    變數 總高=最大(縱,側終)-起縱+30;
    捲動.設定(詳情捲動,內寬,總高,內寬,內容高); 設裁切(空值); 登記區("詳情",[左,內容上,寬,內容高]);
    如果 (詳情捲動["內容高"]>內容高) { 變數 塊=捲動.滑塊(詳情捲動["內容高"],內容高,詳情捲動["縱"],內容高-8); 實框(左+寬-9,內容上+4+塊[0],4,塊[1],強邊線,2); 登記(左+寬-12,內容上,12,內容高,函式(){},字("垂直捲動條"),"捲軸",[詳情捲動,假,內容上+4,內容高-8,塊[0],塊[1]]); }
    如果 (步驟拖曳!=空值) { 如果 (步驟拖曳[3]) { 繪步驟拖影(卡); } }
};
變數 繪詳情側欄=函式(卡,列,左,縱,寬) {
    變數 本卡=卡; 變數 板=取板();
    # 完成
    變數 完字=字("標記完成"); 變數 完圖="圓"; 變數 完樣="一般"; 如果 (卡["完成"]) { 完字=字("已完成"); 完圖="勾圓"; 完樣="選中"; }
    按鈕樣(完字,完圖,左,縱,寬,38,函式(){ 切換完成(本卡["編號"]); },完樣,字("切換完成"),假); 縱+=46;
    變數 注字=字("關注"); 變數 注圖="眼"; 變數 注樣="一般"; 如果 (卡["關注"]) { 注字=字("已關注"); 注圖="實眼"; 注樣="選中"; }
    按鈕樣(注字,注圖,左,縱,寬,36,函式(){ 執行改動(字("切換關注"),函式(){ 本卡["關注"]=!本卡["關注"]; }); },注樣,字("切換關注"),假); 縱+=52;
    # 屬性
    側欄標題(字("優先程度"),左,縱); 縱+=10;
    變數 優圖="旗"; 如果 (卡["優先"]==2) { 優圖="實旗"; } 變數 優位=縱;
    按鈕樣(優先名(卡["優先"]),優圖,左,縱,寬,34,函式(){ 優先選單([本卡["編號"]],[左,優位,寬,34]); },"一般",字("優先程度"),假); 縱+=46;
    側欄標題(字("日期"),左,縱); 縱+=10;
    變數 半=(寬-8)/2; 變數 開字=卡["開始日"]; 如果 (開字=="") { 開字=字("開始日"); } 變數 到字=卡["到期日"]; 如果 (到字=="") { 到字=字("到期日"); }
    變數 日縱=縱;
    按鈕樣(開字,"日曆",左,縱,半,34,函式(){ 開日期選擇([左,日縱,半,34],本卡["開始日"],函式(值){ 執行改動(字("設定開始日"),函式(){ 本卡["開始日"]=值; }); }); },"一般",字("開始日"),假);
    變數 到=到期資訊(卡); 變數 到樣="一般"; 如果 (到[1]==珊瑚) { 到樣="危險"; }
    按鈕樣(到字,"時鐘",左+半+8,縱,半,34,函式(){ 開日期選擇([左+半+8,日縱,半,34],本卡["到期日"],函式(值){ 執行改動(字("設定到期日"),函式(){ 本卡["到期日"]=值; }); }); },到樣,字("到期日"),假); 縱+=40;
    如果 (到[0]!="") { 顯示(到[0],左+4,縱+12,12,到[1]); 縱+=20; }
    變數 重位=縱; 按鈕樣(重複名(卡["重複"]),"重複",左,縱,寬,34,函式(){ 變數 項目=[]; 迴圈 (變數 索=0;索<4;索++) { 變數 值=索; 項目=加入(項目,勾項(重複名(索),本卡["重複"]==索,函式(){ 執行改動(字("設定重複"),函式(){ 本卡["重複"]=值; }); })); } 彈出([左,重位,寬,34],項目,寬); },"一般",字("重複"),假); 縱+=40;
    如果 (卡["重複"]>0 && 卡["到期日"]=="") { 段落(字("設定到期日後，完成時會自動建立下一次。"),左+4,縱-2,寬-8,36,11,淡墨); 縱+=34; }
    縱+=8; 側欄標題(字("負責人（個人註記）"),左,縱); 縱+=10;
    輸入欄("卡片負責人",卡["負責人"],左,縱,寬,36,函式(值){ 本卡["負責人"]=值; 延後儲存(); },{"圖示":"人","占位":字("誰負責？"),"說明":字("編輯負責人"),"標籤":字("負責人（個人註記）")}); 縱+=48;
    側欄標題(字("標籤"),左,縱); 縱+=10;
    變數 位=左; 變數 行縱=縱;
    迴圈 (變數 索=0;索<長度(卡["標籤"]);索++) {
        變數 標位=索; 變數 名=卡["標籤"][索]; 變數 需=量(名,12)+34; 如果 (位+需>左+寬) { 位=左; 行縱+=30; }
        移除晶片(名,標籤色(名),位,行縱+2,12,函式(){ 執行改動(字("移除標籤"),函式(){ 本卡["標籤"]=引擎.去除(本卡["標籤"],標位); }); },格式("移除標籤「{0}」",[名]));
        位+=需+6;
    }
    變數 加寬=鈕寬(字("標籤"),"加",12); 如果 (位+加寬>左+寬) { 位=左; 行縱+=30; } 變數 加位=位; 變數 加縱=行縱;
    按鈕樣(字("標籤"),"加",位,行縱,加寬,26,函式(){ 標籤加入選單(本卡,[加位,加縱,加寬,26]); },"幽靈",字("新增標籤"),假);
    縱=行縱+40;
    側欄標題(字("封面"),左,縱); 縱+=12;
    色塊鈕(邊線,左+2,縱,22,卡["封面"]==0,函式(){ 執行改動(字("設定封面"),函式(){ 本卡["封面"]=0; }); },字("無封面"));
    迴圈 (變數 索=0;索<6;索++) { 變數 值=索+1; 色塊鈕(色票[索],左+34+索*32,縱,22,卡["封面"]==值,函式(){ 執行改動(字("設定封面"),函式(){ 本卡["封面"]=值; }); },格式("封面：{0}",[色名(索)])); }
    縱+=40;
    側欄標題(字("動作"),左,縱); 縱+=10;
    按鈕樣(字("移動"),"移動",左,縱,寬,34,函式(){ 卡片移動(本卡["編號"]); },"一般","",假); 縱+=40;
    按鈕樣(字("複製"),"複製",左,縱,寬,34,函式(){ 變數 新=複製一張(本卡["編號"]); 如果 (新!=空值) { 開詳情(新["編號"]); } },"一般",字("建立複本"),假); 縱+=40;
    按鈕樣(字("封存卡片"),"封存",左,縱,寬,34,函式(){ 關全部對話(); 封存卡片們([本卡["編號"]]); },"危險","",假); 縱+=40;
    回傳 縱;
};
變數 繪檢查表=函式(卡,表索,左,縱,寬) {
    變數 表=卡["檢查表"][表索]; 變數 本卡=卡; 變數 本表=表; 變數 本表索=表索; 變數 項們=表["項目"];
    變數 完=0; 迴圈 (變數 索=0;索<長度(項們);索++) { 如果 (項們[索]["完成"]) { 完++; } } 變數 比=0.0d; 如果 (長度(項們)>0) { 比=完*1.0d/長度(項們); }
    短文(表["名稱"],左+4,縱+16,寬-160,14,墨); 顯示(字數(畫.四捨五入(比*100))+"%",左+寬-110,縱+16,12,次墨);
    圖示鈕("更多",左+寬-36,縱-2,30,函式(){ 右鍵選單([項(字("重新命名"),"編輯",函式(){ 表單(字("檢查表名稱"),字("名稱"),本表["名稱"],函式(值){ 執行改動(字("重新命名檢查表"),函式(){ 本表["名稱"]=值; }); }); }),項(字("隱藏已完成項目"),"眼",函式(){ 執行改動(字("清除已完成項目"),函式(){ 變數 留=[]; 迴圈 (變數 索=0;索<長度(本表["項目"]);索++) { 如果 (!本表["項目"][索]["完成"]) { 留=加入(留,本表["項目"][索]); } } 如果 (長度(留)==長度(本表["項目"])) { 回傳 假; } 本表["項目"]=留; }); }),險項(字("刪除檢查表"),"垃圾桶",函式(){ 執行改動(字("刪除檢查表"),函式(){ 本卡["檢查表"]=引擎.去除(本卡["檢查表"],本表索); }); 提示(字("已刪除檢查表。"),"資訊",字("復原"),函式(){ 復原操作(); }); })]); },格式("檢查表動作：{0}",[表["名稱"]]),"幽靈",假);
    縱+=26; 進度條(左+4,縱,寬-8,5,比,成功); 縱+=14;
    迴圈 (變數 索=0;索<長度(項們);索++) {
        變數 項位=索; 變數 項目=項們[索]; 變數 列高=36.0d; 變數 本項=項目;
        變數 編輯中=假; 如果 (步驟編輯!=空值) { 如果 (步驟編輯[0]==表索 && 步驟編輯[1]==索) { 編輯中=真; } }
        變數 拖中=假; 如果 (步驟拖曳!=空值) { 如果 (步驟拖曳[3] && 步驟拖曳[0]==表索 && 步驟拖曳[1]==索) { 拖中=真; } }
        步驟幾何=加入(步驟幾何,[表索,索,縱,列高]);
        如果 (拖中) { 畫.停用填色(); 畫.描邊(強邊線); 畫.描邊粗細(1); 畫.矩形(左,縱+2,寬,列高-4,6); 畫.停用描邊(); 縱+=列高; } 否則 {
        如果 (編輯中) {
            輸入欄("編輯步驟",項目["名稱"],左+30,縱+1,寬-30,34,函式(值){ 本項["名稱"]=值; 延後儲存(); },{"說明":字("編輯步驟"),"標籤":字("步驟內容"),"提交":函式(){ 步驟編輯=空值; 結束編輯(); },"取消":函式(){ 步驟編輯=空值; 結束編輯(); }});
            縱+=列高+2;
        } 否則 {
            變數 標=格式("步驟：{0}",[項目["名稱"]]); 變數 鍵=區鍵("步驟",標,左,縱); 如果 (滑過鍵==鍵) { 實框(左,縱+2,寬,列高-4,卡滑過,6); 繪圖示("握把",左+10,縱+列高/2,13,淡墨); }
            登記(左+20,縱+2,寬-60,列高-4,函式(){ 步驟編輯=[本表索,項位]; 聚焦("編輯步驟",本項["名稱"],函式(值){ 本項["名稱"]=值; 延後儲存(); },假,字("編輯步驟")); },標,"步驟",[表索,索]);
            登記(左,縱+2,20,列高-4,函式(){},格式("拖曳步驟：{0}",[項目["名稱"]]),"步驟握把",[表索,索]);
            如果 (項目["完成"]) { 繪圖示("勾圓",左+34,縱+列高/2,17,成功); } 否則 { 繪圖示("圓",左+34,縱+列高/2,17,次墨); }
            登記(左+22,縱+6,26,24,函式(){ 執行改動(字("勾選步驟"),函式(){ 本項["完成"]=!本項["完成"]; }); },格式("勾選步驟：{0}",[項目["名稱"]]),"按鈕",空值);
            變數 名色=墨; 如果 (項目["完成"]) { 名色=淡墨; } 短文(項目["名稱"],左+52,縱+列高/2+5,寬-100,13,名色);
            如果 (項目["完成"]) { 實框(左+52,縱+列高/2,最小(寬-100,量(項目["名稱"],13)),1,淡墨,0); }
            如果 (滑過鍵==鍵) { 圖示鈕("更多",左+寬-36,縱+4,28,函式(){ 步驟選單(本卡,本表索,項位); },格式("步驟動作：{0}",[項目["名稱"]]),"幽靈",假); }
            縱+=列高;
        }
        }
    }
    如果 (步驟新增==表索) {
        輸入欄("新步驟",步驟新文字,左+30,縱+4,寬-30,36,函式(值){ 步驟新文字=值; },{"占位":字("新增項目，按換行鍵繼續"),"標籤":字("新步驟"),"提交":提交步驟,"取消":取消步驟});
        縱+=46;
    } 否則 {
        按鈕樣(字("新增項目"),"加",左+26,縱+4,0,30,函式(){ 開始步驟(本表索); },"幽靈",格式("新增項目到「{0}」",[表["名稱"]]),假); 縱+=40;
    }
    回傳 縱+10;
};
# 檢查表的連續新增：換行鍵加入項目並保留輸入框。
變數 開始步驟=函式(表索) { 步驟新增=表索; 步驟新文字=""; 聚焦("新步驟","",函式(值){ 步驟新文字=值; },假,""); 編輯提交=提交步驟; 編輯取消=取消步驟; 畫.重繪(); };
變數 提交步驟=函式() {
    變數 卡=取卡(); 如果 (卡==空值 || 步驟新增<0) { 取消步驟(); 回傳 空值; } 變數 表=卡["檢查表"][步驟新增]; 如果 (表==空值) { 取消步驟(); 回傳 空值; }
    變數 名=整潔(步驟新文字); 如果 (名!="") { 執行改動(字("新增步驟"),函式(){ 表["項目"]=加入(表["項目"],{"名稱":名,"完成":假}); }); }
    變數 號=步驟新增; 結束編輯(); 開始步驟(號);
};
變數 取消步驟=函式() { 步驟新增=-1; 步驟新文字=""; 結束編輯(); 畫.重繪(); };
變數 步驟選單=函式(卡,表索,項位) {
    變數 表=卡["檢查表"][表索]; 變數 本項=表["項目"][項位];
    右鍵選單([
        項(字("編輯文字"),"編輯",函式(){ 步驟編輯=[表索,項位]; 聚焦("編輯步驟",本項["名稱"],函式(值){ 本項["名稱"]=值; 延後儲存(); },假,字("編輯步驟")); }),
        項(字("向上移動"),"向上",函式(){ 執行改動(字("移動步驟"),函式(){ 如果 (項位==0) { 回傳 假; } 表["項目"]=引擎.換位(表["項目"],項位,項位-1); }); }),
        項(字("向下移動"),"向下",函式(){ 執行改動(字("移動步驟"),函式(){ 如果 (項位>=長度(表["項目"])-1) { 回傳 假; } 表["項目"]=引擎.換位(表["項目"],項位,項位+1); }); }),
        項(字("轉成卡片"),"卡片",函式(){ 變數 找=引擎.找卡片(取板(),卡["編號"]); 如果 (找==空值) { 回傳 空值; } 執行改動(字("轉成卡片"),函式(){ 變數 新=引擎.插入卡片(找[0],本項["名稱"],找[2]+1); 表["項目"]=引擎.去除(表["項目"],項位); }); 簡提示(字("已在同一份清單建立卡片。")); }),
        分隔(),
        險項(字("刪除步驟"),"垃圾桶",函式(){ 執行改動(字("刪除步驟"),函式(){ 表["項目"]=引擎.去除(表["項目"],項位); }); })
    ]);
};
變數 步驟放置位=函式() {
    如果 (步驟拖曳==空值) { 回傳 -1; } 變數 放=-1; 變數 最後=-1;
    迴圈 (變數 索=0;索<長度(步驟幾何);索++) { 變數 幾=步驟幾何[索]; 如果 (幾[0]==步驟拖曳[0]) { 最後=幾[1]; 如果 (放<0 && 鼠縱<幾[2]+幾[3]/2) { 放=幾[1]; } } }
    如果 (放<0) { 放=最後+1; } 回傳 放;
};
變數 繪步驟拖影=函式(卡) {
    變數 表=卡["檢查表"][步驟拖曳[0]]; 如果 (表==空值) { 回傳 空值; } 變數 項目=表["項目"][步驟拖曳[1]]; 如果 (項目==空值) { 回傳 空值; }
    變數 放=步驟放置位(); 迴圈 (變數 索=0;索<長度(步驟幾何);索++) { 變數 幾=步驟幾何[索]; 如果 (幾[0]==步驟拖曳[0] && 幾[1]==放) { 實框(步驟拖曳[4],幾[2]-1,步驟拖曳[5],2,薄荷,1); } 如果 (幾[0]==步驟拖曳[0] && 幾[1]==放-1 && 放>=長度(表["項目"])) { 實框(步驟拖曳[4],幾[2]+幾[3]-1,步驟拖曳[5],2,薄荷,1); } }
    陰影框(步驟拖曳[4],鼠縱-16,步驟拖曳[5],32,6,6); 圓角框(步驟拖曳[4],鼠縱-16,步驟拖曳[5],32,卡底,薄荷,6); 繪圖示("握把",步驟拖曳[4]+12,鼠縱,13,薄荷); 短文(項目["名稱"],步驟拖曳[4]+28,鼠縱+5,步驟拖曳[5]-40,13,墨);
};

# ── 頁面共用 ──────────────────────────────────────────────
變數 頁首=函式(圖示名,眉,標題,說明,左,上,寬) {
    實框(左,上+4,44,44,透明(薄荷,36),12); 繪圖示(圖示名,左+22,上+26,22,薄荷);
    小標(眉,左+60,上+14); 顯示(標題,左+60,上+44,26,墨); 短文(說明,左+60,上+68,寬-70,13,次墨);
};
變數 頁面區=函式() { 變數 左=側欄寬+32; 變數 寬=最小(版寬-左-32,1100); 如果 (手機版) { 左=16; 寬=版寬-32; } 回傳 [左,頂欄高+24,寬,版高-頂欄高-狀態列高-24]; };

# ── 範本 ──────────────────────────────────────────────────
變數 繪範本=函式() {
    變數 區=頁面區(); 變數 左=區[0]; 變數 上=區[1]; 變數 寬=區[2];
    頁首("範本",字("從一個好的起點出發"),字("範本，替你留住好方法"),字("預設範例與你的自訂流程，都能一鍵建立獨立看板。"),左,上,寬);
    如果 (取板()!=空值 && 寬>620) { 變數 鈕=鈕寬(字("把目前看板存成範本"),"範本",13); 圖示按鈕(字("把目前看板存成範本"),"範本",左+寬-鈕,上+12,鈕,函式(){ 變數 板=取板(); 表單(字("保存範本"),字("範本名稱"),板["名稱"],函式(值){ 執行改動(字("保存範本"),函式(){ 引擎.存範本(板,值); }); 簡提示(字("範本已加入範本庫。")); }); },"一般"); }
    變數 範們=資料()["範本"]; 變數 格上=上+96; 變數 高=區[3]-96; 變數 欄數=畫.向下取整(最大(1,畫.向下取整((寬+18)/320))); 變數 欄寬=(寬-18*(欄數-1))/欄數;
    捲動.設定(頁面捲動,寬,畫.向上取整(長度(範們)/(欄數*1.0d))*258+20,寬,高); 設裁切([左,格上,寬+12,高]); 登記區("頁面",[左,格上,寬,高]);
    迴圈 (變數 索=0; 索<長度(範們); 索++) {
        變數 範索=索; 變數 範=範們[索]; 變數 橫=左+(索%欄數)*(欄寬+18); 變數 縱=格上+(索/欄數)*258-頁面捲動["縱"];
        如果 (縱+240>格上 && 縱<格上+高) {
            變數 板=範["看板"]; 陰影框(橫,縱,欄寬,240,14,2); 圓角框(橫,縱,欄寬,240,面板,邊線,14);
            # 迷你預覽
            實框(橫+14,縱+14,欄寬-28,88,透明(色票[板["色系"]],30),10); 變數 列數=最小(4,長度(板["清單"])); 變數 迷寬=(欄寬-48-8*(列數-1))/最大(1,列數);
            迴圈 (變數 列=0; 列<列數; 列++) { 變數 列橫=橫+24+列*(迷寬+8); 實框(列橫,縱+24,迷寬,68,卡底,6); 實框(列橫+6,縱+30,迷寬*0.5d,3,色票[(索+列)%6],1.5d); 變數 卡數=最小(3,長度(板["清單"][列]["卡片"])); 迴圈 (變數 卡=0; 卡<卡數; 卡++) { 實框(列橫+6,縱+40+卡*16,迷寬-12,11,邊線,3); } }
            短文(範["名稱"],橫+18,縱+128,欄寬-36,17,墨); 短文(範["說明"],橫+18,縱+150,欄寬-36,12,次墨);
            變數 卡總=0; 迴圈 (變數 列=0; 列<長度(板["清單"]); 列++) { 卡總+=長度(板["清單"][列]["卡片"]); }
            顯示(格式("{0} 份清單 · {1} 張卡片",[長度(板["清單"]),卡總]),橫+18,縱+172,12,淡墨);
            按鈕樣(字("使用範本"),"加",橫+18,縱+190,0,34,函式(){ 如果 (取區()==空值) { 新工作區(); 回傳 空值; } 表單(字("由範本建立看板"),字("新看板名稱"),範["名稱"],函式(值){ 執行改動(字("由範本建立看板"),函式(){ 開看板(引擎.套範本(取區(),範索,值)); }); }); },"主要","",假);
            變數 管位=[橫+欄寬-52,縱+190,34,34];
            圖示鈕("更多",橫+欄寬-52,縱+190,34,函式(){ 彈出(管位,[項(字("重新命名"),"編輯",函式(){ 表單(字("範本名稱"),字("名稱"),範["名稱"],函式(值){ 執行改動(字("重新命名範本"),函式(){ 範["名稱"]=值; }); }); }),險項(字("刪除此範本"),"垃圾桶",函式(){ 危險確認(字("刪除範本"),字("來源看板仍會保留。刪除後可以復原。"),字("刪除"),函式(){ 執行改動(字("刪除範本"),函式(){ 資料()["範本"]=引擎.去除(資料()["範本"],範索); }); }); })],220); },格式("管理範本：{0}",[範["名稱"]]),"一般",假);
        }
    }
    如果 (長度(範們)==0) { 置中顯示(字("還沒有範本。在看板設定中可以把看板存成範本。"),左+寬/2,格上+80,14,淡墨); }
    設裁切(空值); 繪捲軸(頁面捲動,左,格上,寬+4,高);
};

# ── 封存庫 ────────────────────────────────────────────────
變數 封存類別=0; 變數 封存查詢="";
變數 繪封存=函式() {
    變數 區=頁面區(); 變數 左=區[0]; 變數 上=區[1]; 變數 寬=區[2];
    頁首("封存",字("為暫時休息的計畫留一個位置"),字("封存庫"),字("恢復會保留原有內容；永久刪除前會再次確認。"),左,上,寬);
    變數 項們=[];
    迴圈 (變數 區索=0; 區索<長度(資料()["工作區"]); 區索++) { 變數 區位=區索; 變數 工區=資料()["工作區"][區索];
        如果 (工區["封存"]) { 項們=加入(項們,[1,工區["名稱"],"",函式(){ 工區["封存"]=假; 目前區=工區["編號"]; },函式(){ 資料()["工作區"]=引擎.去除(資料()["工作區"],區位); }]); }
        迴圈 (變數 板索=0; 板索<長度(工區["看板"]); 板索++) { 變數 板位=板索; 變數 板=工區["看板"][板索];
            如果 (板["封存"]) { 項們=加入(項們,[2,板["名稱"],工區["名稱"],函式(){ 工區["封存"]=假; 板["封存"]=假; },函式(){ 工區["看板"]=引擎.去除(工區["看板"],板位); }]); }
            迴圈 (變數 列索=0; 列索<長度(板["清單"]); 列索++) { 變數 列位=列索; 變數 列=板["清單"][列索];
                如果 (列["封存"]) { 項們=加入(項們,[3,列["名稱"],板["名稱"],函式(){ 工區["封存"]=假; 板["封存"]=假; 列["封存"]=假; },函式(){ 板["清單"]=引擎.去除(板["清單"],列位); }]); }
                迴圈 (變數 卡索=0; 卡索<長度(列["卡片"]); 卡索++) { 變數 卡位=卡索; 變數 卡=列["卡片"][卡索];
                    如果 (卡["封存"]) { 項們=加入(項們,[4,卡["名稱"],板["名稱"]+" / "+列["名稱"],函式(){ 工區["封存"]=假; 板["封存"]=假; 列["封存"]=假; 卡["封存"]=假; },函式(){ 列["卡片"]=引擎.去除(列["卡片"],卡位); }]); }
                }
            }
        }
    }
    # 篩選
    變數 選項們=[[字("全部"),""],[字("工作區"),"工作區"],[字("看板"),"看板"],[字("清單"),"清單"],[字("卡片"),"卡片"]];
    如果 (英文()) { 選項們=[["All",""],["Workspaces","工作區"],["Boards","看板"],["Lists","清單"],["Cards","卡片"]]; }
    變數 列縱=上+96; 變數 分寬=分段(選項們,封存類別,左,列縱,36,函式(索){ 封存類別=索; 頁面捲動=捲動.建立(); },字("封存類別"));
    如果 (寬-分寬>220) { 輸入欄("封存搜尋",封存查詢,左+分寬+12,列縱,最小(300,寬-分寬-12),36,函式(值){ 封存查詢=值; },{"圖示":"搜尋","占位":字("搜尋封存內容"),"標籤":字("搜尋封存內容"),"清除":真}); }
    變數 顯示們=[]; 迴圈 (變數 索=0;索<長度(項們);索++) { 變數 甲=項們[索]; 如果 (封存類別==0 || 甲[0]==封存類別) { 如果 (引擎.寬鬆包含(甲[1]+" "+甲[2],封存查詢)) { 顯示們=加入(顯示們,甲); } } }
    變數 清上=列縱+52; 變數 高=區[3]-(清上-上); 變數 列高=64.0d;
    捲動.設定(頁面捲動,寬,長度(顯示們)*列高+20,寬,高); 設裁切([左,清上,寬+12,高]); 登記區("頁面",[左,清上,寬,高]);
    變數 起=畫.向下取整(最大(0,頁面捲動["縱"]/列高)); 變數 終=最小(長度(顯示們),起+畫.向上取整(高/列高)+1);
    變數 圖們=["","工作區","看板","清單","卡片"]; 變數 類字=["",字("工作區"),字("看板"),字("清單"),字("卡片")];
    迴圈 (變數 索=起; 索<終; 索++) {
        變數 甲=顯示們[索]; 變數 縱=清上+索*列高-頁面捲動["縱"]; 變數 本=甲;
        圓角框(左,縱,寬,56,面板,邊線,10); 實框(左+12,縱+12,32,32,透明(薄荷,30),8); 繪圖示(圖們[甲[0]],左+28,縱+28,16,薄荷);
        變數 刪寬=鈕寬(字("永久刪除"),"垃圾桶",13); 變數 復寬=鈕寬(字("恢復"),"重試",13); 變數 文寬=寬-刪寬-復寬-90;
        短文(甲[1],左+56,縱+25,文寬,14,墨); 變數 次文=類字[甲[0]]; 如果 (甲[2]!="") { 次文+=" · "+甲[2]; } 短文(次文,左+56,縱+44,文寬,12,淡墨);
        按鈕樣(字("恢復"),"重試",左+寬-12-刪寬-8-復寬,縱+11,復寬,34,函式(){ 執行改動(字("恢復"),函式(){ 本[3](); 校正選擇(); }); 簡提示(格式("已恢復「{0}」。",[本[1]])); },"主要","",假);
        按鈕樣(字("永久刪除"),"垃圾桶",左+寬-12-刪寬,縱+11,刪寬,34,函式(){ 危險確認(字("永久刪除"),字("此項目和其中內容會刪除。請先匯出備份；本次工作階段仍可復原。"),字("永久刪除"),函式(){ 執行改動(字("永久刪除"),函式(){ 本[4](); 校正選擇(); }); }); },"危險","",假);
    }
    如果 (長度(顯示們)==0) { 繪圖示("封存",左+寬/2,清上+70,40,淡墨); 置中顯示(字("這裡還沒有封存內容。"),左+寬/2,清上+120,16,次墨); }
    設裁切(空值); 繪捲軸(頁面捲動,左,清上,寬+4,高);
};

# ── 設定 ──────────────────────────────────────────────────
變數 設定段=函式(圖示名,標題,說明,左,縱,寬) { 繪圖示(圖示名,左+10,縱+12,18,薄荷); 顯示(標題,左+30,縱+18,17,墨); 如果 (說明!="") { 短文(說明,左+30,縱+40,寬-30,12,淡墨); 回傳 縱+56; } 回傳 縱+36; };
變數 設定列=函式(標題,說明,左,縱,寬) { 顯示(標題,左,縱+18,14,墨); 如果 (說明!="") { 短文(說明,左,縱+38,寬-260,12,淡墨); } };
變數 套用語言=函式(索引) {
    語言.設定(索引); 引擎.設定語言(索引); 儲存空間.設定偏好(儲存前綴+".language",索引); 分行快取={}; 分行快取數=0; 清除篩選暫存(); 介面.設定標題(視窗,字("星泉看板")); 存檔狀態=儲存完成文字();
    畫.重繪();
};
變數 套用主題=函式(索引) { 套主題(索引); 儲存空間.設定偏好(儲存前綴+".theme",索引); 畫.重繪(); };
變數 繪設定=函式() {
    變數 區=頁面區(); 變數 左=區[0]; 變數 上=區[1]; 變數 寬=最小(區[2],900.0d); 如果 (!手機版) { 左=區[0]+(區[2]-寬)/2; }
    頁首("設定",字("讓工作空間符合你的習慣"),字("設定"),字("外觀、語言與資料都在這裡調整；偏好會保存在這台裝置。"),左,上,寬);
    變數 清上=上+96; 變數 高=區[3]-96; 設裁切([左-8,清上,寬+24,高]); 登記區("頁面",[左,清上,寬,高]);
    變數 縱=清上-頁面捲動["縱"]; 變數 起縱=縱;
    # 外觀
    變數 段起=縱; 縱=設定段("調色盤",字("外觀"),字("主題、語言與介面大小。"),左+18,縱+18,寬-36);
    設定列(字("主題"),"",左+20,縱,寬-40); 縱+=34;
    變數 格寬=(寬-40-12*2)/3.0d; 如果 (寬<640) { 格寬=(寬-40-12)/2.0d; } 變數 每列=3; 如果 (寬<640) { 每列=2; }
    迴圈 (變數 索=0;索<主題.數量;索++) {
        變數 值=索; 變數 橫=左+20+(索%每列)*(格寬+12); 變數 頂=縱+(索/每列)*92; 變數 選中=主題.目前==索; 變數 名=主題.名稱(索,語言.目前); 變數 鍵=區鍵("按鈕",格式("主題：{0}",[名]),橫,頂);
        變數 線=邊線; 如果 (選中) { 線=薄荷; } 否則如果 (滑過鍵==鍵) { 線=強邊線; }
        圓角框(橫,頂,格寬,80,主題.預覽(索,"底"),線,10); 如果 (選中) { 畫.停用填色(); 畫.描邊(薄荷); 畫.描邊粗細(2); 畫.矩形(橫,頂,格寬,80,10); 畫.停用描邊(); }
        實框(橫+10,頂+10,28,40,主題.預覽(索,"側欄"),5); 實框(橫+44,頂+10,格寬-54,40,主題.預覽(索,"面板"),5); 實框(橫+52,頂+18,(格寬-70)/2,24,主題.預覽(索,"卡底"),4); 實框(橫+52,頂+18,18,4,主題.預覽(索,"強調"),2);
        實框(橫+44+(格寬-54)-28,頂+16,20,10,主題.預覽(索,"強調"),5);
        畫.填色(主題.預覽(索,"墨")); 介面.繪文字(名,橫+10,頂+70,12,比例,0); 如果 (選中) { 繪圖示("勾圓",橫+格寬-16,頂+65,14,薄荷); }
        登記(橫,頂,格寬,80,函式(){ 套用主題(值); },格式("主題：{0}",[名]),"按鈕",空值);
    }
    縱+=畫.向上取整(主題.數量/(每列*1.0d))*92+8; 分隔線(左+20,縱,寬-40); 縱+=8;
    設定列(字("語言"),字("介面文字的語言；看板內容不會被翻譯。"),左+20,縱,寬-40);
    分段([["English",""],["繁體中文",""]],語言.目前,左+寬-20-最小(240,鈕寬("English","",13)+鈕寬("繁體中文","",13)-4),縱+6,34,函式(索){ 套用語言(索); },字("語言")); 縱+=60; 分隔線(左+20,縱,寬-40); 縱+=8;
    設定列(字("介面大小"),字("在自動比例上再放大或縮小。"),左+20,縱,寬-40);
    變數 縮右=左+寬-20; 圖示鈕("放大",縮右-36,縱+6,36,函式(){ 設定介面縮放(介面百分比+10); },字("放大介面"),"一般",介面百分比>=150);
    按鈕樣(字數(介面百分比)+"%","",縮右-110,縱+6,70,36,函式(){ 設定介面縮放(100); },"一般",字("重設介面縮放（100%）"),假);
    圖示鈕("縮小",縮右-150,縱+6,36,函式(){ 設定介面縮放(介面百分比-10); },字("縮小介面"),"一般",介面百分比<=70); 縱+=60; 分隔線(左+20,縱,寬-40); 縱+=8;
    設定列(字("減少動態效果"),字("關閉淡入、平滑捲動與拖曳動畫。"),左+20,縱,寬-40);
    開關(減少動態,左+寬-58,縱+12,函式(){ 減少動態=!減少動態; 變數 值=0; 如果 (減少動態) { 值=1; } 儲存空間.設定偏好(儲存前綴+".motion",值); },字("減少動態效果")); 縱+=60; 分隔線(左+20,縱,寬-40); 縱+=8;
    設定列(字("收合側欄"),字("只顯示圖示，讓看板有更多空間。快捷鍵 Ctrl+B。"),左+20,縱,寬-40);
    開關(側欄收合,左+寬-58,縱+12,切換側欄,字("收合側欄")); 縱+=56;
    圓角框(左,段起,寬,縱-段起,透明(面板,0),邊線,14); 縱+=18;
    # 日期
    段起=縱; 縱=設定段("日曆",字("日期"),字("「今日」用來判斷逾期與今日到期的卡片。"),左+18,縱+18,寬-36);
    設定列(字("自動使用系統日期"),格式("目前：{0}",[資料()["今日"]]),左+20,縱,寬-40);
    開關(自動今日,左+寬-58,縱+12,函式(){ 自動今日=!自動今日; 如果 (自動今日) { 資料()["今日"]=目前日期(); 清除篩選暫存(); } },字("自動使用系統日期")); 縱+=56;
    如果 (!自動今日) { 變數 日位=縱; 按鈕樣(資料()["今日"],"日曆",左+20,縱,180,34,函式(){ 開日期選擇([左+20,日位,180,34],資料()["今日"],函式(值){ 如果 (值!="") { 執行改動(字("設定今日日期"),函式(){ 資料()["今日"]=值; }); } }); },"一般",字("設定今日日期"),假); 縱+=46; }
    圓角框(左,段起,寬,縱-段起,透明(面板,0),邊線,14); 縱+=18;
    # 資料
    段起=縱; 變數 存說明=字("桌面版自動儲存在應用程式資料夾；建議定期匯出完整備份。"); 如果 (是網頁) { 存說明=字("網頁版自動儲存在這個瀏覽器；清除網站資料會一併刪除，請定期匯出完整備份。"); }
    縱=設定段("儲存",字("資料與備份"),存說明,左+18,縱+18,寬-36);
    設定列(字("自動儲存"),存檔狀態,左+20,縱,寬-40); 如果 (未儲存 || 儲存鎖定) { 按鈕樣(字("立即儲存"),"重試",左+寬-150,縱+6,130,34,函式(){ 自動存(); },"一般","",假); } 縱+=56;
    變數 鈕位=左+20; 變數 放鈕=函式(文字,圖示名,處理,樣式) { 變數 鈕=鈕寬(文字,圖示名,13); 如果 (鈕位+鈕>左+寬-20) { 鈕位=左+20; 縱+=44; } 按鈕樣(文字,圖示名,鈕位,縱,鈕,34,處理,樣式,"",假); 鈕位+=鈕+10; };
    放鈕(字("儲存完整備份"),"儲存",手動儲存,"主要"); 放鈕(字("載入備份"),"開啟",手動載入,"一般");
    如果 (取板()!=空值) { 放鈕(字("匯出 CSV"),"匯出",函式(){ 匯出看板("csv"); },"一般"); 放鈕(字("匯出 Markdown"),"匯出",函式(){ 匯出看板("md"); },"一般"); }
    縱+=52; 圓角框(左,段起,寬,縱-段起,透明(面板,0),邊線,14); 縱+=18;
    # 說明
    段起=縱; 縱=設定段("說明",字("說明與支援"),格式("星泉看板 {0} · 以星泉程式語言編寫",[版本文字]),左+18,縱+18,寬-36);
    鈕位=左+20; 放鈕(字("重新觀看入門導覽"),"說明",開始導覽,"一般"); 放鈕(字("鍵盤快捷鍵"),"鍵盤",開快捷鍵,"一般"); 放鈕(字("搜尋與指令"),"指令",開指令面板,"一般");
    縱+=52; 圓角框(左,段起,寬,縱-段起,透明(面板,0),邊線,14); 縱+=24;
    捲動.設定(頁面捲動,寬,縱-起縱,寬,高); 設裁切(空值); 繪捲軸(頁面捲動,左,清上,寬+8,高);
};

# ── 對話繪製 ──────────────────────────────────────────────
變數 關對話保留=函式() {
    如果 (長度(對話堆疊)>0) { 變數 上=最後一個(對話堆疊); 對話堆疊=引擎.去除(對話堆疊,長度(對話堆疊)-1); 對話=上["種類"]; 對話資料=上["資料"]; 詳情捲動=上["捲動"]; 對話開啟=0.0d; }
    否則 { 對話=""; 對話資料=空值; } 畫.重繪();
};
變數 是彈出=函式(種類,內容) { 如果 (種類=="日期") { 回傳 真; } 如果 (種類=="選單") { 如果 (內容["錨"]!=空值) { 回傳 真; } } 回傳 假; };
變數 繪對話全部=函式() {
    畫.停用裁切(); 命中裁切=空值;
    變數 頂種=對話; 變數 頂資=對話資料; 變數 頂捲=詳情捲動; 變數 頂開=對話開啟;
    變數 層們=加入(對話堆疊,{"種類":對話,"資料":對話資料,"捲動":詳情捲動});
    變數 已暗=假;
    迴圈 (變數 索=0;索<長度(層們);索++) {
        變數 層=層們[索]; 變數 頂=索==長度(層們)-1;
        對話=層["種類"]; 對話資料=層["資料"]; 詳情捲動=層["捲動"]; 對話開啟=0.0d; 如果 (頂) { 對話開啟=頂開; }
        如果 (頂) { 命中區=[]; 語意節點=[]; }
        如果 (!是彈出(對話,對話資料) && !已暗) { 變數 進=時間進度(頂開,160); 如果 (!頂) { 進=1.0d; } 畫.填色(透明(遮罩,畫.四捨五入(畫.透明度(遮罩)*進))); 畫.停用描邊(); 畫.矩形(0,0,版寬,版高); 已暗=真; }
        如果 (頂) {
            # 點選遮罩：彈出選單直接關閉；其他對話在未輸入時關閉。
            登記(0,0,版寬,版高,函式(){ 點遮罩(); },字("關閉"),"遮罩",空值);
        }
        繪單一對話(頂);
    }
    對話=頂種; 對話資料=頂資; 詳情捲動=頂捲; 對話開啟=頂開;
};
變數 點遮罩=函式() {
    如果 (是彈出(對話,對話資料)) { 如果 (對話資料["保留編輯"]==真) { 關對話保留(); } 否則 { 關對話(); } 回傳 空值; }
    如果 (編輯器!=空值 && 對話!="表單") { 結束編輯(); 畫.重繪(); 回傳 空值; }
    如果 (對話=="詳情" || 對話=="活動" || 對話=="快捷鍵" || 對話=="指令" || 對話=="選單" || 對話=="看板設定" || 對話=="工作區設定") { 關對話(); }
};
變數 對話框=函式(寬,高) {
    變數 左=(版寬-寬)/2; 變數 上=(版高-高)/2; 變數 進=時間進度(對話開啟,180); 上+=(1.0d-進)*14;
    陰影框(左,上,寬,高,16,10); 圓角框(左,上,寬,高,面板,強邊線,16);
    # 擋住對話內部的點擊，避免穿透到遮罩。
    登記(左,上,寬,高,函式(){},字("對話框"),"面板",空值);
    回傳 [左,上,進];
};
變數 淡入=函式(左,上,寬,高,進) { 如果 (進<1) { 實框(左-1,上-1,寬+2,高+2,透明(面板,畫.四捨五入((1.0d-進)*230)),16); } };
變數 繪單一對話=函式(頂) {
    如果 (對話=="詳情") {
        變數 寬=最小(940,版寬-32); 變數 高=最小(880,版高-36); 如果 (手機版) { 寬=版寬-12; 高=版高-12; }
        變數 位=對話框(寬,高); 繪詳情(位[0],位[1],寬,高); 淡入(位[0],位[1],寬,高,位[2]);
    } 否則如果 (對話=="表單") {
        變數 多=對話資料["多行"]==真; 變數 寬=最小(560,版寬-24); 變數 高=236.0d; 如果 (多) { 高=360.0d; }
        變數 位=對話框(寬,高); 變數 左=位[0]; 變數 上=位[1];
        顯示(對話資料["標題"],左+28,上+44,21,墨); 圖示鈕("關閉",左+寬-52,上+16,34,關對話,字("關閉"),"幽靈",假);
        顯示(對話資料["欄名"],左+28,上+80,12,次墨);
        如果 (多) { 輸入欄("表單",對話資料["值"],左+28,上+90,寬-56,170,函式(值){ 對話資料["值"]=值; },{"多行":真,"標籤":對話資料["欄名"]}); }
        否則 { 輸入欄("表單",對話資料["值"],左+28,上+90,寬-56,44,函式(值){ 對話資料["值"]=值; },{"標籤":對話資料["欄名"],"提交":提交表單}); }
        顯示(字("按換行鍵確認，或按離開鍵返回。"),左+28,上+高-38,12,淡墨);
        按鈕樣(字("取消"),"",左+寬-224,上+高-58,92,36,關對話,"一般","",假); 按鈕樣(字("確認"),"勾",左+寬-122,上+高-58,98,36,提交表單,"主要","",假);
        淡入(左,上,寬,高,位[2]);
    } 否則如果 (對話=="確認") {
        變數 寬=最小(520,版寬-24); 變數 行們=分行(對話資料["說明"],寬-56,14); 變數 高=150.0d+長度(行們)*23;
        變數 位=對話框(寬,高); 變數 左=位[0]; 變數 上=位[1]; 變數 危險=對話資料["危險"]==真;
        變數 圖色=薄荷; 變數 圖="資訊"; 如果 (危險) { 圖色=珊瑚; 圖="警告"; } 繪圖示(圖,左+40,上+40,22,圖色);
        顯示(對話資料["標題"],左+62,上+47,20,墨); 段落(對話資料["說明"],左+28,上+70,寬-56,長度(行們)*23+10,14,次墨);
        變數 確字=字("確認"); 如果 (對話資料["按鈕"]!=空值) { 確字=對話資料["按鈕"]; } 變數 確樣="主要"; 如果 (危險) { 確樣="危險"; }
        變數 確寬=最大(98,鈕寬(確字,"",13));
        按鈕樣(字("返回"),"",左+寬-確寬-130,上+高-58,92,36,關對話,"一般","",假);
        按鈕樣(確字,"",左+寬-確寬-28,上+高-58,確寬,36,函式(){ 變數 處理=對話資料["提交"]; 關對話(); 處理(); },確樣,字("確認"),假);
        淡入(左,上,寬,高,位[2]);
    } 否則如果 (對話=="選單") { 繪選單();
    } 否則如果 (對話=="日期") { 繪日期選擇();
    } 否則如果 (對話=="活動") {
        變數 寬=最小(640,版寬-24); 變數 高=最小(640,版高-60); 變數 位=對話框(寬,高); 變數 左=位[0]; 變數 上=位[1];
        繪圖示("活動",左+40,上+38,20,薄荷); 顯示(字("看板活動"),左+62,上+45,21,墨); 圖示鈕("關閉",左+寬-52,上+16,34,關對話,字("關閉"),"幽靈",假);
        變數 記=取板()["活動"]; 變數 視野=高-90; 捲動.設定(詳情捲動,寬-56,長度(記)*44+10,寬-56,視野); 設裁切([左+20,上+74,寬-40,視野]); 登記區("詳情",[左,上+74,寬,視野]);
        迴圈 (變數 索=0; 索<長度(記); 索++) { 變數 縱=上+80+索*44-詳情捲動["縱"]; 如果 (縱>上+40 && 縱<上+高) { 實框(左+36,縱+10,8,8,透明(薄荷,160),4); 如果 (索<長度(記)-1) { 實框(左+39,縱+22,2,30,邊線,1); } 短文(記[長度(記)-1-索],左+56,縱+19,寬-90,13,次墨); } }
        如果 (長度(記)==0) { 置中顯示(字("這份看板還沒有活動紀錄。"),左+寬/2,上+130,14,淡墨); }
        設裁切(空值); 淡入(左,上,寬,高,位[2]);
    } 否則如果 (對話=="看板設定") { 繪看板設定();
    } 否則如果 (對話=="工作區設定") { 繪工作區設定();
    } 否則如果 (對話=="指令") { 繪指令面板();
    } 否則如果 (對話=="快捷鍵") { 繪快捷鍵(); }
};
變數 提交表單=函式() {
    如果 (對話!="表單") { 回傳 空值; } 變數 值=整潔(對話資料["值"]); 如果 (值=="") { 提示(字("請先填寫內容。"),"警告","",空值); 回傳 空值; }
    變數 處理=對話資料["提交"]; 關對話(); 處理(值);
};

# ── 選單 ──────────────────────────────────────────────────
變數 選單幾何=函式() {
    變數 項目=對話資料["項目"]; 變數 寬=對話資料["寬"]; 如果 (寬==空值) { 寬=360; } 變數 內高=8.0d;
    迴圈 (變數 索=0;索<長度(項目);索++) { 如果 (項目[索]["分隔"]==真) { 內高+=9; } 否則 { 內高+=38; } }
    內高+=8; 變數 錨=對話資料["錨"]; 變數 左=0.0d; 變數 上=0.0d; 變數 高=內高; 變數 標高=0.0d;
    如果 (錨==空值) { 寬=最小(寬,版寬-24); 標高=56.0d; 高=最小(內高+標高+8,版高-80); 左=(版寬-寬)/2; 上=(版高-高)/2; }
    否則 {
        寬=最小(寬,版寬-16); 高=最小(內高,版高-24); 左=錨[0]; 上=錨[1]+錨[3]+4;
        如果 (對話資料["右鍵"]==真) { 上=錨[1]+2; 左=錨[0]+2; }
        如果 (左+寬>版寬-8) { 左=版寬-8-寬; 如果 (對話資料["右鍵"]!=真) { 左=最大(8,錨[0]+錨[2]-寬); } } 如果 (左<8) { 左=8.0d; }
        如果 (上+高>版高-8) { 如果 (錨[1]-高-4>=8) { 上=錨[1]-高-4; } 否則 { 上=最大(8,版高-8-高); } }
    }
    回傳 [左,上,寬,高,標高,內高];
};
變數 執行選項=函式(甲) {
    如果 (甲["停用"]==真) { 回傳 空值; } 變數 動=甲["動作"];
    如果 (對話資料["保留編輯"]==真) { 關對話保留(); } 否則 { 關對話(); } 動();
};
變數 繪選單=函式() {
    變數 幾=選單幾何(); 變數 左=幾[0]; 變數 上=幾[1]; 變數 寬=幾[2]; 變數 高=幾[3]; 變數 項目=對話資料["項目"]; 變數 進=時間進度(對話開啟,140);
    上+=(1.0d-進)*-6; 陰影框(左,上,寬,高,12,8); 圓角框(左,上,寬,高,面板,強邊線,12); 登記(左,上,寬,高,函式(){},字("選單"),"面板",空值);
    如果 (幾[4]>0) { 短文(對話資料["標題"],左+22,上+36,寬-80,17,墨); 圖示鈕("關閉",左+寬-48,上+12,32,關對話,字("關閉"),"幽靈",假); 分隔線(左+1,上+幾[4],寬-2); }
    變數 視野=高-幾[4]; 捲動.設定(詳情捲動,寬,幾[5],寬,視野); 設裁切([左+1,上+幾[4],寬-2,視野]); 登記區("詳情",[左,上+幾[4],寬,視野]);
    變數 縱=上+幾[4]+8-詳情捲動["縱"]; 變數 可索=0;
    迴圈 (變數 索=0;索<長度(項目);索++) {
        變數 甲=項目[索]; 變數 本=甲;
        如果 (甲["分隔"]==真) { 分隔線(左+12,縱+4,寬-24); 縱+=9; } 否則 {
            變數 停=甲["停用"]==真; 變數 鍵=區鍵("按鈕",甲["文字"],左+6,縱); 變數 焦=對話資料["焦點"]==可索;
            如果 (!停 && (滑過鍵==鍵 || 焦)) { 實框(左+6,縱+1,寬-12,36,卡滑過,7); }
            變數 色=墨; 如果 (甲["危險"]==真) { 色=珊瑚; } 如果 (停) { 色=淡墨; }
            變數 字左=左+18;
            如果 (甲["色"]!=空值) { 實框(左+18,縱+12,14,14,甲["色"],4); 字左=左+42; }
            否則如果 (甲["圖示"]!=空值 && 甲["圖示"]!="") { 變數 圖色=次墨; 如果 (甲["危險"]==真) { 圖色=珊瑚; } 如果 (停) { 圖色=淡墨; } 繪圖示(甲["圖示"],左+26,縱+19,16,圖色); 字左=左+44; }
            否則如果 (甲["勾選"]!=空值) { 字左=左+42; }
            如果 (甲["勾選"]==真) { 繪圖示("勾",左+寬-26,縱+19,15,薄荷); }
            變數 右留=24.0d; 如果 (甲["勾選"]==真) { 右留=44.0d; }
            如果 (甲["快捷"]!=空值) { 變數 快=甲["快捷"]; 右顯示(快,左+寬-右留+6,縱+24,11,淡墨); 右留+=量(快,11)+10; }
            如果 (甲["說明"]!=空值) { 右顯示(甲["說明"],左+寬-右留+6,縱+24,12,淡墨); 右留+=量(甲["說明"],12)+10; }
            短文(甲["文字"],字左,縱+24,左+寬-右留-字左,13,色);
            如果 (!停) { 登記(左+6,縱+1,寬-12,36,函式(){ 執行選項(本); },甲["文字"],"按鈕",空值); }
            縱+=38; 可索++;
        }
    }
    設裁切(空值);
    如果 (詳情捲動["內容高"]>視野) { 變數 塊=捲動.滑塊(詳情捲動["內容高"],視野,詳情捲動["縱"],視野-8); 實框(左+寬-7,上+幾[4]+4+塊[0],3,塊[1],強邊線,2); }
};
# 選單鍵盤操作：上下移動、換行執行。
變數 選單可用項=函式() { 變數 結果=[]; 變數 項目=對話資料["項目"]; 迴圈 (變數 索=0;索<長度(項目);索++) { 如果 (項目[索]["分隔"]!=真) { 結果=加入(結果,項目[索]); } } 回傳 結果; };
變數 選單移動=函式(方向) { 變數 可=選單可用項(); 如果 (長度(可)==0) { 回傳 空值; } 變數 新=對話資料["焦點"]+方向; 如果 (新<0) { 新=長度(可)-1; } 如果 (新>=長度(可)) { 新=0; } 對話資料["焦點"]=新; };
變數 選單執行=函式() { 變數 可=選單可用項(); 變數 位=對話資料["焦點"]; 如果 (位>=0 && 位<長度(可)) { 執行選項(可[位]); } };

# ── 日期選擇 ──────────────────────────────────────────────
變數 開日期選擇=函式(錨,值,回呼) {
    變數 月=片段(資料()["今日"],0,7); 如果 (引擎.日期數(值)>0) { 月=片段(值,0,7); }
    開對話("日期",{"錨":錨,"值":值,"月":月,"回呼":回呼});
};
變數 選日期=函式(值) { 變數 回呼=對話資料["回呼"]; 關對話(); 回呼(值); };
變數 繪日期選擇=函式() {
    變數 寬=320.0d; 變數 高=338.0d; 變數 錨=對話資料["錨"]; 變數 左=錨[0]; 變數 上=錨[1]+錨[3]+4;
    如果 (左+寬>版寬-8) { 左=版寬-8-寬; } 如果 (左<8) { 左=8.0d; } 如果 (上+高>版高-8) { 上=最大(8,錨[1]-高-4); }
    變數 進=時間進度(對話開啟,140); 陰影框(左,上,寬,高,12,8); 圓角框(左,上,寬,高,面板,強邊線,12); 登記(左,上,寬,高,函式(){},字("日期選擇"),"面板",空值);
    變數 月=對話資料["月"]; 變數 年=字串.解析整數(片段(月,0,4)); 變數 月數=字串.解析整數(片段(月,5,7));
    圖示鈕("向左",左+12,上+12,30,函式(){ 對話資料["月"]=片段(引擎.加月份(對話資料["月"]+"-01",-1),0,7); },字("上個月"),"幽靈",假);
    置中顯示(月標題(年,月數),左+寬/2,上+33,15,墨);
    圖示鈕("向右",左+寬-42,上+12,30,函式(){ 對話資料["月"]=片段(引擎.加月份(對話資料["月"]+"-01",1),0,7); },字("下個月"),"幽靈",假);
    變數 格=38.0d; 變數 格左=左+(寬-格*7)/2; 變數 縱=上+52;
    迴圈 (變數 索=0;索<7;索++) { 置中顯示(週名(索),格左+索*格+格/2,縱+14,11,淡墨); }
    縱+=22; 變數 首=引擎.日數(月+"-01"); 變數 起=首-引擎.星期(首); 變數 今=引擎.日數(資料()["今日"]); 變數 選=引擎.日數(對話資料["值"]);
    迴圈 (變數 索=0;索<42;索++) {
        變數 天=起+索; 變數 日期=引擎.日數轉日期(天); 變數 橫=格左+(索%7)*格; 變數 縱格=縱+(索/7)*34; 變數 本日=日期;
        變數 本月=片段(日期,0,7)==月; 變數 鍵=區鍵("按鈕",日期,橫+2,縱格+1); 變數 色=墨; 如果 (!本月) { 色=淡墨; }
        如果 (天==選) { 實框(橫+3,縱格+1,格-6,32,薄荷,8); 色=強調字; } 否則如果 (滑過鍵==鍵) { 實框(橫+3,縱格+1,格-6,32,卡滑過,8); } 否則如果 (天==今) { 圓角框(橫+3,縱格+1,格-6,32,透明(面板,0),薄荷,8); }
        置中顯示(字數(字串.解析整數(片段(日期,8,10))),橫+格/2,縱格+22,13,色);
        登記(橫+2,縱格+1,格-4,32,函式(){ 選日期(本日); },日期,"按鈕",空值);
    }
    縱+=6*34+8; 分隔線(左+12,縱,寬-24); 縱+=8;
    變數 今日=資料()["今日"]; 變數 快選=[[字("今天"),今日],[字("明天"),引擎.加天數(今日,1)],[字("下週"),引擎.加天數(今日,7)]];
    變數 寬們=[]; 變數 總=0.0d; 迴圈 (變數 索=0;索<3;索++) { 變數 量寬=量(快選[索][0],13)+18; 寬們=加入(寬們,量寬); 總+=量寬; }
    變數 清寬=量(字("清除"),13)+18; 變數 餘=(寬-24-18-總-清寬)/4; 如果 (餘<0) { 餘=0.0d; } 變數 位=左+12;
    迴圈 (變數 索=0;索<3;索++) { 變數 日=快選[索][1]; 按鈕樣(快選[索][0],"",位,縱,寬們[索]+餘,30,函式(){ 選日期(日); },"幽靈","",假); 位+=寬們[索]+餘+6; }
    按鈕樣(字("清除"),"",位,縱,清寬+餘,30,函式(){ 選日期(""); },"危險",字("清除日期"),假);
    淡入(左,上,寬,高,進);
};

# ── 看板與工作區設定 ──────────────────────────────────────
變數 看板設定=函式() { 如果 (取板()==空值) { 回傳 空值; } 開對話("看板設定",{"板":目前板}); };
變數 工作區設定=函式() { 如果 (取區()==空值) { 回傳 空值; } 開對話("工作區設定",{"區":目前區}); };
變數 移動看板=函式(板) {
    變數 選=[]; 迴圈 (變數 索=0; 索<長度(資料()["工作區"]); 索++) { 變數 區=資料()["工作區"][索]; 如果 (!區["封存"] && 區["編號"]!=目前區) {
        選=加入(選,項(區["名稱"],"工作區",函式(){ 執行改動(字("移動看板"),函式(){ 變數 原=取區(); 迴圈 (變數 位=0; 位<長度(原["看板"]); 位++) { 如果 (原["看板"][位]["編號"]==板["編號"]) { 原["看板"]=引擎.去除(原["看板"],位); 中斷; } } 區["看板"]=加入(區["看板"],板); 目前區=區["編號"]; }); 簡提示(格式("已移到「{0}」。",[區["名稱"]])); })); } }
    如果 (長度(選)==0) { 選=加入(選,{"文字":字("沒有其他工作區。"),"停用":真,"動作":函式(){}}); } 選=加入(選,分隔()); 選=加入(選,項(字("建立工作區"),"加",新工作區));
    右鍵或彈出(字("移至另一個工作區"),選);
};
變數 繪看板設定=函式() {
    變數 板=取板(); 如果 (板==空值) { 關對話(); 回傳 空值; } 變數 本板=板;
    變數 寬=最小(660,版寬-24); 變數 高=最小(700,版高-40); 變數 位=對話框(寬,高); 變數 左=位[0]; 變數 上=位[1];
    繪圖示("設定",左+40,上+38,20,薄荷); 顯示(字("看板設定"),左+62,上+45,21,墨); 圖示鈕("關閉",左+寬-52,上+16,34,關對話,字("關閉"),"幽靈",假);
    變數 內左=左+28; 變數 內寬=寬-56; 變數 視野=高-80; 設裁切([左+1,上+72,寬-2,視野]); 登記區("詳情",[左,上+72,寬,視野]); 變數 縱=上+80-詳情捲動["縱"]; 變數 起=縱;
    顯示(字("名稱"),內左,縱+12,12,次墨); 縱+=20;
    輸入欄("看板名稱",板["名稱"],內左,縱,內寬,40,函式(值){ 本板["名稱"]=值; 延後儲存(); },{"說明":字("重新命名看板"),"標籤":字("看板名稱")}); 縱+=54;
    顯示(字("說明"),內左,縱+12,12,次墨); 縱+=20;
    變數 說高=輸入欄("看板說明",板["說明"],內左,縱,內寬,70,函式(值){ 本板["說明"]=值; 延後儲存(); },{"多行":真,"最小行":2,"最多行":6,"說明":字("編輯看板說明"),"標籤":字("看板說明")}); 縱+=說高+16;
    顯示(字("顏色"),內左,縱+12,12,次墨); 縱+=24;
    迴圈 (變數 索=0;索<6;索++) { 變數 值=索; 色塊鈕(色票[索],內左+索*40,縱,26,板["色系"]==索,函式(){ 執行改動(字("切換看板色系"),函式(){ 本板["色系"]=值; }); },格式("看板顏色：{0}",[色名(索)])); }
    縱+=46; 分隔線(內左,縱,內寬); 縱+=10;
    顯示(字("完成欄自動完成"),內左,縱+18,14,墨); 短文(字("卡片移入完成欄時自動標記完成。"),內左,縱+38,內寬-80,12,淡墨);
    開關(板["自動完成"],內左+內寬-40,縱+10,函式(){ 執行改動(字("切換完成欄自動完成"),函式(){ 本板["自動完成"]=!本板["自動完成"]; }); },字("完成欄自動完成")); 縱+=60; 分隔線(內左,縱,內寬); 縱+=16;
    顯示(字("動作"),內左,縱+12,12,次墨); 縱+=24;
    變數 鈕位=內左; 變數 放鈕=函式(文字,圖示名,處理,樣式) { 變數 鈕=鈕寬(文字,圖示名,13); 如果 (鈕位+鈕>內左+內寬) { 鈕位=內左; 縱+=44; } 按鈕樣(文字,圖示名,鈕位,縱,鈕,34,處理,樣式,"",假); 鈕位+=鈕+10; };
    放鈕(字("複製整份看板"),"複製",函式(){ 表單(字("複製看板"),字("新看板名稱"),本板["名稱"]+字("（複本）"),函式(值){ 執行改動(字("複製看板"),函式(){ 關全部對話(); 開看板(引擎.複製看板(取區(),本板,值)); }); }); },"一般");
    放鈕(字("保存為我的範本"),"範本",函式(){ 表單(字("保存範本"),字("範本名稱"),本板["名稱"],函式(值){ 執行改動(字("保存範本"),函式(){ 引擎.存範本(本板,值); }); 簡提示(字("範本已加入範本庫。")); }); },"一般");
    放鈕(字("移至另一個工作區"),"移動",函式(){ 移動看板(本板); },"一般");
    放鈕(字("匯出 CSV"),"匯出",函式(){ 匯出看板("csv"); },"一般");
    放鈕(字("匯出 Markdown"),"匯出",函式(){ 匯出看板("md"); },"一般");
    放鈕(字("查看看板活動"),"活動",函式(){ 開對話("活動",{}); },"一般");
    縱+=50; 分隔線(內左,縱,內寬); 縱+=16;
    按鈕樣(字("封存看板"),"封存",內左,縱,0,34,函式(){ 危險確認(字("封存看板"),字("可稍後在封存庫恢復這份看板。"),字("封存"),函式(){ 執行改動(字("封存看板"),函式(){ 本板["封存"]=真; 校正選擇(); }); 關全部對話(); 提示(格式("已封存看板「{0}」。",[本板["名稱"]]),"資訊",字("復原"),函式(){ 復原操作(); }); }); },"危險","",假);
    縱+=50; 捲動.設定(詳情捲動,內寬,縱-起,內寬,視野); 設裁切(空值); 淡入(左,上,寬,高,位[2]);
};
變數 繪工作區設定=函式() {
    變數 區=取區(); 如果 (區==空值) { 關對話(); 回傳 空值; } 變數 本區=區;
    變數 寬=最小(600,版寬-24); 變數 高=最小(430,版高-40); 變數 位=對話框(寬,高); 變數 左=位[0]; 變數 上=位[1];
    繪圖示("工作區",左+40,上+38,20,薄荷); 顯示(字("工作空間設定"),左+62,上+45,21,墨); 圖示鈕("關閉",左+寬-52,上+16,34,關對話,字("關閉"),"幽靈",假);
    變數 內左=左+28; 變數 內寬=寬-56; 變數 縱=上+80;
    顯示(字("名稱"),內左,縱+12,12,次墨); 縱+=20; 輸入欄("工作區名稱",區["名稱"],內左,縱,內寬,40,函式(值){ 本區["名稱"]=值; 延後儲存(); },{"說明":字("重新命名工作區"),"標籤":字("工作區名稱")}); 縱+=54;
    顯示(字("說明"),內左,縱+12,12,次墨); 縱+=20; 輸入欄("工作區說明",區["說明"],內左,縱,內寬,70,函式(值){ 本區["說明"]=值; 延後儲存(); },{"多行":真,"最小行":2,"最多行":3,"說明":字("編輯工作區說明"),"標籤":字("工作區說明")}); 縱+=96;
    按鈕樣(字("封存這個工作區"),"封存",內左,縱,0,34,函式(){ 危險確認(字("封存工作區"),字("所有看板會保留在封存庫，可隨時恢復。"),字("封存"),函式(){ 執行改動(字("封存工作區"),函式(){ 本區["封存"]=真; 目前板=0; 校正選擇(); }); 關全部對話(); }); },"危險","",假);
    淡入(左,上,寬,高,位[2]);
};

# ── 指令面板 ──────────────────────────────────────────────
變數 開指令面板=函式() { 關全部對話(); 開對話("指令",{"查詢":"","焦點":0}); 聚焦("指令搜尋","",函式(值){ 對話資料["查詢"]=值; 對話資料["焦點"]=0; },假,""); 編輯提交=函式(){ 指令執行(); }; };
變數 指令項目=函式(查) {
    變數 結果=[]; 變數 板=取板();
    變數 加=函式(文字,圖示名,說明,動作) { 如果 (引擎.寬鬆包含(文字+" "+說明,查)) { 結果=加入(結果,{"文字":文字,"圖示":圖示名,"說明":說明,"動作":動作}); } };
    如果 (板!=空值) { 變數 列們=可見清單(板); 如果 (長度(列們)>0) { 加(字("新增卡片"),"加",字("指令"),函式(){ 頁面="看板"; 檢視="流動"; 開始新增(列們[0]["編號"]); }); } 加(字("新增清單"),"清單",字("指令"),新清單); }
    加(字("新增看板"),"看板",字("指令"),新看板); 加(字("建立工作區"),"工作區",字("指令"),新工作區);
    加(字("開啟設定"),"設定",字("指令"),函式(){ 頁面="設定"; 頁面捲動=捲動.建立(); }); 加(字("前往範本"),"範本",字("指令"),函式(){ 頁面="範本"; 頁面捲動=捲動.建立(); }); 加(字("前往封存庫"),"封存",字("指令"),函式(){ 頁面="封存"; 頁面捲動=捲動.建立(); });
    加(字("切換主題"),"調色盤",主題.名稱((主題.目前+1)%主題.數量,語言.目前),函式(){ 套用主題((主題.目前+1)%主題.數量); });
    如果 (語言.目前==0) { 加("切換為繁體中文","地球","Language",函式(){ 套用語言(1); }); } 否則 { 加("Switch to English","地球","語言",函式(){ 套用語言(0); }); }
    加(字("切換側欄"),"側欄","Ctrl+B",切換側欄); 加(字("儲存完整備份"),"儲存","Ctrl+S",手動儲存); 加(字("載入備份"),"開啟","Ctrl+O",手動載入);
    如果 (板!=空值) { 加(字("匯出 CSV"),"匯出",字("指令"),函式(){ 匯出看板("csv"); }); 加(字("匯出 Markdown"),"匯出",字("指令"),函式(){ 匯出看板("md"); }); 加(字("看板設定"),"設定",字("指令"),看板設定); }
    加(字("鍵盤快捷鍵"),"鍵盤","?",開快捷鍵); 加(字("重新觀看入門導覽"),"說明",字("指令"),開始導覽);
    如果 (引擎.可復原()) { 加(格式("復原：{0}",[引擎.下個復原()]),"復原","Ctrl+Z",復原操作); }
    # 看板
    迴圈 (變數 甲=0; 甲<長度(資料()["工作區"]); 甲++) { 變數 工區=資料()["工作區"][甲]; 如果 (!工區["封存"]) { 迴圈 (變數 乙=0; 乙<長度(工區["看板"]); 乙++) { 變數 目標板=工區["看板"][乙]; 如果 (!目標板["封存"]) { 加(目標板["名稱"],"看板",工區["名稱"],函式(){ 開看板(目標板); }); } } } }
    # 卡片（跨看板）
    如果 (查!="") { 變數 數=0;
        迴圈 (變數 甲=0; 甲<長度(資料()["工作區"]); 甲++) { 變數 工區=資料()["工作區"][甲]; 如果 (!工區["封存"]) { 迴圈 (變數 乙=0; 乙<長度(工區["看板"]); 乙++) { 變數 目標板=工區["看板"][乙]; 如果 (!目標板["封存"]) { 迴圈 (變數 丙=0; 丙<長度(目標板["清單"]); 丙++) { 變數 列=目標板["清單"][丙]; 如果 (!列["封存"]) { 迴圈 (變數 丁=0; 丁<長度(列["卡片"]); 丁++) { 變數 卡=列["卡片"][丁];
            如果 (!卡["封存"] && 數<40) { 如果 (引擎.寬鬆包含(引擎.卡片文字(卡),查)) { 變數 卡號=卡["編號"]; 結果=加入(結果,{"文字":卡["名稱"],"圖示":"卡片","說明":目標板["名稱"]+" / "+列["名稱"],"動作":函式(){ 開看板(目標板); 開詳情(卡號); }}); 數++; } }
        } } } } } } }
    }
    回傳 結果;
};
變數 指令執行=函式() { 變數 項們=指令項目(對話資料["查詢"]); 變數 位=對話資料["焦點"]; 如果 (位>=0 && 位<長度(項們)) { 變數 動=項們[位]["動作"]; 關全部對話(); 動(); } };
變數 繪指令面板=函式() {
    變數 寬=最小(660,版寬-24); 變數 高=最小(520,版高-80); 變數 左=(版寬-寬)/2; 變數 上=最大(20,版高*0.12d); 變數 進=時間進度(對話開啟,150);
    陰影框(左,上,寬,高,16,10); 圓角框(左,上,寬,高,面板,強邊線,16); 登記(左,上,寬,高,函式(){},字("搜尋與指令"),"面板",空值);
    輸入欄("指令搜尋",對話資料["查詢"],左+16,上+16,寬-32,44,函式(值){ 對話資料["查詢"]=值; 對話資料["焦點"]=0; },{"圖示":"搜尋","大小":16,"占位":字("搜尋看板、卡片與指令"),"標籤":字("搜尋與指令"),"提交":指令執行,"取消":關對話});
    變數 項們=指令項目(對話資料["查詢"]); 變數 列高=44.0d; 變數 視上=上+72; 變數 視野=高-110;
    如果 (對話資料["焦點"]>=長度(項們)) { 對話資料["焦點"]=最大(0,長度(項們)-1); }
    捲動.設定(詳情捲動,寬,長度(項們)*列高+8,寬,視野); 捲動.顯示縱向(詳情捲動,對話資料["焦點"]*列高,對話資料["焦點"]*列高+列高,假);
    設裁切([左+1,視上,寬-2,視野]); 登記區("詳情",[左,視上,寬,視野]);
    變數 起=畫.向下取整(詳情捲動["縱"]/列高); 變數 終=最小(長度(項們),起+畫.向上取整(視野/列高)+1);
    迴圈 (變數 索=起;索<終;索++) {
        變數 甲=項們[索]; 變數 縱=視上+4+索*列高-詳情捲動["縱"]; 變數 本=索; 變數 鍵=區鍵("按鈕",甲["文字"],左+8,縱);
        如果 (對話資料["焦點"]==索) { 實框(左+8,縱,寬-16,列高-4,透明(薄荷,40),8); } 否則如果 (滑過鍵==鍵) { 實框(左+8,縱,寬-16,列高-4,卡滑過,8); }
        繪圖示(甲["圖示"],左+32,縱+20,16,次墨); 短文(甲["文字"],左+52,縱+25,寬-240,14,墨); 右顯示(截斷(甲["說明"],170,12),左+寬-24,縱+25,12,淡墨);
        登記(左+8,縱,寬-16,列高-4,函式(){ 對話資料["焦點"]=本; 指令執行(); },甲["文字"],"按鈕",空值);
    }
    設裁切(空值);
    如果 (長度(項們)==0) { 置中顯示(字("找不到符合的項目。"),左+寬/2,視上+60,14,淡墨); }
    分隔線(左+1,上+高-34,寬-2); 顯示(字("上下鍵選擇 · 換行鍵執行 · 離開鍵關閉"),左+20,上+高-12,11,淡墨);
    淡入(左,上,寬,高,進);
};

# ── 快捷鍵說明 ────────────────────────────────────────────
變數 開快捷鍵=函式() { 關全部對話(); 開對話("快捷鍵",{}); };
變數 快捷鍵表=函式() { 回傳 [
    ["Ctrl+K",字("搜尋看板、卡片與指令")],["Ctrl+F  /  /",字("聚焦搜尋")],["Ctrl+Z",字("復原")],["Ctrl+Shift+Z  ·  Ctrl+Y",字("重做")],
    ["Ctrl+S",字("儲存完整備份")],["Ctrl+O",字("載入備份")],["Ctrl+B",字("切換側欄")],["Ctrl+ +  /  −  /  0",字("放大、縮小、重設介面")],
    ["N",字("在目前清單新增卡片")],["← → ↑ ↓",字("在卡片之間移動")],["Alt + ← → ↑ ↓",字("移動選中的卡片")],["Enter",字("開啟卡片")],["D",字("切換完成")],
    ["Ctrl+A",字("選取全部卡片")],["Ctrl+C / X / V",字("複製、剪下、貼上卡片")],["Ctrl+D",字("建立卡片複本")],["Delete",字("封存選取的卡片")],
    ["Tab  /  Shift+Tab",字("在功能之間移動焦點")],["Esc",字("關閉、取消或清除選取")],["?",字("顯示這份說明")],
    [字("右鍵"),字("卡片、清單、文字與日曆的更多動作")],[字("雙擊文字"),字("選取字詞；三擊選取整行")]
]; };
變數 繪快捷鍵=函式() {
    變數 寬=最小(880,版寬-24); 變數 表=快捷鍵表(); 變數 雙=寬>620; 變數 每欄=長度(表); 如果 (雙) { 每欄=(長度(表)+1)/2; }
    變數 高=最小(每欄*40+110,版高-40); 變數 位=對話框(寬,高); 變數 左=位[0]; 變數 上=位[1];
    繪圖示("鍵盤",左+40,上+38,20,薄荷); 顯示(字("鍵盤快捷鍵"),左+62,上+45,21,墨); 圖示鈕("關閉",左+寬-52,上+16,34,關對話,字("關閉"),"幽靈",假);
    變數 視野=高-90;
    捲動.設定(詳情捲動,寬,每欄*40+10,寬,視野); 設裁切([左+1,上+76,寬-2,視野]); 登記區("詳情",[左,上+76,寬,視野]);
    變數 欄寬=寬-56; 如果 (雙) { 欄寬=(寬-56-24)/2; }
    迴圈 (變數 索=0;索<長度(表);索++) {
        變數 欄=0; 變數 列=索; 如果 (雙 && 索>=每欄) { 欄=1; 列=索-每欄; }
        變數 橫=左+28+欄*(欄寬+24); 變數 縱=上+80+列*40-詳情捲動["縱"];
        變數 鍵寬=最小(欄寬*0.45d,量(表[索][0],12)+20); 實框(橫,縱+4,鍵寬,26,卡底,6); 圓角框(橫,縱+4,鍵寬,26,卡底,邊線,6); 短文(表[索][0],橫+10,縱+22,鍵寬-14,12,墨);
        短文(表[索][1],橫+鍵寬+12,縱+22,欄寬-鍵寬-14,13,次墨);
    }
    設裁切(空值); 淡入(左,上,寬,高,位[2]);
};

# ── 入門導覽（聚光燈） ────────────────────────────────────
變數 開始導覽=函式() { 關全部對話(); 頁面="看板"; 檢視="流動"; 教學=0; 畫.重繪(); };
變數 完成教學=函式() { 教學=-1; 資料()["導覽完成"]=真; 儲存空間.設定偏好(儲存前綴+".tutorial",真); 排程儲存(300.0d); 畫.重繪(); };
變數 找區=函式(種類,標籤) { 迴圈 (變數 索=0;索<長度(命中區);索++) { 變數 區=命中區[索]; 如果 (區[6]==種類 && (標籤=="" || 區[5]==標籤)) { 回傳 [區[0],區[1],區[2],區[3]]; } } 回傳 空值; };
變數 導覽步驟=函式() { 回傳 [
    [字("歡迎，讓想法開始流動"),字("這是一份可以放心嘗試的範例看板。接下來用幾個步驟認識主要功能，隨時可以按離開鍵略過。"),空值],
    [字("工作空間與看板"),字("左側切換工作空間與看板。收藏的看板會出現在最上方；按 Ctrl+B 可以收合側欄。"),[0,頂欄高,側欄寬,版高-頂欄高-狀態列高]],
    [字("把下一步，放進一張卡片"),字("按住卡片拖到另一欄改變進度；點開卡片可寫說明、日期、檢查表與附件。在卡片上按右鍵可看到更多動作。"),找區("卡片","")],
    [字("快速找到需要的內容"),字("搜尋與篩選只影響畫面，不會改動卡片。看板、表格與日曆三種檢視可在右上角切換。"),找區("輸入",字("搜尋卡片"))],
    [字("隨時找到任何東西"),字("按 Ctrl+K 搜尋所有看板與卡片，也能執行指令，例如切換主題或語言。"),找區("按鈕",字("搜尋與指令"))],
    [字("每一次修改，都有地方安放"),字("修改會自動儲存。儲存備份會匯出含附件的完整檔案，可在桌面版與網頁版之間搬移。"),找區("按鈕",字("儲存備份"))]
]; };
變數 繪教學=函式() {
    變數 步們=導覽步驟(); 如果 (教學>=長度(步們)) { 教學=長度(步們)-1; } 變數 步=步們[教學]; 變數 目標=步[2];
    命中區=[]; 語意節點=[]; 畫.停用描邊();
    如果 (目標==空值) { 畫.填色(遮罩); 畫.矩形(0,0,版寬,版高); }
    否則 {
        變數 甲=目標[0]-6; 變數 乙=目標[1]-6; 變數 丙=目標[2]+12; 變數 丁=目標[3]+12; 甲=動值("導覽甲",甲,220); 乙=動值("導覽乙",乙,220); 丙=動值("導覽丙",丙,220); 丁=動值("導覽丁",丁,220);
        畫.填色(遮罩); 畫.矩形(0,0,版寬,乙); 畫.矩形(0,乙+丁,版寬,版高-乙-丁); 畫.矩形(0,乙,甲,丁); 畫.矩形(甲+丙,乙,版寬-甲-丙,丁);
        畫.停用填色(); 畫.描邊(薄荷); 畫.描邊粗細(2); 畫.矩形(甲,乙,丙,丁,12); 畫.停用描邊();
    }
    登記(0,0,版寬,版高,函式(){},字("導覽"),"遮罩",空值);
    變數 寬=最小(460,版寬-24); 變數 說行=分行(步[1],寬-56,14); 變數 高=170.0d+長度(說行)*22; 變數 左=(版寬-寬)/2; 變數 上=(版高-高)/2;
    如果 (目標!=空值) {
        左=限(目標[0],12,版寬-寬-12); 上=目標[1]+目標[3]+18;
        如果 (上+高>版高-12) { 上=目標[1]-高-18; } 如果 (上<12) { 左=限(目標[0]+目標[2]+18,12,版寬-寬-12); 上=限(目標[1],12,版高-高-12); }
    }
    陰影框(左,上,寬,高,14,10); 圓角框(左,上,寬,高,面板,薄荷,14); 登記(左,上,寬,高,函式(){},字("導覽"),"面板",空值);
    繪星標(左+38,上+36,24); 小標(格式("入門導覽 · {0}／{1}",[教學+1,長度(步們)]),左+64,上+40);
    顯示(步[0],左+28,上+78,19,墨); 段落(步[1],左+28,上+90,寬-56,長度(說行)*22+8,14,次墨);
    迴圈 (變數 索=0; 索<長度(步們); 索++) { 變數 色=邊線; 如果 (索==教學) { 色=薄荷; } 實框(左+28+索*16,上+高-62,8,8,色,4); }
    按鈕樣(字("略過導覽"),"",左+24,上+高-48,0,34,完成教學,"幽靈","",假);
    如果 (教學>0) { 按鈕樣(字("上一步"),"向左",左+寬-244,上+高-48,104,34,函式(){ 教學-=1; },"一般","",假); }
    變數 次字=字("下一步"); 如果 (教學==長度(步們)-1) { 次字=字("開始使用"); }
    按鈕樣(次字,"向右",左+寬-130,上+高-48,108,34,函式(){ 如果 (教學<長度(導覽步驟())-1) { 教學++; } 否則 { 完成教學(); } },"主要","",假);
};

# ── 手機版 ────────────────────────────────────────────────
變數 手機清單=0; 變數 手機搜尋=假;
變數 手機選單=函式() {
    變數 項目=[];
    變數 區=取區(); 如果 (區!=空值) { 迴圈 (變數 索=0;索<長度(區["看板"]);索++) { 變數 板=區["看板"][索]; 如果 (!板["封存"]) { 項目=加入(項目,勾項(板["名稱"],板["編號"]==目前板 && 頁面=="看板",函式(){ 開看板(板); 手機清單=0; })); } } }
    項目=加入(項目,項(字("新增看板"),"加",新看板)); 項目=加入(項目,分隔());
    項目=加入(項目,項(字("切換工作空間"),"工作區",函式(){ 變數 選=[]; 迴圈 (變數 索=0; 索<長度(資料()["工作區"]); 索++) { 變數 工作=資料()["工作區"][索]; 如果 (!工作["封存"]) { 選=加入(選,勾項(工作["名稱"],工作["編號"]==目前區,函式(){ 選工作區(工作); 手機清單=0; })); } } 選=加入(選,項(字("建立工作區"),"加",新工作區)); 右鍵或彈出(字("選擇工作空間"),選); }));
    項目=加入(項目,項(字("範本"),"範本",函式(){ 頁面="範本"; 頁面捲動=捲動.建立(); }));
    項目=加入(項目,項(字("封存庫"),"封存",函式(){ 頁面="封存"; 頁面捲動=捲動.建立(); }));
    項目=加入(項目,項(字("設定"),"設定",函式(){ 頁面="設定"; 頁面捲動=捲動.建立(); }));
    項目=加入(項目,分隔());
    項目=加入(項目,{"文字":字("復原"),"圖示":"復原","停用":!引擎.可復原(),"動作":復原操作});
    項目=加入(項目,{"文字":字("重做"),"圖示":"重做","停用":!引擎.可重做(),"動作":重做操作});
    項目=加入(項目,項(字("儲存備份"),"儲存",手動儲存)); 項目=加入(項目,項(字("載入備份"),"開啟",手動載入));
    右鍵或彈出(字("星泉看板"),項目);
};
變數 繪手機頂欄=函式() {
    實框(0,0,版寬,頂欄高,側底,0); 分隔線(0,頂欄高-0.5d,版寬);
    圖示鈕("側欄",8,10,36,手機選單,字("選單"),"幽靈",假);
    變數 標題=字("星泉看板"); 如果 (頁面=="看板" && 取板()!=空值) { 標題=取板()["名稱"]; } 如果 (頁面=="範本") { 標題=字("範本"); } 如果 (頁面=="封存") { 標題=字("封存庫"); } 如果 (頁面=="設定") { 標題=字("設定"); }
    短文(標題,52,34,版寬-150,17,墨);
    如果 (頁面=="看板") {
        變數 搜樣="幽靈"; 如果 (手機搜尋 || 篩選中()) { 搜樣="選中"; } 圖示鈕("搜尋",版寬-88,10,36,函式(){ 手機搜尋=!手機搜尋; 如果 (!手機搜尋) { 重設篩選(); 結束編輯(); } },字("搜尋卡片"),搜樣,假);
        圖示鈕("更多",版寬-46,10,36,函式(){ 變數 板=取板(); 如果 (板==空值) { 回傳 空值; } 變數 列們=可見清單(板); 變數 項目=[項(字("新增清單"),"清單",新清單),項(字("看板設定"),"設定",看板設定)]; 如果 (長度(列們)>0) { 變數 列=列們[最小(手機清單,長度(列們)-1)]; 項目=加入(項目,分隔()); 項目=加入(項目,項(格式("清單設定：{0}",[列["名稱"]]),"更多",函式(){ 清單選單(列,空值); })); } 右鍵或彈出(字("看板"),項目); },字("看板動作"),"幽靈",假);
    } 否則 { 圖示鈕("看板",版寬-46,10,36,函式(){ 頁面="看板"; },字("看板"),"幽靈",假); }
};
變數 繪手機看板=函式() {
    變數 板=取板(); 變數 上=頂欄高+8;
    如果 (板==空值) { 置中顯示(字("開始你的第一份看板"),版寬/2,上+120,20,墨); 按鈕樣(字("建立看板"),"加",版寬/2-90,上+150,180,40,新看板,"主要","",假); 回傳 空值; }
    如果 (手機搜尋) {
        輸入欄("搜尋",查詢,12,上,版寬-24,40,函式(值){ 查詢=值; 清除篩選暫存(); },{"占位":字("搜尋卡片"),"圖示":"搜尋","標籤":字("搜尋卡片"),"清除":真,"提交":函式(){ 結束編輯(); }}); 上+=48;
        變數 位=12.0d; 變數 錨縱=上; 變數 狀寬=鈕寬(狀態名(狀態篩選),"篩選",13); 變數 狀樣="一般"; 如果 (狀態篩選!=0) { 狀樣="選中"; }
        按鈕樣(狀態名(狀態篩選),"篩選",位,上,狀寬,34,函式(){ 狀態選單([12,錨縱,狀寬,34]); },狀樣,"",假); 位+=狀寬+8;
        變數 標寬=鈕寬(字("標籤"),"標籤",13); 變數 標樣="一般"; 如果 (標籤篩選!="") { 標樣="選中"; } 變數 標位=位; 按鈕樣(字("標籤"),"標籤",位,上,標寬,34,函式(){ 收集選單([標位,錨縱,標寬,34],"標籤"); },標樣,"",假); 位+=標寬+8;
        如果 (篩選中()) { 圖示鈕("關閉",位,上,34,重設篩選,字("清除篩選"),"幽靈",假); }
        上+=44;
    }
    變數 列們=可見清單(板); 如果 (長度(列們)==0) { 置中顯示(字("這份看板還沒有清單。"),版寬/2,上+80,15,次墨); 按鈕樣(字("新增清單"),"加",版寬/2-80,上+100,160,40,新清單,"主要","",假); 回傳 空值; }
    手機清單=畫.向下取整(限(手機清單,0,長度(列們)-1)); 變數 列=列們[手機清單]; 變數 本列=列;
    # 清單切換列
    變數 滑=手機滑動; 圖示鈕("向左",8,上,36,函式(){ 手機切換(-1); },字("上一個清單"),"幽靈",手機清單==0);
    圖示鈕("向右",版寬-44,上,36,函式(){ 手機切換(1); },字("下一個清單"),"幽靈",手機清單>=長度(列們)-1);
    置中顯示(截斷(列["名稱"],版寬-170,16),版寬/2+滑*0.3d,上+18,16,墨);
    置中顯示(格式("{0}／{1} · {2} 張卡片",[手機清單+1,長度(列們),長度(篩卡(列))]),版寬/2,上+36,11,淡墨);
    登記(48,上,版寬-96,40,函式(){ 清單選單(本列,空值); },格式("清單：{0}",[列["名稱"]]),"清單頭",[列["編號"]]);
    上+=48;
    # 卡片
    變數 尾高=60.0d; 如果 (新增中列==列["編號"]) { 尾高=108.0d; }
    變數 高=版高-上-尾高; 變數 寬=版寬-24; 變數 版=列版面(列,寬); 變數 卡們=版[0]; 變數 頂們=版[1]; 變數 捲=取列捲動(列["編號"]);
    捲動.設定(捲,寬,版[2]+8,寬,高); 設裁切([0,上,版寬,高]); 登記區("手機清單",[0,上,版寬,高]);
    登記(0,上,版寬,高,函式(){},格式("清單內容：{0}",[列["名稱"]]),"清單空白",[0,列["編號"]]);
    變數 偏=捲["縱"]; 迴圈 (變數 位=0;位<長度(卡們);位++) { 變數 縱=上+頂們[位]-偏; 如果 (縱>上+高) { 中斷; } 如果 (縱+頂們[位+1]-頂們[位]>上) { 繪卡片(卡們[位],列,12+滑,縱,寬,"一般"); } }
    如果 (長度(卡們)==0) { 置中顯示(字("這份清單是空的。"),版寬/2,上+60,14,淡墨); }
    設裁切(空值);
    如果 (捲["內容高"]>高) { 變數 塊=捲動.滑塊(捲["內容高"],高,捲["縱"],高); 實框(版寬-5,上+塊[0],3,塊[1],強邊線,2); }
    # 新增
    變數 尾上=版高-尾高;
    實框(0,尾上,版寬,尾高,側底,0); 分隔線(0,尾上,版寬);
    如果 (新增中列==列["編號"]) {
        輸入欄("新增卡片"+字數(列["編號"]),新增文字,12,尾上+8,版寬-24,44,函式(值){ 新增文字=值; },{"占位":字("輸入卡片標題，按換行鍵新增"),"標籤":字("新卡片標題"),"提交":提交新增,"取消":取消新增});
        按鈕樣(字("新增"),"加",12,尾上+58,110,38,提交新增,"主要","",假); 按鈕樣(字("取消"),"",130,尾上+58,96,38,取消新增,"一般","",假);
    } 否則 { 按鈕樣(字("寫下下一步"),"加",12,尾上+10,版寬-24,40,函式(){ 開始新增(本列["編號"]); },"主要",格式("新增卡片到「{0}」",[列["名稱"]]),假); }
};
變數 手機切換=函式(方向) {
    變數 板=取板(); 如果 (板==空值) { 回傳 空值; } 變數 數=長度(可見清單(板)); 變數 新=手機清單+方向; 如果 (新<0 || 新>=數) { 回傳 空值; }
    手機清單=新; 新增中列=0; 結束編輯(); 動畫["手機滑"]=[方向*80.0d,0.0d,目前時間(),180]; 畫.重繪();
};

# ── 尺寸 ──────────────────────────────────────────────────
變數 更新尺=函式() {
    變數 寬=介面.寬度(); 變數 高=介面.高度();
    手機版=寬<760;
    自動比例=最大(1.0d,最小(最大(1,寬)/1440.0d,最大(1,高)/900.0d));
    比例=自動比例*介面百分比/100.0d;
    如果 (手機版) { 比例=限(寬/400.0d,0.85d,1.25d)*介面百分比/100.0d; }
    版寬=寬/比例; 版高=高/比例;
    鼠橫=介面.滑鼠橫()/比例; 鼠縱=介面.滑鼠縱()/比例;
    如果 (手機版) { 頂欄高=56.0d; 狀態列高=0.0d; 側欄寬=0.0d; }
    否則 { 頂欄高=60.0d; 狀態列高=34.0d; 變數 收=側欄收合 || 版寬<1000; 變數 目標=244.0d; 如果 (收) { 目標=64.0d; } 側欄寬=動值("側欄",目標,170); }
};
變數 頂區索=函式(橫,縱) { 迴圈 (變數 索=長度(命中區)-1; 索>=0; 索-=1) { 變數 區=命中區[索]; 如果 (命中(橫,縱,區[0],區[1],區[2],區[3])) { 回傳 索; } } 回傳 -1; };
變數 區鍵值=函式(區) { 回傳 區鍵(區[6],區[5],區[0],區[1]); };
# 視窗事件的按鈕：瀏覽器使用 DOM（2 右鍵、1 中鍵），桌面使用 GLFW（1 右鍵、2 中鍵）。
變數 指標按鈕有效=假;
變數 是右鍵=函式() { 如果 (指標按鈕有效) { 如果 (是網頁) { 回傳 指標按鈕==2; } 回傳 指標按鈕==1; } 回傳 介面.按鈕代碼()==1; };
變數 是中鍵=函式() { 如果 (指標按鈕有效) { 如果 (是網頁) { 回傳 指標按鈕==1; } 回傳 指標按鈕==2; } 回傳 介面.按鈕代碼()==2; };
變數 控制中=函式() { 回傳 指標修飾%4>=2 || 指標修飾%16>=8 || 畫.按鍵是否按下(341) || 畫.按鍵是否按下(345); };
變數 位移中=函式() { 回傳 指標修飾%2==1 || 畫.按鍵是否按下(340) || 畫.按鍵是否按下(344); };
變數 觸控中=函式() { 回傳 指標裝置=="touch" || 是安卓; };

# ── 右鍵 ──────────────────────────────────────────────────
變數 右鍵處理=函式(區) {
    變數 種類=區[6]; 變數 板=取板();
    如果 (種類=="輸入") {
        變數 識=區[7]; 如果 (編輯識別!=識) { 變數 動=區[4]; 動(); }
        變數 字位=點中字位(識,鼠橫,鼠縱); 變數 選=選取範圍(); 變數 起=最小(選[0],選[1]); 變數 終=最大(選[0],選[1]);
        如果 (字位<起 || 字位>終 || 起==終) { 安全選取(字位,字位); } 文字選單(); 回傳 空值;
    }
    結束編輯();
    如果 (種類=="卡片" || 種類=="表格列") { 焦點卡=區[7][0]; 卡片選單(區[7][0]); 回傳 空值; }
    如果 (板==空值) { 回傳 空值; }
    如果 (種類=="清單頭") { 變數 列=引擎.找清單(板,區[7][0]); 如果 (列!=空值) { 清單選單(列,空值); } 回傳 空值; }
    如果 (種類=="清單空白") {
        變數 列=引擎.找清單(板,區[7][1]); 如果 (列==空值) { 回傳 空值; } 變數 項目=[項(字("新增卡片"),"加",函式(){ 開始新增(列["編號"]); })];
        如果 (長度(卡片剪貼)>0) { 項目=加入(項目,{"文字":格式("貼上 {0} 張卡片",[長度(卡片剪貼)]),"圖示":"貼上","快捷":"Ctrl+V","動作":函式(){ 貼上卡片(列,長度(列["卡片"])); }}); }
        否則 { 項目=加入(項目,{"文字":字("貼上文字為卡片"),"圖示":"貼上","快捷":"Ctrl+V","動作":函式(){ 貼上卡片(列,長度(列["卡片"])); }}); }
        項目=加入(項目,分隔()); 項目=加入(項目,項(字("清單設定"),"更多",函式(){ 清單選單(列,空值); })); 右鍵選單(項目); 回傳 空值;
    }
    如果 (種類=="看板空白") { 右鍵選單([項(字("新增清單"),"清單",新清單),項(字("看板設定"),"設定",看板設定),項(字("選取全部卡片"),"選取",全選卡片),分隔(),項(字("切換側欄"),"側欄",切換側欄)]); 回傳 空值; }
    如果 (種類=="側欄看板") {
        變數 目標=引擎.找看板(區[7][0]); 如果 (目標==空值) { 回傳 空值; }
        變數 星字=字("加入收藏"); 如果 (目標["星號"]) { 星字=字("取消收藏"); }
        右鍵選單([項(字("開啟看板"),"看板",函式(){ 開看板(目標); }),項(星字,"星",函式(){ 執行改動(星字,函式(){ 目標["星號"]=!目標["星號"]; }); }),項(字("重新命名"),"編輯",函式(){ 表單(字("重新命名看板"),字("名稱"),目標["名稱"],函式(值){ 執行改動(字("重新命名看板"),函式(){ 目標["名稱"]=值; }); }); }),項(字("複製整份看板"),"複製",函式(){ 變數 所=引擎.找所屬區(目標["編號"]); 執行改動(字("複製看板"),函式(){ 開看板(引擎.複製看板(所,目標,目標["名稱"]+字("（複本）"))); }); }),分隔(),險項(字("封存看板"),"封存",函式(){ 執行改動(字("封存看板"),函式(){ 目標["封存"]=真; 校正選擇(); }); 提示(格式("已封存看板「{0}」。",[目標["名稱"]]),"資訊",字("復原"),函式(){ 復原操作(); }); })]);
        回傳 空值;
    }
    如果 (種類=="日曆格") { 變數 日=區[7][0]; 右鍵選單([項(格式("新增 {0} 到期的卡片",[日]),"加",函式(){ 日曆新增(日); })]); 回傳 空值; }
    如果 (種類=="步驟" || 種類=="步驟握把") { 變數 卡=取卡(); 如果 (卡!=空值) { 步驟選單(卡,區[7][0],區[7][1]); } 回傳 空值; }
};
變數 全選卡片=函式() { 變數 板=取板(); 如果 (板==空值) { 回傳 空值; } 多選=[]; 變數 列們=可見清單(板); 迴圈 (變數 索=0;索<長度(列們);索++) { 變數 卡們=篩卡(列們[索]); 迴圈 (變數 位=0;位<長度(卡們);位++) { 多選=加入(多選,卡們[位]["編號"]); } } 畫.重繪(); };

# ── 指標 ──────────────────────────────────────────────────
變數 按下處理=函式() {
    更新尺(); 指標按鈕有效=假; 收集視窗事件(-1.0d);
    變數 現=目前時間(); 長按起=現; 長按中=假; 手機拖縱=鼠縱; 手機拖橫=鼠橫; 手機捲動中=假; 速度樣本=[[現,鼠橫,鼠縱]];
    變數 索=頂區索(鼠橫,鼠縱);
    如果 (索<0) { 結束編輯(); 按下資訊=空值; 畫.重繪(); 回傳 空值; }
    停止捲動();
    變數 區=命中區[索]; 變數 種類=區[6];
    如果 (是右鍵()) { 按下資訊=空值; 右鍵處理(區); 畫.重繪(); 回傳 空值; }
    如果 (是中鍵()) { 回傳 空值; }
    按下鍵=區鍵值(區); 按下資訊={"區":區,"橫":鼠橫,"縱":鼠縱,"時":現};
    變數 保留=假; 如果 (對話=="選單") { 如果 (對話資料["保留編輯"]==真) { 保留=真; } }
    如果 (種類!="輸入" && 編輯器!=空值 && !保留) { 變數 同欄=假; 如果 (種類=="按鈕" && 區[5]==字("清除")) { 同欄=真; } 如果 (!同欄) { 結束編輯(); } }
    如果 (觸控中()) { 介面.延遲重繪(520); }
    如果 (種類=="捲軸") { 變數 元=區[7]; 變數 座=鼠縱; 如果 (元[1]) { 座=鼠橫; } 變數 抓=座-元[2]-元[4]; 如果 (抓<0 || 抓>元[5]) { 抓=元[5]/2; } 滑塊拖曳=[元,抓]; 更新滑塊(); 指標="捲軸"; }
    否則如果 (種類=="輸入") {
        變數 識=區[7]; 如果 (編輯識別!=識) { 變數 動=區[4]; 動(); }
        如果 (現-上次點擊<420 && 畫.絕對值(鼠橫-點擊點[0])+畫.絕對值(鼠縱-點擊點[1])<6) { 點擊次數++; } 否則 { 點擊次數=1; } 上次點擊=現; 點擊點=[鼠橫,鼠縱];
        變數 字位=點中字位(識,鼠橫,鼠縱);
        如果 (點擊次數==2) { 選取字詞(字位); } 否則如果 (點擊次數>=3) { 選取整行(字位); } 否則如果 (位移中()) { 變數 選=選取範圍(); 安全選取(選[0],字位); } 否則 { 安全選取(字位,字位); }
        選字拖曳=識; 指標="選字"; 按下鍵="";
    }
    否則如果 (種類=="卡片" || 種類=="表格列") {
        變數 卡號=區[7][0];
        如果 (控制中()) { 選卡(卡號); 焦點卡=卡號; 按下資訊=空值; 按下鍵=""; }
        否則如果 (位移中() && 焦點卡!=0) { 範圍選取(焦點卡,卡號); 按下資訊=空值; 按下鍵=""; }
        否則如果 (種類=="卡片") { 卡片拖曳=[卡號,區[7][1],鼠橫,鼠縱,區[4],鼠橫-區[0],鼠縱-區[1]]; 指標="按卡"; }
        否則 { 指標="按下"; }
    }
    否則如果 (種類=="清單頭") { 清單拖曳=[區[7][0],鼠橫-區[0],鼠縱-區[1],假,鼠橫,鼠縱]; 指標="按清單"; }
    否則如果 (種類=="步驟握把") { 步驟拖曳=[區[7][0],區[7][1],鼠縱,假,區[0],420]; 指標="按步驟"; }
    否則如果 (種類=="日曆格") { 如果 (現-上次點擊<420) { 日曆新增(區[7][0]); 按下資訊=空值; } 上次點擊=現; }
    否則 { 指標="按下"; }
    畫.重繪();
};
變數 停止捲動=函式() { 捲動.停止(看板捲動); 捲動.停止(頁面捲動); 捲動.停止(詳情捲動); 捲動.停止(側欄捲動); 變數 值們=雜湊.值列表(列捲動); 迴圈 (變數 索=0;索<長度(值們);索++) { 捲動.停止(值們[索]); } };
變數 範圍選取=函式(起號,終號) {
    變數 板=取板(); 變數 列們=可見清單(板); 變數 全=[]; 迴圈 (變數 索=0;索<長度(列們);索++) { 變數 卡們=篩卡(列們[索]); 迴圈 (變數 位=0;位<長度(卡們);位++) { 全=加入(全,卡們[位]["編號"]); } }
    變數 甲=陣列.尋找(全,起號); 變數 乙=陣列.尋找(全,終號); 如果 (甲<0 || 乙<0) { 選卡(終號); 回傳 空值; }
    如果 (甲>乙) { 變數 暫=甲; 甲=乙; 乙=暫; } 迴圈 (變數 索=甲;索<=乙;索++) { 如果 (!已選(全[索])) { 多選=加入(多選,全[索]); } } 焦點卡=終號;
};
變數 更新滑塊=函式() { 如果 (滑塊拖曳==空值) { 回傳 空值; } 變數 元=滑塊拖曳[0]; 變數 座=鼠縱; 如果 (元[1]) { 座=鼠橫; } 捲動.拖曳(元[0],元[1],座-元[2]-滑塊拖曳[1],元[3]); };
# 依指標位置找出要捲動的區域。
變數 找捲動區=函式(名) { 變數 結果=空值; 迴圈 (變數 索=0;索<長度(捲動區們);索++) { 如果 (捲動區們[索][0]==名) { 結果=捲動區們[索][1]; } } 回傳 結果; };
變數 指標捲動區=函式(橫,縱) {
    如果 (對話!="") { 如果 (對話=="詳情" || 對話=="選單" || 對話=="活動" || 對話=="看板設定" || 對話=="指令" || 對話=="快捷鍵") { 回傳 [詳情捲動,假]; } 回傳 空值; }
    如果 (手機版) { 如果 (頁面=="看板") { 變數 板=取板(); 如果 (板==空值) { 回傳 空值; } 變數 列們=可見清單(板); 如果 (長度(列們)==0) { 回傳 空值; } 回傳 [取列捲動(列們[限(手機清單,0,長度(列們)-1)]["編號"]),假]; } 回傳 [頁面捲動,假]; }
    變數 側=找捲動區("側欄"); 如果 (側!=空值) { 如果 (命中(橫,縱,側[0],側[1],側[2],側[3])) { 回傳 [側欄捲動,假]; } }
    如果 (頁面!="看板") { 回傳 [頁面捲動,假]; }
    如果 (檢視=="流動") { 迴圈 (變數 索=0;索<長度(列幾何);索++) { 變數 幾=列幾何[索]; 如果 (!幾[5] && 命中(橫,縱,幾[1],幾[2],幾[3],幾[4])) { 回傳 [取列捲動(幾[0]),真]; } } 回傳 [看板捲動,真]; }
    回傳 [看板捲動,假];
};
變數 套用滾輪=函式(橫量,縱量,修) {
    如果 (教學>=0) { 回傳 空值; }
    如果 (修%4>=2 || 修%16>=8) { 如果 (縱量<0) { 設定介面縮放(介面百分比+10); } 否則如果 (縱量>0) { 設定介面縮放(介面百分比-10); } 回傳 空值; }
    如果 (修%2==1 && 橫量==0) { 橫量=縱量; 縱量=0.0d; }
    變數 目標=指標捲動區(鼠橫,鼠縱); 如果 (目標==空值) { 回傳 空值; } 變數 區=目標[0];
    # 看板空白處：直向滾輪改為橫向移動清單。
    如果 (目標[1] && 區==看板捲動 && 檢視=="流動") { 橫量+=縱量; 縱量=0.0d; }
    否則如果 (目標[1] && 橫量!=0) { 捲動.平滑移動(看板捲動,橫量,0); 橫量=0.0d; }
    如果 (減少動態) { 捲動.移動(區,橫量,縱量); } 否則 { 捲動.平滑移動(區,橫量,縱量); }
    畫.重繪();
};
變數 拖曳處理=函式() {
    更新尺(); 變數 現=目前時間(); 速度樣本=加入(速度樣本,[現,鼠橫,鼠縱]); 如果 (長度(速度樣本)>6) { 速度樣本=其餘(速度樣本); }
    如果 (長按中) { 回傳 空值; }
    如果 (選字拖曳!="") { 如果 (編輯器!=空值) { 變數 字位=點中字位(選字拖曳,鼠橫,鼠縱); 變數 選=選取範圍(); 安全選取(選[0],字位); } 畫.重繪(); 回傳 空值; }
    如果 (滑塊拖曳!=空值) { 更新滑塊(); 畫.重繪(); 回傳 空值; }
    如果 (按下資訊==空值) { 回傳 空值; }
    變數 移動量=畫.絕對值(鼠橫-按下資訊["橫"])+畫.絕對值(鼠縱-按下資訊["縱"]);
    如果 (觸控中() && !拖曳中) {
        如果 (移動量>8) { 手機捲動中=真; 卡片拖曳=空值; 清單拖曳=空值; 步驟拖曳=空值; 按下鍵=""; }
        如果 (手機捲動中) {
            變數 縱差=手機拖縱-鼠縱; 變數 橫差=手機拖橫-鼠橫; 手機拖縱=鼠縱; 手機拖橫=鼠橫;
            如果 (手機版 && 頁面=="看板" && 對話=="") { 變數 總橫=鼠橫-按下資訊["橫"]; 變數 總縱=鼠縱-按下資訊["縱"]; 如果 (畫.絕對值(總橫)>畫.絕對值(總縱)*1.4d && 畫.絕對值(總橫)>12) { 動畫["手機滑"]=[限(總橫,-120,120),限(總橫,-120,120),現,0]; 畫.重繪(); 回傳 空值; } }
            變數 目標=指標捲動區(按下資訊["橫"],按下資訊["縱"]); 如果 (目標!=空值) { 變數 區=目標[0]; 如果 (目標[1] && 區==看板捲動) { 捲動.移動(區,橫差,0); } 否則 { 捲動.移動(區,0,縱差); 如果 (目標[1]) { 捲動.移動(看板捲動,橫差,0); } } }
            畫.重繪(); 回傳 空值;
        }
    }
    如果 (卡片拖曳!=空值) { 如果 (移動量>6) { 如果 (!拖曳中) { 拖曳中=真; 指標="拖卡"; 焦點卡=卡片拖曳[0]; 介面.設定游標(視窗,"Move"); } }
        如果 (拖曳中 && 檢視=="日曆") { 日曆拖曳日=""; 變數 索=頂區索(鼠橫,鼠縱); 迴圈 (變數 次=索; 次>=0; 次-=1) { 如果 (命中區[次][6]=="日曆格" && 命中(鼠橫,鼠縱,命中區[次][0],命中區[次][1],命中區[次][2],命中區[次][3])) { 日曆拖曳日=命中區[次][7][0]; 中斷; } } }
    }
    如果 (清單拖曳!=空值) { 如果 (移動量>6 && !清單拖曳[3]) { 清單拖曳[3]=真; 指標="拖清單"; 介面.設定游標(視窗,"Move"); } }
    如果 (步驟拖曳!=空值) { 如果 (畫.絕對值(鼠縱-步驟拖曳[2])>4 && !步驟拖曳[3]) { 步驟拖曳[3]=真; 指標="拖步驟"; } }
    畫.重繪();
};
變數 清單拖曳已動=函式() { 如果 (清單拖曳==空值) { 回傳 假; } 回傳 清單拖曳[3]; };
變數 步驟拖曳已動=函式() { 如果 (步驟拖曳==空值) { 回傳 假; } 回傳 步驟拖曳[3]; };
變數 放開處理=函式() {
    更新尺(); 收集視窗事件(-1.0d);
    如果 (長按中) { 長按中=假; 按下資訊=空值; 按下鍵=""; 卡片拖曳=空值; 指標="閒置"; 畫.重繪(); 回傳 空值; }
    如果 (手機捲動中) {
        手機捲動中=假; 變數 總橫=0.0d; 如果 (按下資訊!=空值) { 總橫=鼠橫-按下資訊["橫"]; }
        如果 (手機版 && 頁面=="看板" && 對話=="" && 按下資訊!=空值 && 畫.絕對值(總橫)>70 && 畫.絕對值(總橫)>畫.絕對值(鼠縱-按下資訊["縱"])*1.4d) { 如果 (總橫<0) { 手機切換(1); } 否則 { 手機切換(-1); } }
        否則如果 (長度(速度樣本)>=2 && 按下資訊!=空值) {
            變數 甲=速度樣本[0]; 變數 乙=最後一個(速度樣本); 變數 時=乙[0]-甲[0];
            如果 (時>0 && 目前時間()-乙[0]<80) { 變數 目標=指標捲動區(按下資訊["橫"],按下資訊["縱"]); 如果 (目標!=空值 && !減少動態) { 捲動.慣性(目標[0],0,-(乙[2]-甲[2])/時); } }
        }
        動畫["手機滑"]=[0.0d,0.0d,0.0d,0]; 按下資訊=空值; 按下鍵=""; 卡片拖曳=空值; 拖曳中=假; 指標="閒置"; 畫.重繪(); 回傳 空值;
    }
    滑塊拖曳=空值; 選字拖曳="";
    變數 板=取板();
    如果 (卡片拖曳!=空值 && 拖曳中) {
        變數 卡號=卡片拖曳[0];
        如果 (檢視=="日曆") { 如果 (日曆拖曳日!="") { 變數 日=日曆拖曳日; 變數 找=引擎.找卡片(板,卡號); 如果 (找!=空值) { 執行改動(字("設定到期日"),函式(){ 如果 (找[1]["到期日"]==日) { 回傳 假; } 找[1]["到期日"]=日; }); } } }
        否則 {
            放置目標=計算放置目標();
            如果 (放置目標!=空值) {
                變數 目標=放置目標; 變數 組=[卡號]; 如果 (已選(卡號) && 長度(多選)>1) { 組=多選; }
                變數 失敗=假;
                執行改動(字("移動卡片"),函式(){ 變數 動=0; 變數 位=目標[1]; 迴圈 (變數 索=0;索<長度(組);索++) { 變數 找=引擎.找卡片(板,組[索]); 變數 原位=-1; 如果 (找!=空值) { 如果 (找[0]["編號"]==目標[0]) { 原位=找[2]; } } 如果 (引擎.移卡(板,組[索],目標[0],位)) { 動++; 如果 (原位<0 || 原位>=位) { 位++; } } 否則 { 如果 (找!=空值) { 如果 (找[0]["編號"]!=目標[0]) { 失敗=真; } } } } 如果 (動==0) { 回傳 假; } });
                如果 (失敗) { 提示(字("目標清單已達在製品上限。"),"警告","",空值); }
            }
        }
    } 否則如果 (卡片拖曳!=空值 && 指標=="按卡") { 變數 索=頂區索(鼠橫,鼠縱); 如果 (索>=0) { 如果 (命中區[索][6]=="卡片" && 命中區[索][7][0]==卡片拖曳[0]) { 變數 動=卡片拖曳[4]; 卡片拖曳=空值; 焦點卡=0; 動(); } } }
    否則如果 (清單拖曳已動()) {
        變數 目標=計算清單位置(); 變數 列號=清單拖曳[0]; 變數 實=長度(板["清單"]); 如果 (目標<長度(列幾何)) { 實=引擎.清單位置(板,列幾何[目標][0]); }
        執行改動(字("移動清單"),函式(){ 回傳 引擎.移清單(板,列號,實); });
    }
    否則如果 (步驟拖曳已動()) {
        變數 卡=取卡(); 如果 (卡!=空值) { 變數 表=卡["檢查表"][步驟拖曳[0]]; 變數 從=步驟拖曳[1]; 變數 到=步驟放置位(); 如果 (到>從) { 到-=1; }
            如果 (表!=空值 && 到!=從) { 執行改動(字("移動步驟"),函式(){ 表["項目"]=引擎.換位(表["項目"],從,到); }); } }
    }
    否則如果 (按下資訊!=空值 && 按下鍵!="") { 變數 索=頂區索(鼠橫,鼠縱); 如果 (索>=0) { 變數 區=命中區[索]; 變數 原=按下資訊["區"]; 如果 (區[6]==原[6] && 區[5]==原[5]) { 變數 動=區[4]; 按下鍵=""; 按下資訊=空值; 動(); } } }
    按下鍵=""; 按下資訊=空值; 卡片拖曳=空值; 拖曳中=假; 放置目標=空值; 清單拖曳=空值; 步驟拖曳=空值; 指標="閒置"; 日曆拖曳日="";
    更新游標(); 畫.重繪();
};
變數 更新游標=函式() {
    變數 名="Arrow"; 如果 (滑過區!=空值) { 變數 種=滑過區[6]; 如果 (種=="輸入") { 名="Text"; } 否則如果 (種=="按鈕" || 種=="開關" || 種=="卡片" || 種=="表格列" || 種=="側欄看板" || 種=="步驟" || 種=="捲軸") { 名="Hand"; } 否則如果 (種=="清單頭" || 種=="步驟握把") { 名="Move"; } }
    如果 (拖曳中 || 指標=="拖清單" || 指標=="拖步驟") { 名="Move"; } 如果 (指標=="選字") { 名="Text"; }
    介面.設定游標(視窗,名);
};
變數 計算滑過=函式() {
    變數 索=頂區索(鼠橫,鼠縱); 變數 新鍵=""; 變數 新區=空值; 如果 (索>=0) { 新區=命中區[索]; 新鍵=區鍵值(新區); 如果 (新區[6]=="遮罩" || 新區[6]=="面板" || 新區[6]=="看板空白" || 新區[6]=="清單空白") { 新鍵=""; } }
    滑過區=新區; 如果 (新鍵!=滑過鍵) { 滑過鍵=新鍵; 滑過起=目前時間(); 如果 (新區!=空值) { 如果 (新區[7]=="提示") { 介面.延遲重繪(500); } } 回傳 真; } 回傳 假;
};
變數 移動處理=函式() { 更新尺(); 如果 (計算滑過()) { 畫.重繪(); } 更新游標(); };

# ── 滾輪與視窗事件 ────────────────────────────────────────
變數 滾輪處理=函式() {
    更新尺(); 已收滾輪=假; 收集視窗事件(-1.0d);
    如果 (!已收滾輪 && !曾收滾輪) { 變數 量=-介面.滾輪()*48; 變數 修=0; 如果 (畫.按鍵是否按下(340) || 畫.按鍵是否按下(344)) { 修=1; } 套用滾輪(0.0d,量,修); }
    畫.重繪();
};
變數 待視窗事件=[]; 變數 待按鍵事件=[]; 變數 待按鍵起=[]; 變數 曾收滾輪=假;
變數 鍵碼=函式(文字) {
    如果 (文字==空值) { 回傳 -1; }
    變數 特=["Escape","Enter","Tab","Backspace","Insert","Delete","ArrowRight","ArrowLeft","ArrowDown","ArrowUp","PageUp","PageDown","Home","End"]; 迴圈 (變數 索=0;索<長度(特);索++) { 如果 (文字==特[索]) { 回傳 256+索; } }
    如果 (文字=="F2") { 回傳 291; } 如果 (文字==" ") { 回傳 32; }
    如果 (字串.開頭是(文字,"key:")) { 變數 數=字串.解析整數(片段(文字,4,長度(文字))); 如果 (數==空值) { 回傳 -1; } 回傳 數; }
    如果 (長度(文字)==1) { 變數 碼=字串.字元碼(文字,0); 如果 (碼>=97 && 碼<=122) { 回傳 碼-32; } 回傳 碼; }
    回傳 -1;
};
變數 收集視窗事件=函式(截止) {
    如果 (視窗==空值) { 回傳 空值; }
    # 按鍵通常在對應的按鍵／文字回呼中依時間處理，讓快速輸入與換行鍵保持順序；
    # 桌面主機以輪詢判斷按鍵，按下與放開落在同一格時不會送出回呼；此時等候 70 毫秒後由繪製補處理。
    變數 現=目前時間(); 變數 事們=待按鍵事件; 變數 起們=待按鍵起; 待按鍵事件=[]; 待按鍵起=[];
    變數 新們=視窗.輪詢(); 迴圈 (變數 索=0;索<長度(新們);索++) { 事們=加入(事們,新們[索]); 起們=加入(起們,現); }
    迴圈 (變數 索=0;索<長度(事們);索++) {
        變數 事=事們[索]; 變數 類=介面.事件類型(事);
        如果 (類=="keyPressed" || 類=="keyRepeat") {
            變數 逾時=!是網頁 && 截止<0 && 現-起們[索]>70;
            如果 (介面.事件時間(事)>截止 && !逾時) { 待按鍵事件=加入(待按鍵事件,事); 待按鍵起=加入(待按鍵起,起們[索]); 介面.延遲重繪(90); }
            否則如果 (!介面.事件組字(事)) { 變數 修=介面.事件修飾(事); 變數 控=修%4>=2 || 修%16>=8; 變數 移=修%2==1; 變數 替=修%8>=4; 按鍵命令(鍵碼(介面.事件按鍵(事)),控,移,替,介面.事件按鍵(事),修); }
        }
        否則如果 (類=="pointerPressed") { 指標修飾=介面.事件修飾(事); 變數 裝=介面.事件裝置(事); 如果 (裝!=空值) { 指標裝置=裝; } 變數 鈕=介面.事件按鈕(事); 如果 (鈕!=空值) { 指標按鈕=鈕; 指標按鈕有效=真; } }
        否則如果 (類=="wheel") {
            變數 橫=介面.事件滾橫(事); 變數 縱=介面.事件滾縱(事); 如果 (橫==空值) { 橫=0.0d; } 如果 (縱==空值) { 縱=0.0d; }
            變數 單=介面.事件滾單位(事); 變數 倍=1.0d; 如果 (單=="line") { 倍=40.0d; } 如果 (單=="page") { 倍=600.0d; }
            已收滾輪=真; 曾收滾輪=真; 更新尺(); 套用滾輪(橫*倍/比例,縱*倍/比例,介面.事件修飾(事));
        }
        否則 { 待視窗事件=加入(待視窗事件,事); }
    }
};
變數 文字處理=函式() { 收集視窗事件(介面.輸入時間()); 如果 (編輯器!=空值) { 編輯器.提交(介面.輸入()); 提交編輯(); } };
變數 按鍵處理=函式() { 收集視窗事件(介面.按鍵時間()); };

# ── 鍵盤 ──────────────────────────────────────────────────
變數 編輯鍵=函式(鍵,控,移,修) {
    如果 (控) {
        變數 字=""; 如果 (鍵==65) { 字="a"; } 如果 (鍵==67) { 字="c"; } 如果 (鍵==86) { 字="v"; } 如果 (鍵==88) { 字="x"; }
        如果 (字!="") { 編輯器.快速鍵(字,修); 如果 (鍵==86 || 鍵==88) { 提交編輯(); } 游標起=目前時間(); 畫.重繪(); 回傳 空值; }
    }
    如果 (鍵==259) { 編輯器.快速鍵("Backspace",修); 提交編輯(); }
    否則如果 (鍵==261) { 編輯器.快速鍵("Delete",修); 提交編輯(); }
    否則如果 (鍵==263) { 編輯器.快速鍵("ArrowLeft",修); }
    否則如果 (鍵==262) { 編輯器.快速鍵("ArrowRight",修); }
    否則如果 (鍵==268) { 編輯器.快速鍵("Home",修); }
    否則如果 (鍵==269) { 編輯器.快速鍵("End",修); }
    否則如果 (鍵==265) { 垂直移動(-1,移); }
    否則如果 (鍵==264) { 垂直移動(1,移); }
    否則如果 (鍵==257) {
        如果 (多行編輯 && !控) { 編輯器.提交(字串.從字元碼(10)); 提交編輯(); }
        否則如果 (編輯提交!=空值) { 變數 提=編輯提交; 提(); }
        否則如果 (對話=="表單") { 提交表單(); }
        否則 { 結束編輯(); }
    }
    游標起=目前時間(); 畫.重繪();
};
變數 移動焦點=函式(步) {
    如果 (長度(命中區)==0) { 回傳 空值; } 變數 可=[]; 迴圈 (變數 索=0;索<長度(命中區);索++) { 變數 種=命中區[索][6]; 如果 (種!="遮罩" && 種!="面板" && 種!="看板空白" && 種!="清單空白" && 種!="日曆格") { 可=加入(可,索); } }
    如果 (長度(可)==0) { 回傳 空值; } 變數 目前=-1; 迴圈 (變數 索=0;索<長度(可);索++) { 如果 (區鍵值(命中區[可[索]])==焦點鍵) { 目前=索; } }
    變數 新=目前+步; 如果 (目前<0 && 步<0) { 新=長度(可)-1; } 如果 (新<0) { 新=長度(可)-1; } 如果 (新>=長度(可)) { 新=0; }
    焦點鍵=區鍵值(命中區[可[新]]); 變數 區=命中區[可[新]]; 如果 (區[6]=="卡片") { 焦點卡=區[7][0]; }
};
變數 啟動焦點=函式() { 迴圈 (變數 索=0;索<長度(命中區);索++) { 如果 (區鍵值(命中區[索])==焦點鍵) { 變數 區=命中區[索]; 如果 (區[6]=="輸入") { 變數 動=區[4]; 動(); } 否則 { 變數 動=區[4]; 動(); } 回傳 真; } } 回傳 假; };
# 依方向在卡片之間移動焦點，必要時捲動到可見位置。
變數 卡片導覽=函式(橫向,縱向) {
    變數 板=取板(); 如果 (板==空值) { 回傳 空值; } 變數 列們=[]; 變數 全=可見清單(板); 迴圈 (變數 索=0;索<長度(全);索++) { 如果 (!全[索]["收合"]) { 列們=加入(列們,全[索]); } }
    如果 (長度(列們)==0) { 回傳 空值; } 變數 列索=0; 變數 位=0; 變數 找到=假;
    迴圈 (變數 索=0;索<長度(列們);索++) { 變數 卡們=篩卡(列們[索]); 迴圈 (變數 子=0;子<長度(卡們);子++) { 如果 (卡們[子]["編號"]==焦點卡) { 列索=索; 位=子; 找到=真; } } }
    如果 (找到) { 列索=畫.向下取整(限(列索+橫向,0,長度(列們)-1)); 位=位+縱向; }
    變數 卡們=篩卡(列們[列索]); 如果 (長度(卡們)==0) { 回傳 空值; } 位=畫.向下取整(限(位,0,長度(卡們)-1)); 焦點卡=卡們[位]["編號"]; 焦點鍵="";
    變數 版=篩選暫存[列們[列索]["編號"]]; 如果 (版!=空值) { 如果 (版[1]!=空值) { 捲動.顯示縱向(取列捲動(列們[列索]["編號"]),版[1][位],版[1][位+1]+20,!減少動態); } }
    迴圈 (變數 索=0;索<長度(列幾何);索++) { 如果 (列幾何[索][0]==列們[列索]["編號"]) { 變數 相對=列幾何[索][1]+看板捲動["橫"]-看板區[0]; 捲動.顯示橫向(看板捲動,相對-20,相對+列幾何[索][3]+20,!減少動態); } }
};
# Alt＋方向鍵移動焦點卡片。
變數 鍵盤移卡=函式(橫向,縱向) {
    變數 板=取板(); 變數 找=引擎.找卡片(板,焦點卡); 如果 (找==空值) { 回傳 空值; } 變數 列們=可見清單(板); 變數 列索=-1; 迴圈 (變數 索=0;索<長度(列們);索++) { 如果 (列們[索]["編號"]==找[0]["編號"]) { 列索=索; } }
    如果 (橫向!=0) { 變數 新=列索+橫向; 如果 (新<0 || 新>=長度(列們)) { 回傳 空值; } 執行改動(字("移動卡片"),函式(){ 如果 (!引擎.移卡(板,焦點卡,列們[新]["編號"],-1)) { 提示(字("目標清單已達在製品上限。"),"警告","",空值); 回傳 假; } }); }
    否則 { 變數 目標=找[2]+縱向; 如果 (縱向>0) { 目標=找[2]+2; } 如果 (目標<0 || 目標>長度(找[0]["卡片"])) { 回傳 空值; } 執行改動(字("移動卡片"),函式(){ 回傳 引擎.移卡(板,焦點卡,找[0]["編號"],目標); }); }
};
變數 焦點清單=函式() { 變數 板=取板(); 如果 (板==空值) { 回傳 空值; } 如果 (焦點卡!=0) { 變數 找=引擎.找卡片(板,焦點卡); 如果 (找!=空值) { 回傳 找[0]; } } 變數 列們=可見清單(板); 如果 (長度(列們)>0) { 回傳 列們[0]; } 回傳 空值; };
變數 操作卡片們=函式() { 如果 (長度(多選)>0) { 回傳 多選; } 如果 (焦點卡!=0) { 回傳 [焦點卡]; } 回傳 []; };
變數 按鍵命令=函式(鍵,控,移,替,邏輯,修) {
    如果 (鍵==256) {
        如果 (教學>=0) { 完成教學(); }
        否則如果 (卡片拖曳!=空值 || 清單拖曳!=空值 || 步驟拖曳!=空值) { 卡片拖曳=空值; 拖曳中=假; 放置目標=空值; 清單拖曳=空值; 步驟拖曳=空值; 指標="閒置"; 按下資訊=空值; 按下鍵=""; }
        否則如果 (編輯器!=空值) { 如果 (編輯取消!=空值) { 變數 取=編輯取消; 取(); } 否則如果 (對話=="表單" || 對話=="指令") { 關對話(); } 否則 { 結束編輯(); } }
        否則如果 (對話!="") { 如果 (對話=="選單" && 對話資料["保留編輯"]==真) { 關對話保留(); } 否則 { 關對話(); } }
        否則如果 (長度(多選)>0) { 多選=[]; }
        否則如果 (焦點卡!=0 || 焦點鍵!="") { 焦點卡=0; 焦點鍵=""; }
        否則如果 (篩選中()) { 重設篩選(); }
        畫.重繪(); 回傳 空值;
    }
    如果 (介面.組字中()) { 回傳 空值; }
    如果 (載入中) { 回傳 空值; }
    如果 (控 && 鍵==83) { 手動儲存(); 畫.重繪(); 回傳 空值; }
    如果 (控 && 鍵==79) { 手動載入(); 畫.重繪(); 回傳 空值; }
    如果 (控 && (鍵==90 || 鍵==89)) {
        變數 是重做=鍵==89 || 移;
        如果 (編輯器!=空值 && 編輯已改) { 如果 (是重做) { 編輯器.快速鍵("y",2); } 否則 { 編輯器.快速鍵("z",2); } 提交編輯(); 回傳 空值; }
        如果 (是重做) { 重做操作(); } 否則 { 復原操作(); } 回傳 空值;
    }
    如果 (控 && 鍵==75) { 開指令面板(); 回傳 空值; }
    如果 (控 && 鍵==66) { 切換側欄(); 回傳 空值; }
    如果 (控 && (鍵==61 || 鍵==43)) { 設定介面縮放(介面百分比+10); 回傳 空值; }
    如果 (控 && 鍵==45) { 設定介面縮放(介面百分比-10); 回傳 空值; }
    如果 (控 && 鍵==48) { 設定介面縮放(100); 回傳 空值; }
    如果 (控 && 鍵==70) { 如果 (頁面!="看板") { 頁面="看板"; } 關全部對話(); 如果 (手機版) { 手機搜尋=真; } 聚焦("搜尋",查詢,函式(值){ 查詢=值; 清除篩選暫存(); },假,""); 編輯提交=函式(){ 結束編輯(); }; 畫.重繪(); 回傳 空值; }
    如果 (鍵==258) { 結束編輯(); 如果 (移) { 移動焦點(-1); } 否則 { 移動焦點(1); } 畫.重繪(); 回傳 空值; }
    如果 (編輯器!=空值) { 編輯鍵(鍵,控,移,修); 回傳 空值; }
    如果 (教學>=0) { 如果 (鍵==257 || 鍵==262) { 如果 (教學<長度(導覽步驟())-1) { 教學++; } 否則 { 完成教學(); } } 如果 (鍵==263 && 教學>0) { 教學-=1; } 畫.重繪(); 回傳 空值; }
    如果 (對話=="選單") { 如果 (鍵==264) { 選單移動(1); } 如果 (鍵==265) { 選單移動(-1); } 如果 (鍵==257 || 鍵==32) { 如果 (對話資料["焦點"]>=0) { 選單執行(); } 否則 { 啟動焦點(); } } 畫.重繪(); 回傳 空值; }
    如果 (對話=="指令") { 如果 (鍵==264) { 對話資料["焦點"]=對話資料["焦點"]+1; } 如果 (鍵==265) { 對話資料["焦點"]=最大(0,對話資料["焦點"]-1); } 如果 (鍵==257) { 指令執行(); } 畫.重繪(); 回傳 空值; }
    如果 (對話=="表單" && 鍵==257) { 提交表單(); 畫.重繪(); 回傳 空值; }
    如果 (對話=="確認" && 鍵==257 && 焦點鍵=="") { 變數 處理=對話資料["提交"]; 關對話(); 處理(); 畫.重繪(); 回傳 空值; }
    如果 ((鍵==257 || 鍵==32) && 焦點鍵!="") { 如果 (啟動焦點()) { 畫.重繪(); 回傳 空值; } }
    如果 (對話!="") {
        如果 (鍵==267) { 捲動.平滑移動(詳情捲動,0,400); } 如果 (鍵==266) { 捲動.平滑移動(詳情捲動,0,-400); } 畫.重繪(); 回傳 空值;
    }
    如果 (頁面=="看板" && 取板()!=空值) {
        如果 (控 && 鍵==65) { 全選卡片(); 回傳 空值; }
        如果 (控 && 鍵==67) { 複製卡片們(操作卡片們(),假); 畫.重繪(); 回傳 空值; }
        如果 (控 && 鍵==88) { 複製卡片們(操作卡片們(),真); 畫.重繪(); 回傳 空值; }
        如果 (控 && 鍵==86) { 貼上目標(); 畫.重繪(); 回傳 空值; }
        如果 (控 && 鍵==68) { 如果 (焦點卡!=0) { 複製一張(焦點卡); } 畫.重繪(); 回傳 空值; }
        如果 (!控 && 檢視!="日曆") {
            如果 (替 && 焦點卡!=0) { 如果 (鍵==263) { 鍵盤移卡(-1,0); } 如果 (鍵==262) { 鍵盤移卡(1,0); } 如果 (鍵==265) { 鍵盤移卡(0,-1); } 如果 (鍵==264) { 鍵盤移卡(0,1); } 畫.重繪(); 回傳 空值; }
            如果 (鍵==263) { 卡片導覽(-1,0); } 如果 (鍵==262) { 卡片導覽(1,0); } 如果 (鍵==265) { 卡片導覽(0,-1); } 如果 (鍵==264) { 卡片導覽(0,1); }
            如果 (鍵==257 && 焦點卡!=0) { 開詳情(焦點卡); }
            如果 (鍵==68 && 焦點卡!=0) { 切換完成(焦點卡); }
            如果 (鍵==78) { 變數 列=焦點清單(); 如果 (列!=空值) { 開始新增(列["編號"]); } }
            如果 ((鍵==261 || 鍵==259) && 長度(操作卡片們())>0) { 封存卡片們(操作卡片們()); }
        }
    }
    如果 (鍵==47) { 如果 (移) { 開快捷鍵(); } 否則如果 (頁面=="看板") { 聚焦("搜尋",查詢,函式(值){ 查詢=值; 清除篩選暫存(); },假,""); } }
    如果 (鍵==63) { 開快捷鍵(); }
    變數 頁區=看板捲動; 如果 (頁面!="看板") { 頁區=頁面捲動; }
    如果 (鍵==267) { 捲動.平滑移動(頁區,0,400); } 如果 (鍵==266) { 捲動.平滑移動(頁區,0,-400); }
    畫.重繪();
};

# ── 錯誤 ──────────────────────────────────────────────────
變數 處理錯誤=函式() {
    變數 文=介面.錯誤文字(); 印出("星泉看板："+文); 載入中=假; 待載入=空值; 滑塊拖曳=空值; 卡片拖曳=空值; 拖曳中=假; 指標="閒置";
    記錄錯誤(文);
    如果 (正在儲存) { 正在儲存=假; 重試次數++; 存檔狀態=字("儲存失敗 · 將自動重試"); 如果 (重試次數<=3) { 排程儲存(2000.0d*重試次數); } 提示(格式("儲存失敗：{0}",[文]),"錯誤",字("立即重試"),函式(){ 自動存(); }); }
    否則 { 提示(格式("無法完成操作，現有內容仍保留。{0}",[文]),"錯誤","",空值); }
    畫.重繪();
};

# ── 主迴圈 ────────────────────────────────────────────────
變數 步進捲動=函式() {
    變數 進行=假; 變數 距=幀距;
    如果 (捲動.步進(看板捲動,距)) { 進行=真; } 如果 (捲動.步進(頁面捲動,距)) { 進行=真; } 如果 (捲動.步進(詳情捲動,距)) { 進行=真; } 如果 (捲動.步進(側欄捲動,距)) { 進行=真; }
    變數 值們=雜湊.值列表(列捲動); 迴圈 (變數 索=0;索<長度(值們);索++) { 如果 (捲動.步進(值們[索],距)) { 進行=真; } }
    迴圈 (變數 索=0;索<長度(對話堆疊);索++) { 如果 (捲動.步進(對話堆疊[索]["捲動"],距)) { 進行=真; } }
    回傳 進行;
};
# 拖曳靠近邊緣時持續捲動。
變數 邊緣捲動=函式() {
    如果 (!拖曳中 && !(清單拖曳!=空值)) { 回傳 空值; } 如果 (清單拖曳!=空值) { 如果 (!清單拖曳[3]) { 回傳 空值; } }
    如果 (頁面!="看板" || 檢視!="流動") { 回傳 空值; } 變數 速=0.0d;
    如果 (鼠橫<看板區[0]+70) { 速=-(看板區[0]+70-鼠橫)*0.018d; } 如果 (鼠橫>看板區[0]+看板區[2]-70) { 速=(鼠橫-(看板區[0]+看板區[2]-70))*0.018d; }
    如果 (速!=0) { 捲動.移動(看板捲動,速*幀距,0); 需要動畫=真; }
    如果 (拖曳中) { 迴圈 (變數 索=0;索<長度(列幾何);索++) { 變數 幾=列幾何[索]; 如果 (!幾[5] && 鼠橫>=幾[1] && 鼠橫<幾[1]+幾[3]) { 變數 縱速=0.0d; 如果 (鼠縱<幾[2]+50) { 縱速=-(幾[2]+50-鼠縱)*0.02d; } 如果 (鼠縱>幾[2]+幾[4]-50) { 縱速=(鼠縱-(幾[2]+幾[4]-50))*0.02d; } 如果 (縱速!=0) { 捲動.移動(取列捲動(幾[0]),0,縱速*幀距); 需要動畫=真; } } } }
};
變數 繪提示框=函式() {
    如果 (滑過區==空值) { 回傳 空值; } 如果 (滑過區[7]!="提示") { 回傳 空值; } 如果 (指標!="閒置") { 回傳 空值; }
    變數 經=目前時間()-滑過起; 如果 (經<480) { 回傳 空值; } 變數 文=滑過區[5]; 變數 寬=量(文,12)+20; 變數 左=限(滑過區[0]+滑過區[2]/2-寬/2,6,版寬-寬-6); 變數 上=滑過區[1]+滑過區[3]+6; 如果 (上+28>版高) { 上=滑過區[1]-34; }
    圓角框(左,上,寬,26,墨,空值,6); 顯示(文,左+10,上+18,12,底);
};
變數 繪載入=函式() { 畫.填色(遮罩); 畫.矩形(0,0,版寬,版高); 命中區=[]; 登記(0,0,版寬,版高,函式(){},字("載入中"),"遮罩",空值); 變數 寬=300.0d; 圓角框((版寬-寬)/2,版高/2-40,寬,80,面板,強邊線,14); 繪圖示("時鐘",(版寬-寬)/2+36,版高/2,20,薄荷); 顯示(字("正在載入備份…"),(版寬-寬)/2+60,版高/2+6,15,墨); };
變數 計時=[];
變數 繪製=函式() {
    收集視窗事件(-1.0d);
    變數 現=目前時間(); 幀距=限(現-上幀,1,100); 如果 (現-上幀>400) { 幀距=16.0d; } 上幀=現; 需要動畫=假;
    如果 (待儲存期限>0 && 現>=待儲存期限) { 自動存(); }
    如果 (自動今日) { 變數 今日=目前日期(); 如果 (資料()["今日"]!=今日) { 資料()["今日"]=今日; 清除篩選暫存(); } }
    如果 (待載入!=空值) { 如果 (載入畫面) { 變數 檔=待載入; 待載入=空值; 載入畫面=假; 讀入資源(檔); 載入中=假; } 否則 { 載入畫面=真; 畫.重繪(); } }
    更新尺(); 介面.更新文字比例(比例); 畫.重設矩陣(); 畫.縮放(比例); 畫.停用裁切(); 命中區=[]; 語意節點=[]; 命中裁切=空值; 捲動區們=[];
    如果 (步進捲動()) { 需要動畫=真; } 邊緣捲動();
    畫.背景(底);
    如果 (手機版) {
        手機滑動=動值("手機滑",0.0d,200);
        如果 (頁面=="看板") { 繪手機看板(); } 否則如果 (頁面=="範本") { 繪範本(); } 否則如果 (頁面=="封存") { 繪封存(); } 否則 { 繪設定(); }
        繪手機頂欄();
    } 否則 {
        變數 計起=目前時間(); 如果 (頁面=="看板") { 繪看板(); } 否則如果 (頁面=="範本") { 繪範本(); } 否則如果 (頁面=="封存") { 繪封存(); } 否則 { 繪設定(); }
        變數 計甲=目前時間(); 繪頂欄(); 變數 計乙=目前時間(); 繪側欄(); 變數 計丙=目前時間(); 繪狀態列(); 計時=[計甲-計起,計乙-計甲,計丙-計乙,目前時間()-計丙];
    }
    如果 (對話!="") { 繪對話全部(); }
    如果 (教學>=0) { 繪教學(); }
    繪提示();
    如果 (載入中) { 繪載入(); }
    如果 (焦點鍵!="") { 迴圈 (變數 索=0;索<長度(命中區);索++) { 變數 區=命中區[索]; 如果 (區鍵值(區)==焦點鍵) { 畫.停用填色(); 畫.描邊(薄荷); 畫.描邊粗細(2); 畫.矩形(區[0]-3,區[1]-3,區[2]+6,區[3]+6,9); 畫.停用描邊(); } } }
    繪提示框();
    # 可及性樹只在畫面靜止時更新，避免捲動與動畫時每格重建。
    如果 (!需要動畫 && !拖曳中) { 介面.宣告語意(語意節點); } 變數 事件們=待視窗事件; 待視窗事件=[];
    迴圈 (變數 索=0; 索<長度(事件們); 索++) { 變數 事=事件們[索]; 如果 (介面.事件類型(事)=="closeRequested") {
        儲存未完成();
        如果 (未儲存) { 介面.取消關閉(視窗); 危險確認(字("仍有未儲存的修改"),字("自動儲存尚未完成。請返回重試儲存，或匯出完整備份。確認會直接離開。"),字("離開"),函式(){ 畫.結束(); }); } 否則 { 介面.接受關閉(視窗); }
    } }
    # 觸控長按開啟右鍵選單
    如果 (按下資訊!=空值 && 觸控中() && !手機捲動中 && !拖曳中 && !長按中) { 如果 (現-長按起>=500) { 長按中=真; 變數 區=按下資訊["區"]; 按下鍵=""; 卡片拖曳=空值; 右鍵處理(區); 畫.重繪(); } }
    如果 (計算滑過()) { 畫.重繪(); }
    如果 (需要動畫) { 畫.持續繪圖(); } 否則 { 畫.停止持續繪圖(); }
    # 初次字型與畫面資源建立後再繪一次，之後維持事件驅動繪製。
    如果 (!首繪完成) { 首繪完成=真; 畫.重繪(); }
};

# ── 啟動 ──────────────────────────────────────────────────
變數 讀偏好整數=函式(鍵,預設,最小,最大) { 變數 值=儲存空間.取得偏好(儲存前綴+鍵); 迴圈 (變數 候=最小;候<=最大;候++) { 如果 (值==候) { 回傳 候; } } 回傳 預設; };
變數 設定=函式() {
    首繪完成=假;
    介面百分比=100; 變數 已存縮放=儲存空間.取得偏好(儲存前綴+".ui-scale"); 迴圈 (變數 值=70;值<=150;值+=10) { 如果 (已存縮放==值) { 介面百分比=值; 中斷; } }
    變數 語=讀偏好整數(".language",0,0,1); 語言.設定(語); 引擎.設定語言(語);
    套主題(讀偏好整數(".theme",0,0,主題.數量-1)); 減少動態=讀偏好整數(".motion",0,0,1)==1; 側欄收合=讀偏好整數(".sidebar",0,0,1)==1;
    附件庫.設定(真,儲存前綴);
    畫.尺寸(1440,900,"P2D",字("星泉看板")); 介面.套用字型(14); 畫.文字行距(24); 介面.初始化文字輸入(); 變數 視窗庫=介面.視窗庫; 視窗=視窗庫.目前視窗(); 介面.設定標題(視窗,字("星泉看板"));
    介面.當按下(按下處理); 介面.當放開(放開處理); 介面.當拖曳(拖曳處理); 介面.當滾輪(滾輪處理); 介面.當按鍵(按鍵處理); 介面.當文字(文字處理); 介面.當尺寸(函式(){ 畫.重繪(); }); 介面.當組字(函式(){ 畫.重繪(); }); 介面.當錯誤(處理錯誤);
    介面.當移動(移動處理);
    清除篩選暫存(); 引擎.初始範例語言(語); 未儲存=假; 存檔狀態=字("準備好了");
    變數 已存=儲存空間.讀取(儲存前綴+".document"); 變數 備援=空值;
    如果 (已存!=空值) {
        變數 新=介面.解包(已存);
        如果 (引擎.載入(新)) { 上次封包=已存; 存檔狀態=字("已恢復上次內容"); 備援=介面.解包(儲存空間.讀取(儲存前綴+".backup")); 如果 (備援!=空值) { 如果 (!引擎.驗證文件(備援)) { 備援=空值; } } 附件庫.清理(引擎.文件,備援); }
        否則 { 變數 備=儲存空間.讀取(儲存前綴+".backup"); 變數 恢復=假; 如果 (備!=空值) { 恢復=引擎.載入(介面.解包(備)); }
            如果 (恢復) { 上次封包=備; 提示(字("已從上一份備援恢復內容，請匯出完整備份。"),"警告","",空值); } 否則 { 儲存鎖定=真; 存檔狀態=字("原有資料無效，已暫停自動儲存"); 提示(字("原有檔案仍保留，請由完整備份載入以恢復。"),"錯誤","",空值); } }
    }
    目前板=資料()["上次看板"]; 校正選擇(); 變數 教過=儲存空間.取得偏好(儲存前綴+".tutorial"); 如果 (!資料()["導覽完成"] && 教過!=真) { 教學=0; }
    畫.停止持續繪圖();
};
變數 啟動=函式() { 畫.執行(設定,繪製); };

# ── 測試與相容 ────────────────────────────────────────────
變數 儲存未完成文字=函式() { 儲存未完成(); };
變數 使用隔離儲存=函式(前綴) { 儲存前綴=前綴; 上次封包=空值; 儲存鎖定=假; };
變數 取得狀態=函式() { 回傳 {"文件":資料(),"是網頁":是網頁,"未儲存":未儲存,"目前板":目前板,"目前區":目前區,"頁面":頁面,"檢視":檢視,"對話":對話,"對話層數":長度(對話堆疊),"教學":教學,"訊息":訊息,"水平":看板捲動["橫"],"垂直":看板捲動["縱"],"詳情垂直":詳情捲動["縱"],"儲存耗時":儲存耗時,"介面百分比":介面百分比,"自動比例":自動比例,"介面比例":比例,"版寬":版寬,"版高":版高,"語言":語言.目前,"主題":主題.目前,"多選":多選,"焦點卡":焦點卡,"查詢":查詢,"標籤篩選":標籤篩選,"狀態篩選":狀態篩選,"側欄收合":側欄收合,"可復原":引擎.可復原(),"可重做":引擎.可重做(),"復原數":長度(引擎.復原堆疊),"編輯識別":編輯識別,"選取":選取範圍(),"存檔狀態":存檔狀態,"提示數":長度(提示們),"缺字":語言.缺少,"指標":指標,"按下鍵":按下鍵,"側欄縱":側欄捲動["縱"],"拖曳中":拖曳中,"計時":計時}; };
變數 建立壓力資料=函式() { 變數 板=取板(); 迴圈 (變數 索=0;索<16;索++) { 變數 列=引擎.建立清單(板,"Stress list "+字數(索+1)); 迴圈 (變數 位=0;位<250;位++) { 引擎.建立卡片(列,"Performance card "+字數(位+1)); } } 清除篩選暫存(); 畫.重繪(); };
變數 取得操作區=函式() { 變數 區們=[]; 迴圈 (變數 索=0;索<長度(命中區);索++) { 變數 區=命中區[索]; 區們=加入(區們,[區[0]*比例,區[1]*比例,區[2]*比例,區[3]*比例,區[5],區[6]]); } 回傳 區們; };
變數 列捲動值=函式(列號) { 回傳 取列捲動(列號)["縱"]; };
變數 清空卡片剪貼=函式() { 卡片剪貼=[]; 剪貼文字=""; };
