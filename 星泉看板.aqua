變數 換行="
"; 變數 定位="	";
# 星泉看板：應用程式、互動與繪製全由星泉編譯成 WebAssembly。
變數 介面=匯入("星泉介面.aqua"); 變數 引擎=匯入("看板引擎.aqua"); 變數 捲動=匯入("捲動區.aqua");
變數 附件庫=匯入("附件管理.aqua"); 變數 儲存前綴="xingquan-kanban";
變數 畫=介面.畫; 變數 空值=介面.空值;
變數 檔案=介面.檔案; 變數 儲存空間=介面.儲存空間; 變數 編輯庫=介面.編輯庫;
變數 資料=函式() { 回傳 引擎.文件; };
變數 是網頁=介面.網頁環境(); 變數 視窗=空值;
變數 目前板=0; 變數 目前區=0; 變數 頁面="看板"; 變數 檢視="流動";
變數 看板捲動=捲動.建立(); 變數 頁面捲動=捲動.建立(); 變數 詳情捲動=捲動.建立();
變數 命中區=[]; 變數 語意節點=[]; 變數 鍵盤焦點=-1; 變數 滑塊拖曳=空值;
變數 比例=1.0d; 變數 版寬=1440.0d; 變數 版高=900.0d; 變數 鼠橫=0.0d; 變數 鼠縱=0.0d;
變數 介面百分比=100; 變數 自動比例=1.0d;
變數 裁切=函式(橫,縱,寬,高) { 介面.裁切(橫,縱,寬,高,比例); };
變數 看板上緣=225.0d;
變數 卡片拖曳=空值; 變數 拖曳中=假; 變數 放置目標=空值;
變數 編輯器=空值; 變數 編輯識別=""; 變數 編輯回呼=空值; 變數 多行編輯=假;
變數 對話=""; 變數 對話資料=空值; 變數 詳情卡=0; 變數 教學=-1;
變數 查詢=""; 變數 標籤篩選=""; 變數 負責篩選=""; 變數 狀態篩選=0;
變數 多選=[]; 變數 未儲存=假; 變數 存檔狀態="準備好了"; 變數 儲存耗時=0.0d; 變數 載入中=假;
變數 訊息=""; 變數 附件預算=4194304;
變數 上次封包=空值; 變數 命中裁切=空值;
變數 儲存鎖定=假; 變數 自動今日=真;
變數 待儲存期限=0.0d;
變數 首繪完成=假;
變數 篩選暫存={}; 變數 表格暫存=空值;
變數 上次查詢=""; 變數 上次標籤=""; 變數 上次負責=""; 變數 上次狀態=0; 變數 上次今日="";
變數 清除篩選暫存=函式() { 篩選暫存={}; 表格暫存=空值; };
變數 墨=畫.顏色(231,236,233); 變數 次墨=畫.顏色(140,155,159); 變數 薄荷=畫.顏色(165,231,216);
變數 深底=畫.顏色(8,14,17); 變數 面板=畫.顏色(15,24,28); 變數 卡底=畫.顏色(22,33,37); 變數 邊線=畫.顏色(39,57,61);
變數 琥珀=畫.顏色(236,194,131); 變數 珊瑚=畫.顏色(233,146,143);
變數 色票=[畫.顏色(165,231,216),畫.顏色(166,188,232),畫.顏色(220,173,218),畫.顏色(236,194,131),畫.顏色(233,146,143),畫.顏色(171,204,146)];
變數 色名=["泉綠","星藍","暮紫","晨金","珊瑚","苔綠"]; 變數 狀態名=["全部卡片","尚未完成","已完成","今日與逾期","我關注的"];
變數 取板=函式() { 回傳 引擎.找看板(目前板); };
變數 取區=函式() { 回傳 引擎.找工作區(目前區); };
變數 取卡=函式() { 變數 找=引擎.找卡片(取板(),詳情卡); 如果 (找==空值) { 回傳 空值; } 回傳 找[1]; };
變數 字數=函式(數) { 回傳 引擎.文字化(數); };
變數 標籤文字=函式(標籤們) { 變數 文=""; 迴圈 (變數 索=0;索<長度(標籤們);索++) { 如果 (索>0) { 文+=" · "; } 文+=標籤們[索]; } 回傳 文; };
變數 命中=函式(橫,縱,左,上,寬,高) { 回傳 橫>=左 && 橫<左+寬 && 縱>=上 && 縱<上+高; };
變數 片段=函式(文字,起,終) { 變數 新=""; 迴圈 (變數 索=起; 索<終; 索++) { 如果 (索<長度(文字)) { 新+=文字[索]; } } 回傳 新; };
變數 整潔=函式(文字) { 變數 起=0; 變數 終=長度(文字); 迴圈 (變數 索=0;索<終;索++) { 如果 (文字[索]!=" " && 文字[索]!=換行 && 文字[索]!=定位) { 中斷; } 起++; } 迴圈 (變數 索=終-1;索>=起;索-=1) { 如果 (文字[索]!=" " && 文字[索]!=換行 && 文字[索]!=定位) { 中斷; } 終-=1; } 回傳 片段(文字,起,終); };
變數 餘數=函式(數,除數) { 回傳 畫.向下取整(數-畫.向下取整(數/(除數*1.0d))*除數); };
變數 顯示=函式(文字,橫,縱,大小,顏色) { 畫.填色(顏色); 介面.繪文字(文字,橫,縱,大小,比例,0); };
變數 短文=函式(文字,橫,縱,寬,大小,顏色) {
    介面.文字大小(大小,比例); 變數 新=文字; 如果 (介面.文字寬度(文字,比例)>寬) { 新=""; 迴圈 (變數 索=0;索<長度(文字);索++) { 如果 (介面.文字寬度(新+文字[索]+"…",比例)>寬) { 中斷; } 新+=文字[索]; } 新+="…"; } 顯示(新,橫,縱,大小,顏色);
};
變數 段落快取=[];
變數 分行=函式(文字,寬,大小) {
    介面.文字大小(大小,比例); 變數 密度=介面.像素密度();
    迴圈 (變數 索=0;索<長度(段落快取);索++) { 變數 存=段落快取[索]; 如果 (存[0]==文字 && 存[1]==寬 && 存[2]==大小 && 存[4]==比例 && 存[5]==密度) { 回傳 存[3]; } }
    變數 行們=[]; 變數 行=""; 變數 末斷=換行[長度(換行)-1]; 變數 前斷=換行[0];
    迴圈 (變數 索=0;索<長度(文字);索++) { 變數 字=文字[索]; 如果 (字==末斷) { 行們=加入(行們,行); 行=""; } 否則如果 (字!=前斷) { 如果 (長度(行)>0 && 介面.文字寬度(行+字,比例)>寬) { 行們=加入(行們,行); 行=""; } 行+=字; } }
    行們=加入(行們,行); 如果 (長度(段落快取)>=8) { 段落快取=其餘(段落快取); } 段落快取=加入(段落快取,[文字,寬,大小,行們,比例,密度]); 回傳 行們;
};
變數 段落=函式(文字,橫,縱,寬,高,大小,顏色) { 變數 行們=分行(文字,寬,大小); 迴圈 (變數 索=0;索<長度(行們);索++) { 如果 (索*(大小+9)+大小>高) { 中斷; } 顯示(行們[索],橫,縱+大小+索*(大小+9),大小,顏色); } };
變數 方框=函式(橫,縱,寬,高,底,線) { 畫.描邊(線); 畫.描邊粗細(1); 畫.填色(底); 畫.矩形(橫,縱,寬,高,10); 畫.停用描邊(); };
變數 登記=函式(橫,縱,寬,高,處理,文字,種類,資料) {
    如果 (命中裁切!=空值) { 變數 右=畫.最小值(橫+寬,命中裁切[0]+命中裁切[2]); 變數 下=畫.最小值(縱+高,命中裁切[1]+命中裁切[3]); 橫=畫.最大值(橫,命中裁切[0]); 縱=畫.最大值(縱,命中裁切[1]); 寬=右-橫; 高=下-縱; 如果 (寬<=0 || 高<=0) { 回傳 空值; } }
    如果 (縱+高<0 || 縱>版高 || 橫+寬<0 || 橫>版寬) { 回傳 空值; }
    命中區=加入(命中區,[橫,縱,寬,高,處理,文字,種類,資料]); 語意節點=加入(語意節點,介面.語意(長度(命中區),文字));
};
變數 按鈕=函式(文字,橫,縱,寬,處理,強調) {
    變數 底=面板; 變數 字色=墨; 如果 (強調) { 底=薄荷; 字色=深底; }
    如果 (命中(鼠橫,鼠縱,橫,縱,寬,34) && 對話=="") { 如果 (!強調) { 底=卡底; } }
    方框(橫,縱,寬,34,底,邊線); 短文(文字,橫+12,縱+22,寬-24,12,字色); 登記(橫,縱,寬,34,處理,文字,"按鈕",空值);
};
變數 結束編輯=函式() { 如果 (編輯器!=空值) { 編輯器.取消組字(); 介面.結束文字輸入(); } 編輯器=空值; 編輯識別=""; 編輯回呼=空值; };
變數 自動存=函式() {
    待儲存期限=0.0d; 畫.停止持續繪圖();
    如果 (儲存鎖定) { 存檔狀態="暫停自動儲存 · 請先載入有效備份"; 回傳 空值; }
    如果 (是網頁) { 存檔狀態="尚未匯出 · 請手動儲存"; 介面.防止關閉(視窗,未儲存); 回傳 空值; }
    變數 起=目前時間(); 變數 資料=介面.封包(引擎.文件);
    # 寫入採主機原子替換；保留上一份完整文件，失敗不清除未儲存標誌。
    如果 (上次封包!=空值) { 儲存空間.寫入(儲存前綴+".backup",上次封包); }
    儲存空間.寫入(儲存前綴+".document",資料);
    上次封包=資料;
    儲存耗時=目前時間()-起; 未儲存=假; 存檔狀態="已即時儲存"; 介面.防止關閉(視窗,假);
};
變數 改動=函式() { 清除篩選暫存(); 未儲存=真; 存檔狀態="正在儲存"; 介面.防止關閉(視窗,真); 自動存(); 畫.重繪(); };
變數 延後儲存=函式() { 清除篩選暫存(); 未儲存=真; 存檔狀態="文字輸入中 · 即將自動儲存"; 如果 (是網頁) { 自動存(); } 否則 { 介面.防止關閉(視窗,真); 待儲存期限=目前時間()+240.0d; 畫.持續繪圖(); } 畫.重繪(); };
變數 儲存未完成文字=函式() { 如果 (待儲存期限>0) { 自動存(); } };
變數 執行改動=函式(動作) { 引擎.記錄復原(); 動作(); 改動(); };
變數 開看板=函式(板) { 結束編輯(); 清除篩選暫存(); 目前板=板["編號"]; 目前區=(引擎.找所屬區(目前板))["編號"]; 資料()["上次看板"]=目前板; 頁面="看板"; 看板捲動=捲動.建立(); 查詢=""; 多選=[]; 詳情卡=0; 畫.重繪(); };
變數 開詳情=函式(編號) { 結束編輯(); 詳情卡=編號; 對話="詳情"; 詳情捲動=捲動.建立(); 畫.重繪(); };
變數 關對話=函式() { 結束編輯(); 對話=""; 對話資料=空值; 畫.重繪(); };
變數 聚焦=函式(識別,文字,回呼,多行,記錄) {
    如果 (編輯識別==識別) { 畫.開始文字輸入(); 回傳 空值; } 結束編輯(); 如果 (記錄) { 引擎.記錄復原(); }
    編輯器=編輯庫.建立(文字); 編輯器.選取(介面.編輯長度(編輯器),介面.編輯長度(編輯器)); 編輯識別=識別; 編輯回呼=回呼; 多行編輯=多行;
    畫.開始文字輸入();
};
變數 輸入框=函式(識別,名稱,內容,橫,縱,寬,高,回呼,多行,記錄) {
    顯示(名稱,橫,縱-10,11,次墨); 變數 線=邊線; 如果 (編輯識別==識別) { 線=薄荷; }
    方框(橫,縱,寬,高,深底,線); 變數 文=內容; 如果 (編輯識別==識別) { 文=介面.編輯內容(編輯器); }
    裁切(橫+8,縱+4,寬-16,高-8); 畫.填色(墨); 介面.文字大小(14,比例);
    如果 (多行) {
        變數 行們=分行(文,寬-24,14); 變數 起行=0; 變數 游行=0; 變數 游欄=0.0d; 變數 可視行=畫.向下取整(畫.最大值(1,(高-16)/22));
        如果 (編輯識別==識別) { 變數 位=編輯庫.轉換位置(文,介面.編輯游標(編輯器),"Grapheme","Utf16"); 變數 前行=分行(片段(文,0,位),寬-24,14); 游行=長度(前行)-1; 游欄=介面.文字寬度(前行[游行],比例); 起行=畫.向下取整(畫.最大值(0,游行-可視行+1)); }
        迴圈 (變數 索=起行;索<長度(行們);索++) { 如果 (索>=起行+可視行) { 中斷; } 顯示(行們[索],橫+12,縱+25+(索-起行)*22,14,墨); }
        如果 (編輯識別==識別) { 變數 游橫=橫+12+游欄; 變數 游縱=縱+10+(游行-起行)*22; 畫.填色(薄荷); 畫.矩形(游橫,游縱,1,19); 顯示(介面.組字(),游橫,游縱+15,14,薄荷); 畫.文字輸入矩形(畫.四捨五入(游橫*比例),畫.四捨五入(游縱*比例),1,畫.四捨五入(22*比例)); }
    } 否則 {
        變數 偏=0.0d; 如果 (編輯識別==識別) { 變數 位=編輯庫.轉換位置(文,介面.編輯游標(編輯器),"Grapheme","Utf16"); 變數 前=片段(文,0,位); 偏=畫.最大值(0,介面.文字寬度(前,比例)-寬+36); 變數 游=橫+12+介面.文字寬度(前,比例)-偏; 畫.填色(薄荷); 畫.矩形(游,縱+10,1,19); 顯示(介面.組字(),游,縱+25,14,薄荷); 畫.文字輸入矩形(畫.四捨五入(游*比例),畫.四捨五入((縱+9)*比例),1,畫.四捨五入(22*比例)); } 顯示(文,橫+12-偏,縱+25,14,墨);
    }
    畫.停用裁切(); 如果 (命中裁切!=空值) { 裁切(命中裁切[0],命中裁切[1],命中裁切[2],命中裁切[3]); } 登記(橫,縱,寬,高,函式(){ 聚焦(識別,內容,回呼,多行,記錄); },名稱,"輸入",空值);
};
變數 表單=函式(標題,欄名,預設,提交) { 結束編輯(); 對話="表單"; 對話資料={"標題":標題,"欄名":欄名,"值":預設,"提交":提交}; 畫.重繪(); };
變數 確認=函式(標題,說明,提交) { 結束編輯(); 對話="確認"; 對話資料={"標題":標題,"說明":說明,"提交":提交}; 畫.重繪(); };
變數 菜單=函式(標題,項目) { 結束編輯(); 對話="選單"; 對話資料={"標題":標題,"項目":項目}; 詳情捲動=捲動.建立(); 畫.重繪(); };
變數 手動儲存=函式() {
    結束編輯(); 變數 資源=介面.儲存檔("星泉看板備份.星板"); 如果 (資源==空值) { 訊息="已取消儲存。"; 回傳 空值; }
    變數 完整=附件庫.封裝(引擎.文件); 如果 (完整==空值) { 訊息="有附件檔案遺失，請先恢復附件再儲存備份。"; 回傳 空值; }
    檔案.儲存位元組(資源,介面.封包(完整),!是網頁); 未儲存=假; 存檔狀態="已匯出完整備份"; 如果 (是網頁) { 介面.防止關閉(視窗,假); } 訊息="備份包含所有工作區、範本與附件。";
};
變數 讀入資源=函式(資源) {
    載入中=真; 變數 新=介面.解包(檔案.讀取位元組(資源));
    如果 (!引擎.驗證文件(新)) { 載入中=假; 訊息="這份檔案不是支援的星泉看板備份。"; 回傳 空值; }
    如果 (!附件庫.載入(新)) { 載入中=假; 訊息="附件內容無效，尚未取代目前看板。"; 回傳 空值; }
    引擎.記錄復原(); 引擎.置換(新); 清除篩選暫存(); 目前板=資料()["上次看板"]; 校正選擇(); 載入中=假; 儲存鎖定=假; 關對話(); 未儲存=真; 自動存(); 訊息="已載入備份，可用復原回到載入前。";
};
變數 手動載入=函式() { 變數 資源=介面.開啟檔(); 如果 (長度(資源)==0) { 回傳 空值; } 變數 檔=資源[0]; 確認("載入備份","目前內容會由備份取代。可先按儲存保留一份，載入後亦可復原。",函式(){ 讀入資源(檔); }); };
變數 校正選擇=函式() {
    變數 板=取板(); 如果 (板!=空值) { 如果 (!板["封存"]) { 目前區=(引擎.找所屬區(目前板))["編號"]; 回傳 空值; } }
    目前板=0; 目前區=0; 迴圈 (變數 區=0; 區<長度(資料()["工作區"]); 區++) { 變數 工作=資料()["工作區"][區]; 如果 (!工作["封存"]) { 目前區=工作["編號"]; 迴圈 (變數 索=0; 索<長度(工作["看板"]); 索++) { 如果 (!工作["看板"][索]["封存"]) { 目前板=工作["看板"][索]["編號"]; 回傳 空值; } } } } 頁面="看板";
};
變數 復原操作=函式() { 結束編輯(); 如果 (引擎.復原()) { 關對話(); 校正選擇(); 改動(); 訊息="已復原上一個動作。"; } };
變數 重做操作=函式() { 結束編輯(); 如果 (引擎.重做()) { 關對話(); 校正選擇(); 改動(); 訊息="已重做。"; } };
變數 選工作區=函式(區) {
    結束編輯(); 清除篩選暫存(); 目前區=區["編號"]; 目前板=0; 頁面="看板";
    查詢=""; 標籤篩選=""; 負責篩選=""; 狀態篩選=0; 多選=[]; 詳情卡=0;
    卡片拖曳=空值; 拖曳中=假; 放置目標=空值; 滑塊拖曳=空值; 鍵盤焦點=-1; 看板捲動=捲動.建立();
    迴圈 (變數 索=0;索<長度(區["看板"]);索++) { 如果 (!區["看板"][索]["封存"]) { 開看板(區["看板"][索]); 回傳 空值; } }
    資料()["上次看板"]=0; 畫.重繪();
};
變數 新工作區=函式() { 表單("建立工作區","工作區名稱","",函式(名稱){ 執行改動(函式(){ 選工作區(引擎.建立工作區(名稱)); }); }); };
變數 新看板=函式() { 如果 (取區()==空值) { 新工作區(); 回傳 空值; } 表單("建立看板","看板名稱","",函式(名稱){ 執行改動(函式(){ 變數 板=引擎.建立看板(取區(),名稱); 引擎.建立清單(板,"靈感池"); 引擎.建立清單(板,"進行中"); 引擎.建立清單(板,"已完成"); 開看板(板); }); }); };
變數 新清單=函式() { 表單("新增清單","清單名稱","",函式(名稱){ 執行改動(函式(){ 引擎.建立清單(取板(),名稱); }); }); };
變數 新卡片=函式(列) { 表單("新增卡片","用一句話寫下下一步","",函式(名稱){ 如果 (!引擎.可移入(列)) { 訊息="這份清單已達在製品上限，請先完成或移動卡片。"; 回傳 空值; } 執行改動(函式(){ 變數 卡=引擎.建立卡片(列,名稱); 引擎.記事(取板(),"新增「"+名稱+"」。"); 開詳情(卡["編號"]); }); }); };
變數 看板設定=函式() {
    變數 板=取板(); 變數 項目=[];
    項目=加入(項目,["重新命名",函式(){ 表單("重新命名看板","名稱",板["名稱"],函式(值){ 執行改動(函式(){ 板["名稱"]=值; }); }); }]);
    項目=加入(項目,["編輯看板說明",函式(){ 表單("看板說明","說明",板["說明"],函式(值){ 執行改動(函式(){ 板["說明"]=值; }); }); }]);
    項目=加入(項目,["複製整份看板",函式(){ 表單("複製看板","新看板名稱",板["名稱"]+"（複本）",函式(值){ 執行改動(函式(){ 開看板(引擎.複製看板(取區(),板,值)); }); }); }]);
    項目=加入(項目,["保存為我的範本",函式(){ 表單("保存範本","範本名稱",板["名稱"],函式(值){ 執行改動(函式(){ 引擎.存範本(板,值); 訊息="範本已加入範本庫。"; }); }); }]);
    項目=加入(項目,["移至另一個工作區",函式(){ 變數 選=[]; 迴圈 (變數 索=0; 索<長度(資料()["工作區"]); 索++) { 變數 區=資料()["工作區"][索]; 如果 (!區["封存"] && 區["編號"]!=目前區) { 選=加入(選,[區["名稱"],函式(){ 執行改動(函式(){ 變數 原=取區(); 迴圈 (變數 位=0; 位<長度(原["看板"]); 位++) { 如果 (原["看板"][位]["編號"]==目前板) { 原["看板"]=引擎.去除(原["看板"],位); 中斷; } } 區["看板"]=加入(區["看板"],板); 目前區=區["編號"]; }); }]); } } 菜單("移動看板",選); }]);
    項目=加入(項目,["切換看板色系",函式(){ 執行改動(函式(){ 板["色系"]=餘數(板["色系"]+1,6); }); }]);
    變數 自動字="啟用完成欄自動完成"; 如果 (板["自動完成"]) { 自動字="停用完成欄自動完成"; }
    項目=加入(項目,[自動字,函式(){ 執行改動(函式(){ 板["自動完成"]=!板["自動完成"]; }); }]);
    項目=加入(項目,["查看看板活動",函式(){ 對話="活動"; 詳情捲動=捲動.建立(); 畫.重繪(); }]);
    項目=加入(項目,["封存看板",函式(){ 確認("封存看板","可稍後在封存庫恢復這份看板。",函式(){ 執行改動(函式(){ 板["封存"]=真; 校正選擇(); }); }); }]);
    菜單("看板設定",項目);
};
變數 清單設定=函式(列) {
    變數 板=取板(); 變數 項目=[];
    項目=加入(項目,["重新命名",函式(){ 表單("清單名稱","名稱",列["名稱"],函式(值){ 執行改動(函式(){ 列["名稱"]=值; }); }); }]);
    項目=加入(項目,["設定在製品上限（零表示不限）",函式(){ 表單("在製品上限","請輸入零至九百九十九",字數(列["上限"]),函式(值){ 變數 數=解析正整數(值); 如果 (數<0 || 數>999) { 訊息="上限必須是零至九百九十九的整數。"; 回傳 空值; } 執行改動(函式(){ 列["上限"]=數; }); }); }]);
    項目=加入(項目,["向左移動清單",函式(){ 執行改動(函式(){ 迴圈 (變數 索=0; 索<長度(板["清單"]); 索++) { 如果 (板["清單"][索]["編號"]==列["編號"]) { 板["清單"]=引擎.換位(板["清單"],索,索-1); 中斷; } } }); }]);
    項目=加入(項目,["向右移動清單",函式(){ 執行改動(函式(){ 迴圈 (變數 索=0; 索<長度(板["清單"]); 索++) { 如果 (板["清單"][索]["編號"]==列["編號"]) { 板["清單"]=引擎.換位(板["清單"],索,索+1); 中斷; } } }); }]);
    項目=加入(項目,["依到期日排序（未填日期排最後）",函式(){ 執行改動(函式(){ 變數 卡們=列["卡片"]; 迴圈 (變數 甲=0; 甲<長度(卡們); 甲++) { 迴圈 (變數 乙=甲+1; 乙<長度(卡們); 乙++) { 變數 甲日=引擎.日期數(卡們[甲]["到期日"]); 變數 乙日=引擎.日期數(卡們[乙]["到期日"]); 如果 (甲日==0) { 甲日=99999999; } 如果 (乙日==0) { 乙日=99999999; } 如果 (乙日<甲日) { 變數 暫=卡們[甲]; 卡們[甲]=卡們[乙]; 卡們[乙]=暫; } } } }); }]);
    項目=加入(項目,["切換為完成欄／一般欄",函式(){ 執行改動(函式(){ 列["完成欄"]=!列["完成欄"]; }); }]);
    項目=加入(項目,["複製這份清單",函式(){ 執行改動(函式(){ 變數 新=引擎.建立清單(板,列["名稱"]+"（複本）"); 新["上限"]=列["上限"]; 迴圈 (變數 索=0; 索<長度(列["卡片"]); 索++) { 引擎.複製卡(新,列["卡片"][索]); } }); }]);
    項目=加入(項目,["封存這欄已完成的卡片",函式(){ 執行改動(函式(){ 迴圈 (變數 索=0; 索<長度(列["卡片"]); 索++) { 如果 (列["卡片"][索]["完成"]) { 列["卡片"][索]["封存"]=真; } } }); }]);
    項目=加入(項目,["封存清單與卡片",函式(){ 確認("封存清單","整份清單會保留在封存庫。",函式(){ 執行改動(函式(){ 列["封存"]=真; }); }); }]);
    菜單("清單設定 · "+列["名稱"],項目);
};
變數 解析正整數=函式(文字) { 如果 (長度(文字)==0 || 長度(文字)>8) { 回傳 -1; } 變數 數=0; 變數 字="0123456789"; 迴圈 (變數 索=0; 索<長度(文字); 索++) { 變數 位=-1; 迴圈 (變數 找=0; 找<10; 找++) { 如果 (文字[索]==字[找]) { 位=找; } } 如果 (位<0) { 回傳 -1; } 數=數*10+位; } 回傳 數; };
變數 卡片移動=函式(卡號) { 變數 板=取板(); 變數 項目=[]; 迴圈 (變數 索=0; 索<長度(板["清單"]); 索++) { 變數 列=板["清單"][索]; 如果 (!列["封存"]) { 項目=加入(項目,[列["名稱"],函式(){ 執行改動(函式(){ 如果 (!引擎.移卡(板,卡號,列["編號"],-1)) { 訊息="目標清單已達在製品上限。"; } }); 開詳情(卡號); }]); } } 菜單("移動至清單",項目); };
變數 批次操作=函式() { 變數 板=取板(); 變數 項目=[]; 迴圈 (變數 索=0; 索<長度(板["清單"]); 索++) { 變數 列=板["清單"][索]; 如果 (!列["封存"]) { 項目=加入(項目,["移至「"+列["名稱"]+"」",函式(){ 執行改動(函式(){ 迴圈 (變數 位=0; 位<長度(多選); 位++) { 如果 (!引擎.移卡(板,多選[位],列["編號"],-1)) { 訊息="部分卡片受清單上限限制，尚未移動。"; } } 多選=[]; }); }]); } }
    項目=加入(項目,["標記全部完成",函式(){ 執行改動(函式(){ 迴圈 (變數 位=0; 位<長度(多選); 位++) { 變數 找=引擎.找卡片(板,多選[位]); 如果 (找!=空值) { 找[1]["完成"]=真; } } 多選=[]; }); }]);
    項目=加入(項目,["封存所選卡片",函式(){ 執行改動(函式(){ 迴圈 (變數 位=0; 位<長度(多選); 位++) { 變數 找=引擎.找卡片(板,多選[位]); 如果 (找!=空值) { 找[1]["封存"]=真; } } 多選=[]; }); }]); 菜單("批次處理 "+字數(長度(多選))+" 張卡片",項目);
};
變數 已選=函式(編號) { 迴圈 (變數 索=0; 索<長度(多選); 索++) { 如果 (多選[索]==編號) { 回傳 真; } } 回傳 假; };
變數 選卡=函式(編號) { 迴圈 (變數 索=0; 索<長度(多選); 索++) { 如果 (多選[索]==編號) { 多選=引擎.去除(多選,索); 回傳 空值; } } 多選=加入(多選,編號); };
變數 繪捲軸=函式(區,左,上,寬,高) {
    如果 (區["內容寬"]>區["視野寬"]) { 變數 塊=捲動.滑塊(區["內容寬"],區["視野寬"],區["橫"],寬); 畫.填色(卡底); 畫.矩形(左,上+高,寬,10,5); 畫.填色(次墨); 畫.矩形(左+塊[0],上+高,塊[1],10,5); 登記(左,上+高,寬,14,函式(){},"水平捲動條","捲軸",[區,真,左,寬,塊[0],塊[1]]); }
    如果 (區["內容高"]>區["視野高"]) { 變數 塊=捲動.滑塊(區["內容高"],區["視野高"],區["縱"],高); 畫.填色(卡底); 畫.矩形(左+寬,上,10,高,5); 畫.填色(次墨); 畫.矩形(左+寬,上+塊[0],10,塊[1],5); 登記(左+寬,上,14,高,函式(){},"垂直捲動條","捲軸",[區,假,上,高,塊[0],塊[1]]); }
};
變數 繪星標=函式(橫,縱) { 畫.停用填色(); 畫.描邊(薄荷); 畫.描邊粗細(1.4d); 畫.橢圓(橫,縱,32,18); 畫.線段(橫-12,縱-12,橫+12,縱+12); 畫.停用描邊(); 畫.填色(薄荷); 畫.圓形(橫,縱,5); };
變數 設定介面縮放=函式(百分比) {
    介面百分比=畫.向下取整(畫.限制範圍(百分比,70,150)/10)*10;
    儲存空間.設定偏好(儲存前綴+".ui-scale",介面百分比);
    滑塊拖曳=空值; 卡片拖曳=空值; 拖曳中=假; 放置目標=空值; 鍵盤焦點=-1; 上次滑過=-2;
    畫.重繪();
};
變數 縮放按鈕=函式(文字,名稱,橫,縱,寬,處理,啟用) {
    變數 底=面板; 變數 色=墨; 如果 (!啟用) { 色=次墨; }
    如果 (啟用 && 命中(鼠橫,鼠縱,橫,縱,寬,28)) { 底=卡底; }
    方框(橫,縱,寬,28,底,邊線); 畫.填色(色); 介面.繪文字(文字,橫+寬/2,縱+19,13,比例,2);
    如果 (啟用) { 登記(橫,縱,寬,28,處理,名稱,"按鈕",空值); }
};
變數 繪縮放=函式() {
    變數 左=版寬-166; 變數 上=版高-34;
    畫.停用裁切(); 命中裁切=空值; 畫.填色(深底); 畫.矩形(左-48,版高-39,214,39);
    顯示("介面",左-40,上+19,11,次墨);
    縮放按鈕("−","縮小介面",左,上,34,函式(){ 設定介面縮放(介面百分比-10); },介面百分比>70);
    縮放按鈕(字數(介面百分比)+"%","重設介面縮放（100%）",左+38,上,66,函式(){ 設定介面縮放(100); },真);
    縮放按鈕("+","放大介面",左+108,上,34,函式(){ 設定介面縮放(介面百分比+10); },介面百分比<150);
};
變數 繪外殼=函式() {
    畫.背景(深底); 畫.停用描邊(); 畫.填色(面板); 畫.矩形(0,78,220,版高-78); 畫.描邊(邊線); 畫.線段(0,77,版寬,77); 畫.線段(220,78,220,版高-40); 畫.停用描邊();
    繪星標(36,39); 顯示("星 泉 看 板",62,40,22,墨); 顯示("讓想法，找到流動的方向",64,59,10,次墨);
    變數 名們=["看板","範本"]; 迴圈 (變數 索=0; 索<長度(名們); 索++) { 變數 名=名們[索]; 變數 橫=290+索*96; 變數 字=次墨; 如果 (頁面==名) { 字=薄荷; 畫.填色(薄荷); 畫.矩形(橫,75,48,2); } 顯示(名,橫,44,14,字); 登記(橫-12,14,82,54,函式(){ 頁面=名; 頁面捲動=捲動.建立(); 結束編輯(); },名,"按鈕",空值); }
    按鈕("復原",版寬-390,23,66,復原操作,假); 按鈕("重做",版寬-314,23,66,重做操作,假); 按鈕("載入",版寬-232,23,66,手動載入,假); 按鈕("儲存備份",版寬-154,23,122,手動儲存,真);
    顯示("工 作 空 間",24,111,11,次墨); 變數 區=取區(); 變數 名="尚未建立"; 如果 (區!=空值) { 名=區["名稱"]; }
    按鈕(名+"  ▾",18,130,184,函式(){ 變數 項=[]; 迴圈 (變數 索=0; 索<長度(資料()["工作區"]); 索++) { 變數 工作=資料()["工作區"][索]; 如果 (!工作["封存"]) { 項=加入(項,[工作["名稱"],函式(){ 選工作區(工作); }]); } } 項=加入(項,["＋ 建立工作區",新工作區]); 如果 (取區()!=空值) { 項=加入(項,["工作空間設定",工作區設定]); } 菜單("選擇工作空間",項); },假);
    顯示("看 板 星 圖",24,202,11,次墨); 變數 縱=222.0d;
    如果 (區!=空值) { 變數 板們=區["看板"]; 迴圈 (變數 索=0; 索<長度(板們); 索++) { 變數 板=板們[索]; 如果 (!板["封存"] && 縱<版高-232) { 變數 顏=次墨; 如果 (板["編號"]==目前板 && 頁面=="看板") { 顏=薄荷; 畫.填色(卡底); 畫.矩形(12,縱-8,196,42,8); } 畫.填色(色票[板["色系"]]); 畫.圓形(26,縱+11,6); 短文(板["名稱"],40,縱+16,156,12,顏); 登記(12,縱-8,196,42,函式(){ 開看板(板); },"開啟看板："+板["名稱"],"按鈕",空值); 縱+=48; } } }
    按鈕("＋ 新增看板",18,畫.最小值(縱+6,版高-198),184,新看板,假);
    按鈕("封存庫",18,版高-144,184,函式(){ 頁面="封存"; 頁面捲動=捲動.建立(); },假);
    變數 存檔選項="立即重試自動儲存"; 如果 (是網頁) { 存檔選項="儲存完整備份"; }
    按鈕("使用導覽與設定",18,版高-98,184,函式(){ 菜單("使用導覽與設定",[["重新觀看入門導覽",函式(){ 教學=0; }],["設定今日日期（日期篩選基準）",函式(){ 表單("今日日期","年－月－日",資料()["今日"],函式(值){ 如果 (引擎.日期數(值)<=0) { 訊息="日期請使用西元年－月－日，例如二〇二六－十－十二的數字格式。"; 回傳 空值; } 執行改動(函式(){ 資料()["今日"]=值; 自動今日=假; }); }); }],[存檔選項,函式(){ 如果 (!是網頁) { 自動存(); } 否則 { 手動儲存(); } }]]); },假);
    畫.填色(深底); 畫.矩形(0,版高-40,版寬,40); 畫.描邊(邊線); 畫.線段(0,版高-40,版寬,版高-40); 畫.停用描邊();
    變數 文="桌面模式 · "+存檔狀態; 如果 (是網頁) { 文="網頁模式 · 手動存取 · "+存檔狀態; } 短文(文,24,版高-15,版寬*0.40d-48,11,薄荷);
    短文(訊息,版寬*0.40d,版高-15,版寬*0.60d-230,11,次墨);
};
變數 繪卡片=函式(卡,列,橫,縱,寬) {
    變數 線=邊線; 如果 (已選(卡["編號"])) { 線=薄荷; } 方框(橫,縱,寬,142,卡底,線);
    如果 (卡["封面"]>0) { 畫.填色(色票[餘數(卡["封面"]-1,6)]); 畫.矩形(橫+1,縱+1,寬-2,5,2); }
    變數 標=卡["標籤"]; 變數 位=橫+12; 迴圈 (變數 索=0; 索<長度(標); 索++) { 如果 (索<3) { 變數 色=色票[餘數(索,6)]; 畫.填色(色); 畫.矩形(位,縱+15,42,3,1); 位+=48; } }
    畫.填色(墨); 介面.繪文字區(卡["名稱"],橫+12,縱+30,寬-48,45,14,比例); 變數 圈="○"; 如果 (卡["完成"]) { 圈="✓"; } 顯示(圈,橫+寬-30,縱+47,17,薄荷);
    短文(標籤文字(標),橫+12,縱+91,寬-24,10,次墨);
    變數 進=引擎.檢查進度(卡); 變數 文=""; 如果 (進[1]>0) { 文=字數(進[0])+"／"+字數(進[1])+"  "; }
    如果 (長度(卡["附件"])>0) { 文+="附件 "+字數(長度(卡["附件"]))+"  "; }
    如果 (長度(卡["留言"])>0) { 文+="筆記 "+字數(長度(卡["留言"]))+"  "; } 文+=卡["負責人"]; 短文(文,橫+12,縱+115,寬-24,10,次墨);
    變數 日=卡["到期日"]; 變數 色=次墨; 如果 (卡["完成"]) { 日="已完成"; 色=薄荷; } 否則如果 (引擎.日期數(日)>0 && 引擎.日期數(日)<引擎.日期數(資料()["今日"])) { 色=珊瑚; } 如果 (卡["關注"]) { 日="☆ "+日; } 顯示(日,橫+12,縱+133,10,色);
    如果 (卡["優先"]==2) { 顯示("優先",橫+寬-42,縱+133,10,琥珀); }
    登記(橫,縱,寬,142,函式(){ 開詳情(卡["編號"]); },"卡片："+卡["名稱"],"卡片",[卡["編號"],列["編號"]]);
};
變數 可見清單=函式(板) { 變數 列們=[]; 迴圈 (變數 索=0; 索<長度(板["清單"]); 索++) { 如果 (!板["清單"][索]["封存"]) { 列們=加入(列們,板["清單"][索]); } } 回傳 列們; };
變數 篩卡=函式(列) {
    如果 (上次查詢!=查詢 || 上次標籤!=標籤篩選 || 上次負責!=負責篩選 || 上次狀態!=狀態篩選 || 上次今日!=資料()["今日"]) { 清除篩選暫存(); 上次查詢=查詢; 上次標籤=標籤篩選; 上次負責=負責篩選; 上次狀態=狀態篩選; 上次今日=資料()["今日"]; }
    變數 已篩=篩選暫存[列["編號"]]; 如果 (已篩!=空值) { 回傳 已篩; }
    變數 卡們=[]; 迴圈 (變數 索=0; 索<長度(列["卡片"]); 索++) { 變數 卡=列["卡片"][索]; 如果 (引擎.符合(卡,查詢,標籤篩選,狀態篩選,負責篩選)) { 卡們=加入(卡們,卡); } } 篩選暫存[列["編號"]]=卡們; 回傳 卡們;
};
變數 繪看板=函式() {
    變數 板=取板(); 如果 (板==空值) { 顯示("開始你的第一份看板",260,152,28,墨); 按鈕("＋ 建立看板",260,200,180,新看板,真); 回傳 空值; }
    變數 色=色票[板["色系"]]; 顯示("個 人 看 板   ／   "+取區()["名稱"],248,106,10,次墨); 短文(板["名稱"],248,143,版寬-680,27,墨);
    變數 星="☆ 收藏"; 如果 (板["星號"]) { 星="★ 已收藏"; } 按鈕(星,版寬-420,113,100,函式(){ 執行改動(函式(){ 板["星號"]=!板["星號"]; }); },假);
    按鈕("設定",版寬-308,113,66,看板設定,假); 按鈕("＋ 新增清單",版寬-230,113,114,新清單,真); 變數 視圖字="表格"; 如果 (檢視=="表格") { 視圖字="看板"; } 按鈕(視圖字,版寬-104,113,72,函式(){ 如果 (檢視=="流動") { 檢視="表格"; } 否則 { 檢視="流動"; } 看板捲動=捲動.建立(); },假);
    輸入框("搜尋","搜尋卡片",查詢,248,166,246,36,函式(值){ 查詢=值; },假,假);
    按鈕(狀態名[狀態篩選],508,166,142,函式(){ 狀態篩選=餘數(狀態篩選+1,5); },假);
    變數 標="標籤"; 如果 (標籤篩選!="") { 標=標籤篩選; } 按鈕(標,662,166,98,函式(){ 表單("篩選標籤","標籤文字（輸入＊清除）",標籤篩選,函式(值){ 如果 (值=="＊" || 值=="*") { 值=""; } 標籤篩選=值; }); },假);
    按鈕("負責人",772,166,86,函式(){ 表單("篩選負責人","姓名（輸入＊清除）",負責篩選,函式(值){ 如果 (值=="＊" || 值=="*") { 值=""; } 負責篩選=值; }); },假);
    變數 篩選橫=870.0d; 變數 篩選縱=166.0d; 變數 所選橫=984.0d;
    如果 (版寬<1180) { 篩選橫=248; 篩選縱=212; 所選橫=362; }
    按鈕("清除篩選",篩選橫,篩選縱,100,函式(){ 查詢=""; 標籤篩選=""; 負責篩選=""; 狀態篩選=0; 結束編輯(); },假);
    如果 (長度(多選)>0) { 按鈕("處理所選 "+字數(長度(多選)),所選橫,篩選縱,140,批次操作,真); } 否則 { 顯示("按住控制鍵點選可多選",所選橫,篩選縱+23,10,次墨); }
    變數 左=248.0d; 變數 上=看板上緣; 變數 寬=版寬-284; 變數 高=版高-看板上緣-66; 變數 列們=可見清單(板);
    如果 (檢視=="表格") { 繪表格(列們,左,上,寬,高); 回傳 空值; }
    變數 卡陣列=[]; 變數 最大高=高; 迴圈 (變數 索=0; 索<長度(列們); 索++) { 變數 卡們=篩卡(列們[索]); 卡陣列=加入(卡陣列,卡們); 最大高=畫.最大值(最大高,長度(卡們)*154+110); }
    捲動.設定(看板捲動,長度(列們)*298+160,最大高,寬,高); 放置目標=空值;
    命中裁切=[左,上,寬,高]; 裁切(左,上,寬,高);
    迴圈 (變數 索=0; 索<長度(列們); 索++) {
        變數 列=列們[索]; 變數 橫=左+索*298-看板捲動["橫"]; 變數 縱=上-看板捲動["縱"];
        如果 (橫+282>=左 && 橫<左+寬) {
            方框(橫,上,282,高,面板,邊線); 顯示(列["名稱"],橫+14,縱+29,15,墨); 顯示(字數(長度(卡陣列[索])),橫+216,縱+29,11,次墨);
            如果 (縱+40>=上 && 縱<上+高) { 按鈕("⋯",橫+238,縱+6,34,函式(){ 清單設定(列); },假); }
            如果 (列["上限"]>0) { 顯示("在製品上限 "+字數(列["上限"]),橫+14,縱+49,10,琥珀); } 否則 { 顯示("每一小步，都算數",橫+14,縱+49,10,次墨); }
            變數 卡們=卡陣列[索]; 變數 起=畫.向下取整(畫.最大值(0,畫.向下取整((看板捲動["縱"]-60)/154))); 變數 終=畫.最小值(長度(卡們),起+畫.向上取整(高/154)+2);
            迴圈 (變數 位=起; 位<終; 位++) { 變數 卡縱=縱+64+位*154; 繪卡片(卡們[位],列,橫+10,卡縱,262); }
            變數 新縱=縱+64+長度(卡們)*154; 如果 (新縱>=上-34 && 新縱<上+高) { 按鈕("＋ 寫下下一步",橫+10,新縱,262,函式(){ 新卡片(列); },假); }
            如果 (拖曳中 && 命中(鼠橫,鼠縱,畫.最大值(左,橫),上,畫.最小值(282,左+寬-橫),高)) {
                變數 位=畫.向下取整(畫.限制範圍(畫.向下取整((鼠縱-縱-64+77)/154),0,長度(卡們))); 變數 實位=長度(列["卡片"]); 如果 (位<長度(卡們)) { 迴圈 (變數 找=0; 找<長度(列["卡片"]); 找++) { 如果 (列["卡片"][找]["編號"]==卡們[位]["編號"]) { 實位=找; 中斷; } } }
                放置目標=[列["編號"],實位]; 畫.填色(薄荷); 畫.矩形(橫+10,縱+60+位*154,262,3);
            }
        }
    }
    命中裁切=空值; 畫.停用裁切(); 繪捲軸(看板捲動,左,上,寬,高);
    如果 (拖曳中) { 方框(鼠橫+12,鼠縱+12,210,46,卡底,薄荷); 變數 找=引擎.找卡片(板,卡片拖曳[0]); 如果 (找!=空值) { 短文(找[1]["名稱"],鼠橫+24,鼠縱+41,186,13,墨); } }
};
變數 工作區設定=函式() {
    變數 區=取區(); 如果 (區==空值) { 回傳 空值; }
    菜單("工作區設定",[["重新命名工作區",函式(){ 表單("工作區名稱","名稱",區["名稱"],函式(值){ 執行改動(函式(){ 區["名稱"]=值; }); }); }],["編輯工作區說明",函式(){ 表單("工作區說明","說明",區["說明"],函式(值){ 執行改動(函式(){ 區["說明"]=值; }); }); }],["封存這個工作區",函式(){ 確認("封存工作區","所有看板會保留在封存庫，可隨時恢復。",函式(){ 執行改動(函式(){ 區["封存"]=真; 目前板=0; 校正選擇(); }); }); }]]);
};
變數 繪範本=函式() {
    顯示("從 一 個 好 的 起 點 出 發",252,111,11,薄荷); 顯示("範本，替你留住好方法",252,155,30,墨); 顯示("預設範例與你的自訂流程，都能一鍵建立獨立看板。",254,184,13,次墨);
    變數 範們=資料()["範本"]; 變數 左=252.0d; 變數 上=218.0d; 變數 寬=版寬-292; 變數 高=版高-284; 變數 欄數=畫.向下取整(畫.最大值(1,畫.向下取整(寬/330))); 變數 欄寬=(寬-18*(欄數-1))/欄數;
    捲動.設定(頁面捲動,寬,畫.向上取整(長度(範們)/(欄數*1.0d))*244,寬,高); 命中裁切=[左,上,寬,高]; 裁切(左,上,寬,高);
    迴圈 (變數 索=0; 索<長度(範們); 索++) { 變數 範索=索; 變數 範=範們[索]; 變數 橫=左+(餘數(索,欄數))*(欄寬+18); 變數 縱=上+畫.向下取整(索/欄數)*244-頁面捲動["縱"]; 如果 (縱+224>上 && 縱<上+高) {
        方框(橫,縱,欄寬,226,面板,邊線); 變數 板=範["看板"]; 迴圈 (變數 列=0; 列<畫.最小值(4,長度(板["清單"])); 列++) { 畫.填色(卡底); 畫.矩形(橫+20+列*57,縱+22,47,38,4); 畫.填色(色票[餘數(索+列,6)]); 畫.矩形(橫+25+列*57,縱+30,30,3,1); }
        短文(範["名稱"],橫+20,縱+92,欄寬-40,21,墨); 短文(範["說明"],橫+20,縱+121,欄寬-40,11,次墨); 顯示(字數(長度(板["清單"]))+" 份清單 · 完整保留卡片內容",橫+20,縱+148,11,次墨);
        按鈕("使用範本",橫+20,縱+174,112,函式(){ 如果 (取區()==空值) { 新工作區(); 回傳 空值; } 表單("由範本建立看板","新看板名稱",範["名稱"],函式(值){ 執行改動(函式(){ 開看板(引擎.套範本(取區(),範索,值)); }); }); },真);
        按鈕("管理",橫+欄寬-94,縱+174,74,函式(){ 菜單("範本管理",[["重新命名",函式(){ 表單("範本名稱","名稱",範["名稱"],函式(值){ 執行改動(函式(){ 範["名稱"]=值; }); }); }],["刪除此範本",函式(){ 確認("刪除範本","來源看板仍會保留。刪除後可以復原。",函式(){ 執行改動(函式(){ 資料()["範本"]=引擎.去除(資料()["範本"],範索); }); }); }]]); },假);
    } }
    命中裁切=空值; 畫.停用裁切(); 繪捲軸(頁面捲動,左,上,寬,高);
};
變數 繪封存=函式() {
    顯示("為 暫 時 休 息 的 計 畫 留 一 個 位 置",252,111,11,薄荷); 顯示("封存庫",252,155,30,墨); 顯示("恢復會保留原有內容；永久刪除前會再次確認。",254,184,13,次墨); 變數 項們=[];
    迴圈 (變數 區索=0; 區索<長度(資料()["工作區"]); 區索++) { 變數 區位=區索; 變數 區=資料()["工作區"][區索]; 如果 (區["封存"]) { 項們=加入(項們,["工作區 · "+區["名稱"],函式(){ 區["封存"]=假; 目前區=區["編號"]; },函式(){ 資料()["工作區"]=引擎.去除(資料()["工作區"],區位); }]); }
        迴圈 (變數 板索=0; 板索<長度(區["看板"]); 板索++) { 變數 板位=板索; 變數 板=區["看板"][板索]; 如果 (板["封存"]) { 項們=加入(項們,["看板 · "+板["名稱"],函式(){ 區["封存"]=假; 板["封存"]=假; },函式(){ 區["看板"]=引擎.去除(區["看板"],板位); }]); }
            迴圈 (變數 列索=0; 列索<長度(板["清單"]); 列索++) { 變數 列位=列索; 變數 列=板["清單"][列索]; 如果 (列["封存"]) { 項們=加入(項們,["清單 · "+列["名稱"]+" ／ "+板["名稱"],函式(){ 區["封存"]=假; 板["封存"]=假; 列["封存"]=假; },函式(){ 板["清單"]=引擎.去除(板["清單"],列位); }]); }
                迴圈 (變數 卡索=0; 卡索<長度(列["卡片"]); 卡索++) { 變數 卡位=卡索; 變數 卡=列["卡片"][卡索]; 如果 (卡["封存"]) { 項們=加入(項們,["卡片 · "+卡["名稱"]+" ／ "+板["名稱"],函式(){ 區["封存"]=假; 板["封存"]=假; 列["封存"]=假; 卡["封存"]=假; },函式(){ 列["卡片"]=引擎.去除(列["卡片"],卡位); }]); } }
            }
        }
    }
    變數 左=252.0d; 變數 上=218.0d; 變數 寬=版寬-292; 變數 高=版高-284; 捲動.設定(頁面捲動,寬,長度(項們)*66+40,寬,高); 命中裁切=[左,上,寬,高]; 裁切(左,上,寬,高);
    變數 起=畫.向下取整(畫.最大值(0,畫.向下取整(頁面捲動["縱"]/66))); 變數 終=畫.最小值(長度(項們),起+畫.向上取整(高/66)+1);
    迴圈 (變數 索=起; 索<終; 索++) { 變數 項=項們[索]; 變數 縱=上+索*66-頁面捲動["縱"]; 方框(左,縱,寬-4,56,面板,邊線); 短文(項[0],左+16,縱+33,寬-250,14,墨); 按鈕("恢復",左+寬-216,縱+11,82,函式(){ 執行改動(函式(){ 項[1](); 校正選擇(); }); },真); 按鈕("永久刪除",左+寬-124,縱+11,106,函式(){ 確認("永久刪除","此項目和其中內容會刪除。請先匯出備份；本次工作階段仍可復原。",函式(){ 執行改動(函式(){ 項[2](); 校正選擇(); }); }); },假); }
    如果 (長度(項們)==0) { 顯示("這裡還沒有封存內容。",左+20,上+80,20,次墨); }
    命中裁切=空值; 畫.停用裁切(); 繪捲軸(頁面捲動,左,上,寬,高);
};
變數 卡片欄=函式(卡,欄名,名稱,橫,縱,寬,高,多行) { 輸入框("卡片"+欄名,名稱,卡[欄名],橫,縱,寬,高,函式(值){ 卡[欄名]=值; 延後儲存(); },多行,真); };
變數 日期欄=函式(卡,欄名,橫,縱,寬) { 按鈕(欄名+"："+卡[欄名],橫,縱,寬,函式(){ 表單(欄名,"西元年－月－日（輸入＊清除）",卡[欄名],函式(值){ 如果 (值=="＊" || 值=="*") { 值=""; } 如果 (引擎.日期數(值)<0) { 訊息="日期無效，請使用數字格式，例如 2026-10-12。"; 開詳情(卡["編號"]); 回傳 空值; } 執行改動(函式(){ 卡[欄名]=值; }); 開詳情(卡["編號"]); }); },假); };
變數 附件總量=函式() { 變數 數=0; 迴圈 (變數 區=0; 區<長度(資料()["工作區"]); 區++) { 變數 工作=資料()["工作區"][區]; 迴圈 (變數 板=0; 板<長度(工作["看板"]); 板++) { 變數 板體=工作["看板"][板]; 迴圈 (變數 列=0; 列<長度(板體["清單"]); 列++) { 變數 清單=板體["清單"][列]; 迴圈 (變數 卡=0; 卡<長度(清單["卡片"]); 卡++) { 變數 卡體=清單["卡片"][卡]; 迴圈 (變數 附=0; 附<長度(卡體["附件"]); 附++) { 數+=卡體["附件"][附]["大小"]; } } } } } 回傳 數; };
變數 添加附件=函式(卡) {
    變數 資源=介面.選擇附件(); 如果 (長度(資源)==0) { 回傳 空值; }
    引擎.記錄復原(); 迴圈 (變數 索=0; 索<長度(資源); 索++) { 變數 檔=資源[索]; 如果 (介面.資源大小(檔)>262144) { 訊息="附件太大：每個最多二百五十六千位元組。"; } 否則 { 變數 位元=檔案.讀取位元組(檔); 如果 (附件總量()+長度(位元)<=附件預算) { 卡["附件"]=加入(卡["附件"],附件庫.建立(介面.資源名稱(檔),位元)); } 否則 { 訊息="附件總量已達四百萬位元組上限。"; } } } 改動();
};
變數 繪詳情=函式(左,上,寬,高) {
    變數 卡=取卡(); 如果 (卡==空值) { 關對話(); 回傳 空值; }
    短文(卡["名稱"],左+26,上+42,寬-110,23,墨); 變數 找=引擎.找卡片(取板(),詳情卡); 顯示("在「"+找[0]["名稱"]+"」清單中 · 編輯即時生效",左+28,上+68,11,次墨);
    變數 內容左=左+26; 變數 內容上=上+92; 變數 內容寬=寬-64; 變數 內容高=高-156; 變數 縱=內容上-詳情捲動["縱"]; 變數 欄寬=(內容寬-14)/2;
    命中裁切=[內容左,內容上,內容寬,內容高]; 裁切(內容左,內容上,內容寬,內容高);
    卡片欄(卡,"名稱","卡片名稱",內容左,縱+22,內容寬,40,假); 卡片欄(卡,"說明","說明與背景",內容左,縱+102,內容寬,94,真);
    卡片欄(卡,"負責人","負責人（個人註記）",內容左,縱+236,欄寬,40,假); 按鈕("優先程度："+["低","一般","高"][卡["優先"]],內容左+欄寬+14,縱+240,欄寬,函式(){ 執行改動(函式(){ 卡["優先"]=餘數(卡["優先"]+1,3); }); },假);
    日期欄(卡,"開始日",內容左,縱+294,欄寬); 日期欄(卡,"到期日",內容左+欄寬+14,縱+294,欄寬);
    變數 完字="○ 標記完成"; 如果 (卡["完成"]) { 完字="✓ 已完成"; } 按鈕(完字,內容左,縱+340,152,函式(){ 執行改動(函式(){ 卡["完成"]=!卡["完成"]; }); },卡["完成"]);
    變數 關字="☆ 關注"; 如果 (卡["關注"]) { 關字="★ 已關注"; } 按鈕(關字,內容左+166,縱+340,130,函式(){ 執行改動(函式(){ 卡["關注"]=!卡["關注"]; }); },假);
    變數 封面字="無"; 如果 (卡["封面"]>0) { 封面字=色名[卡["封面"]-1]; } 按鈕("封面："+封面字,內容左+310,縱+340,140,函式(){ 執行改動(函式(){ 卡["封面"]=餘數(卡["封面"]+1,7); }); },假);
    短文("標籤："+標籤文字(卡["標籤"]),內容左,縱+407,內容寬-150,13,次墨); 按鈕("管理標籤",內容左+內容寬-130,縱+384,130,函式(){ 變數 項=[]; 迴圈 (變數 索=0; 索<長度(卡["標籤"]); 索++) { 變數 標位=索; 變數 標=卡["標籤"][索]; 項=加入(項,["移除「"+標+"」",函式(){ 執行改動(函式(){ 卡["標籤"]=引擎.去除(卡["標籤"],標位); }); 開詳情(卡["編號"]); }]); } 項=加入(項,["＋ 新增標籤",函式(){ 表單("新增標籤","名稱","",函式(值){ 執行改動(函式(){ 卡["標籤"]=加入(卡["標籤"],值); }); 開詳情(卡["編號"]); }); }]); 菜單("卡片標籤",項); },假);
    變數 位=縱+448; 顯示("檢查表",內容左,位,17,墨); 按鈕("＋ 檢查表",內容左+內容寬-130,位-24,130,函式(){ 表單("新增檢查表","檢查表名稱","待辦步驟",函式(值){ 執行改動(函式(){ 卡["檢查表"]=加入(卡["檢查表"],{"名稱":值,"項目":[]}); }); 開詳情(卡["編號"]); }); },假); 位+=32;
    迴圈 (變數 表索=0; 表索<長度(卡["檢查表"]); 表索++) { 變數 表位=表索; 變數 表=卡["檢查表"][表索]; 顯示(表["名稱"],內容左,位+20,13,薄荷); 按鈕("管理",內容左+內容寬-74,位,74,函式(){ 菜單("檢查表管理",[["重新命名",函式(){ 表單("檢查表名稱","名稱",表["名稱"],函式(值){ 執行改動(函式(){ 表["名稱"]=值; }); 開詳情(卡["編號"]); }); }],["刪除檢查表",函式(){ 確認("刪除檢查表","本次工作階段可以復原。",函式(){ 執行改動(函式(){ 卡["檢查表"]=引擎.去除(卡["檢查表"],表位); }); 開詳情(卡["編號"]); }); }]]); },假); 位+=43;
        迴圈 (變數 索=0; 索<長度(表["項目"]); 索++) { 變數 項位=索; 變數 項=表["項目"][索]; 變數 文="○ "; 如果 (項["完成"]) { 文="✓ "; } 按鈕(文+項["名稱"],內容左,位,內容寬-88,函式(){ 執行改動(函式(){ 項["完成"]=!項["完成"]; }); },假); 按鈕("⋯",內容左+內容寬-74,位,74,函式(){ 菜單("檢查項目",[["編輯文字",函式(){ 表單("編輯步驟","內容",項["名稱"],函式(值){ 執行改動(函式(){ 項["名稱"]=值; }); 開詳情(卡["編號"]); }); }],["向上移動",函式(){ 執行改動(函式(){ 表["項目"]=引擎.換位(表["項目"],項位,項位-1); }); 開詳情(卡["編號"]); }],["向下移動",函式(){ 執行改動(函式(){ 表["項目"]=引擎.換位(表["項目"],項位,項位+1); }); 開詳情(卡["編號"]); }],["刪除步驟",函式(){ 執行改動(函式(){ 表["項目"]=引擎.去除(表["項目"],項位); }); 開詳情(卡["編號"]); }]]); },假); 位+=42; }
        按鈕("＋ 新增步驟",內容左,位,160,函式(){ 表單("新增步驟","內容","",函式(值){ 執行改動(函式(){ 表["項目"]=加入(表["項目"],{"名稱":值,"完成":假}); }); 開詳情(卡["編號"]); }); },假); 位+=62;
    }
    顯示("附件",內容左,位+10,17,墨); 按鈕("＋ 加入附件",內容左+內容寬-130,位-15,130,函式(){ 添加附件(卡); },假); 位+=38;
    迴圈 (變數 索=0; 索<長度(卡["附件"]); 索++) { 變數 附位=索; 變數 附=卡["附件"][索]; 短文(附["名稱"],內容左,位+23,內容寬-205,12,次墨); 按鈕("另存",內容左+內容寬-188,位,82,函式(){ 變數 資源=介面.下載附件(附["名稱"]); 如果 (資源!=空值) { 變數 位元=附件庫.讀取(附); 如果 (位元!=空值) { 檔案.儲存位元組(資源,位元,!是網頁); } 否則 { 訊息="找不到附件檔案，請由完整備份恢復。"; } } },假); 按鈕("移除",內容左+內容寬-94,位,82,函式(){ 確認("移除附件","備份中的附件會一併移除，可以復原。",函式(){ 執行改動(函式(){ 卡["附件"]=引擎.去除(卡["附件"],附位); }); 開詳情(卡["編號"]); }); },假); 位+=44; } 位+=26;
    顯示("個人筆記",內容左,位,17,墨); 按鈕("＋ 留下筆記",內容左+內容寬-130,位-24,130,函式(){ 表單("留下筆記","內容","",函式(值){ 執行改動(函式(){ 卡["留言"]=加入(卡["留言"],值); }); 開詳情(卡["編號"]); }); },假); 位+=32;
    迴圈 (變數 索=0; 索<長度(卡["留言"]); 索++) { 變數 記位=索; 變數 文=卡["留言"][索]; 方框(內容左,位,內容寬,66,卡底,邊線); 短文(文,內容左+12,位+28,內容寬-115,12,墨); 按鈕("管理",內容左+內容寬-86,位+16,74,函式(){ 菜單("個人筆記",[["編輯",函式(){ 表單("編輯筆記","內容",文,函式(值){ 執行改動(函式(){ 卡["留言"][記位]=值; }); 開詳情(卡["編號"]); }); }],["刪除",函式(){ 執行改動(函式(){ 卡["留言"]=引擎.去除(卡["留言"],記位); }); 開詳情(卡["編號"]); }]]); },假); 位+=78; }
    捲動.設定(詳情捲動,內容寬,位-縱+30,內容寬,內容高); 命中裁切=空值; 畫.停用裁切(); 繪捲軸(詳情捲動,內容左,內容上,內容寬,內容高);
    按鈕("移動",左+26,上+高-47,98,函式(){ 卡片移動(卡["編號"]); },假); 按鈕("複製",左+136,上+高-47,98,函式(){ 執行改動(函式(){ 開詳情((引擎.複製卡(找[0],卡))["編號"]); }); },假);
    按鈕("封存卡片",左+246,上+高-47,120,函式(){ 執行改動(函式(){ 卡["封存"]=真; 引擎.記事(取板(),"封存「"+卡["名稱"]+"」。"); }); 關對話(); },假);
    按鈕("關閉詳情",左+寬-152,上+高-47,126,關對話,真);
};
變數 提交表單=函式() {
    如果 (對話!="表單") { 回傳 空值; } 變數 值=整潔(對話資料["值"]); 如果 (值=="") { 訊息="請先填寫內容。"; 回傳 空值; }
    變數 處理=對話資料["提交"]; 關對話(); 處理(值);
};
變數 繪對話=函式() {
    畫.停用裁切(); 命中裁切=空值; 畫.填色(0,0,0,185); 畫.矩形(0,0,版寬,版高); 命中區=[]; 語意節點=[];
    變數 寬=畫.最小值(560,版寬-24); 變數 高=312.0d; 如果 (對話=="詳情") { 寬=畫.最小值(840,版寬-24); 高=畫.最小值(760,版高-90); }
    如果 (對話=="選單" || 對話=="活動") { 高=畫.最小值(620,版高-100); }
    變數 左=(版寬-寬)/2; 變數 上=(版高-高)/2; 方框(左,上,寬,高,面板,邊線);
    如果 (對話=="詳情") { 繪詳情(左,上,寬,高); }
    否則如果 (對話=="表單") {
        顯示(對話資料["標題"],左+28,上+43,24,墨); 輸入框("表單",對話資料["欄名"],對話資料["值"],左+28,上+100,寬-56,54,函式(值){ 對話資料["值"]=值; },假,假);
        顯示("按確認完成，或按離開鍵返回。",左+28,上+190,11,次墨);
        按鈕("取消",左+寬-236,上+高-66,92,關對話,假); 按鈕("確認",左+寬-130,上+高-66,102,提交表單,真);
    } 否則如果 (對話=="確認") {
        顯示(對話資料["標題"],左+28,上+44,24,墨); 段落(對話資料["說明"],左+28,上+81,寬-56,112,14,次墨);
        按鈕("返回",左+寬-236,上+高-66,92,關對話,假); 按鈕("確認",左+寬-130,上+高-66,102,函式(){ 變數 處理=對話資料["提交"]; 關對話(); 處理(); },真);
    } 否則如果 (對話=="選單") {
        短文(對話資料["標題"],左+28,上+44,寬-56,22,墨); 變數 項們=對話資料["項目"]; 變數 視野=高-146;
        捲動.設定(詳情捲動,寬-68,長度(項們)*47,寬-68,視野); 命中裁切=[左+28,上+74,寬-68,視野]; 裁切(左+28,上+74,寬-68,視野);
        迴圈 (變數 索=0; 索<長度(項們); 索++) { 變數 項=項們[索]; 按鈕(項[0],左+28,上+74+索*47-詳情捲動["縱"],寬-68,函式(){ 變數 動作=項[1]; 關對話(); 動作(); },假); }
        如果 (長度(項們)==0) { 顯示("目前沒有可選項目。",左+40,上+120,14,次墨); }
        命中裁切=空值; 畫.停用裁切(); 繪捲軸(詳情捲動,左+28,上+74,寬-68,視野); 按鈕("關閉",左+寬-130,上+高-55,102,關對話,真);
    } 否則如果 (對話=="活動") {
        顯示("看板活動",左+28,上+44,24,墨); 變數 記=取板()["活動"]; 變數 視野=高-146; 捲動.設定(詳情捲動,寬-68,長度(記)*48,寬-68,視野);
        命中裁切=[左+28,上+74,寬-68,視野]; 裁切(左+28,上+74,寬-68,視野); 迴圈 (變數 索=0; 索<長度(記); 索++) { 短文(記[長度(記)-1-索],左+28,上+96+索*48-詳情捲動["縱"],寬-68,12,次墨); }
        命中裁切=空值; 畫.停用裁切(); 繪捲軸(詳情捲動,左+28,上+74,寬-68,視野); 按鈕("關閉",左+寬-130,上+高-55,102,關對話,真);
    }
    如果 (對話!="詳情") { 按鈕("×",左+寬-66,上+12,38,關對話,假); }
};
變數 完成教學=函式() { 教學=-1; 資料()["導覽完成"]=真; 儲存空間.設定偏好(儲存前綴+".tutorial",真); 如果 (!是網頁) { 未儲存=真; 自動存(); } 畫.重繪(); };
變數 繪教學=函式() {
    畫.填色(0,0,0,180); 畫.矩形(0,0,版寬,版高); 命中區=[]; 語意節點=[];
    變數 教寬=畫.最小值(650,版寬-24); 變數 左=(版寬-教寬)/2; 變數 上=(版高-390)/2; 方框(左,上,教寬,390,面板,邊線); 繪星標(左+42,上+42);
    變數 標題=["歡迎，讓想法開始流動","為不同的計畫，留一片星空","把下一步，放進一張卡片","每一次修改，都有地方安放"];
    變數 說明=["這是一份可以放心嘗試的範例看板。按住卡片拖到另一欄，就能改變進度；內容太長時，使用底部與右側的捲動條。","工作區收納看板，看板收納清單與卡片。上方的範本庫可以複製現成流程，也能保存你自己的好方法。","點開卡片，可寫說明、標籤、日期、負責人，加入檢查表、附件與個人筆記。按住控制鍵點選卡片，可一次處理多張。","桌面版會自動儲存，連續輸入會合併保存，關閉前會補存。重新開啟便會恢復。網頁版使用上方的儲存備份與載入，離開前記得匯出。"];
    顯示("初 次 見 面   ·   "+字數(教學+1)+"／四",左+70,上+47,11,薄荷); 顯示(標題[教學],左+32,上+108,22,墨);
    段落(說明[教學],左+32,上+146,教寬-64,154,16,次墨);
    迴圈 (變數 索=0; 索<4; 索++) { 畫.填色(邊線); 如果 (索==教學) { 畫.填色(薄荷); } 畫.圓形(左+38+索*18,上+310,5); }
    按鈕("稍後再看",左+32,上+336,112,完成教學,假); 如果 (教學>0) { 按鈕("上一步",左+教寬-280,上+336,112,函式(){ 教學-=1; },假); }
    變數 字="下一步"; 如果 (教學==3) { 字="開始使用"; } 按鈕(字,左+教寬-172,上+336,140,函式(){ 如果 (教學<3) { 教學++; } 否則 { 完成教學(); } },真);
};
# 以正常桌面尺寸作為閱讀基準；大視窗同步放大字體、元件、間距與捲動條。
# 手動百分比疊加在響應比例上；最高 150% 保留至少 960 × 600 的版面。
變數 手機版=假; 變數 手機清單=0; 變數 手機拖縱=0.0d; 變數 手機捲動中=假;
變數 更新尺=函式() {
    手機版=介面.寬度()<760;
    自動比例=畫.最小值(畫.最大值(1,介面.寬度())/1440.0d,畫.最大值(1,介面.高度())/900.0d);
    比例=自動比例*介面百分比/100.0d; 版寬=介面.寬度()/比例; 版高=介面.高度()/比例;
    如果 (手機版) { 比例=畫.最大值(0.5d,畫.最小值(1,介面.寬度()/560.0d)); 版寬=介面.寬度()/比例; 版高=介面.高度()/比例; }
    鼠橫=介面.滑鼠橫()/比例; 鼠縱=介面.滑鼠縱()/比例;
    看板上緣=225; 如果 (版寬<1180) { 看板上緣=271; }
};
變數 按下處理=函式() {
    更新尺(); 手機拖縱=鼠縱; 手機捲動中=假; 鍵盤焦點=-1; 迴圈 (變數 索=長度(命中區)-1; 索>=0; 索-=1) { 變數 區=命中區[索]; 如果 (命中(鼠橫,鼠縱,區[0],區[1],區[2],區[3])) {
        如果 (區[6]=="捲軸") { 變數 元=區[7]; 變數 座=鼠縱; 如果 (元[1]) { 座=鼠橫; } 變數 抓=座-元[2]-元[4]; 如果 (抓<0 || 抓>元[5]) { 抓=元[5]/2; } 滑塊拖曳=[元,抓]; 更新滑塊(); }
        否則如果 (區[6]=="卡片") { 結束編輯(); 如果 (畫.按鍵是否按下(341) || 畫.按鍵是否按下(345)) { 選卡(區[7][0]); } 否則 { 卡片拖曳=[區[7][0],區[7][1],鼠橫,鼠縱,區[4]]; } }
        否則 { 如果 (區[6]!="輸入") { 結束編輯(); } 變數 動作=區[4]; 動作(); } 畫.重繪(); 回傳 空值;
    } } 結束編輯(); 畫.重繪();
};
變數 更新滑塊=函式() { 如果 (滑塊拖曳==空值) { 回傳 空值; } 變數 元=滑塊拖曳[0]; 變數 座=鼠縱; 如果 (元[1]) { 座=鼠橫; } 捲動.拖曳(元[0],元[1],座-元[2]-滑塊拖曳[1],元[3]); };
變數 拖曳處理=函式() { 更新尺();
    如果 (手機版 && 教學<0 && 滑塊拖曳==空值) {
        變數 量=手機拖縱-鼠縱; 手機拖縱=鼠縱;
        如果 (畫.絕對值(量)>2) { 手機捲動中=真; 卡片拖曳=空值; }
        如果 (對話=="詳情" || 對話=="選單" || 對話=="活動") { 捲動.移動(詳情捲動,0,量); } 否則如果 (對話=="") { 捲動.移動(看板捲動,0,量); } 畫.重繪(); 回傳 空值;
    } 更新滑塊(); 如果 (卡片拖曳!=空值) { 如果 (畫.絕對值(鼠橫-卡片拖曳[2])+畫.絕對值(鼠縱-卡片拖曳[3])>7) { 拖曳中=真; } 如果 (拖曳中) { 如果 (鼠橫<280) { 捲動.移動(看板捲動,-28,0); } 如果 (鼠橫>版寬-70) { 捲動.移動(看板捲動,28,0); } 如果 (鼠縱<看板上緣+25) { 捲動.移動(看板捲動,0,-24); } 如果 (鼠縱>版高-90) { 捲動.移動(看板捲動,0,24); } } } 畫.重繪(); };
變數 放開處理=函式() {
    更新尺(); 如果 (手機捲動中) { 手機捲動中=假; 卡片拖曳=空值; 拖曳中=假; 畫.重繪(); 回傳 空值; } 滑塊拖曳=空值; 如果 (拖曳中) { 放置目標=計算放置目標(); } 如果 (卡片拖曳!=空值) { 變數 卡號=卡片拖曳[0]; 如果 (拖曳中 && 放置目標!=空值) { 變數 目標=放置目標; 執行改動(函式(){ 如果 (!引擎.移卡(取板(),卡號,目標[0],目標[1])) { 訊息="目標清單已達在製品上限。"; } }); }
        否則如果 (!拖曳中) { 變數 動作=卡片拖曳[4]; 動作(); } } 卡片拖曳=空值; 拖曳中=假; 放置目標=空值; 畫.重繪();
};
變數 計算放置目標=函式() {
    如果 (!命中(鼠橫,鼠縱,248,看板上緣,版寬-284,版高-看板上緣-66)) { 回傳 空值; }
    變數 列們=可見清單(取板()); 變數 索=畫.向下取整((鼠橫-248+看板捲動["橫"])/298);
    如果 (索<0 || 索>=長度(列們)) { 回傳 空值; } 變數 列=列們[索]; 變數 卡們=篩卡(列);
    變數 位=畫.向下取整(畫.限制範圍(畫.向下取整((鼠縱-看板上緣+看板捲動["縱"]-64+77)/154),0,長度(卡們)));
    變數 實位=長度(列["卡片"]); 如果 (位<長度(卡們)) { 迴圈 (變數 找=0;找<長度(列["卡片"]);找++) { 如果 (列["卡片"][找]["編號"]==卡們[位]["編號"]) { 實位=找; 中斷; } } }
    回傳 [列["編號"],實位];
};
變數 滾輪處理=函式() { 更新尺(); 如果 (教學>=0) { 回傳 空值; } 變數 量=介面.滾輪()*48; 如果 (對話=="詳情" || 對話=="選單" || 對話=="活動") { 捲動.移動(詳情捲動,0,量); }
    否則如果 (對話=="") { 如果 (頁面=="看板") { 如果 (畫.按鍵是否按下(340) || 畫.按鍵是否按下(344)) { 捲動.移動(看板捲動,量,0); } 否則 { 捲動.移動(看板捲動,0,量); } } 否則 { 捲動.移動(頁面捲動,0,量); } } 畫.重繪();
};
變數 提交編輯=函式() { 如果 (編輯器!=空值 && 編輯回呼!=空值) { 變數 回呼=編輯回呼; 回呼(介面.編輯內容(編輯器)); } 畫.重繪(); };
變數 待視窗事件=[];
變數 待按鍵事件=[];
變數 鍵碼=函式(文字) { 變數 字="ABCDEFGHIJKLMNOPQRSTUVWXYZ"; 變數 小="abcdefghijklmnopqrstuvwxyz"; 迴圈 (變數 索=0;索<26;索++) { 如果 (文字==字[索] || 文字==小[索] || 文字=="key:"+字數(65+索)) { 回傳 65+索; } } 變數 特=["Escape","Enter","Tab","Backspace","Insert","Delete","ArrowRight","ArrowLeft","ArrowDown","ArrowUp","PageUp","PageDown","Home","End"]; 迴圈 (變數 索=0;索<長度(特);索++) { 如果 (文字==特[索]) { 回傳 256+索; } } 如果 (文字==" ") { 回傳 32; } 回傳 -1; };
變數 收集視窗事件=函式(截止) {
    變數 事們=待按鍵事件; 待按鍵事件=[]; 變數 新們=視窗.輪詢(); 迴圈 (變數 索=0;索<長度(新們);索++) { 事們=加入(事們,新們[索]); }
    迴圈 (變數 索=0;索<長度(事們);索++) { 變數 事=事們[索]; 變數 類=介面.事件類型(事); 如果 (類=="keyPressed" || 類=="keyRepeat") { 如果 (介面.事件時間(事)>截止) { 待按鍵事件=加入(待按鍵事件,事); } 否則如果 (!介面.事件組字(事)) { 變數 修=介面.事件修飾(事); 變數 控=餘數(畫.向下取整(修/2),2)==1 || 餘數(畫.向下取整(修/8),2)==1; 變數 移=餘數(修,2)==1; 按鍵命令(鍵碼(介面.事件按鍵(事)),控,移); } } 否則 { 待視窗事件=加入(待視窗事件,事); } }
};
變數 文字處理=函式() { 收集視窗事件(介面.輸入時間()); 如果 (編輯器!=空值) { 編輯器.提交(介面.輸入()); 提交編輯(); } };
變數 按鍵處理=函式() { 收集視窗事件(介面.按鍵時間()); };
變數 按鍵命令=函式(鍵,控,移) {
    如果 (鍵==256) { 如果 (教學>=0) { 完成教學(); } 否則如果 (對話!="") { 關對話(); } 否則 { 結束編輯(); 多選=[]; } 畫.重繪(); 回傳 空值; }
    如果 (介面.組字中()) { 回傳 空值; }
    如果 (控 && 鍵==83) { 手動儲存(); 畫.重繪(); 回傳 空值; } 如果 (控 && 鍵==79) { 手動載入(); 畫.重繪(); 回傳 空值; }
    如果 (控 && 鍵==90) { 如果 (移) { 重做操作(); } 否則 { 復原操作(); } 回傳 空值; }
    如果 (控 && 鍵==70) { 聚焦("搜尋",查詢,函式(值){ 查詢=值; },假,假); 畫.重繪(); 回傳 空值; }
    如果 (鍵==258 && 長度(命中區)>0) { 結束編輯(); 變數 步=1; 如果 (移) { 步=-1; 如果 (鍵盤焦點<0) { 鍵盤焦點=長度(命中區); } } 鍵盤焦點=餘數(鍵盤焦點+步+長度(命中區),長度(命中區)); 畫.重繪(); 回傳 空值; }
    如果 (編輯器!=空值) {
        如果 (控) { 變數 字=""; 如果 (鍵==65) { 字="a"; } 如果 (鍵==67) { 字="c"; } 如果 (鍵==86) { 字="v"; } 如果 (鍵==88) { 字="x"; } 如果 (字!="") { 編輯器.快速鍵(字,2); 如果 (鍵==86 || 鍵==88) { 提交編輯(); } 畫.重繪(); 回傳 空值; } }
        如果 (鍵==259) { 編輯器.退格(); 提交編輯(); } 如果 (鍵==261) { 編輯器.刪除(); 提交編輯(); }
        如果 (鍵==263 || 鍵==262) { 變數 方向=1; 如果 (鍵==263) { 方向=-1; } 變數 單位="grapheme"; 如果 (控) { 單位="word"; } 編輯器.移動(方向,單位,移); }
        如果 (鍵==268) { 編輯器.選取(0,0); } 如果 (鍵==269) { 編輯器.選取(介面.編輯長度(編輯器),介面.編輯長度(編輯器)); }
        如果 (鍵==257) { 如果 (多行編輯) { 編輯器.提交(換行); 提交編輯(); } 否則如果 (對話=="表單") { 提交表單(); } 否則 { 結束編輯(); } } 畫.重繪(); 回傳 空值;
    }
    如果 ((鍵==257 || 鍵==32) && 鍵盤焦點>=0 && 鍵盤焦點<長度(命中區)) { 變數 動作=命中區[鍵盤焦點][4]; 動作(); }
    如果 (鍵==267) { 如果 (頁面=="看板") { 捲動.移動(看板捲動,0,300); } 否則 { 捲動.移動(頁面捲動,0,300); } }
    如果 (鍵==266) { 如果 (頁面=="看板") { 捲動.移動(看板捲動,0,-300); } 否則 { 捲動.移動(頁面捲動,0,-300); } } 畫.重繪();
};
變數 處理錯誤=函式() { 載入中=假; 存檔狀態="操作未完成 · 請重試或匯出備份"; 訊息="無法完成操作，現有內容仍保留。請檢查檔案、空間與權限。"; 印出("星泉看板："+介面.錯誤文字()); 滑塊拖曳=空值; 卡片拖曳=空值; 拖曳中=假; 畫.重繪(); };
變數 上次滑過=-2;
變數 使用隔離儲存=函式(前綴) { 儲存前綴=前綴; 上次封包=空值; 儲存鎖定=假; };
變數 取得狀態=函式() { 回傳 {"文件":資料(),"是網頁":是網頁,"未儲存":未儲存,"目前板":目前板,"目前區":目前區,"頁面":頁面,"檢視":檢視,"對話":對話,"教學":教學,"訊息":訊息,"水平":看板捲動["橫"],"垂直":看板捲動["縱"],"詳情垂直":詳情捲動["縱"],"儲存耗時":儲存耗時,"介面百分比":介面百分比,"自動比例":自動比例,"介面比例":比例,"版寬":版寬,"版高":版高}; };
變數 建立壓力資料=函式() { 變數 板=取板(); 迴圈 (變數 索=0;索<16;索++) { 變數 列=引擎.建立清單(板,"延伸清單"+字數(索+1)); 迴圈 (變數 位=0;位<250;位++) { 引擎.建立卡片(列,"輕量效能驗證卡片"+字數(位+1)); } } 清除篩選暫存(); 畫.重繪(); };
變數 取得操作區=函式() { 變數 區們=[]; 迴圈 (變數 索=0;索<長度(命中區);索++) { 變數 區=命中區[索]; 區們=加入(區們,[區[0]*比例,區[1]*比例,區[2]*比例,區[3]*比例,區[5],區[6]]); } 回傳 區們; };
變數 設定=函式() {
    首繪完成=假;
    介面百分比=100; 變數 已存縮放=儲存空間.取得偏好(儲存前綴+".ui-scale");
    迴圈 (變數 值=70;值<=150;值+=10) { 如果 (已存縮放==值) { 介面百分比=值; 中斷; } }
    附件庫.設定(是網頁,儲存前綴);
    畫.尺寸(1440,900,"P2D","星泉看板"); 畫.文字字型("Microsoft JhengHei",14); 畫.文字行距(24); 介面.初始化文字輸入(); 變數 視窗庫=介面.視窗庫; 視窗=視窗庫.目前視窗();
    介面.當按下(按下處理); 介面.當放開(放開處理); 介面.當拖曳(拖曳處理); 介面.當滾輪(滾輪處理); 介面.當按鍵(按鍵處理); 介面.當文字(文字處理); 介面.當尺寸(函式(){ 畫.重繪(); }); 介面.當組字(函式(){ 畫.重繪(); }); 介面.當錯誤(處理錯誤);
    介面.當移動(函式(){ 更新尺(); 變數 找=-1; 迴圈 (變數 索=長度(命中區)-1; 索>=0; 索-=1) { 變數 區=命中區[索]; 如果 (命中(鼠橫,鼠縱,區[0],區[1],區[2],區[3])) { 找=索; 中斷; } } 如果 (找!=上次滑過) { 上次滑過=找; 畫.重繪(); } });
    清除篩選暫存(); 引擎.初始範例();
    如果 (!是網頁) { 變數 已存=儲存空間.讀取(儲存前綴+".document"); 如果 (已存!=空值) { 變數 新=介面.解包(已存); 如果 (引擎.載入(新)) { 上次封包=已存; 存檔狀態="已恢復上次內容"; } 否則 { 變數 備援=儲存空間.讀取(儲存前綴+".backup"); 變數 恢復=假; 如果 (備援!=空值) { 恢復=引擎.載入(介面.解包(備援)); } 如果 (恢復) { 上次封包=備援; 訊息="已從上一份備援恢復內容，請匯出完整備份。"; } 否則 { 儲存鎖定=真; 存檔狀態="原有資料無效，已暫停自動儲存"; 訊息="原有檔案仍保留，請由完整備份載入以恢復。"; } } } }
    目前板=資料()["上次看板"]; 校正選擇(); 變數 教過=儲存空間.取得偏好(儲存前綴+".tutorial"); 如果 (!資料()["導覽完成"] && 教過!=真) { 教學=0; }
    如果 (是網頁) { 存檔狀態="請手動匯出備份"; } 畫.停止持續繪圖();
};
變數 繪手機看板=函式() {
    畫.背景(深底); 顯示("星泉看板",18,34,24,墨);
    按鈕("導覽",版寬-100,12,82,函式(){ 變數 選項=[["新增看板",新看板],["新增清單",新清單],["載入備份",手動載入],["儲存備份",手動儲存]]; 變數 區=取區(); 如果 (區!=空值) { 迴圈 (變數 索=0;索<長度(區["看板"]);索++) { 變數 板=區["看板"][索]; 如果 (!板["封存"]) { 選項=加入(選項,[板["名稱"],函式(){ 開看板(板); 手機清單=0; }]); } } } 菜單("導覽",選項); },真);
    變數 板=取板(); 如果 (板==空值) { 按鈕("建立看板",18,82,版寬-36,新看板,真); 回傳 空值; }
    短文(板["名稱"],18,80,版寬-36,22,墨); 輸入框("搜尋","搜尋卡片",查詢,18,98,版寬-36,44,函式(值){ 查詢=值; },假,假);
    變數 列們=可見清單(板); 如果 (長度(列們)==0) { 按鈕("新增清單",18,162,版寬-36,新清單,真); 回傳 空值; }
    手機清單=畫.向下取整(畫.限制範圍(手機清單,0,長度(列們)-1)); 變數 列=列們[手機清單];
    按鈕("上一欄",18,158,104,函式(){ 手機清單=畫.最大值(0,手機清單-1); 看板捲動=捲動.建立(); },假);
    按鈕("下一欄",版寬-122,158,104,函式(){ 手機清單=畫.最小值(長度(列們)-1,手機清單+1); 看板捲動=捲動.建立(); },假); 短文(列["名稱"],138,182,版寬-276,15,薄荷);
    變數 卡們=篩卡(列); 變數 高=版高-274; 捲動.設定(看板捲動,版寬-36,長度(卡們)*154+64,版寬-36,高);
    命中裁切=[18,212,版寬-36,高]; 裁切(18,212,版寬-36,高);
    迴圈 (變數 索=0;索<長度(卡們);索++) { 變數 縱=212+索*154-看板捲動["縱"]; 如果 (縱+142>212 && 縱<212+高) { 繪卡片(卡們[索],列,18,縱,版寬-36); } }
    畫.停用裁切(); 命中裁切=空值; 按鈕("＋ 寫下下一步",18,版高-52,版寬-36,函式(){ 新卡片(列); },真);
};
變數 繪製=函式() {
    收集視窗事件(1000000000000.0d);
    如果 (待儲存期限>0 && 目前時間()>=待儲存期限) { 自動存(); }
    如果 (自動今日) { 變數 今日=目前日期(); 如果 (資料()["今日"]!=今日) { 資料()["今日"]=今日; } }
    更新尺(); 介面.更新文字比例(比例); 畫.重設矩陣(); 畫.縮放(比例); 畫.停用裁切(); 命中區=[]; 語意節點=[]; 命中裁切=空值; 如果 (手機版) { 繪手機看板(); } 否則 { 繪外殼(); }
    如果 (手機版) { } 否則如果 (頁面=="看板") { 繪看板(); } 否則如果 (頁面=="範本") { 繪範本(); } 否則 { 繪封存(); }
    如果 (對話!="") { 繪對話(); } 如果 (教學>=0) { 繪教學(); }
    繪縮放();
    如果 (鍵盤焦點>=0 && 鍵盤焦點<長度(命中區)) { 變數 區=命中區[鍵盤焦點]; 畫.停用填色(); 畫.描邊(薄荷); 畫.描邊粗細(2); 畫.矩形(區[0]-2,區[1]-2,區[2]+4,區[3]+4,8); 畫.停用描邊(); }
    介面.宣告語意(語意節點); 變數 事件們=待視窗事件; 待視窗事件=[];
    迴圈 (變數 索=0; 索<長度(事件們); 索++) { 變數 事=事件們[索]; 如果 (介面.事件類型(事)=="closeRequested") {
        儲存未完成文字();
        如果 (未儲存) { 介面.取消關閉(視窗); 確認("仍有未儲存的修改","請先返回並重試儲存，或匯出完整備份。確認會直接離開。",函式(){ 畫.結束(); }); } 否則 { 介面.接受關閉(視窗); }
    } }
    # 初次字型與畫面資源建立後再繪一次，之後維持事件驅動繪製。
    如果 (!首繪完成) { 首繪完成=真; 畫.重繪(); }
};
變數 啟動=函式() { 畫.執行(設定,繪製); };
變數 繪表格=函式(列們,左,上,寬,高) {
    迴圈 (變數 索=0;索<長度(列們);索++) { 篩卡(列們[索]); }
    如果 (表格暫存==空值) { 表格暫存=[]; 迴圈 (變數 索=0; 索<長度(列們); 索++) { 變數 清單卡=篩卡(列們[索]); 迴圈 (變數 位=0; 位<長度(清單卡); 位++) { 表格暫存=加入(表格暫存,[清單卡[位],列們[索]]); } } }
    變數 卡們=表格暫存;
    捲動.設定(看板捲動,畫.最大值(850,寬),長度(卡們)*58+60,寬,高); 命中裁切=[左,上,寬,高]; 裁切(左,上,寬,高);
    變數 橫=左-看板捲動["橫"]; 變數 縱=上-看板捲動["縱"]; 顯示("卡片",橫+16,縱+25,11,次墨); 顯示("清單",橫+400,縱+25,11,次墨); 顯示("負責人",橫+570,縱+25,11,次墨); 顯示("到期日",橫+690,縱+25,11,次墨);
    變數 起=畫.向下取整(畫.最大值(0,畫.向下取整(看板捲動["縱"]/58)-1)); 變數 終=畫.最小值(長度(卡們),起+畫.向上取整(高/58)+2);
    迴圈 (變數 索=起; 索<終; 索++) { 變數 卡=卡們[索][0]; 變數 列=卡們[索][1]; 變數 縱=上+40+索*58-看板捲動["縱"]; 方框(橫,縱,畫.最大值(850,寬)-8,50,卡底,邊線); 短文(卡["名稱"],橫+16,縱+30,365,14,墨); 短文(列["名稱"],橫+400,縱+30,150,12,次墨); 短文(卡["負責人"],橫+570,縱+30,100,12,次墨); 顯示(卡["到期日"],橫+690,縱+30,12,次墨); 登記(橫,縱,畫.最大值(850,寬)-8,50,函式(){ 開詳情(卡["編號"]); },卡["名稱"],"卡片",[卡["編號"],列["編號"]]); }
    命中裁切=空值; 畫.停用裁切(); 繪捲軸(看板捲動,左,上,寬,高);
};
