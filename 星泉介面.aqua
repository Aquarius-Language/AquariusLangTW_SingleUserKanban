# 官方函式庫識別字、事件及資料欄位保留固定協定；相容邊界集中於此。
# 應用程式的名稱、資料、註解與函式皆採繁體中文。
變數 畫 = 匯入("Processing");
變數 檔案 = 匯入("Files");
變數 序列 = 匯入("Serialization");
變數 儲存空間 = 匯入("Storage");
變數 應用 = 匯入("Application");
變數 視窗庫 = 匯入("Window");
變數 編輯庫 = 匯入("TextEdit");
變數 字元庫 = 匯入("TextInput");
變數 空值 = [0][1];
變數 網頁環境 = 函式() { 回傳 !(是Windows() || 是Linux() || 是MacOS()); };
變數 寬度 = 函式() { 回傳 畫.width; };
變數 高度 = 函式() { 回傳 畫.height; };
變數 滑鼠橫 = 函式() { 回傳 畫.mouseX; };
變數 滑鼠縱 = 函式() { 回傳 畫.mouseY; };
變數 按鍵 = 函式() { 回傳 畫.keyCode; };
變數 按鈕代碼 = 函式() { 回傳 畫.mouseButton; };
變數 滾輪 = 函式() { 回傳 畫.wheelCount; };
變數 輸入 = 函式() { 回傳 畫.inputText; };
變數 輸入時間 = 函式() { 回傳 畫.inputTimestamp; };
變數 按鍵時間 = 函式() { 回傳 畫.keyTimestamp; };
變數 組字 = 函式() { 回傳 畫.compositionText; };
變數 組字中 = 函式() { 回傳 畫.isComposing; };
變數 編輯內容 = 函式(編輯器) { 變數 狀態 = 編輯器.狀態(); 回傳 狀態.text; };
變數 編輯長度 = 函式(編輯器) { 變數 狀態 = 編輯器.狀態(); 回傳 狀態.length; };
變數 編輯游標 = 函式(編輯器) { 變數 狀態 = 編輯器.狀態(); 變數 選取=狀態.selection; 回傳 選取["caret"]; };
變數 事件類型 = 函式(事件) { 回傳 事件.type; };
變數 事件時間 = 函式(事件) { 回傳 事件.timestamp; };
變數 事件組字 = 函式(事件) { 回傳 事件.state == 真; };
變數 事件按鍵 = 函式(事件) { 回傳 事件.logicalKey; };
變數 事件修飾 = 函式(事件) { 回傳 事件.modifiers; };
變數 事件檔案 = 函式(事件) { 回傳 事件.files; };
變數 資源名稱 = 函式(資源) { 回傳 資源.name; };
變數 資源大小 = 函式(資源) { 變數 資訊 = 檔案.取得資訊(資源); 回傳 資訊.length; };
變數 開啟檔 = 函式() { 回傳 應用.開啟檔案({"title":"載入星泉看板", "multiple":假, "filters":[{"name":"星泉看板備份", "extensions":["星板"]}]}); };
變數 儲存檔 = 函式(名稱) { 回傳 應用.儲存檔案({"title":"儲存星泉看板", "suggestedName":名稱, "filters":[{"name":"星泉看板備份", "extensions":["星板"]}]}); };
變數 選擇附件 = 函式() { 回傳 應用.開啟檔案({"title":"加入附件（每個最多二百五十六千位元組）", "multiple":真}); };
變數 下載附件 = 函式(名稱) { 回傳 應用.儲存檔案({"title":"儲存附件", "suggestedName":名稱}); };
變數 解包 = 函式(位元組) { 變數 結果 = 序列.嘗試解析二進位(位元組); 如果 (!結果.ok || 結果.schema != 1) { 回傳 空值; } 回傳 結果.value; };
變數 封包 = 函式(資料) { 回傳 序列.二進位序列化(資料,1); };
變數 防止關閉 = 函式(視窗,啟用) { 如果 (網頁環境()) { 如果 (啟用) { 視窗.決定關閉("Cancel"); } 否則 { 視窗.決定關閉("Accept"); } } };
變數 取消關閉 = 函式(視窗) { 視窗.決定關閉("Cancel"); };
變數 接受關閉 = 函式(視窗) { 視窗.決定關閉("Accept"); };
變數 宣告語意 = 函式(節點) { 應用.可及性(節點); };
變數 語意 = 函式(編號,文字) { 回傳 {"id":"功能"+序列.JSON序列化(編號),"role":"button","label":文字}; };
變數 當按下 = 函式(處理) { 畫.註冊事件("mousePressed",處理); };
變數 當放開 = 函式(處理) { 畫.註冊事件("mouseReleased",處理); };
變數 當拖曳 = 函式(處理) { 畫.註冊事件("mouseDragged",處理); };
變數 當移動 = 函式(處理) { 畫.註冊事件("mouseMoved",處理); };
變數 當滾輪 = 函式(處理) { 畫.註冊事件("mouseWheel",處理); };
變數 當按鍵 = 函式(處理) { 畫.註冊事件("keyPressed",處理); };
變數 當文字 = 函式(處理) { 畫.註冊事件("textInput",處理); };
變數 當尺寸 = 函式(處理) { 畫.註冊事件("windowResized",處理); };
變數 當組字 = 函式(處理) { 畫.註冊事件("compositionUpdated",處理); };
變數 當錯誤 = 函式(處理) { 畫.註冊事件("error",處理); };
變數 錯誤文字 = 函式() { 回傳 畫.errorMessage; };
