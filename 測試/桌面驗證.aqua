變數 看板=匯入("星泉看板.aqua"); 變數 介面=看板.介面; 變數 引擎=看板.引擎; 變數 附件=看板.附件庫; 變數 畫=介面.畫; 變數 儲存=介面.儲存空間;
變數 空值=介面.空值; 變數 失敗=0; 變數 通過=0; 變數 板=空值; 變數 卡=空值; 變數 第一次名稱=""; 變數 階段=0;
變數 切換次=0; 變數 切換區=空值; 變數 切換板=空值;
變數 驗=函式(結果,名稱) { 如果 (結果) { 通過++; } 否則 { 失敗++; 印出("失敗："+名稱); } };
變數 點=函式(名稱) {
    變數 區們=看板.命中區;
    迴圈 (變數 索=0;索<長度(區們);索++) { 變數 區=區們[索]; 如果 (區[5]==名稱) { 變數 動作=區[4]; 動作(); 看板.繪製(); 回傳 空值; } }
    驗(假,"找不到操作區："+名稱);
};
看板.使用隔離儲存("kanban-verification");
儲存.刪除("kanban-verification.document"); 儲存.刪除("kanban-verification.backup");
儲存.設定偏好("kanban-verification.ui-scale",100);
畫.執行(看板.設定,函式(){
    如果 (切換次<7) {
        如果 (切換次==0) { 看板.完成教學(); 切換區=引擎.建立工作區("切換測試空間"); 切換板=引擎.建立看板(切換區,"切換測試看板"); 引擎.建立清單(切換板,"待辦"); }
        看板.繪製(); 變數 狀=看板.取得狀態(); 變數 文件=引擎.文件;
        如果 (切換次==0 || 切換次==2 || 切換次==4) { 變數 區=引擎.找工作區(狀["目前區"]); 點(區["名稱"]+"  ▾"); }
        否則如果 (切換次==1 || 切換次==5) { 點("切換測試空間"); 驗((看板.取得狀態())["目前區"]==切換區["編號"],"反覆切換到第二個工作空間"); }
        否則如果 (切換次==3) { 點(文件["工作區"][0]["名稱"]); 驗((看板.取得狀態())["目前區"]==文件["工作區"][0]["編號"],"切回原工作空間"); }
        否則 { 看板.開看板(文件["工作區"][0]["看板"][0]); }
        切換次++; 畫.重繪(); 回傳 空值;
    }
    如果 (階段==1) { 看板.繪製(); 如果 (!(看板.取得狀態())["未儲存"]) { 變數 文字存檔=介面.解包(儲存.讀取("kanban-verification.document")); 驗(文字存檔["工作區"][0]["看板"][0]["清單"][0]["卡片"][0]["說明"]=="延後儲存測試","停頓後自動補存"); 卡["說明"]="關閉前的文字"; 看板.延後儲存(); 看板.儲存未完成文字(); 文字存檔=介面.解包(儲存.讀取("kanban-verification.document")); 驗(文字存檔["工作區"][0]["看板"][0]["清單"][0]["卡片"][0]["說明"]=="關閉前的文字","關閉前補存"); 畫.結束(); } 回傳 空值; }
    看板.完成教學(); 變數 文件=引擎.文件; 板=文件["工作區"][0]["看板"][0]; 卡=板["清單"][0]["卡片"][0]; 第一次名稱=卡["名稱"];
    看板.設定介面縮放(110); 驗((看板.取得狀態())["介面百分比"]==110,"桌面介面縮放"); 驗(儲存.取得偏好("kanban-verification.ui-scale")==110,"縮放偏好落盤"); 驗(!(看板.取得狀態())["未儲存"],"縮放不修改看板");
    卡["名稱"]="桌面即時儲存驗證"; 看板.改動(); 變數 已存=介面.解包(儲存.讀取("kanban-verification.document")); 驗(已存["工作區"][0]["看板"][0]["清單"][0]["卡片"][0]["名稱"]==卡["名稱"],"修改立即落盤");
    變數 前存=介面.解包(儲存.讀取("kanban-verification.backup")); 驗(前存["工作區"][0]["看板"][0]["清單"][0]["卡片"][0]["名稱"]==第一次名稱,"保留上一份備援");
    變數 附=附件.建立("繁體中文附件.txt",[65,66,67,10,228,184,173]); 卡["附件"]=加入(卡["附件"],附); 看板.改動();
    已存=介面.解包(儲存.讀取("kanban-verification.document")); 變數 磁碟附=已存["工作區"][0]["看板"][0]["清單"][0]["卡片"][0]["附件"][0]; 驗(磁碟附["位元組"]==空值,"即時儲存不重寫附件"); 驗(長度(附件.讀取(磁碟附))==7,"附件獨立落盤");
    變數 完整=附件.封裝(文件); 驗(長度(完整["工作區"][0]["看板"][0]["清單"][0]["卡片"][0]["附件"][0]["位元組"])==7,"完整備份包含附件");
    驗(!介面.網頁環境(),"桌面環境判斷"); 變數 原說明=卡["說明"]; 卡["說明"]="延後儲存測試"; 看板.延後儲存(); 變數 未補存=介面.解包(儲存.讀取("kanban-verification.document")); 驗(未補存["工作區"][0]["看板"][0]["清單"][0]["卡片"][0]["說明"]==原說明,"連續鍵入合併儲存"); 階段=1; 看板.繪製();
});
畫.執行(看板.設定,函式(){ 變數 文件=引擎.文件; 驗((看板.取得狀態())["介面百分比"]==110,"重新啟動恢復縮放偏好"); 看板.設定介面縮放(100); 驗((看板.取得狀態())["介面百分比"]==100,"重設介面縮放"); 驗(文件["工作區"][0]["看板"][0]["清單"][0]["卡片"][0]["名稱"]=="桌面即時儲存驗證","重新啟動恢復"); 看板.建立壓力資料(); 看板.改動(); 印出("四千張卡片即時儲存耗時（毫秒）：",(看板.取得狀態())["儲存耗時"]); 變數 開始=目前時間(); 看板.繪製(); 印出("四千張卡片首次繪圖耗時（毫秒）：",目前時間()-開始); 開始=目前時間(); 看板.繪製(); 印出("四千張卡片快取繪圖耗時（毫秒）：",目前時間()-開始); 畫.結束(); });
儲存.寫入("kanban-verification.document",[1,2,3]);
畫.執行(看板.設定,函式(){ 變數 文件=引擎.文件; 驗(文件["工作區"][0]["看板"][0]["清單"][0]["卡片"][0]["名稱"]=="桌面即時儲存驗證","損壞主檔恢復備援"); 畫.結束(); });
儲存.寫入("kanban-verification.backup",[1,2,3]);
儲存.設定偏好("kanban-verification.ui-scale","無效比例");
畫.執行(看板.設定,函式(){ 驗((看板.取得狀態())["介面百分比"]==100,"無效縮放偏好回到預設"); 看板.改動(); 驗(長度(儲存.讀取("kanban-verification.document"))==3,"兩份損壞時不覆寫原檔"); 畫.結束(); });
印出("桌面驗證完成：",通過,"通過，",失敗,"失敗。"); 回傳 失敗;
