變數 引擎=匯入("../看板引擎.aqua"); 變數 捲動=匯入("../捲動區.aqua"); 變數 序列=匯入("Serialization");
變數 失敗=0; 變數 通過=0;
變數 驗=函式(結果,名稱) { 如果 (結果) { 通過++; } 否則 { 失敗++; 印出("失敗："+名稱); } };
引擎.初始範例(); 變數 文件=引擎.文件; 變數 區=文件["工作區"][0]; 變數 板=區["看板"][0]; 變數 列=板["清單"][0]; 變數 卡=列["卡片"][0];
驗(長度(文件["範本"])==3,"範本庫"); 驗((引擎.統計(板))[0]==6,"範例卡片");
驗(引擎.日期數("2024-02-29")==20240229,"閏日"); 驗(引擎.日期數("2025-02-29")==-1,"無效閏日"); 驗(引擎.日期數("2026-13-01")==-1,"無效月份");
驗(引擎.包含("繁體中文星泉","中文"),"中文字搜尋"); 驗(!引擎.包含("星泉","看板"),"搜尋不符");
引擎.記錄復原(); 變數 卡號=卡["編號"]; 變數 完欄=板["清單"][3]; 驗(引擎.移卡(板,卡號,完欄["編號"],0),"跨欄移動"); 驗((引擎.找卡片(板,卡號))[1]["完成"],"完成欄自動規則");
驗(引擎.復原(),"復原"); 板=引擎.找看板(板["編號"]); 驗(!(引擎.找卡片(板,卡號))[1]["完成"],"復原恢復完成狀態"); 驗(引擎.重做(),"重做"); 板=引擎.找看板(板["編號"]); 驗((引擎.找卡片(板,卡號))[1]["完成"],"重做移動");
變數 空列=引擎.建立清單(板,"上限測試"); 空列["上限"]=1; 引擎.建立卡片(空列,"填滿"); 驗(!引擎.移卡(板,卡號,空列["編號"],0),"在製品上限"); 驗((引擎.找卡片(板,卡號))[0]["編號"]!=空列["編號"],"拒絕移動不破壞來源");
變數 原=序列.JSON序列化(板); 區=引擎.找所屬區(板["編號"]); 變數 新=引擎.複製看板(區,板,"複本"); 新["清單"][0]["名稱"]="獨立修改"; 驗(板["清單"][0]["名稱"]!="獨立修改","看板深複製"); 驗(新["清單"][0]["編號"]!=板["清單"][0]["編號"],"清單識別重建");
變數 進=引擎.檢查進度(板["清單"][1]["卡片"][0]); 驗(進[0]==1 && 進[1]==3,"檢查表進度");
變數 文件=引擎.文件; 變數 二進位=序列.二進位序列化(文件,1); 變數 往返=序列.解析二進位(二進位); 驗(序列.JSON序列化(往返.value)==序列.JSON序列化(文件),"含中文完整文件往返");
變數 滾=捲動.建立(); 捲動.設定(滾,5000,9000,900,600); 捲動.移動(滾,99999,99999); 驗(滾["橫"]==4100 && 滾["縱"]==8400,"雙軸邊界"); 捲動.拖曳(滾,真,0,900); 驗(滾["橫"]==0,"拖曳至開頭"); 捲動.設定(滾,100,100,900,600); 驗(滾["橫"]==0 && 滾["縱"]==0,"內容縮小重設"); 驗((捲動.滑塊(100,200,0,200))[1]==200,"無溢出不需要捲動");
驗(引擎.驗證文件(文件),"完整結構驗證"); 驗(!引擎.驗證文件(4),"拒絕純量文件");
變數 壞=引擎.複本(文件); 壞["工作區"][0]["看板"][0]["清單"][0]["卡片"][0]["附件"]=[{"名稱":"壞","資源鍵":"任意","大小":9999999}]; 驗(!引擎.驗證文件(壞),"拒絕過大附件");
壞=引擎.複本(文件); 壞["工作區"][0]["看板"][0]["清單"][0]["卡片"][0]["完成"]="錯誤"; 驗(!引擎.驗證文件(壞),"拒絕無效欄位型別");
壞=引擎.複本(文件); 壞["序號"]=1; 驗(!引擎.驗證文件(壞),"拒絕無效識別序號");
變數 安全=序列.嘗試解析二進位([1,2,3]); 驗(!安全.ok,"損壞文件可恢復"); 安全=序列.嘗試解析二進位(二進位); 驗(安全.ok && 安全.schema==1,"安全解析正常文件");
驗(長度(目前日期())==10,"系統本地日期");
印出("資料驗證完成：",通過,"通過，",失敗,"失敗。"); 回傳 失敗;
