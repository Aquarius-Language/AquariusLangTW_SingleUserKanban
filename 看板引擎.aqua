# 純星泉資料模型：桌面與瀏覽器共用；不依賴繪圖或儲存主機。
變數 序列 = 匯入("Serialization");
變數 空值 = [0][1];
變數 文件 = {"格式":"星泉看板","版本":1,"序號":1,"工作區":[],"範本":[],"導覽完成":假,"上次看板":0,"今日":目前日期()};
變數 復原堆疊 = []; 變數 重做堆疊 = [];
變數 文字化 = 函式(值) { 回傳 序列.JSON序列化(值); };
變數 餘數 = 函式(數,除數) { 回傳 數-(數/除數)*除數; };
變數 複本 = 函式(值) { 回傳 序列.解析JSON(序列.JSON序列化(值)); };
變數 識別 = 函式() { 變數 編號=文件["序號"]; 文件["序號"]=編號+1; 回傳 編號; };
變數 去除 = 函式(陣列,位置) { 變數 新=[]; 迴圈 (變數 索=0; 索<長度(陣列); 索++) { 如果 (索!=位置) { 新=加入(新,陣列[索]); } } 回傳 新; };
變數 插入 = 函式(陣列,位置,項目) { 變數 新=[]; 迴圈 (變數 索=0; 索<=長度(陣列); 索++) { 如果 (索==位置) { 新=加入(新,項目); } 如果 (索<長度(陣列)) { 新=加入(新,陣列[索]); } } 回傳 新; };
變數 換位 = 函式(陣列,位置,新位置) { 如果 (新位置<0 || 新位置>=長度(陣列)) { 回傳 陣列; } 變數 項=陣列[位置]; 回傳 插入(去除(陣列,位置),新位置,項); };
變數 包含 = 函式(內容,查詢) {
    如果 (查詢=="") { 回傳 真; }
    迴圈 (變數 起=0; 起<=長度(內容)-長度(查詢); 起++) {
        變數 符合=真; 迴圈 (變數 字=0; 字<長度(查詢); 字++) { 如果 (內容[起+字]!=查詢[字]) { 符合=假; } }
        如果 (符合) { 回傳 真; }
    } 回傳 假;
};
變數 記錄復原 = 函式() { 復原堆疊=加入(復原堆疊,序列.JSON序列化(文件)); 變數 總量=0; 迴圈 (變數 索=0;索<長度(復原堆疊);索++) { 總量+=長度(復原堆疊[索]); } 迴圈 (變數 索=0;索<30;索++) { 如果 (長度(復原堆疊)<=30 && 總量<=16777216) { 中斷; } 總量-=長度(復原堆疊[0]); 復原堆疊=其餘(復原堆疊); } 重做堆疊=[]; };
變數 復原 = 函式() { 如果 (長度(復原堆疊)==0) { 回傳 假; } 重做堆疊=加入(重做堆疊,序列.JSON序列化(文件)); 文件=序列.解析JSON(最後一個(復原堆疊)); 復原堆疊=去除(復原堆疊,長度(復原堆疊)-1); 回傳 真; };
變數 重做 = 函式() { 如果 (長度(重做堆疊)==0) { 回傳 假; } 復原堆疊=加入(復原堆疊,序列.JSON序列化(文件)); 文件=序列.解析JSON(最後一個(重做堆疊)); 重做堆疊=去除(重做堆疊,長度(重做堆疊)-1); 回傳 真; };
變數 建立工作區 = 函式(名稱) { 變數 區={"編號":識別(),"名稱":名稱,"說明":"讓想法找到流動的方向。","看板":[],"封存":假}; 文件["工作區"]=加入(文件["工作區"],區); 回傳 區; };
變數 建立看板 = 函式(區,名稱) { 變數 板={"編號":識別(),"名稱":名稱,"說明":"把大計畫拆成小小的下一步。","清單":[],"星號":假,"封存":假,"色系":0,"自動完成":真,"活動":[]}; 區["看板"]=加入(區["看板"],板); 回傳 板; };
變數 建立清單 = 函式(板,名稱) { 變數 列={"編號":識別(),"名稱":名稱,"卡片":[],"封存":假,"完成欄":名稱=="已完成","上限":0}; 板["清單"]=加入(板["清單"],列); 回傳 列; };
變數 建立卡片 = 函式(列,名稱) { 變數 卡={"編號":識別(),"名稱":名稱,"說明":"","標籤":[],"負責人":"","開始日":"","到期日":"","完成":假,"封存":假,"優先":1,"封面":0,"檢查表":[],"附件":[],"留言":[],"關注":假}; 列["卡片"]=加入(列["卡片"],卡); 回傳 卡; };
變數 找工作區 = 函式(編號) { 迴圈 (變數 索=0; 索<長度(文件["工作區"]); 索++) { 變數 區=文件["工作區"][索]; 如果 (區["編號"]==編號) { 回傳 區; } } 回傳 空值; };
變數 找看板 = 函式(編號) { 迴圈 (變數 區=0; 區<長度(文件["工作區"]); 區++) { 變數 板們=文件["工作區"][區]["看板"]; 迴圈 (變數 索=0; 索<長度(板們); 索++) { 如果 (板們[索]["編號"]==編號) { 回傳 板們[索]; } } } 回傳 空值; };
變數 找所屬區 = 函式(編號) { 迴圈 (變數 區=0; 區<長度(文件["工作區"]); 區++) { 變數 工作=文件["工作區"][區]; 迴圈 (變數 索=0; 索<長度(工作["看板"]); 索++) { 如果 (工作["看板"][索]["編號"]==編號) { 回傳 工作; } } } 回傳 空值; };
變數 找清單 = 函式(板,編號) { 迴圈 (變數 索=0; 索<長度(板["清單"]); 索++) { 如果 (板["清單"][索]["編號"]==編號) { 回傳 板["清單"][索]; } } 回傳 空值; };
變數 找卡片 = 函式(板,編號) { 迴圈 (變數 列=0; 列<長度(板["清單"]); 列++) { 變數 清單=板["清單"][列]; 迴圈 (變數 索=0; 索<長度(清單["卡片"]); 索++) { 如果 (清單["卡片"][索]["編號"]==編號) { 回傳 [清單,清單["卡片"][索],索]; } } } 回傳 空值; };
變數 記事 = 函式(板,說明) { 板["活動"]=加入(板["活動"],說明); 如果 (長度(板["活動"])>120) { 板["活動"]=其餘(板["活動"]); } };
變數 可移入 = 函式(列) { 如果 (列["上限"]<=0) { 回傳 真; } 變數 數=0; 迴圈 (變數 索=0; 索<長度(列["卡片"]); 索++) { 如果 (!列["卡片"][索]["封存"]) { 數++; } } 回傳 數<列["上限"]; };
變數 移卡 = 函式(板,卡號,目標列,位置) {
    變數 找到=找卡片(板,卡號); 變數 列=找清單(板,目標列); 如果 (找到==空值 || 列==空值) { 回傳 假; }
    如果 (找到[0]["編號"]!=目標列) { 如果 (!可移入(列)) { 回傳 假; } }
    如果 (找到[0]["編號"]==目標列 && 位置>找到[2]) { 位置-=1; }
    找到[0]["卡片"]=去除(找到[0]["卡片"],找到[2]); 如果 (位置<0 || 位置>長度(列["卡片"])) { 位置=長度(列["卡片"]); }
    列["卡片"]=插入(列["卡片"],位置,找到[1]);
    如果 (板["自動完成"] && 列["完成欄"]) { 找到[1]["完成"]=真; }
    記事(板,"將「"+找到[1]["名稱"]+"」移至「"+列["名稱"]+"」。"); 回傳 真;
};
變數 複製卡 = 函式(列,卡) { 變數 新=複本(卡); 新["編號"]=識別(); 新["名稱"]=新["名稱"]+"（複本）"; 新["封存"]=假; 列["卡片"]=加入(列["卡片"],新); 回傳 新; };
變數 複製看板 = 函式(區,板,名稱) {
    變數 新=複本(板); 新["編號"]=識別(); 新["名稱"]=名稱; 新["封存"]=假; 新["星號"]=假; 新["活動"]=[];
    迴圈 (變數 列=0; 列<長度(新["清單"]); 列++) { 變數 清單=新["清單"][列]; 清單["編號"]=識別(); 迴圈 (變數 卡=0; 卡<長度(清單["卡片"]); 卡++) { 清單["卡片"][卡]["編號"]=識別(); } }
    區["看板"]=加入(區["看板"],新); 回傳 新;
};
變數 存範本 = 函式(板,名稱) { 文件["範本"]=加入(文件["範本"],{"編號":識別(),"名稱":名稱,"說明":板["說明"],"看板":複本(板)}); };
變數 套範本 = 函式(區,索,名稱) { 回傳 複製看板(區,文件["範本"][索]["看板"],名稱); };
變數 檢查進度 = 函式(卡) { 變數 全=0; 變數 完=0; 迴圈 (變數 表=0; 表<長度(卡["檢查表"]); 表++) { 變數 項目=卡["檢查表"][表]["項目"]; 迴圈 (變數 索=0; 索<長度(項目); 索++) { 全++; 如果 (項目[索]["完成"]) { 完++; } } } 回傳 [完,全]; };
變數 日期數 = 函式(日期) {
    如果 (日期=="") { 回傳 0; } 如果 (長度(日期)!=10) { 回傳 -1; } 如果 (日期[4]!="-" || 日期[7]!="-") { 回傳 -1; }
    變數 數字="0123456789"; 變數 值=0; 變數 月=0; 變數 日=0; 變數 年=0;
    迴圈 (變數 索=0; 索<10; 索++) { 如果 (索!=4 && 索!=7) { 變數 數=-1; 迴圈 (變數 位=0; 位<10; 位++) { 如果 (日期[索]==數字[位]) { 數=位; } } 如果 (數<0) { 回傳 -1; } 值=值*10+數; 如果 (索<4) { 年=年*10+數; } 否則如果 (索<7) { 月=月*10+數; } 否則 { 日=日*10+數; } } }
    如果 (月<1 || 月>12 || 日<1 || 年<1) { 回傳 -1; } 變數 天=[31,28,31,30,31,30,31,31,30,31,30,31]; 如果 (餘數(年,400)==0 || (餘數(年,4)==0 && 餘數(年,100)!=0)) { 天[1]=29; } 如果 (日>天[月-1]) { 回傳 -1; } 回傳 值;
};
變數 符合 = 函式(卡,查詢,標籤,狀態,負責人) {
    如果 (卡["封存"]) { 回傳 假; }
    如果 (查詢!="") { 如果 (!包含(卡["名稱"]+" "+卡["說明"]+" "+卡["負責人"]+" "+文字化(卡["標籤"]),查詢)) { 回傳 假; } }
    如果 (標籤!="") { 如果 (!包含(文字化(卡["標籤"]),標籤)) { 回傳 假; } }
    如果 (負責人!="") { 如果 (!包含(卡["負責人"],負責人)) { 回傳 假; } }
    如果 (狀態==1 && 卡["完成"]) { 回傳 假; } 如果 (狀態==2 && !卡["完成"]) { 回傳 假; }
    如果 (狀態==3) { 如果 (卡["完成"] || 日期數(卡["到期日"])<=0 || 日期數(卡["到期日"])>日期數(文件["今日"])) { 回傳 假; } }
    如果 (狀態==4 && !卡["關注"]) { 回傳 假; } 回傳 真;
};
變數 統計 = 函式(板) { 變數 全=0; 變數 完=0; 變數 逾=0; 迴圈 (變數 列=0; 列<長度(板["清單"]); 列++) { 變數 清單=板["清單"][列]; 如果 (!清單["封存"]) { 迴圈 (變數 索=0; 索<長度(清單["卡片"]); 索++) { 變數 卡=清單["卡片"][索]; 如果 (!卡["封存"]) { 全++; 如果 (卡["完成"]) { 完++; } 如果 (!卡["完成"] && 日期數(卡["到期日"])>0 && 日期數(卡["到期日"])<日期數(文件["今日"])) { 逾++; } } } } } 回傳 [全,完,逾]; };
變數 形狀 = 函式(值,首字) { 變數 文字=序列.JSON序列化(值); 回傳 文字[0]==首字; };
變數 文字首=(序列.JSON序列化(""))[0];
變數 是文字 = 函式(值) { 回傳 形狀(值,文字首); };
變數 是陣列 = 函式(值) { 回傳 形狀(值,"["); };
變數 是物件 = 函式(值) { 回傳 形狀(值,"{"); };
變數 是整數 = 函式(值) { 變數 文=序列.JSON序列化(值); 如果 (包含("0123456789",文[0]) && !包含(文,".") && !包含(文,"e") && !包含(文,"E")) { 回傳 值>=0 && 值<=2147483000; } 回傳 假; };
變數 是真假 = 函式(值) { 回傳 值==真 || 值==假; };
變數 已用編號={}; 變數 最大編號=0;
變數 驗編號 = 函式(值,唯一) { 如果 (!是整數(值)) { 回傳 假; } 如果 (值<1) { 回傳 假; } 如果 (唯一) { 如果 (已用編號[值]!=空值) { 回傳 假; } 已用編號[值]=真; } 如果 (值>最大編號) { 最大編號=值; } 回傳 真; };
變數 驗卡 = 函式(卡,唯一) {
    如果 (!是物件(卡)) { 回傳 假; } 如果 (!驗編號(卡["編號"],唯一)) { 回傳 假; }
    變數 文欄=["名稱","說明","負責人","開始日","到期日"]; 迴圈 (變數 索=0;索<長度(文欄);索++) { 如果 (!是文字(卡[文欄[索]])) { 回傳 假; } 如果 (長度(卡[文欄[索]])>65536) { 回傳 假; } }
    如果 (日期數(卡["開始日"])<0 || 日期數(卡["到期日"])<0) { 回傳 假; }
    如果 (!是真假(卡["完成"]) || !是真假(卡["封存"]) || !是真假(卡["關注"])) { 回傳 假; }
    如果 (!是整數(卡["優先"]) || !是整數(卡["封面"])) { 回傳 假; } 如果 (卡["優先"]>2 || 卡["封面"]>6) { 回傳 假; }
    變數 列欄=["標籤","檢查表","附件","留言"]; 迴圈 (變數 索=0;索<長度(列欄);索++) { 如果 (!是陣列(卡[列欄[索]])) { 回傳 假; } 如果 (長度(卡[列欄[索]])>1000) { 回傳 假; } }
    迴圈 (變數 索=0;索<長度(卡["標籤"]);索++) { 如果 (!是文字(卡["標籤"][索])) { 回傳 假; } }
    迴圈 (變數 索=0;索<長度(卡["留言"]);索++) { 如果 (!是文字(卡["留言"][索])) { 回傳 假; } }
    迴圈 (變數 索=0;索<長度(卡["檢查表"]);索++) { 變數 表=卡["檢查表"][索]; 如果 (!是物件(表)) { 回傳 假; } 如果 (!是文字(表["名稱"]) || !是陣列(表["項目"])) { 回傳 假; } 迴圈 (變數 位=0;位<長度(表["項目"]);位++) { 變數 項=表["項目"][位]; 如果 (!是物件(項)) { 回傳 假; } 如果 (!是文字(項["名稱"]) || !是真假(項["完成"])) { 回傳 假; } } }
    迴圈 (變數 索=0;索<長度(卡["附件"]);索++) { 變數 附=卡["附件"][索]; 如果 (!是物件(附)) { 回傳 假; } 如果 (!是文字(附["名稱"]) || !是文字(附["資源鍵"]) || !是整數(附["大小"])) { 回傳 假; } 如果 (附["大小"]>262144) { 回傳 假; } }
    回傳 真;
};
變數 驗板 = 函式(板,唯一) {
    如果 (!是物件(板)) { 回傳 假; } 如果 (!驗編號(板["編號"],唯一)) { 回傳 假; }
    如果 (!是文字(板["名稱"]) || !是文字(板["說明"]) || !是陣列(板["清單"]) || !是陣列(板["活動"])) { 回傳 假; }
    如果 (!是真假(板["封存"]) || !是真假(板["星號"]) || !是真假(板["自動完成"]) || !是整數(板["色系"])) { 回傳 假; } 如果 (板["色系"]>5) { 回傳 假; }
    迴圈 (變數 索=0;索<長度(板["活動"]);索++) { 如果 (!是文字(板["活動"][索])) { 回傳 假; } }
    迴圈 (變數 索=0;索<長度(板["清單"]);索++) { 變數 列=板["清單"][索]; 如果 (!是物件(列)) { 回傳 假; } 如果 (!驗編號(列["編號"],唯一)) { 回傳 假; }
        如果 (!是文字(列["名稱"]) || !是陣列(列["卡片"]) || !是真假(列["封存"]) || !是真假(列["完成欄"]) || !是整數(列["上限"])) { 回傳 假; }
        迴圈 (變數 位=0;位<長度(列["卡片"]);位++) { 如果 (!驗卡(列["卡片"][位],唯一)) { 回傳 假; } }
    } 回傳 真;
};
變數 驗證文件 = 函式(新) {
    如果 (!是物件(新)) { 回傳 假; } 如果 (新["格式"]!="星泉看板" || 新["版本"]!=1) { 回傳 假; }
    如果 (!是陣列(新["工作區"]) || !是陣列(新["範本"]) || !是整數(新["序號"]) || !是整數(新["上次看板"]) || !是真假(新["導覽完成"]) || !是文字(新["今日"])) { 回傳 假; }
    如果 (日期數(新["今日"])<=0) { 回傳 假; } 已用編號={}; 最大編號=0;
    迴圈 (變數 索=0;索<長度(新["工作區"]);索++) { 變數 區=新["工作區"][索]; 如果 (!是物件(區)) { 回傳 假; } 如果 (!驗編號(區["編號"],真)) { 回傳 假; } 如果 (!是文字(區["名稱"]) || !是文字(區["說明"]) || !是真假(區["封存"]) || !是陣列(區["看板"])) { 回傳 假; } 迴圈 (變數 位=0;位<長度(區["看板"]);位++) { 如果 (!驗板(區["看板"][位],真)) { 回傳 假; } } }
    迴圈 (變數 索=0;索<長度(新["範本"]);索++) { 變數 範=新["範本"][索]; 如果 (!是物件(範)) { 回傳 假; } 如果 (!驗編號(範["編號"],真)) { 回傳 假; } 如果 (!是文字(範["名稱"]) || !是文字(範["說明"]) || !驗板(範["看板"],假)) { 回傳 假; } }
    回傳 新["序號"]>最大編號;
};
變數 載入 = 函式(新) { 如果 (!驗證文件(新)) { 回傳 假; } 文件=新; 復原堆疊=[]; 重做堆疊=[]; 回傳 真; };
變數 置換 = 函式(新) { 文件=新; };
變數 初始範例 = 函式() {
    變數 區=建立工作區("我的星泉工作室"); 變數 板=建立看板(區,"讓想法開始流動"); 板["星號"]=真; 板["說明"]="一份可以自由修改的範例。拖曳卡片，讓你的下一步慢慢成形。";
    變數 想=建立清單(板,"靈感池"); 變數 待=建立清單(板,"準備出發"); 變數 進=建立清單(板,"進行中"); 進["上限"]=4; 變數 完=建立清單(板,"已完成");
    變數 卡=建立卡片(想,"捕捉一個讓你心動的點子"); 卡["說明"]="這裡是卡片詳情。可以補上背景、標籤、負責人與日期，並加入檢查表、附件和自己的筆記。"; 卡["標籤"]=["靈感"]; 卡["封面"]=1;
    卡=建立卡片(想,"整理本週的閱讀清單"); 卡["標籤"]=["生活"]; 卡["負責人"]="自己";
    卡=建立卡片(待,"設計一個小而美的首頁"); 卡["標籤"]=["設計","重要"]; 卡["優先"]=2; 卡["封面"]=2; 卡["檢查表"]=[{"名稱":"上線之前","項目":[{"名稱":"確認文字與視覺方向","完成":真},{"名稱":"完成版面草圖","完成":假},{"名稱":"檢查小螢幕的排版","完成":假}]}];
    卡=建立卡片(待,"試試把這張卡片拖到進行中"); 卡["說明"]="按住卡片拖曳，放到另一欄。也可以在詳情的移動選單使用鍵盤操作。"; 卡["標籤"]=["教學"];
    卡=建立卡片(進,"為下一個作品寫下第一步"); 卡["標籤"]=["創作"]; 卡["負責人"]="自己"; 卡["關注"]=真; 卡["檢查表"]=[{"名稱":"小步前進","項目":[{"名稱":"列出三個目標","完成":真},{"名稱":"挑選最小的一步","完成":假}]}];
    卡=建立卡片(完,"建立自己的工作空間"); 卡["完成"]=真; 卡["標籤"]=["里程碑"]; 卡["留言"]=["歡迎！這是你的個人看板，所有內容都可以編輯。"];
    存範本(板,"日常計畫");
    變數 週=建立看板(區,"一週生活提案"); 週["色系"]=1; 週["說明"]="替日常保留一些餘裕。"; 變數 列=建立清單(週,"這週想做"); 建立卡片(列,"散步時拍一張喜歡的照片"); 列=建立清單(週,"正在嘗試"); 建立卡片(列,"每天留十分鐘整理桌面"); 建立清單(週,"留下的美好"); 存範本(週,"生活與習慣");
    變數 研=建立看板(區,"產品開發流程"); 研["色系"]=2; 研["說明"]="從需求到交付，讓每一步有跡可循。"; 變數 列=建立清單(研,"需求探索"); 建立卡片(列,"收集使用者問題"); 建立清單(研,"規劃中"); 列=建立清單(研,"製作中"); 列["上限"]=3; 建立清單(研,"待驗證"); 建立清單(研,"已完成"); 存範本(研,"產品開發");
    文件["上次看板"]=板["編號"];
};
