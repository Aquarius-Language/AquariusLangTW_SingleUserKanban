# 純星泉資料模型：桌面與瀏覽器共用；不依賴繪圖或儲存主機。
變數 序列 = 匯入("Serialization");
變數 空值 = [0][1];
變數 文件 = {"格式":"星泉看板","版本":1,"序號":1,"工作區":[],"範本":[],"導覽完成":假,"上次看板":0,"今日":目前日期()};
變數 復原堆疊 = []; 變數 重做堆疊 = [];
變數 復原說明 = []; 變數 重做說明 = [];
# 0 為英文、1 為繁體中文；只影響引擎產生的活動紀錄與範例。
變數 語言 = 0;
變數 設定語言 = 函式(索引) { 語言 = 索引; };
變數 雙語 = 函式(英, 中) { 如果 (語言 == 1) { 回傳 中; } 回傳 英; };
變數 換行字 = 字串.從字元碼(10);

變數 文字化 = 函式(值) { 回傳 序列.JSON序列化(值); };
變數 餘數 = 函式(數,除數) { 回傳 數-(數/除數)*除數; };
變數 複本 = 函式(值) { 回傳 序列.解析JSON(序列.JSON序列化(值)); };
變數 識別 = 函式() { 變數 編號=文件["序號"]; 文件["序號"]=編號+1; 回傳 編號; };
變數 去除 = 函式(陣列值,位置) { 變數 新=[]; 迴圈 (變數 索=0; 索<長度(陣列值); 索++) { 如果 (索!=位置) { 新=加入(新,陣列值[索]); } } 回傳 新; };
變數 插入 = 函式(陣列值,位置,項目) { 變數 新=[]; 迴圈 (變數 索=0; 索<=長度(陣列值); 索++) { 如果 (索==位置) { 新=加入(新,項目); } 如果 (索<長度(陣列值)) { 新=加入(新,陣列值[索]); } } 回傳 新; };
變數 換位 = 函式(陣列值,位置,新位置) { 如果 (新位置<0 || 新位置>=長度(陣列值)) { 回傳 陣列值; } 變數 項=陣列值[位置]; 回傳 插入(去除(陣列值,位置),新位置,項); };
# 區分大小寫的子字串比對（保留舊行為供測試使用）。
變數 包含 = 函式(內容,查詢) {
    如果 (查詢=="") { 回傳 真; }
    迴圈 (變數 起=0; 起<=長度(內容)-長度(查詢); 起++) {
        變數 符合=真; 迴圈 (變數 字=0; 字<長度(查詢); 字++) { 如果 (內容[起+字]!=查詢[字]) { 符合=假; 中斷; } }
        如果 (符合) { 回傳 真; }
    } 回傳 假;
};
# 不分大小寫（含全形英文字母）的搜尋。
變數 小寫 = 函式(文字) { 回傳 字串.轉小寫(文字); };
變數 寬鬆包含 = 函式(內容,查詢) { 如果 (查詢=="") { 回傳 真; } 回傳 字串.包含(字串.轉小寫(內容),字串.轉小寫(查詢)); };

# ── 復原與重做 ──────────────────────────────────────────────
變數 修剪復原 = 函式() {
    變數 總量=0; 迴圈 (變數 索=0;索<長度(復原堆疊);索++) { 總量+=長度(復原堆疊[索]); }
    迴圈 (變數 索=0;索<60;索++) {
        如果 (長度(復原堆疊)<=30 && 總量<=16777216) { 中斷; }
        總量-=長度(復原堆疊[0]); 復原堆疊=其餘(復原堆疊); 復原說明=其餘(復原說明);
    }
};
變數 快照 = 函式() { 回傳 序列.JSON序列化(文件); };
# 只有實際改變文件時才推入快照，避免空的復原步驟並保留重做。
變數 推入復原 = 函式(快照文字,說明) {
    復原堆疊=加入(復原堆疊,快照文字); 復原說明=加入(復原說明,說明); 重做堆疊=[]; 重做說明=[]; 修剪復原();
};
變數 記錄復原說明 = 函式(說明) { 推入復原(快照(),說明); };
變數 記錄復原 = 函式() { 推入復原(快照(),""); };
變數 可復原 = 函式() { 回傳 長度(復原堆疊)>0; };
變數 可重做 = 函式() { 回傳 長度(重做堆疊)>0; };
變數 下個復原 = 函式() { 如果 (長度(復原說明)==0) { 回傳 ""; } 回傳 最後一個(復原說明); };
變數 下個重做 = 函式() { 如果 (長度(重做說明)==0) { 回傳 ""; } 回傳 最後一個(重做說明); };
變數 復原 = 函式() {
    如果 (長度(復原堆疊)==0) { 回傳 假; }
    重做堆疊=加入(重做堆疊,序列.JSON序列化(文件)); 重做說明=加入(重做說明,最後一個(復原說明));
    文件=序列.解析JSON(最後一個(復原堆疊)); 復原堆疊=去除(復原堆疊,長度(復原堆疊)-1); 復原說明=去除(復原說明,長度(復原說明)-1); 回傳 真;
};
變數 重做 = 函式() {
    如果 (長度(重做堆疊)==0) { 回傳 假; }
    復原堆疊=加入(復原堆疊,序列.JSON序列化(文件)); 復原說明=加入(復原說明,最後一個(重做說明));
    文件=序列.解析JSON(最後一個(重做堆疊)); 重做堆疊=去除(重做堆疊,長度(重做堆疊)-1); 重做說明=去除(重做說明,長度(重做說明)-1); 回傳 真;
};

# ── 日期 ──────────────────────────────────────────────────
變數 閏年 = 函式(年) { 回傳 (年%400==0) || (年%4==0 && 年%100!=0); };
變數 月天數 = 函式(年,月) { 變數 天=[31,28,31,30,31,30,31,31,30,31,30,31]; 如果 (月==2 && 閏年(年)) { 回傳 29; } 回傳 天[月-1]; };
變數 日期數 = 函式(日期) {
    如果 (日期=="") { 回傳 0; } 如果 (長度(日期)!=10) { 回傳 -1; } 如果 (日期[4]!="-" || 日期[7]!="-") { 回傳 -1; }
    變數 數字="0123456789"; 變數 值=0; 變數 月=0; 變數 日=0; 變數 年=0;
    迴圈 (變數 索=0; 索<10; 索++) { 如果 (索!=4 && 索!=7) { 變數 數=-1; 迴圈 (變數 位=0; 位<10; 位++) { 如果 (日期[索]==數字[位]) { 數=位; } } 如果 (數<0) { 回傳 -1; } 值=值*10+數; 如果 (索<4) { 年=年*10+數; } 否則如果 (索<7) { 月=月*10+數; } 否則 { 日=日*10+數; } } }
    如果 (月<1 || 月>12 || 日<1 || 年<1) { 回傳 -1; } 如果 (日>月天數(年,月)) { 回傳 -1; } 回傳 值;
};
# 自西元 1 年 1 月 1 日起的天數；無效或空白日期回傳 0。
變數 年前天數 = 函式(年) { 變數 前=年-1; 回傳 前*365+前/4-前/100+前/400; };
變數 日數 = 函式(日期) {
    變數 數=日期數(日期); 如果 (數<=0) { 回傳 0; }
    變數 年=數/10000; 變數 月=(數/100)%100; 變數 日=數%100; 變數 天=年前天數(年);
    迴圈 (變數 索=1; 索<月; 索++) { 天+=月天數(年,索); } 回傳 天+日;
};
變數 補零 = 函式(數,位數) { 變數 文=字串.轉文字(數); 迴圈 (變數 索=0; 索<10; 索++) { 如果 (長度(文)>=位數) { 中斷; } 文="0"+文; } 回傳 文; };
變數 組日期 = 函式(年,月,日) { 回傳 補零(年,4)+"-"+補零(月,2)+"-"+補零(日,2); };
變數 日數轉日期 = 函式(天) {
    如果 (天<=0) { 回傳 ""; }
    變數 年=天/366+1; 迴圈 (變數 索=0; 索<5; 索++) { 如果 (年前天數(年+1)<天) { 年++; } }
    變數 餘=天-年前天數(年); 變數 月=1; 迴圈 (變數 索=0; 索<12; 索++) { 變數 本月=月天數(年,月); 如果 (餘<=本月) { 中斷; } 餘-=本月; 月++; }
    回傳 組日期(年,月,餘);
};
# 0 為星期日。西元 1 年 1 月 1 日為星期一。
變數 星期 = 函式(天) { 回傳 天%7; };
變數 加天數 = 函式(日期,天) { 變數 基=日數(日期); 如果 (基<=0) { 回傳 ""; } 回傳 日數轉日期(基+天); };
變數 加月份 = 函式(日期,月數) {
    變數 數=日期數(日期); 如果 (數<=0) { 回傳 ""; }
    變數 年=數/10000; 變數 月=(數/100)%100+月數; 變數 日=數%100;
    迴圈 (變數 索=0; 索<240; 索++) { 如果 (月<=12) { 中斷; } 月-=12; 年++; }
    迴圈 (變數 索=0; 索<240; 索++) { 如果 (月>=1) { 中斷; } 月+=12; 年-=1; }
    如果 (日>月天數(年,月)) { 日=月天數(年,月); } 回傳 組日期(年,月,日);
};
# 距今日天數：負數表示已逾期；無日期回傳 null。
變數 距今 = 函式(日期) { 變數 甲=日數(日期); 變數 乙=日數(文件["今日"]); 如果 (甲<=0 || 乙<=0) { 回傳 空值; } 回傳 甲-乙; };

# ── 建立 ──────────────────────────────────────────────────
變數 建立工作區 = 函式(名稱) { 變數 區={"編號":識別(),"名稱":名稱,"說明":雙語("A place for ideas to find their flow.","讓想法找到流動的方向。"),"看板":[],"封存":假}; 文件["工作區"]=加入(文件["工作區"],區); 回傳 區; };
變數 建立看板 = 函式(區,名稱) { 變數 板={"編號":識別(),"名稱":名稱,"說明":雙語("Break big plans into small next steps.","把大計畫拆成小小的下一步。"),"清單":[],"星號":假,"封存":假,"色系":0,"自動完成":真,"活動":[]}; 區["看板"]=加入(區["看板"],板); 回傳 板; };
變數 建立清單 = 函式(板,名稱) { 變數 列={"編號":識別(),"名稱":名稱,"卡片":[],"封存":假,"完成欄":名稱=="已完成" || 名稱=="Done","上限":0,"收合":假}; 板["清單"]=加入(板["清單"],列); 回傳 列; };
變數 新卡片 = 函式(名稱) { 回傳 {"編號":識別(),"名稱":名稱,"說明":"","標籤":[],"負責人":"","開始日":"","到期日":"","完成":假,"封存":假,"優先":1,"封面":0,"檢查表":[],"附件":[],"留言":[],"關注":假,"重複":0}; };
變數 建立卡片 = 函式(列,名稱) { 變數 卡=新卡片(名稱); 列["卡片"]=加入(列["卡片"],卡); 回傳 卡; };
變數 插入卡片 = 函式(列,名稱,位置) { 變數 卡=新卡片(名稱); 如果 (位置<0 || 位置>長度(列["卡片"])) { 位置=長度(列["卡片"]); } 列["卡片"]=插入(列["卡片"],位置,卡); 回傳 卡; };

# ── 搜尋 ──────────────────────────────────────────────────
變數 找工作區 = 函式(編號) { 迴圈 (變數 索=0; 索<長度(文件["工作區"]); 索++) { 變數 區=文件["工作區"][索]; 如果 (區["編號"]==編號) { 回傳 區; } } 回傳 空值; };
變數 找看板 = 函式(編號) { 迴圈 (變數 區=0; 區<長度(文件["工作區"]); 區++) { 變數 板們=文件["工作區"][區]["看板"]; 迴圈 (變數 索=0; 索<長度(板們); 索++) { 如果 (板們[索]["編號"]==編號) { 回傳 板們[索]; } } } 回傳 空值; };
變數 找所屬區 = 函式(編號) { 迴圈 (變數 區=0; 區<長度(文件["工作區"]); 區++) { 變數 工作=文件["工作區"][區]; 迴圈 (變數 索=0; 索<長度(工作["看板"]); 索++) { 如果 (工作["看板"][索]["編號"]==編號) { 回傳 工作; } } } 回傳 空值; };
變數 找清單 = 函式(板,編號) { 迴圈 (變數 索=0; 索<長度(板["清單"]); 索++) { 如果 (板["清單"][索]["編號"]==編號) { 回傳 板["清單"][索]; } } 回傳 空值; };
變數 清單位置 = 函式(板,編號) { 迴圈 (變數 索=0; 索<長度(板["清單"]); 索++) { 如果 (板["清單"][索]["編號"]==編號) { 回傳 索; } } 回傳 -1; };
變數 找卡片 = 函式(板,編號) { 迴圈 (變數 列=0; 列<長度(板["清單"]); 列++) { 變數 清單=板["清單"][列]; 迴圈 (變數 索=0; 索<長度(清單["卡片"]); 索++) { 如果 (清單["卡片"][索]["編號"]==編號) { 回傳 [清單,清單["卡片"][索],索]; } } } 回傳 空值; };
變數 記事 = 函式(板,說明) { 板["活動"]=加入(板["活動"],文件["今日"]+" · "+說明); 如果 (長度(板["活動"])>200) { 板["活動"]=其餘(板["活動"]); } };
變數 有效卡數 = 函式(列) { 變數 數=0; 迴圈 (變數 索=0; 索<長度(列["卡片"]); 索++) { 如果 (!列["卡片"][索]["封存"]) { 數++; } } 回傳 數; };
變數 可移入 = 函式(列) { 如果 (列["上限"]<=0) { 回傳 真; } 回傳 有效卡數(列)<列["上限"]; };

# ── 重複卡片 ──────────────────────────────────────────────
變數 下次日期 = 函式(日期,重複) { 如果 (重複==1) { 回傳 加天數(日期,1); } 如果 (重複==2) { 回傳 加天數(日期,7); } 如果 (重複==3) { 回傳 加月份(日期,1); } 回傳 ""; };
# 完成具重複規則且有到期日的卡片時，在其後建立下一次的卡片。
變數 建立下一次 = 函式(列,卡) {
    如果 (卡["重複"]<=0 || 日期數(卡["到期日"])<=0) { 回傳 空值; }
    變數 新=複本(卡); 新["編號"]=識別(); 新["完成"]=假; 新["封存"]=假; 新["到期日"]=下次日期(卡["到期日"],卡["重複"]);
    如果 (日期數(卡["開始日"])>0) { 新["開始日"]=下次日期(卡["開始日"],卡["重複"]); }
    迴圈 (變數 表=0; 表<長度(新["檢查表"]); 表++) { 迴圈 (變數 項=0; 項<長度(新["檢查表"][表]["項目"]); 項++) { 新["檢查表"][表]["項目"][項]["完成"]=假; } }
    變數 位置=長度(列["卡片"]); 迴圈 (變數 索=0; 索<長度(列["卡片"]); 索++) { 如果 (列["卡片"][索]["編號"]==卡["編號"]) { 位置=索+1; } }
    列["卡片"]=插入(列["卡片"],位置,新); 回傳 新;
};
變數 設定完成 = 函式(板,列,卡,完成) {
    如果 (卡["完成"]==完成) { 回傳 空值; } 卡["完成"]=完成;
    如果 (完成) { 回傳 建立下一次(列,卡); } 回傳 空值;
};

變數 移卡 = 函式(板,卡號,目標列,位置) {
    變數 找到=找卡片(板,卡號); 變數 列=找清單(板,目標列); 如果 (找到==空值 || 列==空值) { 回傳 假; }
    如果 (找到[0]["編號"]!=目標列) { 如果 (!可移入(列)) { 回傳 假; } }
    如果 (找到[0]["編號"]==目標列) { 如果 (位置==找到[2] || 位置==找到[2]+1) { 回傳 假; } 如果 (位置>找到[2]) { 位置-=1; } }
    找到[0]["卡片"]=去除(找到[0]["卡片"],找到[2]); 如果 (位置<0 || 位置>長度(列["卡片"])) { 位置=長度(列["卡片"]); }
    列["卡片"]=插入(列["卡片"],位置,找到[1]);
    如果 (板["自動完成"] && 列["完成欄"]) { 設定完成(板,列,找到[1],真); }
    記事(板,雙語("Moved “"+找到[1]["名稱"]+"” to “"+列["名稱"]+"”.","將「"+找到[1]["名稱"]+"」移至「"+列["名稱"]+"」。")); 回傳 真;
};
變數 移清單 = 函式(板,列號,新位置) {
    變數 原=清單位置(板,列號); 如果 (原<0) { 回傳 假; } 如果 (新位置>原) { 新位置-=1; }
    如果 (新位置<0) { 新位置=0; } 如果 (新位置>=長度(板["清單"])) { 新位置=長度(板["清單"])-1; } 如果 (新位置==原) { 回傳 假; }
    板["清單"]=換位(板["清單"],原,新位置); 回傳 真;
};
變數 複製卡 = 函式(列,卡) { 變數 新=複本(卡); 新["編號"]=識別(); 新["名稱"]=新["名稱"]+雙語(" (copy)","（複本）"); 新["封存"]=假; 列["卡片"]=加入(列["卡片"],新); 回傳 新; };
# 貼上卡片：保留原名稱並插在指定位置。
變數 貼上卡 = 函式(列,卡,位置) { 變數 新=複本(卡); 新["編號"]=識別(); 新["封存"]=假; 如果 (位置<0 || 位置>長度(列["卡片"])) { 位置=長度(列["卡片"]); } 列["卡片"]=插入(列["卡片"],位置,新); 回傳 新; };
變數 複製看板 = 函式(區,板,名稱) {
    變數 新=複本(板); 新["編號"]=識別(); 新["名稱"]=名稱; 新["封存"]=假; 新["星號"]=假; 新["活動"]=[];
    迴圈 (變數 列=0; 列<長度(新["清單"]); 列++) { 變數 清單=新["清單"][列]; 清單["編號"]=識別(); 迴圈 (變數 卡=0; 卡<長度(清單["卡片"]); 卡++) { 清單["卡片"][卡]["編號"]=識別(); } }
    區["看板"]=加入(區["看板"],新); 回傳 新;
};
變數 存範本 = 函式(板,名稱) { 文件["範本"]=加入(文件["範本"],{"編號":識別(),"名稱":名稱,"說明":板["說明"],"看板":複本(板)}); };
變數 套範本 = 函式(區,索,名稱) { 回傳 複製看板(區,文件["範本"][索]["看板"],名稱); };
變數 檢查進度 = 函式(卡) { 變數 全=0; 變數 完=0; 迴圈 (變數 表=0; 表<長度(卡["檢查表"]); 表++) { 變數 項目=卡["檢查表"][表]["項目"]; 迴圈 (變數 索=0; 索<長度(項目); 索++) { 全++; 如果 (項目[索]["完成"]) { 完++; } } } 回傳 [完,全]; };

# ── 篩選 ──────────────────────────────────────────────────
變數 標籤含 = 函式(標籤們,標籤) { 迴圈 (變數 索=0; 索<長度(標籤們); 索++) { 如果 (標籤們[索]==標籤) { 回傳 真; } } 回傳 假; };
變數 卡片文字 = 函式(卡) {
    變數 文=卡["名稱"]+" "+卡["說明"]+" "+卡["負責人"]; 迴圈 (變數 索=0; 索<長度(卡["標籤"]); 索++) { 文+=" "+卡["標籤"][索]; }
    迴圈 (變數 索=0; 索<長度(卡["留言"]); 索++) { 文+=" "+卡["留言"][索]; }
    迴圈 (變數 表=0; 表<長度(卡["檢查表"]); 表++) { 變數 項們=卡["檢查表"][表]["項目"]; 迴圈 (變數 索=0; 索<長度(項們); 索++) { 文+=" "+項們[索]["名稱"]; } }
    回傳 文;
};
# 狀態：0 全部、1 未完成、2 已完成、3 今日與逾期、4 我關注的、5 本週到期、6 高優先。
變數 符合 = 函式(卡,查詢,標籤,狀態,負責人) {
    如果 (卡["封存"]) { 回傳 假; }
    如果 (查詢!="") { 如果 (!寬鬆包含(卡片文字(卡),查詢)) { 回傳 假; } }
    如果 (標籤!="") { 如果 (!標籤含(卡["標籤"],標籤)) { 回傳 假; } }
    如果 (負責人!="") { 如果 (卡["負責人"]!=負責人) { 回傳 假; } }
    如果 (狀態==1 && 卡["完成"]) { 回傳 假; } 如果 (狀態==2 && !卡["完成"]) { 回傳 假; }
    如果 (狀態==3) { 如果 (卡["完成"]) { 回傳 假; } 變數 差=距今(卡["到期日"]); 如果 (差==空值) { 回傳 假; } 如果 (差>0) { 回傳 假; } }
    如果 (狀態==4 && !卡["關注"]) { 回傳 假; }
    如果 (狀態==5) { 如果 (卡["完成"]) { 回傳 假; } 變數 差=距今(卡["到期日"]); 如果 (差==空值) { 回傳 假; } 如果 (差>7) { 回傳 假; } }
    如果 (狀態==6 && 卡["優先"]!=2) { 回傳 假; }
    回傳 真;
};
變數 統計 = 函式(板) {
    變數 全=0; 變數 完=0; 變數 逾=0; 變數 今=日期數(文件["今日"]);
    迴圈 (變數 列=0; 列<長度(板["清單"]); 列++) { 變數 清單=板["清單"][列]; 如果 (!清單["封存"]) { 變數 卡們=清單["卡片"]; 迴圈 (變數 索=0; 索<長度(卡們); 索++) { 變數 卡=卡們[索]; 如果 (!卡["封存"]) { 全++; 如果 (卡["完成"]) { 完++; } 否則 { 變數 到=卡["到期日"]; 如果 (到!="") { 變數 數=日期數(到); 如果 (數>0) { 如果 (數<今) { 逾++; } } } } } } } }
    回傳 [全,完,逾];
};
# 依出現次數排列看板內的標籤或負責人：[[名稱,次數],…]。
變數 收集 = 函式(板,欄位) {
    變數 名們=[]; 變數 數們=[];
    迴圈 (變數 列=0; 列<長度(板["清單"]); 列++) { 變數 清單=板["清單"][列]; 如果 (!清單["封存"]) { 迴圈 (變數 索=0; 索<長度(清單["卡片"]); 索++) { 變數 卡=清單["卡片"][索]; 如果 (!卡["封存"]) {
        變數 值們=[]; 如果 (欄位=="標籤") { 值們=卡["標籤"]; } 否則如果 (卡["負責人"]!="") { 值們=[卡["負責人"]]; }
        迴圈 (變數 位=0; 位<長度(值們); 位++) { 變數 找=陣列.尋找(名們,值們[位]); 如果 (找<0) { 名們=加入(名們,值們[位]); 數們=加入(數們,1); } 否則 { 數們[找]=數們[找]+1; } }
    } } } }
    變數 結果=[]; 迴圈 (變數 索=0; 索<長度(名們); 索++) { 結果=加入(結果,[名們[索],數們[索]]); }
    迴圈 (變數 甲=1; 甲<長度(結果); 甲++) { 變數 項=結果[甲]; 變數 乙=甲-1; 迴圈 (變數 次=0; 次<長度(結果); 次++) { 如果 (乙<0) { 中斷; } 如果 (結果[乙][1]>=項[1]) { 中斷; } 結果[乙+1]=結果[乙]; 乙-=1; } 結果[乙+1]=項; }
    回傳 結果;
};
# 標籤顏色依名稱決定，同一個標籤在每張卡片上顏色一致。
變數 標籤色 = 函式(名稱) { 變數 和=7; 迴圈 (變數 索=0; 索<長度(名稱); 索++) { 和=(和*31+字串.字元碼(名稱,索))%100003; } 回傳 和%6; };
# 依字元碼比較兩段文字，供表格排序。
變數 比較文字 = 函式(甲,乙) {
    變數 短=長度(甲); 如果 (長度(乙)<短) { 短=長度(乙); }
    迴圈 (變數 索=0; 索<短; 索++) { 變數 子=字串.字元碼(甲,索); 變數 丑=字串.字元碼(乙,索); 如果 (子<丑) { 回傳 -1; } 如果 (子>丑) { 回傳 1; } }
    如果 (長度(甲)<長度(乙)) { 回傳 -1; } 如果 (長度(甲)>長度(乙)) { 回傳 1; } 回傳 0;
};

# ── 匯出 ──────────────────────────────────────────────────
變數 CSV欄 = 函式(文字) {
    變數 引號=字串.從字元碼(34); 變數 需要=字串.包含(文字,",") || 字串.包含(文字,引號) || 字串.包含(文字,換行字) || 字串.包含(文字,字串.從字元碼(13));
    如果 (!需要) { 回傳 文字; } 回傳 引號+字串.取代(文字,引號,引號+引號)+引號;
};
# 標題：清單、卡片、說明、標籤、負責人、開始日、到期日、完成、優先、檢查表。
變數 匯出CSV = 函式(板,標題們,是字,否字,優先名) {
    變數 列們=[]; 列們=加入(列們,字串.合併(標題們,","));
    迴圈 (變數 列=0; 列<長度(板["清單"]); 列++) { 變數 清單=板["清單"][列]; 如果 (!清單["封存"]) { 迴圈 (變數 索=0; 索<長度(清單["卡片"]); 索++) { 變數 卡=清單["卡片"][索]; 如果 (!卡["封存"]) {
        變數 進=檢查進度(卡); 變數 完=否字; 如果 (卡["完成"]) { 完=是字; } 變數 進文=""; 如果 (進[1]>0) { 進文=字串.轉文字(進[0])+"/"+字串.轉文字(進[1]); }
        變數 欄們=[CSV欄(清單["名稱"]),CSV欄(卡["名稱"]),CSV欄(卡["說明"]),CSV欄(字串.合併(卡["標籤"],"; ")),CSV欄(卡["負責人"]),卡["開始日"],卡["到期日"],完,優先名[卡["優先"]],進文];
        列們=加入(列們,字串.合併(欄們,","));
    } } } }
    回傳 字串.從字元碼(65279)+字串.合併(列們,字串.從字元碼(13)+換行字);
};
變數 匯出Markdown = 函式(板,到期字,負責字,標籤字) {
    變數 行們=["# "+板["名稱"],"",板["說明"],""];
    迴圈 (變數 列=0; 列<長度(板["清單"]); 列++) { 變數 清單=板["清單"][列]; 如果 (!清單["封存"]) {
        行們=加入(行們,"## "+清單["名稱"]); 行們=加入(行們,"");
        迴圈 (變數 索=0; 索<長度(清單["卡片"]); 索++) { 變數 卡=清單["卡片"][索]; 如果 (!卡["封存"]) {
            變數 框="- [ ] "; 如果 (卡["完成"]) { 框="- [x] "; } 變數 行=框+卡["名稱"];
            如果 (卡["到期日"]!="") { 行+=" · "+到期字+" "+卡["到期日"]; } 如果 (卡["負責人"]!="") { 行+=" · "+負責字+" "+卡["負責人"]; } 如果 (長度(卡["標籤"])>0) { 行+=" · "+標籤字+" "+字串.合併(卡["標籤"],", "); }
            行們=加入(行們,行);
            迴圈 (變數 表=0; 表<長度(卡["檢查表"]); 表++) { 變數 項們=卡["檢查表"][表]["項目"]; 迴圈 (變數 位=0; 位<長度(項們); 位++) { 變數 小框="  - [ ] "; 如果 (項們[位]["完成"]) { 小框="  - [x] "; } 行們=加入(行們,小框+項們[位]["名稱"]); } }
        } }
        行們=加入(行們,"");
    } }
    回傳 字串.合併(行們,換行字);
};

# ── 驗證 ──────────────────────────────────────────────────
變數 形狀 = 函式(值,首字) { 變數 文字=序列.JSON序列化(值); 回傳 文字[0]==首字; };
變數 是文字 = 函式(值) { 回傳 型別(值)=="string"; };
變數 是陣列 = 函式(值) { 回傳 型別(值)=="array"; };
變數 是物件 = 函式(值) { 回傳 型別(值)=="hash"; };
變數 是整數 = 函式(值) { 如果 (型別(值)!="integer") { 回傳 假; } 回傳 值>=0 && 值<=2147483000; };
變數 是真假 = 函式(值) { 回傳 型別(值)=="boolean"; };
變數 已用編號={}; 變數 最大編號=0;
變數 驗編號 = 函式(值,唯一) { 如果 (!是整數(值)) { 回傳 假; } 如果 (值<1) { 回傳 假; } 如果 (唯一) { 如果 (已用編號[值]!=空值) { 回傳 假; } 已用編號[值]=真; } 如果 (值>最大編號) { 最大編號=值; } 回傳 真; };
# 選用欄位：舊備份沒有時補上預設值，存在時檢查型別。
變數 選用真假 = 函式(物件,欄) { 如果 (物件[欄]==空值) { 物件[欄]=假; 回傳 真; } 回傳 是真假(物件[欄]); };
變數 驗卡 = 函式(卡,唯一) {
    如果 (!是物件(卡)) { 回傳 假; } 如果 (!驗編號(卡["編號"],唯一)) { 回傳 假; }
    變數 文欄=["名稱","說明","負責人","開始日","到期日"]; 迴圈 (變數 索=0;索<長度(文欄);索++) { 如果 (!是文字(卡[文欄[索]])) { 回傳 假; } 如果 (長度(卡[文欄[索]])>65536) { 回傳 假; } }
    如果 (日期數(卡["開始日"])<0 || 日期數(卡["到期日"])<0) { 回傳 假; }
    如果 (!是真假(卡["完成"]) || !是真假(卡["封存"]) || !是真假(卡["關注"])) { 回傳 假; }
    如果 (!是整數(卡["優先"]) || !是整數(卡["封面"])) { 回傳 假; } 如果 (卡["優先"]>2 || 卡["封面"]>6) { 回傳 假; }
    如果 (卡["重複"]==空值) { 卡["重複"]=0; } 如果 (!是整數(卡["重複"])) { 回傳 假; } 如果 (卡["重複"]>3) { 回傳 假; }
    變數 列欄=["標籤","檢查表","附件","留言"]; 迴圈 (變數 索=0;索<長度(列欄);索++) { 如果 (!是陣列(卡[列欄[索]])) { 回傳 假; } 如果 (長度(卡[列欄[索]])>1000) { 回傳 假; } }
    迴圈 (變數 索=0;索<長度(卡["標籤"]);索++) { 如果 (!是文字(卡["標籤"][索])) { 回傳 假; } }
    迴圈 (變數 索=0;索<長度(卡["留言"]);索++) { 如果 (!是文字(卡["留言"][索])) { 回傳 假; } }
    迴圈 (變數 索=0;索<長度(卡["檢查表"]);索++) { 變數 表=卡["檢查表"][索]; 如果 (!是物件(表)) { 回傳 假; } 如果 (!是文字(表["名稱"]) || !是陣列(表["項目"])) { 回傳 假; } 迴圈 (變數 位=0;位<長度(表["項目"]);位++) { 變數 項=表["項目"][位]; 如果 (!是物件(項)) { 回傳 假; } 如果 (!是文字(項["名稱"]) || !是真假(項["完成"])) { 回傳 假; } } }
    迴圈 (變數 索=0;索<長度(卡["附件"]);索++) { 變數 附=卡["附件"][索]; 如果 (!是物件(附)) { 回傳 假; } 如果 (!是文字(附["名稱"]) || !是文字(附["資源鍵"]) || !是整數(附["大小"])) { 回傳 假; } 如果 (附["大小"]>262144) { 回傳 假; } }
    回傳 真;
};
變數 驗板 = 函式(板,唯一) {
    如果 (!是物件(板)) { 回傳 假; } 如果 (!驗編號(板["編號"],唯一)) { 回傳 假; }
    如果 (!是文字(板["名稱"]) || !是文字(板["說明"]) || !是陣列(板["清單"]) || !是陣列(板["活動"])) { 回傳 假; }
    如果 (!是真假(板["封存"]) || !是真假(板["星號"]) || !是真假(板["自動完成"]) || !是整數(板["色系"])) { 回傳 假; } 如果 (板["色系"]>5) { 回傳 假; }
    迴圈 (變數 索=0;索<長度(板["活動"]);索++) { 如果 (!是文字(板["活動"][索])) { 回傳 假; } }
    迴圈 (變數 索=0;索<長度(板["清單"]);索++) { 變數 列=板["清單"][索]; 如果 (!是物件(列)) { 回傳 假; } 如果 (!驗編號(列["編號"],唯一)) { 回傳 假; }
        如果 (!是文字(列["名稱"]) || !是陣列(列["卡片"]) || !是真假(列["封存"]) || !是真假(列["完成欄"]) || !是整數(列["上限"])) { 回傳 假; }
        如果 (!選用真假(列,"收合")) { 回傳 假; }
        迴圈 (變數 位=0;位<長度(列["卡片"]);位++) { 如果 (!驗卡(列["卡片"][位],唯一)) { 回傳 假; } }
    } 回傳 真;
};
變數 驗證文件 = 函式(新) {
    如果 (!是物件(新)) { 回傳 假; } 如果 (新["格式"]!="星泉看板" || 新["版本"]!=1) { 回傳 假; }
    如果 (!是陣列(新["工作區"]) || !是陣列(新["範本"]) || !是整數(新["序號"]) || !是整數(新["上次看板"]) || !是真假(新["導覽完成"]) || !是文字(新["今日"])) { 回傳 假; }
    如果 (日期數(新["今日"])<=0) { 回傳 假; } 已用編號={}; 最大編號=0;
    迴圈 (變數 索=0;索<長度(新["工作區"]);索++) { 變數 區=新["工作區"][索]; 如果 (!是物件(區)) { 回傳 假; } 如果 (!驗編號(區["編號"],真)) { 回傳 假; } 如果 (!是文字(區["名稱"]) || !是文字(區["說明"]) || !是真假(區["封存"]) || !是陣列(區["看板"])) { 回傳 假; } 迴圈 (變數 位=0;位<長度(區["看板"]);位++) { 如果 (!驗板(區["看板"][位],真)) { 回傳 假; } } }
    迴圈 (變數 索=0;索<長度(新["範本"]);索++) { 變數 範=新["範本"][索]; 如果 (!是物件(範)) { 回傳 假; } 如果 (!驗編號(範["編號"],真)) { 回傳 假; } 如果 (!是文字(範["名稱"]) || !是文字(範["說明"]) || !驗板(範["看板"],假)) { 回傳 假; } }
    回傳 新["序號"]>最大編號;
};
變數 載入 = 函式(新) { 如果 (!驗證文件(新)) { 回傳 假; } 文件=新; 復原堆疊=[]; 重做堆疊=[]; 復原說明=[]; 重做說明=[]; 回傳 真; };
變數 置換 = 函式(新) { 文件=新; };

# ── 範例 ──────────────────────────────────────────────────
變數 初始範例語言 = 函式(索引) {
    語言=索引; 變數 英=索引==0;
    變數 區=建立工作區(雙語("My Studio","我的星泉工作室"));
    變數 板=建立看板(區,雙語("Let ideas flow","讓想法開始流動")); 板["星號"]=真; 板["說明"]=雙語("A sample board you can change freely. Drag cards to shape your next step.","一份可以自由修改的範例。拖曳卡片，讓你的下一步慢慢成形。");
    變數 想=建立清單(板,雙語("Ideas","靈感池")); 變數 待=建立清單(板,雙語("Up next","準備出發")); 變數 進=建立清單(板,雙語("In progress","進行中")); 進["上限"]=4; 變數 完=建立清單(板,雙語("Done","已完成")); 完["完成欄"]=真;
    變數 卡=建立卡片(想,雙語("Capture an idea that excites you","捕捉一個讓你心動的點子")); 卡["說明"]=雙語("This is the card detail. Add background, tags, an owner and dates, then checklists, attachments and your own notes.","這裡是卡片詳情。可以補上背景、標籤、負責人與日期，並加入檢查表、附件和自己的筆記。"); 卡["標籤"]=[雙語("Ideas","靈感")]; 卡["封面"]=1;
    卡=建立卡片(想,雙語("Sort this week's reading list","整理本週的閱讀清單")); 卡["標籤"]=[雙語("Life","生活")]; 卡["負責人"]=雙語("Me","自己");
    卡=建立卡片(待,雙語("Design a small, beautiful home page","設計一個小而美的首頁")); 卡["標籤"]=[雙語("Design","設計"),雙語("Important","重要")]; 卡["優先"]=2; 卡["封面"]=2; 卡["檢查表"]=[{"名稱":雙語("Before launch","上線之前"),"項目":[{"名稱":雙語("Confirm copy and visual direction","確認文字與視覺方向"),"完成":真},{"名稱":雙語("Finish layout sketches","完成版面草圖"),"完成":假},{"名稱":雙語("Check small-screen layout","檢查小螢幕的排版"),"完成":假}]}];
    卡=建立卡片(待,雙語("Try dragging this card to In progress","試試把這張卡片拖到進行中")); 卡["說明"]=雙語("Press and drag a card to another list. Right-click a card for more actions, or use the Move menu in its detail.","按住卡片拖曳，放到另一欄。在卡片上按右鍵可看到更多動作，也可以在詳情的移動選單使用鍵盤操作。"); 卡["標籤"]=[雙語("Tutorial","教學")];
    卡=建立卡片(進,雙語("Write down the first step of your next project","為下一個作品寫下第一步")); 卡["標籤"]=[雙語("Create","創作")]; 卡["負責人"]=雙語("Me","自己"); 卡["關注"]=真; 卡["到期日"]=加天數(文件["今日"],2); 卡["檢查表"]=[{"名稱":雙語("Small steps","小步前進"),"項目":[{"名稱":雙語("List three goals","列出三個目標"),"完成":真},{"名稱":雙語("Pick the smallest step","挑選最小的一步"),"完成":假}]}];
    卡=建立卡片(完,雙語("Create your own workspace","建立自己的工作空間")); 卡["完成"]=真; 卡["標籤"]=[雙語("Milestone","里程碑")]; 卡["留言"]=[雙語("Welcome! This is your personal board. Everything is editable.","歡迎！這是你的個人看板，所有內容都可以編輯。")];
    存範本(板,雙語("Everyday plan","日常計畫"));
    變數 週=建立看板(區,雙語("A week of small joys","一週生活提案")); 週["色系"]=1; 週["說明"]=雙語("Leave a little room in everyday life.","替日常保留一些餘裕。");
    變數 列=建立清單(週,雙語("This week","這週想做")); 建立卡片(列,雙語("Take a photo you love on a walk","散步時拍一張喜歡的照片"));
    列=建立清單(週,雙語("Trying","正在嘗試")); 卡=建立卡片(列,雙語("Tidy the desk for ten minutes a day","每天留十分鐘整理桌面")); 卡["重複"]=1; 卡["到期日"]=文件["今日"];
    列=建立清單(週,雙語("Kept","留下的美好")); 列["完成欄"]=真; 存範本(週,雙語("Life and habits","生活與習慣"));
    變數 研=建立看板(區,雙語("Product development","產品開發流程")); 研["色系"]=2; 研["說明"]=雙語("From request to delivery, every step leaves a trail.","從需求到交付，讓每一步有跡可循。");
    列=建立清單(研,雙語("Discovery","需求探索")); 建立卡片(列,雙語("Collect user problems","收集使用者問題")); 建立清單(研,雙語("Planned","規劃中")); 列=建立清單(研,雙語("Building","製作中")); 列["上限"]=3; 建立清單(研,雙語("Review","待驗證")); 列=建立清單(研,雙語("Done","已完成")); 列["完成欄"]=真;
    存範本(研,雙語("Product development","產品開發"));
    文件["上次看板"]=板["編號"];
};
變數 初始範例 = 函式() { 初始範例語言(語言); };
