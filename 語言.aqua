# 依首字分桶，避免在大型雜湊表中線性搜尋。
變數 桶數 = 61;
變數 桶們 = [];
迴圈 (變數 索=0; 索<桶數; 索++) { 桶們=加入(桶們,{}); }
變數 全鍵 = 雜湊.鍵列表(英文表);
迴圈 (變數 索=0; 索<長度(全鍵); 索++) { 變數 鍵=全鍵[索]; 變數 碼=字串.字元碼(鍵,0); 如果 (碼==[0][1]) { 碼=0; } 桶們[碼%桶數][鍵]=英文表[鍵]; }
變數 設定 = 函式(索引) { 目前 = 索引; };
變數 字 = 函式(鍵) {
    如果 (目前==1 || 鍵=="") { 回傳 鍵; }
    變數 碼=字串.字元碼(鍵,0); 如果 (碼==[0][1]) { 碼=0; }
    變數 值=桶們[碼%桶數][鍵]; 如果 (值==[0][1]) { 如果 (!陣列.包含(缺少,鍵)) { 缺少=加入(缺少,鍵); } 回傳 鍵; } 回傳 值;
};
# 以參數取代 {0}、{1}…，並處理英文單複數 {0|單數|複數}。
變數 格式 = 函式(鍵,參數們) {
    變數 文=字(鍵);
    迴圈 (變數 索=0; 索<長度(參數們); 索++) {
        變數 值=參數們[索]; 變數 值文=字串.轉文字(值); 變數 標="{"+字串.轉文字(索);
        迴圈 (變數 次=0; 次<8; 次++) {
            變數 位=字串.尋找(文,標+"|"); 如果 (位<0) { 中斷; }
            變數 終=字串.尋找(字串.切片(文,位,長度(文)),"}"); 如果 (終<0) { 中斷; } 終+=位;
            變數 內=字串.切片(文,位+長度(標)+1,終); 變數 分=字串.分割(內,"|"); 變數 選=分[0]; 如果 (值文!="1" && 長度(分)>1) { 選=分[1]; }
            文=字串.切片(文,0,位)+選+字串.切片(文,終+1,長度(文));
        }
        文=字串.取代(文,標+"}",值文);
    }
    回傳 文;
};
